@import "../../styles/tool-common.wxss";

page { background-color: var(--pageBg,#F8FAFC); }

/* ========== Image List ========== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.section-count {
  font-size: 13px;
  color: var(--textTertiary);
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 12px;
}

.image-item {
  width: calc(33.33% - 7px);
  aspect-ratio: 1;
  position: relative;
  border-radius: 12px;
  overflow: hidden;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: rgba(0,0,0,0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-remove text {
  font-size: 12px;
  color: #FFFFFF;
}

.image-order {
  position: absolute;
  bottom: 4px;
  left: 4px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  color: #FFFFFF;
  font-weight: 700;
}

.image-add {
  width: calc(33.33% - 7px);
  aspect-ratio: 1;
  border: 2px dashed var(--borderLight);
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.image-add-hover {
  border-color: var(--primaryColor);
  background: rgba(59,130,246,0.04);
}

.add-icon {
  font-size: 28px;
  color: var(--textTertiary);
  line-height: 1;
}

.add-text {
  font-size: 11px;
  color: var(--textTertiary);
  margin-top: 4px;
}

/* ========== Options ========== */
.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12px;
}

.option-label {
  font-size: 14px;
  font-weight: 600;
  color: var(--textPrimary);
}

.option-btns {
  display: flex;
  gap: 8px;
}

.opt-btn {
  padding: 6px 16px;
  border-radius: 12px;
  background: var(--surfaceBg);
  border: 1px solid var(--borderLight);
  transition: all 0.15s ease;
}

.opt-btn text {
  font-size: 13px;
  font-weight: 600;
  color: var(--textSecondary);
}

.opt-btn.active {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
  border-color: #7C3AED;
}

.opt-btn.active text {
  color: #FFFFFF;
}

.color-options {
  display: flex;
  gap: 10px;
}

.color-dot {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid var(--borderLight);
  transition: all 0.15s ease;
}

.color-dot.active {
  border-color: #7C3AED;
  box-shadow: 0 0 0 2px rgba(124,58,237,0.3);
}

/* ========== Result ========== */
.result-image {
  width: 100%;
  border-radius: 16px;
  margin-top: 12px;
}

/* ========== Tip Card ========== */
.tip-card {
  background: linear-gradient(135deg, #FEFCE8 0%, #FEF9C3 100%);
  border-radius: var(--radius2xl, 24px);
  padding: 16px 20px;
  margin-top: 16px;
  border-left: 4px solid #EAB308;
}

.tip-title {
  font-size: 14px;
  font-weight: 700;
  color: #854D0E;
  margin-bottom: 8px;
  display: block;
}

.tip-item {
  font-size: 13px;
  color: #A16207;
  line-height: 1.8;
  display: block;
}

/* ========== Dark Mode ========== */
.dark-mode .image-add {
  border-color: #334155;
}

.dark-mode .image-add-hover {
  border-color: #60A5FA;
}

.dark-mode .opt-btn {
  background: #1E293B;
  border-color: #334155;
}

.dark-mode .opt-btn text {
  color: #94A3B8;
}

.dark-mode .opt-btn.active {
  background: linear-gradient(135deg, #8B5CF6 0%, #6D28D9 100%);
  border-color: #8B5CF6;
}

.dark-mode .opt-btn.active text {
  color: #FFFFFF;
}

.dark-mode .color-dot {
  border-color: #475569;
}

.dark-mode .color-dot.active {
  border-color: #A78BFA;
  box-shadow: 0 0 0 2px rgba(167,139,250,0.3);
}

.dark-mode .image-order {
  background: rgba(0,0,0,0.65);
}

.dark-mode .tip-card {
  background: linear-gradient(135deg, #422006 0%, #713F12 100%);
  border-left-color: #CA8A04;
}

.dark-mode .tip-title {
  color: #FEF08A;
}

.dark-mode .tip-item {
  color: #D4AF37;
}
