/* 页面容器 */
.container {
  min-height: 100vh;
  padding: 24rpx 32rpx 60rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%);
  box-sizing: border-box;
}

/* 暗色模式 */
.container.dark-mode {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

/* 工具头部 */
.tool-header {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .tool-header {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.tool-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #8B5CF6, #EC4899);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.tool-icon {
  font-size: 44rpx;
}

.tool-info {
  display: flex;
  flex-direction: column;
}

.tool-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 6rpx;
}

.dark-mode .tool-title {
  color: #f3f4f6;
}

.tool-desc {
  font-size: 24rpx;
  color: #9ca3af;
}

.dark-mode .tool-desc {
  color: #9ca3af;
}

/* ========== 测试列表页 ========== */
.page-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.test-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease;
}

.test-card:active {
  transform: scale(0.98);
}

.dark-mode .test-card {
  background: #2a2a4a;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.test-card-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dark-mode .test-card-icon-wrap {
  background: #374151;
}

.test-card-icon {
  font-size: 40rpx;
}

.test-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.test-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 6rpx;
}

.dark-mode .test-card-title {
  color: #f3f4f6;
}

.test-card-desc {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 4rpx;
}

.dark-mode .test-card-desc {
  color: #9ca3af;
}

.test-card-count {
  font-size: 22rpx;
  color: #9ca3af;
}

.dark-mode .test-card-count {
  color: #6b7280;
}

.test-card-arrow {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.arrow-icon {
  font-size: 40rpx;
  color: #d1d5db;
  font-weight: 300;
}

.dark-mode .arrow-icon {
  color: #4b5563;
}

/* ========== 答题页 ========== */
.page-test {
  display: flex;
  flex-direction: column;
}

/* 进度条 */
.progress-bar-wrap {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #e5e7eb;
  border-radius: 6rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.dark-mode .progress-bar {
  background: #374151;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #8B5CF6, #EC4899);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #6b7280;
  flex-shrink: 0;
  white-space: nowrap;
}

.dark-mode .progress-text {
  color: #9ca3af;
}

/* 题目卡片 */
.question-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .question-card {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.question-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #1f2937;
  line-height: 1.6;
}

.dark-mode .question-text {
  color: #f3f4f6;
}

/* 选项列表 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-btn {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.option-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(139, 92, 246, 0.2);
}

.dark-mode .option-btn {
  background: #2a2a4a;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.option-index-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B5CF6, #EC4899);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-index {
  font-size: 24rpx;
  font-weight: bold;
  color: #ffffff;
}

.option-text {
  font-size: 28rpx;
  color: #374151;
  flex: 1;
}

.dark-mode .option-text {
  color: #e5e7eb;
}

/* ========== 结果页 ========== */
.page-result {
  display: flex;
  flex-direction: column;
}

.result-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .result-card {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.result-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.dark-mode .result-title {
  color: #f3f4f6;
}

.result-score-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #f3f4f6, #e5e7eb);
  border-radius: 32rpx;
  margin-bottom: 24rpx;
}

.dark-mode .result-score-wrap {
  background: linear-gradient(135deg, #374151, #4b5563);
}

.result-score-label {
  font-size: 24rpx;
  color: #6b7280;
}

.dark-mode .result-score-label {
  color: #9ca3af;
}

.result-score-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B5CF6;
}

.dark-mode .result-score-value {
  color: #A78BFA;
}

.result-desc {
  font-size: 28rpx;
  color: #4b5563;
  line-height: 1.8;
  text-align: center;
}

.dark-mode .result-desc {
  color: #d1d5db;
}

/* 操作按钮 */
.result-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 20rpx;
  transition: opacity 0.2s ease;
}

.action-btn:active {
  opacity: 0.85;
}

.action-btn-primary {
  background: linear-gradient(135deg, #8B5CF6, #EC4899);
  box-shadow: 0 6rpx 24rpx rgba(139, 92, 246, 0.4);
}

.action-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.action-btn-secondary {
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.dark-mode .action-btn-secondary {
  background: #2a2a4a;
  border-color: #4b5563;
}

.action-btn-text-secondary {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
}

.dark-mode .action-btn-text-secondary {
  color: #e5e7eb;
}

/* 分享区域 */
.share-area {
  margin-bottom: 24rpx;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  padding: 0;
  margin: 0;
  line-height: normal;
}

.share-btn::after {
  border: none;
}

.dark-mode .share-btn {
  background: #2a2a4a;
  border-color: #4b5563;
}

.share-btn-text {
  font-size: 28rpx;
  color: #6b7280;
}

.dark-mode .share-btn-text {
  color: #9ca3af;
}

/* 免责声明 */
.disclaimer {
  padding: 24rpx;
  background: rgba(245, 158, 11, 0.08);
  border-radius: 16rpx;
  margin-top: 8rpx;
}

.dark-mode .disclaimer {
  background: rgba(245, 158, 11, 0.12);
}

.disclaimer-text {
  font-size: 22rpx;
  color: #92400e;
  line-height: 1.6;
}

.dark-mode .disclaimer-text {
  color: #fbbf24;
}

/* ========== 字体大小设置 ========== */
.font-size-small .tool-title { font-size: 30rpx; }
.font-size-small .tool-desc { font-size: 22rpx; }
.font-size-small .test-card-title { font-size: 26rpx; }
.font-size-small .test-card-desc { font-size: 22rpx; }
.font-size-small .test-card-count { font-size: 20rpx; }
.font-size-small .progress-text { font-size: 22rpx; }
.font-size-small .question-text { font-size: 30rpx; }
.font-size-small .option-text { font-size: 26rpx; }
.font-size-small .result-title { font-size: 36rpx; }
.font-size-small .result-desc { font-size: 26rpx; }
.font-size-small .action-btn-text { font-size: 28rpx; }
.font-size-small .action-btn-text-secondary { font-size: 28rpx; }
.font-size-small .share-btn-text { font-size: 26rpx; }
.font-size-small .disclaimer-text { font-size: 20rpx; }

.font-size-medium .tool-title { font-size: 36rpx; }
.font-size-medium .tool-desc { font-size: 24rpx; }
.font-size-medium .test-card-title { font-size: 30rpx; }
.font-size-medium .test-card-desc { font-size: 24rpx; }
.font-size-medium .test-card-count { font-size: 22rpx; }
.font-size-medium .progress-text { font-size: 24rpx; }
.font-size-medium .question-text { font-size: 34rpx; }
.font-size-medium .option-text { font-size: 28rpx; }
.font-size-medium .result-title { font-size: 40rpx; }
.font-size-medium .result-desc { font-size: 28rpx; }
.font-size-medium .action-btn-text { font-size: 30rpx; }
.font-size-medium .action-btn-text-secondary { font-size: 30rpx; }
.font-size-medium .share-btn-text { font-size: 28rpx; }
.font-size-medium .disclaimer-text { font-size: 22rpx; }

.font-size-large .tool-title { font-size: 42rpx; }
.font-size-large .tool-desc { font-size: 28rpx; }
.font-size-large .test-card-title { font-size: 34rpx; }
.font-size-large .test-card-desc { font-size: 28rpx; }
.font-size-large .test-card-count { font-size: 26rpx; }
.font-size-large .progress-text { font-size: 28rpx; }
.font-size-large .question-text { font-size: 38rpx; }
.font-size-large .option-text { font-size: 32rpx; }
.font-size-large .result-title { font-size: 46rpx; }
.font-size-large .result-desc { font-size: 32rpx; }
.font-size-large .action-btn-text { font-size: 34rpx; }
.font-size-large .action-btn-text-secondary { font-size: 34rpx; }
.font-size-large .share-btn-text { font-size: 32rpx; }
.font-size-large .disclaimer-text { font-size: 26rpx; }

/* 暗黑模式补充 */
.dark-mode .container {
  background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
}

.dark-mode .tool-header {
  background: #334155;
}

.dark-mode .test-card {
  background: #334155;
}

.dark-mode .question-card {
  background: #334155;
}

.dark-mode .option-btn {
  background: #334155;
  color: #F1F5F9;
  border-color: rgba(255, 255, 255, 0.1);
}

.dark-mode .result-card {
  background: #334155;
}

.dark-mode .result-score-wrap {
  background: linear-gradient(135deg, #1E293B, #0F172A);
}

.dark-mode .share-btn {
  background: #334155;
  color: #F1F5F9;
}