.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4ff, #f8f9fe);
  padding-bottom: 60rpx;
}

/* 暗黑模式 */
.dark-mode {
  background: linear-gradient(180deg, #1a1a2e, #16213e);
  color: #E0E0E0;
}

/* 工具头部 */
.tool-header {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
}

.tool-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #8B6914, #6B4F12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dark-mode .tool-icon {
  background: linear-gradient(135deg, #6B5010, #503A0E);
}

.tool-info {
  flex: 1;
}

.tool-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1F2937;
}

.dark-mode .tool-title {
  color: #F0F0F0;
}

.tool-desc {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.dark-mode .tool-desc {
  color: #8B8B9E;
}

/* 状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 30rpx;
  padding: 24rpx 40rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .status-bar {
  background-color: #252540;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.status-item {
  flex: 1;
  text-align: center;
}

.status-label {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-bottom: 8rpx;
}

.dark-mode .status-label {
  color: #8B8B9E;
}

.status-value {
  font-size: 44rpx;
  font-weight: bold;
  line-height: 1.2;
}

.score-value {
  color: #52c41a;
}

.dark-mode .score-value {
  color: #73d13d;
}

.time-value {
  color: #EF4444;
}

.dark-mode .time-value {
  color: #FF6B6B;
}

.status-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: #E5E7EB;
  margin: 0 30rpx;
}

.dark-mode .status-divider {
  background-color: #2D2D44;
}

/* 游戏消息 */
.game-message {
  text-align: center;
  padding: 10rpx 0;
}

.message-text {
  display: inline-block;
  font-size: 28rpx;
  color: #6B7280;
  padding: 8rpx 30rpx;
  border-radius: 20rpx;
  background-color: rgba(0, 0, 0, 0.04);
}

.dark-mode .message-text {
  color: #8B8B9E;
  background-color: rgba(255, 255, 255, 0.06);
}

/* 3x3地鼠网格 */
.mole-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 30rpx;
  margin: 0 20rpx;
}

.hole {
  aspect-ratio: 1;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B6914, #6B4F12);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 4rpx 12rpx rgba(0, 0, 0, 0.3), 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.15s ease, background 0.15s ease;
}

.dark-mode .hole {
  background: linear-gradient(135deg, #6B5010, #503A0E);
  box-shadow: inset 0 4rpx 12rpx rgba(0, 0, 0, 0.5), 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.hole.has-mole {
  background: linear-gradient(135deg, #52c41a, #389e0d);
  box-shadow: inset 0 4rpx 12rpx rgba(0, 0, 0, 0.2), 0 4rpx 16rpx rgba(82, 196, 26, 0.3);
  transform: scale(1.05);
  animation: mole-appear 0.2s ease;
}

.dark-mode .hole.has-mole {
  background: linear-gradient(135deg, #3d9913, #2d7a0a);
  box-shadow: inset 0 4rpx 12rpx rgba(0, 0, 0, 0.3), 0 4rpx 16rpx rgba(61, 153, 19, 0.4);
}

.hole.hit {
  background: linear-gradient(135deg, #EF4444, #DC2626);
  box-shadow: inset 0 4rpx 12rpx rgba(0, 0, 0, 0.2), 0 4rpx 16rpx rgba(239, 68, 68, 0.3);
  animation: hit-shake 0.15s ease;
}

.dark-mode .hole.hit {
  background: linear-gradient(135deg, #CC3333, #B02020);
  box-shadow: inset 0 4rpx 12rpx rgba(0, 0, 0, 0.3), 0 4rpx 16rpx rgba(204, 51, 51, 0.4);
}

@keyframes mole-appear {
  0% {
    transform: scale(0.8);
  }
  60% {
    transform: scale(1.1);
  }
  100% {
    transform: scale(1.05);
  }
}

@keyframes hit-shake {
  0% {
    transform: scale(1.05);
  }
  25% {
    transform: scale(1.1) rotate(5deg);
  }
  50% {
    transform: scale(0.95) rotate(-3deg);
  }
  75% {
    transform: scale(1.02) rotate(1deg);
  }
  100% {
    transform: scale(1);
  }
}

.hole-inner {
  position: relative;
  z-index: 2;
}

.hole-bg {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 30%;
  background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.15));
  border-radius: 0 0 50% 50%;
}

.mole-icon {
  font-size: 60rpx;
  text-align: center;
  line-height: 1;
}

.hit-icon {
  animation: hit-pop 0.2s ease;
}

@keyframes hit-pop {
  0% {
    transform: scale(0.5);
  }
  60% {
    transform: scale(1.3);
  }
  100% {
    transform: scale(1);
  }
}

/* 操作按钮 */
.action-section {
  padding: 30rpx;
  text-align: center;
}

.start-btn {
  display: inline-block;
  padding: 24rpx 100rpx;
  background: linear-gradient(135deg, #8B6914, #6B4F12);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  box-shadow: 0 6rpx 20rpx rgba(107, 79, 18, 0.3);
}

.dark-mode .start-btn {
  background: linear-gradient(135deg, #6B5010, #503A0E);
  box-shadow: 0 6rpx 20rpx rgba(80, 58, 14, 0.4);
}

.start-btn:active {
  transform: scale(0.96);
}

/* 结果展示 */
.result-section {
  padding: 0 30rpx;
}

.result-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .result-card {
  background-color: #252540;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.result-score-label {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-bottom: 12rpx;
}

.dark-mode .result-score-label {
  color: #8B8B9E;
}

.result-score-value {
  font-size: 80rpx;
  font-weight: bold;
  color: #8B6914;
  line-height: 1.2;
  margin-bottom: 24rpx;
}

.dark-mode .result-score-value {
  color: #D4A840;
}

.rating-badge {
  display: inline-block;
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
}

/* 统计区域 */
.stats-section {
  margin: 30rpx 30rpx 0;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .stats-section {
  background-color: #252540;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.stats-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1F2937;
  margin-bottom: 24rpx;
}

.dark-mode .stats-title {
  color: #F0F0F0;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-card {
  text-align: center;
  flex: 1;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #8B6914;
  line-height: 1.2;
}

.dark-mode .stat-value {
  color: #D4A840;
}

.stat-label {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

.dark-mode .stat-label {
  color: #8B8B9E;
}

.reset-stats {
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F3F4F6;
}

.dark-mode .reset-stats {
  color: #8B8B9E;
  border-top-color: #2D2D44;
}

/* 提示卡片 */
.tip-card {
  margin: 30rpx 30rpx 0;
  background-color: #FFF7ED;
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: flex-start;
}

.dark-mode .tip-card {
  background-color: #2D2520;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #92400E;
  line-height: 1.6;
}

.dark-mode .tip-text {
  color: #D4A574;
}

/* 字号设置 */
.font-size-small .tool-title {
  font-size: 30rpx;
}
.font-size-small .status-value {
  font-size: 36rpx;
}
.font-size-small .mole-icon {
  font-size: 50rpx;
}
.font-size-small .result-score-value {
  font-size: 64rpx;
}
.font-size-small .stat-value {
  font-size: 34rpx;
}
.font-size-small .start-btn {
  font-size: 28rpx;
}

.font-size-medium .tool-title {
  font-size: 36rpx;
}
.font-size-medium .status-value {
  font-size: 44rpx;
}
.font-size-medium .mole-icon {
  font-size: 60rpx;
}
.font-size-medium .result-score-value {
  font-size: 80rpx;
}
.font-size-medium .stat-value {
  font-size: 40rpx;
}
.font-size-medium .start-btn {
  font-size: 32rpx;
}

.font-size-large .tool-title {
  font-size: 42rpx;
}
.font-size-large .status-value {
  font-size: 52rpx;
}
.font-size-large .mole-icon {
  font-size: 72rpx;
}
.font-size-large .result-score-value {
  font-size: 96rpx;
}
.font-size-large .stat-value {
  font-size: 46rpx;
}
.font-size-large .start-btn {
  font-size: 36rpx;
}

/* 结果弹窗 */
.result-modal-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);z-index:1000;display:flex;align-items:center;justify-content:center;}
.result-modal{width:80%;max-width:340px;background:#1a1a2e;border-radius:16px;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.4);}
.result-modal-poster{padding:12px;display:flex;justify-content:center;}
.result-poster-img{width:100%;border-radius:8px;}
.result-modal-info{padding:30px 20px 20px;display:flex;flex-direction:column;align-items:center;}
.result-modal-icon{font-size:40px;margin-bottom:8px;}
.result-modal-title{font-size:16px;color:rgba(255,255,255,0.7);margin-bottom:12px;}
.result-modal-score{font-size:40px;font-weight:bold;background:linear-gradient(135deg,#F59E0B,#D97706);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:4px;}
.result-modal-label{font-size:12px;color:rgba(255,255,255,0.5);margin-bottom:10px;}
.result-modal-rating{font-size:16px;font-weight:bold;color:#FCD34D;margin-bottom:4px;}
.result-modal-actions{padding:0 20px 20px;display:flex;flex-direction:column;gap:10px;}
.result-modal-share{background:linear-gradient(135deg,#F59E0B,#D97706);color:#fff;font-size:15px;font-weight:600;border:none;border-radius:24px;padding:12px 0;text-align:center;line-height:1.2;}
.result-modal-share::after{border:none;}
.result-modal-close{text-align:center;color:rgba(255,255,255,0.5);font-size:14px;padding:6px 0;}

/* 暗黑模式补充 */
.dark-mode .page-container {
  background: linear-gradient(180deg, #0F172A, #1E293B);
}

.dark-mode .tool-header {
  background: #334155;
}

.dark-mode .status-bar {
  background-color: #334155;
}

.dark-mode .mole-grid {
  background: #334155;
}

.dark-mode .result-card {
  background-color: #334155;
}

.dark-mode .stats-section {
  background-color: #334155;
}

.dark-mode .tip-card {
  background-color: #1E293B;
}

.dark-mode .result-modal {
  background: #1E293B;
}