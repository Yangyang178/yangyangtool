/* 页面容器 */
.page-container {
  min-height: 100vh;
  padding: 24rpx 32rpx 60rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%);
  box-sizing: border-box;
}

/* 暗色模式 */
.page-container.dark-mode {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

/* 工具头部 */
.tool-header {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .tool-header {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.tool-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #EF4444 0%, #F59E0B 50%, #3B82F6 75%, #10B981 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.tool-icon {
  font-size: 44rpx;
}

.tool-info {
  display: flex;
  flex-direction: column;
}

.tool-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 6rpx;
}

.dark-mode .tool-title {
  color: #f3f4f6;
}

.tool-desc {
  font-size: 24rpx;
  color: #9ca3af;
}

.dark-mode .tool-desc {
  color: #9ca3af;
}

/* 状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.dark-mode .status-bar {
  background: #2a2a4a;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.status-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
}

.dark-mode .status-label {
  color: #6b7280;
}

.status-value {
  font-size: 48rpx;
  font-weight: bold;
}

.level-value {
  color: #3B82F6;
}

.best-value {
  color: #F59E0B;
}

.status-divider {
  width: 2rpx;
  height: 60rpx;
  background: #e5e7eb;
  margin: 0 40rpx;
}

.dark-mode .status-divider {
  background: #4b5563;
}

/* 游戏状态文字 */
.state-text-wrap {
  text-align: center;
  padding: 16rpx 0;
  margin-bottom: 12rpx;
}

.state-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #6b7280;
  transition: color 0.3s ease;
}

.state-over {
  color: #EF4444;
}

.state-correct {
  color: #10B981;
}

.dark-mode .state-text {
  color: #9ca3af;
}

.dark-mode .state-over {
  color: #FCA5A5;
}

.dark-mode .state-correct {
  color: #6EE7B7;
}

/* 游戏区域 */
.game-area {
  padding: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .game-area {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 颜色网格 2x2 */
.color-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24rpx;
}

/* 颜色按钮通用 */
.color-btn {
  width: calc(50% - 12rpx);
  aspect-ratio: 1;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
  position: relative;
  overflow: hidden;
}

.color-btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 24rpx;
  opacity: 0;
  background: rgba(255, 255, 255, 0.3);
  transition: opacity 0.15s ease;
}

.color-btn-active::after {
  opacity: 1;
}

/* 红色按钮 */
.color-btn-0 {
  background: #EF4444;
  box-shadow: 0 6rpx 20rpx rgba(239, 68, 68, 0.35);
}

.color-btn-0.color-btn-active {
  background: #FCA5A5;
  transform: scale(1.08);
  box-shadow: 0 8rpx 30rpx rgba(239, 68, 68, 0.5);
}

/* 蓝色按钮 */
.color-btn-1 {
  background: #3B82F6;
  box-shadow: 0 6rpx 20rpx rgba(59, 130, 246, 0.35);
}

.color-btn-1.color-btn-active {
  background: #93C5FD;
  transform: scale(1.08);
  box-shadow: 0 8rpx 30rpx rgba(59, 130, 246, 0.5);
}

/* 绿色按钮 */
.color-btn-2 {
  background: #10B981;
  box-shadow: 0 6rpx 20rpx rgba(16, 185, 129, 0.35);
}

.color-btn-2.color-btn-active {
  background: #6EE7B7;
  transform: scale(1.08);
  box-shadow: 0 8rpx 30rpx rgba(16, 185, 129, 0.5);
}

/* 黄色按钮 */
.color-btn-3 {
  background: #F59E0B;
  box-shadow: 0 6rpx 20rpx rgba(245, 158, 11, 0.35);
}

.color-btn-3.color-btn-active {
  background: #FCD34D;
  transform: scale(1.08);
  box-shadow: 0 8rpx 30rpx rgba(245, 158, 11, 0.5);
}

/* 禁用状态（展示序列时） */
.color-btn-disabled {
  opacity: 0.7;
  pointer-events: none;
}

.color-btn-name {
  font-size: 36rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  position: relative;
  z-index: 1;
}

/* 操作区域 */
.action-area {
  margin-bottom: 24rpx;
}

.start-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #3B82F6, #6366F1);
  box-shadow: 0 6rpx 24rpx rgba(59, 130, 246, 0.4);
  transition: opacity 0.2s ease;
}

.start-btn:active {
  opacity: 0.85;
}

.start-btn-restart {
  background: linear-gradient(135deg, #EF4444, #F97316);
  box-shadow: 0 6rpx 24rpx rgba(239, 68, 68, 0.4);
}

.start-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 4rpx;
}

/* 统计区域 */
.stats-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .stats-section {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.stats-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.stats-title-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.stats-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
}

.dark-mode .stats-title-text {
  color: #e5e7eb;
}

.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stats-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: #f9fafb;
  border-radius: 16rpx;
}

.dark-mode .stats-card {
  background: #374151;
}

.stats-card-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #3B82F6;
  margin-bottom: 8rpx;
}

.dark-mode .stats-card-value {
  color: #93C5FD;
}

.stats-card-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.dark-mode .stats-card-label {
  color: #6b7280;
}

.reset-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.dark-mode .reset-btn {
  border-color: #4b5563;
}

.reset-btn:active {
  background: #f3f4f6;
}

.dark-mode .reset-btn:active {
  background: #374151;
}

.reset-btn-text {
  font-size: 24rpx;
  color: #9ca3af;
}

.dark-mode .reset-btn-text {
  color: #6b7280;
}

/* 提示卡片 */
.tip-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .tip-card {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.dark-mode .tip-title {
  color: #e5e7eb;
}

.tip-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}

.dark-mode .tip-item {
  color: #9ca3af;
}

/* 字体大小设置 */
.font-size-small .tool-title { font-size: 30rpx; }
.font-size-small .tool-desc { font-size: 22rpx; }
.font-size-small .status-value { font-size: 40rpx; }
.font-size-small .state-text { font-size: 26rpx; }
.font-size-small .color-btn-name { font-size: 30rpx; }
.font-size-small .start-btn-text { font-size: 28rpx; }
.font-size-small .stats-title-text { font-size: 26rpx; }
.font-size-small .stats-card-value { font-size: 34rpx; }
.font-size-small .stats-card-label { font-size: 20rpx; }
.font-size-small .tip-title { font-size: 24rpx; }
.font-size-small .tip-item { font-size: 22rpx; }

.font-size-medium .tool-title { font-size: 36rpx; }
.font-size-medium .tool-desc { font-size: 24rpx; }
.font-size-medium .status-value { font-size: 48rpx; }
.font-size-medium .state-text { font-size: 30rpx; }
.font-size-medium .color-btn-name { font-size: 36rpx; }
.font-size-medium .start-btn-text { font-size: 32rpx; }
.font-size-medium .stats-title-text { font-size: 30rpx; }
.font-size-medium .stats-card-value { font-size: 40rpx; }
.font-size-medium .stats-card-label { font-size: 22rpx; }
.font-size-medium .tip-title { font-size: 28rpx; }
.font-size-medium .tip-item { font-size: 24rpx; }

.font-size-large .tool-title { font-size: 42rpx; }
.font-size-large .tool-desc { font-size: 28rpx; }
.font-size-large .status-value { font-size: 56rpx; }
.font-size-large .state-text { font-size: 34rpx; }
.font-size-large .color-btn-name { font-size: 42rpx; }
.font-size-large .start-btn-text { font-size: 36rpx; }
.font-size-large .stats-title-text { font-size: 34rpx; }
.font-size-large .stats-card-value { font-size: 48rpx; }
.font-size-large .stats-card-label { font-size: 26rpx; }
.font-size-large .tip-title { font-size: 32rpx; }
.font-size-large .tip-item { font-size: 28rpx; }

/* 结果弹窗 */
.result-modal-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);z-index:1000;display:flex;align-items:center;justify-content:center;}
.result-modal{width:80%;max-width:340px;background:#1a1a2e;border-radius:16px;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.4);}
.result-modal-poster{padding:12px;display:flex;justify-content:center;}
.result-poster-img{width:100%;border-radius:8px;}
.result-modal-info{padding:30px 20px 20px;display:flex;flex-direction:column;align-items:center;}
.result-modal-icon{font-size:40px;margin-bottom:8px;}
.result-modal-title{font-size:16px;color:rgba(255,255,255,0.7);margin-bottom:12px;}
.result-modal-score{font-size:40px;font-weight:bold;background:linear-gradient(135deg,#F59E0B,#D97706);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:4px;}
.result-modal-label{font-size:12px;color:rgba(255,255,255,0.5);margin-bottom:10px;}
.result-modal-rating{font-size:16px;font-weight:bold;color:#FCD34D;margin-bottom:4px;}
.result-modal-actions{padding:0 20px 20px;display:flex;flex-direction:column;gap:10px;}
.result-modal-share{background:linear-gradient(135deg,#F59E0B,#D97706);color:#fff;font-size:15px;font-weight:600;border:none;border-radius:24px;padding:12px 0;text-align:center;line-height:1.2;}
.result-modal-share::after{border:none;}
.result-modal-close{text-align:center;color:rgba(255,255,255,0.5);font-size:14px;padding:6px 0;}

/* 暗黑模式补充 */
.dark-mode .page-container {
  background: linear-gradient(180deg, #0F172A 0%, #1E293B 100%);
}

.dark-mode .message-bar {
  background: #334155;
}

.dark-mode .digit-box {
  background: #334155;
  border-color: rgba(255, 255, 255, 0.1);
}

.dark-mode .history-row {
  background: #334155;
}

.dark-mode .history-digit {
  background: #1E293B;
}

.dark-mode .stat-card {
  background: #334155;
}

.dark-mode .tip-card {
  background: #334155;
}

.dark-mode .btn-secondary {
  background: #334155;
  color: #F1F5F9;
  border-color: rgba(255, 255, 255, 0.1);
}

.dark-mode .result-modal {
  background: #1E293B;
}
