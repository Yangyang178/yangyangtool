@import "../../styles/tool-common.wxss";

page { background-color: var(--pageBg, #F8FAFC); }
.tool-page { height: 100vh; }
.container { padding: 20px; padding-bottom: 40px; }

/* ===================================
   工具头部
   =================================== */
.tool-header {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 24px;
  padding: 24px 20px;
  background: linear-gradient(135deg, rgba(16,185,129,0.12) 0%, rgba(59,130,246,0.10) 50%, rgba(139,92,246,0.08) 100%);
  border-radius: 24px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8px 32px rgba(16, 185, 129, 0.15), 0 4px 16px rgba(59, 130, 246, 0.1), inset 0 1px 0 rgba(255,255,255,0.4);
}

.tool-header::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -12%;
  width: 200px;
  height: 200px;
  background: radial-gradient(circle, rgba(255,255,255,0.18) 0%, transparent 70%);
  border-radius: 50%;
  z-index: 0;
}

.green-gradient {
  background: linear-gradient(135deg, #10B981 0%, #3B82F6 50%, #8B5CF6 100%);
}

.tool-icon-decoration {
  position: absolute;
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background: inherit;
  opacity: 0.2;
  filter: blur(18px);
  z-index: 1;
}

.tool-icon-emoji {
  font-size: 40px;
  position: relative;
  z-index: 2;
}

.tool-info {
  flex: 1;
  position: relative;
  z-index: 2;
}

.tool-title-main {
  font-size: 22px;
  font-weight: 800;
  color: var(--textPrimary, #1E293B);
  margin-bottom: 6px;
  display: block;
  letter-spacing: -0.5px;
}

.tool-desc-main {
  font-size: 13px;
  color: var(--textSecondary, #64748B);
  line-height: 1.5;
}

/* ===================================
   Tab栏
   =================================== */
.tab-bar {
  display: flex;
  gap: 8px;
  margin-bottom: 20px;
  background: var(--cardBg, #FFFFFF);
  border-radius: 16px;
  padding: 6px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 12px 8px;
  border-radius: 12px;
  transition: all 0.3s ease;
  position: relative;
}

.tab-item.active {
  background: linear-gradient(135deg, #10B981 0%, #3B82F6 100%);
  box-shadow: 0 4px 16px rgba(16, 185, 129, 0.35);
  transform: translateY(-1px);
}

.tab-icon {
  font-size: 20px;
  font-weight: 700;
}

.tab-item.active .tab-icon {
  color: #FFFFFF;
}

.tab-text {
  font-size: 12px;
  font-weight: 600;
  color: var(--textSecondary, #64748B);
}

.tab-item.active .tab-text {
  color: #FFFFFF;
}

.tab-item:active {
  transform: scale(0.95);
}

/* ===================================
   测试区域通用
   =================================== */
.test-section {
  margin-bottom: 20px;
}

/* ===================================
   Canvas区域
   =================================== */
.canvas-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 20px;
}

.test-canvas {
  width: 280px;
  height: 280px;
  border-radius: 20px;
  background: #F5F5F5;
  box-shadow: 0 4px 20px rgba(0,0,0,0.08), inset 0 1px 0 rgba(255,255,255,1);
}

/* ===================================
   输入区域
   =================================== */
.input-section {
  background: var(--cardBg, #FFFFFF);
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.04);
}

.input-label {
  font-size: 15px;
  font-weight: 600;
  color: var(--textPrimary, #1E293B);
  display: block;
  margin-bottom: 12px;
}

.btn-row {
  margin-top: 16px;
  display: flex;
  justify-content: center;
}

.progress-text {
  display: block;
  text-align: center;
  margin-top: 12px;
  font-size: 13px;
  color: var(--textTertiary, #94A3B8);
  font-weight: 500;
}

/* ===================================
   说明卡片
   =================================== */
.instruction-card {
  background: linear-gradient(135deg, rgba(59,130,246,0.08) 0%, rgba(59,130,246,0.03) 100%);
  border-radius: 16px;
  padding: 16px 18px;
  margin-bottom: 20px;
  border-left: 4px solid #3B82F6;
}

.instruction-title {
  font-size: 14px;
  font-weight: 700;
  color: #1E40AF;
  display: block;
  margin-bottom: 8px;
}

.instruction-text {
  font-size: 13px;
  color: var(--textSecondary, #64748B);
  line-height: 1.6;
}

/* ===================================
   选择按钮区域
   =================================== */
.choice-section {
  background: var(--cardBg, #FFFFFF);
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.04);
}

.choice-label {
  font-size: 15px;
  font-weight: 600;
  color: var(--textPrimary, #1E293B);
  display: block;
  margin-bottom: 14px;
}

.choice-btns {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.choice-btn {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 18px;
  border-radius: 16px;
  transition: all 0.3s ease;
}

.choice-btn:active {
  transform: scale(0.97);
}

.choice-good {
  background: linear-gradient(135deg, rgba(16,185,129,0.1) 0%, rgba(16,185,129,0.05) 100%);
  border: 1.5px solid rgba(16,185,129,0.2);
}

.choice-warn {
  background: linear-gradient(135deg, rgba(245,158,11,0.1) 0%, rgba(245,158,11,0.05) 100%);
  border: 1.5px solid rgba(245,158,11,0.2);
}

.choice-btn-icon {
  font-size: 22px;
}

.choice-btn-text {
  font-size: 15px;
  font-weight: 600;
  color: var(--textPrimary, #1E293B);
}

/* ===================================
   E字显示区域
   =================================== */
.e-display-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--cardBg, #FFFFFF);
  border-radius: 24px;
  padding: 40px 20px;
  margin-bottom: 20px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  min-height: 240px;
}

.e-char-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s ease;
}

.e-char {
  font-family: 'Arial Black', Arial, sans-serif;
  font-weight: 900;
  color: var(--textPrimary, #1E293B);
  line-height: 1;
  letter-spacing: -2px;
}

.e-level-label {
  font-size: 13px;
  color: var(--textTertiary, #94A3B8);
  margin-top: 16px;
  font-weight: 500;
}

/* ===================================
   方向按钮
   =================================== */
.direction-btns {
  background: var(--cardBg, #FFFFFF);
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.04);
}

.direction-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: center;
  margin-top: 4px;
}

.dir-btn {
  width: 72px;
  height: 72px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  border-radius: 16px;
  background: linear-gradient(135deg, #F8FAFF 0%, #EEF2FF 100%);
  border: 1.5px solid rgba(102, 126, 234, 0.1);
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  transition: all 0.3s ease;
}

.dir-btn:active {
  transform: scale(0.92);
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-color: transparent;
}

.dir-btn:active .dir-arrow,
.dir-btn:active .dir-label {
  color: #FFFFFF;
}

.dir-arrow {
  font-size: 26px;
  font-weight: 700;
  color: #667eea;
}

.dir-label {
  font-size: 11px;
  color: var(--textSecondary, #64748B);
  font-weight: 500;
}

/* ===================================
   结果显示
   =================================== */
.result-container {
  background: linear-gradient(135deg, #FFFFFF 0%, #FDFEFF 100%);
  border-radius: 24px;
  padding: 28px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.08), 0 3px 14px rgba(0,0,0,0.04), inset 0 1px 0 rgba(255,255,255,1);
  animation: resultSlideIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  border: 2px solid transparent;
}

@keyframes resultSlideIn {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.result-label {
  font-size: 13px;
  font-weight: 600;
  color: var(--textSecondary, #64748B);
  display: block;
  margin-bottom: 8px;
  letter-spacing: 1px;
}

.result-score-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 12px;
}

.result-value {
  font-size: 36px;
  font-weight: 900;
  color: #10B981;
  line-height: 1.2;
}

.result-unit {
  font-size: 19px;
  font-weight: 600;
  color: var(--textSecondary, #64748B);
  margin-left: 6px;
}

.result-badge {
  display: inline-flex;
  padding: 6px 16px;
  border-radius: 20px;
  margin-bottom: 14px;
}

.result-badge.good {
  background: rgba(16,185,129,0.12);
}

.result-badge.warn {
  background: rgba(245,158,11,0.12);
}

.result-badge.bad {
  background: rgba(239,68,68,0.12);
}

.result-badge-text {
  font-size: 14px;
  font-weight: 700;
}

.result-badge.good .result-badge-text {
  color: #10B981;
}

.result-badge.warn .result-badge-text {
  color: #F59E0B;
}

.result-badge.bad .result-badge-text {
  color: #EF4444;
}

.result-desc {
  font-size: 14px;
  color: var(--textSecondary, #64748B);
  line-height: 1.6;
  display: block;
  margin-bottom: 18px;
}

/* ===================================
   免责声明
   =================================== */
.disclaimer {
  margin-top: 24px;
  padding: 14px 16px;
  background: linear-gradient(135deg, rgba(107,114,128,0.06) 0%, rgba(107,114,128,0.02) 100%);
  border-radius: 12px;
  border-left: 3px solid #9CA3AF;
}

.disclaimer-text {
  font-size: 12px;
  color: var(--textTertiary, #94A3B8);
  line-height: 1.6;
}

/* ===================================
   🌙 夜间模式
   =================================== */
.dark-mode .tool-header {
  background: linear-gradient(135deg, rgba(16,185,129,0.15) 0%, rgba(59,130,246,0.12) 50%, rgba(139,92,246,0.08) 100%);
  box-shadow: 0 8px 32px rgba(0,0,0,0.3), 0 4px 16px rgba(0,0,0,0.2);
}

.dark-mode .tool-title-main {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .tool-desc-main {
  color: var(--textSecondary, #94A3B8);
}

.dark-mode .tab-bar {
  background: var(--cardBg, #1a2035);
  box-shadow: 0 2px 12px rgba(0,0,0,0.2);
}

.dark-mode .tab-item.active {
  box-shadow: 0 4px 16px rgba(16, 185, 129, 0.28);
}

.dark-mode .tab-text {
  color: var(--textSecondary, #94A3B8);
}

.dark-mode .test-canvas {
  background: #1a2035;
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
}

.dark-mode .input-section,
.dark-mode .choice-section,
.dark-mode .direction-btns {
  background: var(--cardBg, #1a2035);
  box-shadow: 0 2px 12px rgba(0,0,0,0.2);
}

.dark-mode .input-label,
.dark-mode .choice-label {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .instruction-card {
  background: rgba(59,130,246,0.08);
  border-left-color: #60A5FA;
}

.dark-mode .instruction-title {
  color: #93C5FD;
}

.dark-mode .instruction-text {
  color: var(--textSecondary, #94A3B8);
}

.dark-mode .choice-btn-text {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .choice-good {
  background: rgba(16,185,129,0.1);
  border-color: rgba(16,185,129,0.15);
}

.dark-mode .choice-warn {
  background: rgba(245,158,11,0.1);
  border-color: rgba(245,158,11,0.15);
}

.dark-mode .e-display-area {
  background: var(--cardBg, #1a2035);
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
}

.dark-mode .e-char {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .e-level-label {
  color: var(--textMuted, #475569);
}

.dark-mode .dir-btn {
  background: linear-gradient(135deg, #232d42 0%, #1a2035 100%);
  border-color: rgba(102, 126, 234, 0.12);
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

.dark-mode .dir-arrow {
  color: #818cf8;
}

.dark-mode .dir-label {
  color: var(--textSecondary, #94A3B8);
}

.dark-mode .result-container {
  background: linear-gradient(135deg, #1a2035 0%, #151b28 100%);
  box-shadow: 0 8px 32px rgba(0,0,0,0.4), 0 3px 14px rgba(0,0,0,0.25);
  border-color: rgba(16, 185, 129, 0.08);
}

.dark-mode .result-value {
  color: #34d399;
}

.dark-mode .result-desc {
  color: var(--textSecondary, #94A3B8);
}

.dark-mode .disclaimer {
  background: rgba(107,114,128,0.08);
  border-left-color: #6B7280;
}

.dark-mode .disclaimer-text {
  color: var(--textMuted, #475569);
}

/* ===================================
   📱 字体大小适配
   =================================== */
.font-size-small .tool-title-main { font-size: 20px; }
.font-size-small .tab-text { font-size: 11px; }
.font-size-small .input-label { font-size: 14px; }
.font-size-small .choice-label { font-size: 14px; }
.font-size-small .instruction-text { font-size: 12px; }
.font-size-small .result-desc { font-size: 13px; }
.font-size-small .disclaimer-text { font-size: 11px; }

.font-size-large .tool-title-main { font-size: 24px; }
.font-size-large .tab-text { font-size: 13px; }
.font-size-large .input-label { font-size: 16px; }
.font-size-large .choice-label { font-size: 16px; }
.font-size-large .instruction-text { font-size: 14px; }
.font-size-large .result-desc { font-size: 15px; }
.font-size-large .disclaimer-text { font-size: 13px; }

.font-size-xlarge .tool-title-main { font-size: 26px; }
.font-size-xlarge .tab-text { font-size: 14px; }
.font-size-xlarge .input-label { font-size: 17px; }
.font-size-xlarge .choice-label { font-size: 17px; }
.font-size-xlarge .instruction-text { font-size: 15px; }
.font-size-xlarge .result-desc { font-size: 16px; }
.font-size-xlarge .disclaimer-text { font-size: 14px; }

/* 暗黑模式补充 */
.dark-mode .input-section {
  background: #334155;
}

.dark-mode .choice-section {
  background: #334155;
}

.dark-mode .e-display-area {
  background: #334155;
}

.dark-mode .direction-btns {
  background: #334155;
}

.dark-mode .result-container {
  background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
}
