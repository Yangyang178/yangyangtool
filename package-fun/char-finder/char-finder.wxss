@import "../../styles/tool-common.wxss";

page { background-color: var(--pageBg, #F8FAFC); }

.container { padding: 20px; padding-bottom: 40px; }

/* 开始界面 */
.start-screen { display: flex; flex-direction: column; align-items: center; }

.tool-header { display: flex; align-items: center; gap: 20px; margin-bottom: 28px; padding: 28px 24px; background: linear-gradient(135deg, rgba(16,185,129,0.12) 0%, rgba(5,150,105,0.10) 50%, rgba(4,120,87,0.08) 100%); border-radius: 24px; position: relative; overflow: hidden; box-shadow: 0 8px 32px rgba(16,185,129,0.12); }

.tool-icon-large { width: 80px; height: 80px; border-radius: 20px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; flex-shrink: 0; }

.green-gradient { background: linear-gradient(135deg, #10B981, #059669); }

.icon-decoration { position: absolute; width: 100px; height: 100px; border-radius: 50%; background: rgba(255,255,255,0.15); filter: blur(18px); top: -20px; right: -20px; }

.tool-icon-text { font-size: 40px; position: relative; z-index: 2; }

.tool-header-info { flex: 1; min-width: 0; }

.tool-title { font-size: 24px; font-weight: 700; color: var(--textPrimary, #1E293B); display: block; margin-bottom: 6px; }

.tool-desc { font-size: 14px; color: var(--textSecondary, #64748B); line-height: 1.5; white-space: pre-line; }

/* 示例卡片 */
.example-card { width: 100%; background: var(--cardBg, #FFFFFF); border-radius: 20px; padding: 20px; margin-bottom: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }

.example-row { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 8px 0; }

.example-char { font-size: 32px; font-weight: 700; color: #059669; }

.example-arrow { font-size: 20px; color: var(--textTertiary, #94A3B8); }

.example-parts { font-size: 24px; font-weight: 600; color: var(--textPrimary, #1E293B); }

/* 按钮 */
.primary-btn { width: 100%; padding: 16px; border-radius: 16px; text-align: center; font-size: 17px; font-weight: 600; color: #FFFFFF; box-shadow: 0 8px 24px rgba(59,130,246,0.25); margin-bottom: 12px; background: linear-gradient(135deg, #3B82F6, #6366F1); }

.primary-btn.green { background: linear-gradient(135deg, #10B981, #059669); box-shadow: 0 8px 24px rgba(16,185,129,0.25); }

.secondary-btn { width: 100%; padding: 16px; border-radius: 16px; background: var(--surfaceBg, #F1F5F9); text-align: center; font-size: 17px; font-weight: 600; color: var(--textSecondary, #64748B); }

.btn-hover { opacity: 0.85; transform: scale(0.98); }

/* 游戏区域 */
.game-section { display: flex; flex-direction: column; align-items: center; }

.stats-bar { display: flex; justify-content: space-around; padding: 16px; background: var(--cardBg, #FFFFFF); border-radius: 16px; margin-bottom: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); width: 100%; }

.stat { display: flex; flex-direction: column; align-items: center; gap: 2px; }

.stat-label { font-size: 12px; color: var(--textTertiary, #94A3B8); }

.stat-val { font-size: 18px; font-weight: 700; color: var(--textPrimary, #1E293B); }

.char-card { width: 140px; height: 140px; border-radius: 24px; background: linear-gradient(135deg, #10B981, #059669); display: flex; align-items: center; justify-content: center; margin-bottom: 20px; box-shadow: 0 8px 32px rgba(16,185,129,0.25); }

.big-char { font-size: 80px; font-weight: 700; color: #FFFFFF; line-height: 1; }

.found-area { width: 100%; margin-bottom: 20px; }

.found-chars { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

.found-item { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 700; }

.found-item.found { background: linear-gradient(135deg, #10B981, #059669); color: #FFFFFF; box-shadow: 0 4px 12px rgba(16,185,129,0.2); }

.found-item.empty { background: var(--surfaceBg, #F1F5F9); border: 2px dashed var(--borderFaint, #CBD5E1); color: var(--textTertiary, #CBD5E1); }

.input-row { display: flex; gap: 12px; width: 100%; margin-bottom: 16px; }

.char-input { flex: 1; height: 48px; padding: 0 16px; border-radius: 14px; background: var(--cardBg, #FFFFFF); border: 2px solid var(--borderFaint, #E2E8F0); font-size: 20px; color: var(--textPrimary, #1E293B); }

.submit-btn { width: 80px; height: 48px; border-radius: 14px; background: linear-gradient(135deg, #10B981, #059669); display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 600; color: #FFFFFF; }

.wrong-hint { padding: 8px 20px; border-radius: 12px; background: #FEE2E2; font-size: 13px; color: #DC2626; animation: fadeInOut 1.5s; }

.dark-mode .wrong-hint { background: #450A0A; color: #FCA5A5; }

@keyframes fadeInOut {
  0% { opacity: 0; }
  20% { opacity: 1; }
  80% { opacity: 1; }
  100% { opacity: 0; }
}

/* 结果界面 */
.result-section { display: flex; flex-direction: column; align-items: center; }

.result-card { width: 100%; background: var(--cardBg, #FFFFFF); border-radius: 24px; padding: 32px 24px; margin-bottom: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); text-align: center; }

.result-emoji { font-size: 48px; display: block; margin-bottom: 12px; }

.result-title { font-size: 24px; font-weight: 700; color: var(--textPrimary, #1E293B); display: block; margin-bottom: 16px; }

.result-desc { font-size: 14px; color: var(--textSecondary, #64748B); line-height: 1.6; display: block; }

.complete-row { display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; }

.complete-big { font-size: 48px; font-weight: 700; color: #059669; }

.complete-eq { font-size: 28px; color: var(--textTertiary, #94A3B8); }

.complete-parts { display: flex; flex-wrap: wrap; }

.complete-part { font-size: 28px; font-weight: 600; color: var(--textPrimary, #1E293B); }

.result-actions { width: 100%; }
