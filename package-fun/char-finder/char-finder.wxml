<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>

<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}}" scroll-y>
  <view class="container">

    <!-- 开始界面 -->
    <view class="start-screen" wx:if="{{gameState === 'idle'}}">
      <view class="tool-header">
        <view class="tool-icon-large green-gradient">
          <view class="icon-decoration"></view>
          <text class="tool-icon-text">🔍</text>
        </view>
        <view class="tool-header-info">
          <text class="tool-title">{{i18n.toolName}}</text>
          <text class="tool-desc">{{i18n.toolDesc}}</text>
        </view>
      </view>

      <view class="example-card">
        <view class="example-row">
          <text class="example-char">明</text>
          <text class="example-arrow">→</text>
          <text class="example-parts">日 + 月</text>
        </view>
        <view class="example-row">
          <text class="example-char">休</text>
          <text class="example-arrow">→</text>
          <text class="example-parts">亻 + 木</text>
        </view>
      </view>

      <view class="primary-btn green" bindtap="startGame" hover-class="btn-hover">
        <text>{{i18n.startGame}}</text>
      </view>
    </view>

    <!-- 游戏区域 -->
    <view class="game-section" wx:if="{{gameState === 'playing'}}">
      <view class="stats-bar">
        <view class="stat">
          <text class="stat-label">{{i18n.level}}</text>
          <text class="stat-val">{{level}}</text>
        </view>
        <view class="stat">
          <text class="stat-label">{{i18n.progress}}</text>
          <text class="stat-val">{{foundCount}}/{{targetCount}}</text>
        </view>

      </view>

      <view class="char-card">
        <text class="big-char">{{currentChar}}</text>
      </view>

      <view class="found-area">
        <view class="found-chars">
          <view wx:for="{{foundChars}}" wx:key="index" class="found-item found">
            <text>{{item}}</text>
          </view>
          <view wx:for="{{remainingSlots}}" wx:key="index" class="found-item empty">
            <text>?</text>
          </view>
        </view>
      </view>

      <view class="input-row">
        <input class="char-input" value="{{inputValue}}" bindinput="onInput" bindconfirm="onSubmit" placeholder="{{i18n.inputPlaceholder}}" maxlength="1" confirm-type="done" />
        <view class="submit-btn" bindtap="onSubmit" hover-class="btn-hover">
          <text>{{i18n.submit}}</text>
        </view>
      </view>

<view class="wrong-hint" wx:if="{{showWrongHint}}">
        <text>{{i18n.wrongHint}}</text>
      </view>
    </view>

    <!-- 过关界面 -->
    <view class="result-section" wx:if="{{gameState === 'levelComplete'}}">
      <view class="result-card">
        <text class="result-emoji">🎉</text>
        <text class="result-title">{{i18n.levelComplete}}</text>
        <view class="complete-row">
          <text class="complete-big">{{currentChar}}</text>
          <text class="complete-eq">=</text>
          <view class="complete-parts">
            <text wx:for="{{allAnswers}}" wx:key="index" class="complete-part">{{item}}{{index < allAnswers.length - 1 ? ' + ' : ''}}</text>
          </view>
        </view>
      </view>
      <view class="result-actions">
        <view class="primary-btn green" bindtap="nextLevel" hover-class="btn-hover">
          <text>{{i18n.nextLevel}}</text>
        </view>
        <view class="secondary-btn" bindtap="goBack" hover-class="btn-hover">
          <text>{{i18n.goBack}}</text>
        </view>
      </view>
    </view>

    <!-- 全部通关 -->
    <view class="result-section" wx:if="{{gameState === 'allComplete'}}">
      <view class="result-card">
        <text class="result-emoji">🏆</text>
        <text class="result-title">{{i18n.allComplete}}</text>
        <text class="result-desc">{{i18n.allCompleteDesc}}</text>
      </view>
      <view class="result-actions">
        <view class="primary-btn green" bindtap="startGame" hover-class="btn-hover">
          <text>{{i18n.playAgain}}</text>
        </view>
        <view class="secondary-btn" bindtap="goBack" hover-class="btn-hover">
          <text>{{i18n.goBack}}</text>
        </view>
      </view>
    </view>

  </view>
</scroll-view>
