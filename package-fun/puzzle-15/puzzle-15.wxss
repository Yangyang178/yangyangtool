/* 页面容器 */
.page-container {
  min-height: 100vh;
  padding: 24rpx 32rpx 60rpx;
  background: linear-gradient(135deg, #f0f4ff 0%, #f8f9fe 100%);
  box-sizing: border-box;
}

.page-container.dark-mode {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

/* 工具头部 */
.tool-header {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .tool-header {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.tool-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.tool-icon {
  font-size: 44rpx;
}

.tool-info {
  display: flex;
  flex-direction: column;
}

.tool-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 6rpx;
}

.dark-mode .tool-title {
  color: #f3f4f6;
}

.tool-desc {
  font-size: 24rpx;
  color: #9ca3af;
}

.dark-mode .tool-desc {
  color: #9ca3af;
}

/* 状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.dark-mode .status-bar {
  background: #2a2a4a;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.status-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
}

.dark-mode .status-label {
  color: #6b7280;
}

.status-value {
  font-size: 48rpx;
  font-weight: bold;
}

.moves-value {
  color: #667eea;
}

.dark-mode .moves-value {
  color: #93a3f5;
}

.time-value {
  color: #764ba2;
}

.dark-mode .time-value {
  color: #b07dd4;
}

.status-divider {
  width: 2rpx;
  height: 60rpx;
  background: #e5e7eb;
  margin: 0 40rpx;
}

.dark-mode .status-divider {
  background: #4b5563;
}

/* 游戏消息 */
.message-wrap {
  text-align: center;
  padding: 16rpx 0;
  margin-bottom: 12rpx;
}

.message-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #6b7280;
  transition: color 0.3s ease;
}

.message-won {
  color: #10B981;
}

.dark-mode .message-text {
  color: #9ca3af;
}

.dark-mode .message-won {
  color: #6EE7B7;
}

/* 游戏区域 */
.game-area {
  padding: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .game-area {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 4x4拼图网格 */
.puzzle-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}

/* 格子通用 */
.tile {
  aspect-ratio: 1;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  transition: transform 0.15s ease;
}

.tile:active {
  transform: scale(0.95);
}

.dark-mode .tile {
  background: linear-gradient(135deg, #4a5ab5, #5c3d8f);
  box-shadow: 0 4rpx 12rpx rgba(74, 90, 181, 0.4);
}

/* 空格 */
.tile.empty {
  background: rgba(0, 0, 0, 0.05);
  box-shadow: none;
}

.tile.empty:active {
  transform: none;
}

.dark-mode .tile.empty {
  background: rgba(255, 255, 255, 0.05);
  box-shadow: none;
}

/* 数字 */
.tile-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
}

/* 操作按钮区域 */
.action-area {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 20rpx;
  transition: opacity 0.2s ease;
}

.action-btn:active {
  opacity: 0.85;
}

.action-btn-primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  box-shadow: 0 6rpx 24rpx rgba(102, 126, 234, 0.4);
}

.action-btn-secondary {
  background: linear-gradient(135deg, #f093fb, #f5576c);
  box-shadow: 0 6rpx 24rpx rgba(245, 87, 108, 0.3);
}

.action-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

/* 统计区域 */
.stats-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .stats-section {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.stats-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.stats-title-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.stats-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
}

.dark-mode .stats-title-text {
  color: #e5e7eb;
}

.stats-grid {
  display: flex;
  gap: 16rpx;
}

.stats-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: #f9fafb;
  border-radius: 16rpx;
}

.dark-mode .stats-card {
  background: #374151;
}

.stats-card-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 8rpx;
}

.dark-mode .stats-card-value {
  color: #93a3f5;
}

.stats-card-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.dark-mode .stats-card-label {
  color: #6b7280;
}

/* 提示卡片 */
.tip-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .tip-card {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.dark-mode .tip-title {
  color: #e5e7eb;
}

.tip-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}

.dark-mode .tip-item {
  color: #9ca3af;
}

/* 字体大小设置 */
.font-size-small .tool-title { font-size: 30rpx; }
.font-size-small .tool-desc { font-size: 22rpx; }
.font-size-small .status-value { font-size: 40rpx; }
.font-size-small .message-text { font-size: 26rpx; }
.font-size-small .tile-number { font-size: 40rpx; }
.font-size-small .action-btn-text { font-size: 26rpx; }
.font-size-small .stats-title-text { font-size: 26rpx; }
.font-size-small .stats-card-value { font-size: 34rpx; }
.font-size-small .stats-card-label { font-size: 20rpx; }
.font-size-small .tip-title { font-size: 24rpx; }
.font-size-small .tip-item { font-size: 22rpx; }

.font-size-medium .tool-title { font-size: 36rpx; }
.font-size-medium .tool-desc { font-size: 24rpx; }
.font-size-medium .status-value { font-size: 48rpx; }
.font-size-medium .message-text { font-size: 30rpx; }
.font-size-medium .tile-number { font-size: 48rpx; }
.font-size-medium .action-btn-text { font-size: 30rpx; }
.font-size-medium .stats-title-text { font-size: 30rpx; }
.font-size-medium .stats-card-value { font-size: 40rpx; }
.font-size-medium .stats-card-label { font-size: 22rpx; }
.font-size-medium .tip-title { font-size: 28rpx; }
.font-size-medium .tip-item { font-size: 24rpx; }

.font-size-large .tool-title { font-size: 42rpx; }
.font-size-large .tool-desc { font-size: 28rpx; }
.font-size-large .status-value { font-size: 56rpx; }
.font-size-large .message-text { font-size: 34rpx; }
.font-size-large .tile-number { font-size: 56rpx; }
.font-size-large .action-btn-text { font-size: 34rpx; }
.font-size-large .stats-title-text { font-size: 34rpx; }
.font-size-large .stats-card-value { font-size: 48rpx; }
.font-size-large .stats-card-label { font-size: 26rpx; }
.font-size-large .tip-title { font-size: 32rpx; }
.font-size-large .tip-item { font-size: 28rpx; }

/* 结果弹窗 */
.result-modal-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);z-index:1000;display:flex;align-items:center;justify-content:center;}
.result-modal{width:80%;max-width:340px;background:#1a1a2e;border-radius:16px;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.4);}
.result-modal-poster{padding:12px;display:flex;justify-content:center;}
.result-poster-img{width:100%;border-radius:8px;}
.result-modal-info{padding:30px 20px 20px;display:flex;flex-direction:column;align-items:center;}
.result-modal-icon{font-size:40px;margin-bottom:8px;}
.result-modal-title{font-size:16px;color:rgba(255,255,255,0.7);margin-bottom:12px;}
.result-modal-score{font-size:40px;font-weight:bold;background:linear-gradient(135deg,#F59E0B,#D97706);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:4px;}
.result-modal-label{font-size:12px;color:rgba(255,255,255,0.5);margin-bottom:10px;}
.result-modal-rating{font-size:16px;font-weight:bold;color:#FCD34D;margin-bottom:4px;}
.result-modal-actions{padding:0 20px 20px;display:flex;flex-direction:column;gap:10px;}
.result-modal-share{background:linear-gradient(135deg,#F59E0B,#D97706);color:#fff;font-size:15px;font-weight:600;border:none;border-radius:24px;padding:12px 0;text-align:center;line-height:1.2;}
.result-modal-share::after{border:none;}
.result-modal-close{text-align:center;color:rgba(255,255,255,0.5);font-size:14px;padding:6px 0;}

/* 暗黑模式补充 */
.dark-mode .page-container {
  background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
}

.dark-mode .tool-header {
  background: #334155;
}

.dark-mode .status-bar {
  background: #334155;
}

.dark-mode .game-area {
  background: #334155;
}

.dark-mode .stats-section {
  background: #334155;
}

.dark-mode .tip-card {
  background: #334155;
}

.dark-mode .result-modal {
  background: #1E293B;
}
