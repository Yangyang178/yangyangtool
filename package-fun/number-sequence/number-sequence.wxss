@import "../../styles/tool-common.wxss";

page { background-color: var(--pageBg, #F8FAFC); }

.container { padding: 20px; padding-bottom: 40px; }

/* 开始界面 */
.start-screen { display: flex; flex-direction: column; align-items: center; }

.tool-header { display: flex; align-items: center; gap: 20px; margin-bottom: 28px; padding: 28px 24px; background: linear-gradient(135deg, rgba(59,130,246,0.12) 0%, rgba(99,102,241,0.10) 50%, rgba(139,92,246,0.08) 100%); border-radius: 24px; position: relative; overflow: hidden; box-shadow: 0 8px 32px rgba(59,130,246,0.12); }

.tool-icon-large { width: 80px; height: 80px; border-radius: 20px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; flex-shrink: 0; }

.blue-gradient { background: linear-gradient(135deg, #3B82F6, #6366F1); }

.icon-decoration { position: absolute; width: 100px; height: 100px; border-radius: 50%; background: rgba(255,255,255,0.15); filter: blur(18px); top: -20px; right: -20px; }

.tool-icon-text { font-size: 40px; position: relative; z-index: 2; }

.tool-header-info { flex: 1; min-width: 0; }

.tool-title { font-size: 24px; font-weight: 700; color: var(--textPrimary, #1E293B); display: block; margin-bottom: 6px; }

.tool-desc { font-size: 14px; color: var(--textSecondary, #64748B); line-height: 1.5; white-space: pre-line; }

/* 难度选择卡片 */
.card { width: 100%; background: var(--cardBg, #FFFFFF); border-radius: 20px; padding: 20px; margin-bottom: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }

.card-title { font-size: 16px; font-weight: 600; color: var(--textPrimary, #1E293B); margin-bottom: 14px; display: block; }

.diff-options { display: flex; gap: 12px; }

.diff-btn { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 14px 8px; border-radius: 14px; background: var(--surfaceBg, #F1F5F9); border: 2px solid transparent; transition: all 0.2s; }

.diff-btn.active { border-color: #3B82F6; background: rgba(59,130,246,0.08); }

.diff-label { font-size: 15px; font-weight: 600; color: var(--textPrimary, #1E293B); margin-bottom: 2px; }

.diff-count { font-size: 12px; color: var(--textTertiary, #94A3B8); }

/* 按钮 */
.primary-btn { width: 100%; padding: 16px; border-radius: 16px; background: linear-gradient(135deg, #3B82F6, #6366F1); text-align: center; font-size: 17px; font-weight: 600; color: #FFFFFF; box-shadow: 0 8px 24px rgba(59,130,246,0.25); margin-bottom: 12px; }

.secondary-btn { width: 100%; padding: 16px; border-radius: 16px; background: var(--surfaceBg, #F1F5F9); text-align: center; font-size: 17px; font-weight: 600; color: var(--textSecondary, #64748B); }

.btn-hover { opacity: 0.85; transform: scale(0.98); }

.best-badge { padding: 10px 24px; background: var(--surfaceBg, #FEF3C7); border-radius: 20px; margin-top: 12px; font-size: 14px; color: #D97706; font-weight: 500; }

.dark-mode .best-badge { background: #422006; color: #FCD34D; }

/* 游戏区域 */
.game-section { display: flex; flex-direction: column; }

.stats-bar { display: flex; justify-content: space-around; padding: 16px; background: var(--cardBg, #FFFFFF); border-radius: 16px; margin-bottom: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }

.stat { display: flex; flex-direction: column; align-items: center; gap: 2px; }

.stat-label { font-size: 12px; color: var(--textTertiary, #94A3B8); }

.stat-val { font-size: 20px; font-weight: 700; color: var(--textPrimary, #1E293B); }

.timer-val { color: #3B82F6; }

.next-val { color: #6366F1; }

.number-grid { position: relative; width: 100%; height: 60vh; }

.num-cell { position: absolute; width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, #3B82F6, #6366F1); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 16px rgba(59,130,246,0.25); transition: all 0.2s; transform: translate(-50%, -50%); font-size: 18px; font-weight: 700; color: #FFFFFF; }

.num-cell.tapped { background: linear-gradient(135deg, #10B981, #059669); box-shadow: 0 4px 16px rgba(16,185,129,0.25); transform: translate(-50%, -50%) scale(0.9); }

.num-cell.wrong { background: linear-gradient(135deg, #EF4444, #DC2626); box-shadow: 0 4px 16px rgba(239,68,68,0.25); animation: shake 0.3s; }

@keyframes shake {
  0%, 100% { transform: translate(-50%, -50%); }
  25% { transform: translate(-50%, -50%) translateX(-6px); }
  75% { transform: translate(-50%, -50%) translateX(6px); }
}

/* 结果界面 */
.result-section { display: flex; flex-direction: column; align-items: center; }

.result-card { width: 100%; background: var(--cardBg, #FFFFFF); border-radius: 24px; padding: 32px 24px; margin-bottom: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); text-align: center; }

.result-emoji { font-size: 48px; display: block; margin-bottom: 12px; }

.result-title { font-size: 24px; font-weight: 700; color: var(--textPrimary, #1E293B); display: block; margin-bottom: 24px; }

.result-stats { display: flex; justify-content: space-around; margin-bottom: 16px; }

.r-stat { display: flex; flex-direction: column; align-items: center; gap: 4px; }

.r-val { font-size: 24px; font-weight: 700; color: #3B82F6; }

.r-label { font-size: 12px; color: var(--textTertiary, #94A3B8); }

.new-record-badge { display: inline-block; padding: 8px 24px; background: #FEF3C7; border-radius: 20px; font-size: 15px; font-weight: 600; color: #D97706; }

.dark-mode .new-record-badge { background: #422006; color: #FCD34D; }

.result-actions { width: 100%; }
