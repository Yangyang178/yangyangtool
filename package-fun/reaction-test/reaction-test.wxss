@import "../../styles/tool-common.wxss";

page { background-color: var(--pageBg, #F8FAFC); }
.tool-page { height: 100vh; }
.container { padding: 20px; padding-bottom: 40px; }

/* 工具头部 */
.tool-header { text-align: center; margin-bottom: 24px; }
.icon-wrapper { width: 80px; height: 80px; border-radius: 24px; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; position: relative; overflow: hidden; }
.blue-gradient { background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%); }
.icon-decoration { position: absolute; width: 100px; height: 100px; border-radius: 50%; background: rgba(255,255,255,0.15); filter: blur(18px); top: -20px; right: -20px; }
.tool-icon { font-size: 40px; position: relative; z-index: 2; }
.tool-title { font-size: 24px; font-weight: 700; color: var(--textPrimary, #1E293B); display: block; margin-bottom: 8px; }
.tool-desc { font-size: 14px; color: var(--textSecondary, #64748B); }

/* ===================================
   测试圆圈区域
   =================================== */
.test-area { display: flex; justify-content: center; align-items: center; margin: 20px 0 28px; }

.circle {
  width: 200px;
  height: 200px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 8px 32px rgba(59, 130, 246, 0.3);
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.circle::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -20%;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  background: rgba(255,255,255,0.12);
  z-index: 0;
}

.circle::after {
  content: '';
  position: absolute;
  bottom: -20%;
  left: -15%;
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
  z-index: 0;
}

/* idle 状态 - 蓝色渐变 */
.circle.idle {
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 50%, #8B5CF6 100%);
  box-shadow: 0 8px 32px rgba(59, 130, 246, 0.35), 0 4px 16px rgba(99, 102, 241, 0.2);
}

.circle.idle:active {
  transform: scale(0.95);
  box-shadow: 0 4px 16px rgba(59, 130, 246, 0.25);
}

/* waiting 状态 - 红色 */
.circle.waiting {
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 50%, #B91C1C 100%);
  box-shadow: 0 8px 32px rgba(239, 68, 68, 0.4), 0 4px 16px rgba(220, 38, 38, 0.25);
  animation: waiting-pulse 1.2s ease-in-out infinite;
}

@keyframes waiting-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03); }
}

/* ready 状态 - 绿色 */
.circle.ready {
  background: linear-gradient(135deg, #10B981 0%, #059669 50%, #047857 100%);
  box-shadow: 0 8px 32px rgba(16, 185, 129, 0.45), 0 4px 16px rgba(5, 150, 105, 0.25);
  animation: ready-bounce 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes ready-bounce {
  0% { transform: scale(0.9); }
  50% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.circle.ready:active {
  transform: scale(0.92);
}

/* result 状态 - 紫色渐变 */
.circle.result {
  background: linear-gradient(135deg, #8B5CF6 0%, #6366F1 50%, #3B82F6 100%);
  box-shadow: 0 8px 32px rgba(139, 92, 246, 0.4), 0 4px 16px rgba(99, 102, 241, 0.25);
}

.circle.result:active {
  transform: scale(0.95);
}

/* tooEarly 状态 - 橙色 */
.circle.tooEarly {
  background: linear-gradient(135deg, #F97316 0%, #EA580C 50%, #C2410C 100%);
  box-shadow: 0 8px 32px rgba(249, 115, 22, 0.4), 0 4px 16px rgba(234, 88, 12, 0.25);
  animation: tooearly-shake 0.5s ease;
}

@keyframes tooearly-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-8px); }
  40% { transform: translateX(8px); }
  60% { transform: translateX(-6px); }
  80% { transform: translateX(6px); }
}

.circle.tooEarly:active {
  transform: scale(0.95);
}

/* 圆圈内容 */
.circle-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.circle-emoji {
  font-size: 36px;
  margin-bottom: 8px;
}

.circle-text {
  font-size: 20px;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2px 8px rgba(0,0,0,0.15);
}

.circle-sub {
  font-size: 12px;
  color: rgba(255,255,255,0.75);
  margin-top: 6px;
}

.circle-time {
  font-size: 48px;
  font-weight: 900;
  color: #FFFFFF;
  line-height: 1.1;
  text-shadow: 0 3px 12px rgba(0,0,0,0.2);
}

.circle-unit {
  font-size: 14px;
  color: rgba(255,255,255,0.8);
  margin-top: 2px;
  font-weight: 500;
}

/* 评级徽章 */
.rating-badge {
  margin-top: 10px;
  padding: 4px 14px;
  border-radius: 20px;
  background: rgba(255,255,255,0.2);
}

.rating-text {
  font-size: 13px;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 1px 4px rgba(0,0,0,0.15);
}

/* ===================================
   统计区域
   =================================== */
.stats-section {
  margin-bottom: 20px;
}

.stats-card {
  background: var(--cardBg, #FFFFFF);
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.04);
  margin-bottom: 16px;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  flex: 1;
}

.stat-value {
  font-size: 22px;
  font-weight: 800;
  color: #3B82F6;
}

.stat-label {
  font-size: 11px;
  color: var(--textTertiary, #94A3B8);
  font-weight: 500;
}

.stat-divider {
  width: 1px;
  height: 36px;
  background: var(--borderLight, #E2E8F0);
}

/* 最近记录 */
.recent-section {
  background: var(--cardBg, #FFFFFF);
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.04);
}

.recent-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.recent-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--textPrimary, #1E293B);
}

.recent-clear {
  font-size: 13px;
  font-weight: 500;
  color: var(--textTertiary, #94A3B8);
  padding: 4px 12px;
  border-radius: 12px;
  background: var(--surfaceBg, #F1F5F9);
}

.recent-clear:active {
  opacity: 0.7;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.recent-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  background: var(--pageBg, #F8FAFC);
  border-radius: 12px;
}

.recent-rank {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--borderLight, #E2E8F0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: var(--textSecondary, #64748B);
  flex-shrink: 0;
}

.recent-bar-wrapper {
  flex: 1;
  height: 8px;
  border-radius: 4px;
  background: var(--surfaceBg, #F1F5F9);
  overflow: hidden;
}

.recent-bar {
  height: 100%;
  border-radius: 4px;
  transition: width 0.5s ease;
  min-width: 4px;
}

.recent-time {
  font-size: 14px;
  font-weight: 700;
  color: var(--textPrimary, #1E293B);
  flex-shrink: 0;
  min-width: 60px;
  text-align: right;
}

/* ===================================
   分享按钮
   =================================== */
.share-btn {
  width: 100%;
  height: 52px;
  border-radius: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 16px;
  font-weight: 600;
  border: none;
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
  color: #FFFFFF;
  box-shadow: 0 6px 20px rgba(59, 130, 246, 0.35);
  margin-bottom: 20px;
  transition: all 0.3s ease;
}

.share-btn:active {
  transform: scale(0.97);
  box-shadow: 0 3px 12px rgba(59, 130, 246, 0.25);
}

.share-icon {
  font-size: 18px;
}

.share-text {
  font-size: 16px;
  font-weight: 600;
}

/* ===================================
   提示卡片
   =================================== */
.tips-section {
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  border-radius: 16px;
  padding: 18px;
  border-left: 4px solid #3B82F6;
}

.tips-title {
  font-size: 15px;
  font-weight: 600;
  color: #1E40AF;
  display: block;
  margin-bottom: 10px;
}

.tips-content {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.tip-item {
  font-size: 13px;
  color: #1E40AF;
  line-height: 1.5;
}

/* ===================================
   🌙 夜间模式完整适配
   =================================== */
.dark-mode page {
  background-color: var(--pageBgNight, #0f1419);
}

.dark-mode .icon-wrapper {
  box-shadow: 0 8px 24px rgba(59, 130, 246, 0.25);
}

.dark-mode .tool-title {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .tool-desc {
  color: var(--textSecondary, #94A3B8);
}

.dark-mode .circle.idle {
  box-shadow: 0 8px 32px rgba(59, 130, 246, 0.25), 0 4px 16px rgba(99, 102, 241, 0.15);
}

.dark-mode .circle.waiting {
  box-shadow: 0 8px 32px rgba(239, 68, 68, 0.3), 0 4px 16px rgba(220, 38, 38, 0.18);
}

.dark-mode .circle.ready {
  box-shadow: 0 8px 32px rgba(16, 185, 129, 0.35), 0 4px 16px rgba(5, 150, 105, 0.18);
}

.dark-mode .circle.result {
  box-shadow: 0 8px 32px rgba(139, 92, 246, 0.3), 0 4px 16px rgba(99, 102, 241, 0.18);
}

.dark-mode .circle.tooEarly {
  box-shadow: 0 8px 32px rgba(249, 115, 22, 0.3), 0 4px 16px rgba(234, 88, 12, 0.18);
}

.dark-mode .stats-card {
  background: var(--cardBg, #1a2035);
  box-shadow: 0 2px 12px rgba(0,0,0,0.2);
}

.dark-mode .stat-value {
  color: #818cf8;
}

.dark-mode .stat-label {
  color: var(--textMuted, #475569);
}

.dark-mode .stat-divider {
  background: var(--borderLight, #374151);
}

.dark-mode .recent-section {
  background: var(--cardBg, #1a2035);
  box-shadow: 0 2px 12px rgba(0,0,0,0.2);
}

.dark-mode .recent-title {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .recent-clear {
  background: var(--elevatedBg, #232d42);
  color: var(--textSecondary, #94A3B8);
}

.dark-mode .recent-item {
  background: var(--elevatedBg, #232d42);
}

.dark-mode .recent-rank {
  background: var(--borderLight, #374151);
  color: var(--textSecondary, #94A3B8);
}

.dark-mode .recent-bar-wrapper {
  background: var(--cardBg, #1a2035);
}

.dark-mode .recent-time {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .share-btn {
  background: linear-gradient(135deg, #4F46E5 0%, #6366F1 100%);
  box-shadow: 0 6px 20px rgba(99, 102, 241, 0.3);
}

.dark-mode .tips-section {
  background: rgba(59, 130, 246, 0.1);
  border-left-color: #60A5FA;
}

.dark-mode .tips-title {
  color: #93C5FD;
}

.dark-mode .tip-item {
  color: var(--textSecondary, #94A3B8);
}

/* 暗黑模式补充 */
.dark-mode .container {
  background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
}

.dark-mode .stats-card {
  background: #334155;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.dark-mode .recent-item {
  background: #1E293B;
}

.dark-mode .recent-bar-wrapper {
  background: #334155;
}

.dark-mode .recent-time {
  color: #F1F5F9;
}

.dark-mode .tips-section {
  background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
}

.dark-mode .share-btn {
  background: linear-gradient(135deg, #4338CA 0%, #6D28D9 100%);
}

.dark-mode .result-modal {
  background: #1E293B;
}

/* ===================================
   📱 字体大小适配
   =================================== */
.font-size-small .circle-text { font-size: 18px; }
.font-size-small .circle-time { font-size: 42px; }
.font-size-small .circle-sub { font-size: 11px; }
.font-size-small .stat-value { font-size: 20px; }
.font-size-small .recent-time { font-size: 13px; }

.font-size-large .circle-text { font-size: 22px; }
.font-size-large .circle-time { font-size: 54px; }
.font-size-large .circle-sub { font-size: 13px; }
.font-size-large .stat-value { font-size: 24px; }
.font-size-large .recent-time { font-size: 15px; }

.font-size-xlarge .circle-text { font-size: 24px; }
.font-size-xlarge .circle-time { font-size: 58px; }
.font-size-xlarge .circle-sub { font-size: 14px; }
.font-size-xlarge .stat-value { font-size: 26px; }
.font-size-xlarge .recent-time { font-size: 16px; }

/* 结果弹窗 */
.result-modal-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);z-index:1000;display:flex;align-items:center;justify-content:center;}
.result-modal{width:80%;max-width:340px;background:#1a1a2e;border-radius:16px;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.4);}
.result-modal-poster{padding:12px;display:flex;justify-content:center;}
.result-poster-img{width:100%;border-radius:8px;}
.result-modal-info{padding:30px 20px 20px;display:flex;flex-direction:column;align-items:center;}
.result-modal-icon{font-size:40px;margin-bottom:8px;}
.result-modal-title{font-size:16px;color:rgba(255,255,255,0.7);margin-bottom:12px;}
.result-modal-score{font-size:40px;font-weight:bold;background:linear-gradient(135deg,#F59E0B,#D97706);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:4px;}
.result-modal-label{font-size:12px;color:rgba(255,255,255,0.5);margin-bottom:10px;}
.result-modal-rating{font-size:16px;font-weight:bold;color:#FCD34D;margin-bottom:4px;}
.result-modal-actions{padding:0 20px 20px;display:flex;flex-direction:column;gap:10px;}
.result-modal-share{background:linear-gradient(135deg,#F59E0B,#D97706);color:#fff;font-size:15px;font-weight:600;border:none;border-radius:24px;padding:12px 0;text-align:center;line-height:1.2;}
.result-modal-share::after{border:none;}
.result-modal-close{text-align:center;color:rgba(255,255,255,0.5);font-size:14px;padding:6px 0;}
