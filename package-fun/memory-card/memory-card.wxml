<navigation-bar title="{{i18n.navTitle}}" />

<view class="container {{isDarkMode ? 'dark-mode' : ''}} {{fontClass}} font-size-{{fontSizeSetting}}" style="{{themeStyle}}">

  <!-- 工具头部 -->
  <view class="tool-header">
    <view class="tool-icon">🃏</view>
    <view class="tool-info">
      <view class="tool-title">{{i18n.toolTitle}}</view>
      <view class="tool-desc">{{i18n.toolDesc}}</view>
    </view>
  </view>

  <!-- 游戏状态栏 -->
  <view class="stats-bar">
    <view class="stat-item">
      <view class="stat-value">{{moves}}</view>
      <view class="stat-label">{{i18n.moves}}</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{timeElapsed}}s</view>
      <view class="stat-label">{{i18n.timeUsed}}</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{matchedPairs}}/{{totalPairs}}</view>
      <view class="stat-label">{{i18n.pairs}}</view>
    </view>
  </view>

  <!-- 游戏提示信息 -->
  <view class="game-message {{gameState === 'won' ? 'won' : ''}}">{{message}}</view>

  <!-- 卡牌网格 -->
  <view class="card-grid">
    <view
      class="card {{item.faceUp ? 'face-up' : 'face-down'}} {{item.matched ? 'matched' : ''}}"
      wx:for="{{cards}}"
      wx:key="id"
      data-index="{{index}}"
      bindtap="onTapCard"
    >
      <view class="card-inner">
        <view class="card-front">?</view>
        <view class="card-back">{{item.emoji}}</view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <view class="btn btn-primary" bindtap="startNewGame">{{i18n.newGame}}</view>
  </view>

  <!-- 最佳记录 -->
  <view class="stats-section">
    <view class="section-title">🏆 {{i18n.bestRecord}}</view>
    <view class="stats-grid">
      <view class="stats-card">
        <view class="stats-card-value">{{bestMoves > 0 ? bestMoves + i18n.movesUnit : '--'}}</view>
        <view class="stats-card-label">{{i18n.leastMoves}}</view>
      </view>
      <view class="stats-card">
        <view class="stats-card-value">{{bestTime > 0 ? bestTime + 's' : '--'}}</view>
        <view class="stats-card-label">{{i18n.shortestTime}}</view>
      </view>
      <view class="stats-card">
        <view class="stats-card-value">{{totalWins}}</view>
        <view class="stats-card-label">{{i18n.completionCount}}</view>
      </view>
    </view>
    <view class="btn-reset" bindtap="resetStats">{{i18n.resetRecords}}</view>
  </view>

  <!-- 规则提示 -->
  <view class="tip-card">
    <view class="tip-title">{{i18n.gameRules}}</view>
    <view class="tip-text">{{i18n.rule1}}</view>
    <view class="tip-text">{{i18n.rule2}}</view>
    <view class="tip-text">{{i18n.rule3}}</view>
    <view class="tip-text">{{i18n.rule4}}</view>
  </view>

</view>
<!-- 结果弹窗 -->
<view class="result-modal-mask" wx:if="{{showResultModal}}" bindtap="closeResultModal">
  <view class="result-modal" catchtap="">
    <view class="result-modal-poster" wx:if="{{_posterPath}}">
      <image src="{{_posterPath}}" mode="widthFix" class="result-poster-img"></image>
    </view>
    <view class="result-modal-info" wx:else>
      <text class="result-modal-icon">{{_resultData.icon}}</text>
      <text class="result-modal-title">{{_resultData.title}}</text>
      <text class="result-modal-score">{{_resultData.mainScore}}</text>
      <text class="result-modal-label">{{_resultData.mainScoreLabel}}</text>
      <text class="result-modal-rating" wx:if="{{_resultData.rating}}">{{_resultData.rating}}</text>
    </view>
    <view class="result-modal-actions">
      <button class="result-modal-share" open-type="share">{{i18n.shareChallenge}}</button>
      <view class="result-modal-close" bindtap="closeResultModal">{{i18n.close}}</view>
    </view>
  </view>
</view>
<!-- 结果海报Canvas -->
<canvas type="2d" id="resultPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:420px;height:560px;"></canvas>