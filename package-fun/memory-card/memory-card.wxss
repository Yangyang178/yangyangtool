.container {
  padding: 24rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4ff 0%, #f8f9fe 100%);
}

/* ========== 暗黑模式 ========== */
.dark-mode {
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
}

/* ========== 字号设置 ========== */
.font-size-small .stat-value,
.font-size-small .card-front,
.font-size-small .card-back,
.font-size-small .section-title,
.font-size-small .tip-title {
  font-size: 90%;
}

.font-size-large .stat-value,
.font-size-large .card-front,
.font-size-large .card-back,
.font-size-large .section-title,
.font-size-large .tip-title {
  font-size: 115%;
}

/* ========== 工具头部 ========== */
.tool-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.dark-mode .tool-header {
  background: linear-gradient(135deg, #4a5ab5 0%, #5c3d8f 100%);
  box-shadow: 0 8rpx 24rpx rgba(74, 90, 181, 0.4);
}

.tool-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.tool-info {
  flex: 1;
}

.tool-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.tool-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

/* ========== 游戏状态栏 ========== */
.stats-bar {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .stats-bar {
  background: #2a2a4a;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #667eea;
}

.dark-mode .stat-value {
  color: #8fa4f0;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.dark-mode .stat-label {
  color: #888;
}

/* ========== 游戏提示信息 ========== */
.game-message {
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 20rpx;
  padding: 12rpx 0;
}

.game-message.won {
  color: #52c41a;
  animation: pulse 0.6s ease-in-out;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.15); }
  100% { transform: scale(1); }
}

/* ========== 卡牌网格 ========== */
.card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 30rpx;
  perspective: 1200rpx;
}

/* ========== 单张卡牌 ========== */
.card {
  aspect-ratio: 1;
  border-radius: 16rpx;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.5s ease;
  cursor: pointer;
}

.card.face-up {
  transform: rotateY(180deg);
}

.card.matched {
  transform: rotateY(180deg) scale(0.92);
  opacity: 0.75;
}

.card-inner {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.card-front,
.card-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

/* 背面 - 未翻开 */
.card-front {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 52rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.dark-mode .card-front {
  background: linear-gradient(135deg, #4a5ab5 0%, #5c3d8f 100%);
  box-shadow: 0 4rpx 12rpx rgba(74, 90, 181, 0.4);
}

/* 正面 - 翻开 */
.card-back {
  background: #fff;
  transform: rotateY(180deg);
  font-size: 56rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.dark-mode .card-back {
  background: #3a3a5c;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

/* 匹配成功 */
.card.matched .card-back {
  border: 4rpx solid #52c41a;
  background: #f6ffed;
}

.dark-mode .card.matched .card-back {
  border: 4rpx solid #52c41a;
  background: #1a3a1a;
}

/* ========== 操作按钮 ========== */
.action-bar {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.35);
}

.dark-mode .btn-primary {
  background: linear-gradient(135deg, #4a5ab5 0%, #5c3d8f 100%);
  box-shadow: 0 6rpx 20rpx rgba(74, 90, 181, 0.4);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* ========== 最佳记录 ========== */
.stats-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .stats-section {
  background: #2a2a4a;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.dark-mode .section-title {
  color: #e0e0e0;
}

.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stats-card {
  flex: 1;
  text-align: center;
  background: #f5f7ff;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
}

.dark-mode .stats-card {
  background: #35355a;
}

.stats-card-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
}

.dark-mode .stats-card-value {
  color: #8fa4f0;
}

.stats-card-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.dark-mode .stats-card-label {
  color: #888;
}

.btn-reset {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 12rpx 0;
}

.dark-mode .btn-reset {
  color: #777;
}

.btn-reset:active {
  color: #667eea;
}

/* ========== 规则提示 ========== */
.tip-card {
  background: #fffbe6;
  border: 2rpx solid #ffe58f;
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.dark-mode .tip-card {
  background: #2a2a1e;
  border: 2rpx solid #5c5020;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.tip-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #d48806;
  margin-bottom: 12rpx;
}

.dark-mode .tip-title {
  color: #e6a817;
}

.tip-text {
  font-size: 24rpx;
  color: #8c8c8c;
  line-height: 1.8;
}

.dark-mode .tip-text {
  color: #999;
}

/* 结果弹窗 */
.result-modal-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);z-index:1000;display:flex;align-items:center;justify-content:center;}
.result-modal{width:80%;max-width:340px;background:#1a1a2e;border-radius:16px;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.4);}
.result-modal-poster{padding:12px;display:flex;justify-content:center;}
.result-poster-img{width:100%;border-radius:8px;}
.result-modal-info{padding:30px 20px 20px;display:flex;flex-direction:column;align-items:center;}
.result-modal-icon{font-size:40px;margin-bottom:8px;}
.result-modal-title{font-size:16px;color:rgba(255,255,255,0.7);margin-bottom:12px;}
.result-modal-score{font-size:40px;font-weight:bold;background:linear-gradient(135deg,#F59E0B,#D97706);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:4px;}
.result-modal-label{font-size:12px;color:rgba(255,255,255,0.5);margin-bottom:10px;}
.result-modal-rating{font-size:16px;font-weight:bold;color:#FCD34D;margin-bottom:4px;}
.result-modal-actions{padding:0 20px 20px;display:flex;flex-direction:column;gap:10px;}
.result-modal-share{background:linear-gradient(135deg,#F59E0B,#D97706);color:#fff;font-size:15px;font-weight:600;border:none;border-radius:24px;padding:12px 0;text-align:center;line-height:1.2;}
.result-modal-share::after{border:none;}
.result-modal-close{text-align:center;color:rgba(255,255,255,0.5);font-size:14px;padding:6px 0;}

/* 暗黑模式补充 */
.dark-mode .container {
  background: linear-gradient(180deg, #0F172A 0%, #1E293B 100%);
}

.dark-mode .tool-header {
  background: #334155;
}

.dark-mode .stats-bar {
  background: #334155;
}

.dark-mode .card-back {
  background: #334155;
  border-color: rgba(255, 255, 255, 0.1);
}

.dark-mode .stats-section {
  background: #334155;
}

.dark-mode .stats-card {
  background: #1E293B;
}

.dark-mode .tip-card {
  background: #334155;
}

.dark-mode .tip-text {
  color: #94A3B8;
}

.dark-mode .result-modal {
  background: #1E293B;
}