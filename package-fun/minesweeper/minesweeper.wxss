/* 页面容器 */
.page-container {
  min-height: 100vh;
  padding: 24rpx 32rpx 60rpx;
  background: linear-gradient(135deg, #f0f4ff 0%, #f8f9fe 100%);
  box-sizing: border-box;
}

/* 暗色模式 */
.page-container.dark-mode {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

/* 工具头部 */
.tool-header {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .tool-header {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.tool-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.tool-icon {
  font-size: 44rpx;
}

.tool-info {
  display: flex;
  flex-direction: column;
}

.tool-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 6rpx;
}

.dark-mode .tool-title {
  color: #f3f4f6;
}

.tool-desc {
  font-size: 24rpx;
  color: #9ca3af;
}

.dark-mode .tool-desc {
  color: #9ca3af;
}

/* 状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.dark-mode .status-bar {
  background: #2a2a4a;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.status-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.status-icon {
  font-size: 32rpx;
}

.status-value {
  font-size: 44rpx;
  font-weight: bold;
}

.mine-value {
  color: #EF4444;
}

.time-value {
  color: #3B82F6;
}

.dark-mode .mine-value {
  color: #FCA5A5;
}

.dark-mode .time-value {
  color: #93C5FD;
}

.status-divider {
  width: 2rpx;
  height: 60rpx;
  background: #e5e7eb;
  margin: 0 40rpx;
}

.dark-mode .status-divider {
  background: #4b5563;
}

/* 游戏状态文字 */
.state-text-wrap {
  text-align: center;
  padding: 16rpx 0;
  margin-bottom: 12rpx;
}

.state-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #6b7280;
  transition: color 0.3s ease;
}

.state-over {
  color: #EF4444;
}

.state-win {
  color: #10B981;
}

.dark-mode .state-text {
  color: #9ca3af;
}

.dark-mode .state-over {
  color: #FCA5A5;
}

.dark-mode .state-win {
  color: #6EE7B7;
}

/* 游戏区域 */
.game-area {
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .game-area {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 扫雷网格 */
.mine-grid {
  display: grid;
  grid-template-columns: repeat(9, 1fr);
  gap: 4rpx;
}

/* 格子通用 */
.mine-cell {
  aspect-ratio: 1;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease;
}

/* 未揭开 */
.mine-cell:not(.revealed):not(.flagged) {
  background: #b0b8c8;
  box-shadow: inset 2rpx 2rpx 4rpx rgba(255, 255, 255, 0.4), inset -2rpx -2rpx 4rpx rgba(0, 0, 0, 0.15);
}

.dark-mode .mine-cell:not(.revealed):not(.flagged) {
  background: #4a4a6a;
  box-shadow: inset 2rpx 2rpx 4rpx rgba(100, 100, 140, 0.3), inset -2rpx -2rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* 已揭开 */
.mine-cell.revealed {
  background: #e8e8e8;
  box-shadow: none;
}

.dark-mode .mine-cell.revealed {
  background: #2a2a4a;
}

/* 标旗 */
.mine-cell.flagged {
  background: #fff3cd;
  box-shadow: inset 2rpx 2rpx 4rpx rgba(255, 255, 255, 0.4), inset -2rpx -2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.dark-mode .mine-cell.flagged {
  background: #5a4a2a;
}

/* 雷 */
.mine-cell.mine {
  background: #ff6b6b;
  box-shadow: none;
}

.dark-mode .mine-cell.mine {
  background: #8b3a3a;
}

/* 格子内容 */
.cell-content {
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1;
}

/* 数字颜色 */
.num-1 { color: #2563EB; }
.num-2 { color: #16A34A; }
.num-3 { color: #DC2626; }
.num-4 { color: #1E40AF; }
.num-5 { color: #92400E; }
.num-6 { color: #0891B2; }
.num-7 { color: #1F2937; }
.num-8 { color: #6B7280; }

/* 暗黑模式数字颜色 */
.dark-mode .num-1 { color: #93C5FD; }
.dark-mode .num-2 { color: #6EE7B7; }
.dark-mode .num-3 { color: #FCA5A5; }
.dark-mode .num-4 { color: #A5B4FC; }
.dark-mode .num-5 { color: #FCD34D; }
.dark-mode .num-6 { color: #67E8F9; }
.dark-mode .num-7 { color: #D1D5DB; }
.dark-mode .num-8 { color: #9CA3AF; }

/* 操作区域 */
.action-area {
  margin-bottom: 24rpx;
}

.start-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  box-shadow: 0 6rpx 24rpx rgba(99, 102, 241, 0.4);
  transition: opacity 0.2s ease;
}

.start-btn:active {
  opacity: 0.85;
}

.start-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 4rpx;
}

/* 统计区域 */
.stats-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .stats-section {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.stats-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.stats-title-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.stats-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
}

.dark-mode .stats-title-text {
  color: #e5e7eb;
}

.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stats-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: #f9fafb;
  border-radius: 16rpx;
}

.dark-mode .stats-card {
  background: #374151;
}

.stats-card-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #6366F1;
  margin-bottom: 8rpx;
}

.dark-mode .stats-card-value {
  color: #A5B4FC;
}

.stats-card-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.dark-mode .stats-card-label {
  color: #6b7280;
}

.reset-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.dark-mode .reset-btn {
  border-color: #4b5563;
}

.reset-btn:active {
  background: #f3f4f6;
}

.dark-mode .reset-btn:active {
  background: #374151;
}

.reset-btn-text {
  font-size: 24rpx;
  color: #9ca3af;
}

.dark-mode .reset-btn-text {
  color: #6b7280;
}

/* 提示卡片 */
.tip-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dark-mode .tip-card {
  background: #2a2a4a;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.dark-mode .tip-title {
  color: #e5e7eb;
}

.tip-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}

.dark-mode .tip-item {
  color: #9ca3af;
}

/* 字体大小设置 */
.font-size-small .tool-title { font-size: 30rpx; }
.font-size-small .tool-desc { font-size: 22rpx; }
.font-size-small .status-value { font-size: 36rpx; }
.font-size-small .state-text { font-size: 26rpx; }
.font-size-small .cell-content { font-size: 22rpx; }
.font-size-small .start-btn-text { font-size: 28rpx; }
.font-size-small .stats-title-text { font-size: 26rpx; }
.font-size-small .stats-card-value { font-size: 30rpx; }
.font-size-small .stats-card-label { font-size: 20rpx; }
.font-size-small .tip-title { font-size: 24rpx; }
.font-size-small .tip-item { font-size: 22rpx; }

.font-size-medium .tool-title { font-size: 36rpx; }
.font-size-medium .tool-desc { font-size: 24rpx; }
.font-size-medium .status-value { font-size: 44rpx; }
.font-size-medium .state-text { font-size: 30rpx; }
.font-size-medium .cell-content { font-size: 28rpx; }
.font-size-medium .start-btn-text { font-size: 32rpx; }
.font-size-medium .stats-title-text { font-size: 30rpx; }
.font-size-medium .stats-card-value { font-size: 36rpx; }
.font-size-medium .stats-card-label { font-size: 22rpx; }
.font-size-medium .tip-title { font-size: 28rpx; }
.font-size-medium .tip-item { font-size: 24rpx; }

.font-size-large .tool-title { font-size: 42rpx; }
.font-size-large .tool-desc { font-size: 28rpx; }
.font-size-large .status-value { font-size: 52rpx; }
.font-size-large .state-text { font-size: 34rpx; }
.font-size-large .cell-content { font-size: 34rpx; }
.font-size-large .start-btn-text { font-size: 36rpx; }
.font-size-large .stats-title-text { font-size: 34rpx; }
.font-size-large .stats-card-value { font-size: 42rpx; }
.font-size-large .stats-card-label { font-size: 26rpx; }
.font-size-large .tip-title { font-size: 32rpx; }
.font-size-large .tip-item { font-size: 28rpx; }

/* 结果弹窗 */
.result-modal-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);z-index:1000;display:flex;align-items:center;justify-content:center;}
.result-modal{width:80%;max-width:340px;background:#1a1a2e;border-radius:16px;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.4);}
.result-modal-poster{padding:12px;display:flex;justify-content:center;}
.result-poster-img{width:100%;border-radius:8px;}
.result-modal-info{padding:30px 20px 20px;display:flex;flex-direction:column;align-items:center;}
.result-modal-icon{font-size:40px;margin-bottom:8px;}
.result-modal-title{font-size:16px;color:rgba(255,255,255,0.7);margin-bottom:12px;}
.result-modal-score{font-size:40px;font-weight:bold;background:linear-gradient(135deg,#F59E0B,#D97706);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:4px;}
.result-modal-label{font-size:12px;color:rgba(255,255,255,0.5);margin-bottom:10px;}
.result-modal-rating{font-size:16px;font-weight:bold;color:#FCD34D;margin-bottom:4px;}
.result-modal-actions{padding:0 20px 20px;display:flex;flex-direction:column;gap:10px;}
.result-modal-share{background:linear-gradient(135deg,#F59E0B,#D97706);color:#fff;font-size:15px;font-weight:600;border:none;border-radius:24px;padding:12px 0;text-align:center;line-height:1.2;}
.result-modal-share::after{border:none;}
.result-modal-close{text-align:center;color:rgba(255,255,255,0.5);font-size:14px;padding:6px 0;}

/* 暗黑模式补充 */
.dark-mode .page-container {
  background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
}

.dark-mode .tool-header {
  background: #334155;
}

.dark-mode .status-bar {
  background: #334155;
}

.dark-mode .game-area {
  background: #334155;
}

.dark-mode .stats-section {
  background: #334155;
}

.dark-mode .tip-card {
  background: #334155;
}

.dark-mode .result-modal {
  background: #1E293B;
}