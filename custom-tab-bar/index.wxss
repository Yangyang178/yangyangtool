.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50px;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  display: flex;
  align-items: center;
  z-index: 999;
}

.tab-bar.dark-mode {
  background: #0F172A;
}

.tab-bar-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: #E5E7EB;
}

.dark-mode .tab-bar-border {
  background: #1E293B;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4px 0;
}

.tab-icon {
  width: 24px;
  height: 24px;
  margin-bottom: 2px;
}

.tab-text {
  font-size: 10px;
  color: #94A3B8;
}

.tab-text.active {
  color: #3B82F6;
  font-weight: 500;
}

.dark-mode .tab-text {
  color: #64748B;
}

.dark-mode .tab-text.active {
  color: #60A5FA;
}