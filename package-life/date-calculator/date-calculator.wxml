<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>

<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}}" scroll-y>
  <view class="container">
    <view class="tool-header">
      <view class="icon-wrapper" style="background: linear-gradient(135deg, #FBBF2433 0%, #FBBF2466 100%);">
        <view class="icon-decoration"></view>
        <text class="tool-icon">📅</text>
      </view>
      <text class="tool-title">{{i18n.toolTitle}}</text>
      <text class="tool-desc">{{i18n.toolDesc}}</text>
    </view>

    <view class="calc-mode-tabs">
      <view 
        class="mode-tab {{calcMode === 'diff' ? 'active' : ''}}"
        data-mode="diff"
        bindtap="switchMode"
      >
        <text>{{i18n.dateInterval}}</text>
      </view>
      <view 
        class="mode-tab {{calcMode === 'add' ? 'active' : ''}}"
        data-mode="add"
        bindtap="switchMode"
      >
        <text>{{i18n.dateAddSub}}</text>
      </view>
    </view>

    <view wx:if="{{calcMode === 'diff'}}" class="input-section">
      <view class="date-input-group">
        <view class="date-label">
          <text class="label-icon">📌</text>
          <text>{{i18n.startDate}}</text>
        </view>
        <picker mode="date" value="{{startDate}}" start="1900-01-01" end="2099-12-31" bindchange="onStartDateChange">
          <view class="date-picker">
            <text>{{startDate}}</text>
            <text class="picker-arrow">📅</text>
          </view>
        </picker>
      </view>

      <view class="swap-btn" bindtap="swapDates">
        <text>⇅</text>
      </view>

      <view class="date-input-group">
        <view class="date-label">
          <text class="label-icon">🎯</text>
          <text>{{i18n.endDate}}</text>
        </view>
        <picker mode="date" value="{{endDate}}" start="1900-01-01" end="2099-12-31" bindchange="onEndDateChange">
          <view class="date-picker">
            <text>{{endDate}}</text>
            <text class="picker-arrow">📅</text>
          </view>
        </picker>
      </view>

      <view class="quick-dates">
        <text class="quick-label">{{i18n.quickSelect}}</text>
        <view class="quick-btn" bindtap="setTodayStart">{{i18n.today}}</view>
        <view class="quick-btn" bindtap="setYesterday">{{i18n.yesterday}}</view>
        <view class="quick-btn" bindtap="setThisWeek">{{i18n.thisWeek}}</view>
        <view class="quick-btn" bindtap="setThisMonth">{{i18n.thisMonth}}</view>
        <view class="quick-btn" bindtap="setThisYear">{{i18n.thisYear}}</view>
      </view>

      <view class="calculate-btn" bindtap="calculateDiff">
        <text>{{i18n.calcInterval}}</text>
      </view>
    </view>

    <view wx:if="{{calcMode === 'add'}}" class="input-section">
      <view class="date-input-group">
        <view class="date-label">
          <text class="label-icon">📌</text>
          <text>{{i18n.baseDate}}</text>
        </view>
        <picker mode="date" value="{{baseDate}}" start="1900-01-01" end="2099-12-31" bindchange="onBaseDateChange">
          <view class="date-picker">
            <text>{{baseDate}}</text>
            <text class="picker-arrow">📅</text>
          </view>
        </picker>
      </view>

      <view class="add-subtract-toggle">
        <view 
          class="toggle-btn {{addSubtract === 'add' ? 'active' : ''}}"
          data-type="add"
          bindtap="toggleAddSubtract"
        >
          <text>{{i18n.addLabel}}</text>
        </view>
        <view 
          class="toggle-btn {{addSubtract === 'subtract' ? 'active' : ''}}"
          data-type="subtract"
          bindtap="toggleAddSubtract"
        >
          <text>{{i18n.subLabel}}</text>
        </view>
      </view>

      <view class="number-inputs">
        <view class="number-input-item">
          <text class="number-label">{{i18n.yearUnit}}</text>
          <input 
            class="number-input" 
            type="number" 
            placeholder="0"
            value="{{addYears}}"
            bindinput="onAddYearsChange"
          />
        </view>
        <view class="number-input-item">
          <text class="number-label">{{i18n.monthUnit}}</text>
          <input 
            class="number-input" 
            type="number" 
            placeholder="0"
            value="{{addMonths}}"
            bindinput="onAddMonthsChange"
          />
        </view>
        <view class="number-input-item">
          <text class="number-label">{{i18n.dayUnit}}</text>
          <input 
            class="number-input" 
            type="number" 
            placeholder="0"
            value="{{addDays}}"
            bindinput="onAddDaysChange"
          />
        </view>
      </view>

      <view class="calculate-btn" bindtap="calculateAdd">
        <text>{{i18n.calcResult}}</text>
      </view>
    </view>

    <view wx:if="{{showResult}}" class="result-section">
      <view class="result-card">
        <view class="result-header">
          <text class="result-title">{{i18n.calcResult}}</text>
        </view>

        <view wx:if="{{calcMode === 'diff'}}" class="diff-results">
          <view class="main-result">
            <text class="result-number">{{totalDays}}</text>
            <text class="result-unit">{{i18n.daysUnit}}</text>
          </view>

          <view class="detail-grid">
            <view class="detail-item">
              <text class="detail-value">{{weeks}}</text>
              <text class="detail-label">{{i18n.weeks}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-value">{{months}}</text>
              <text class="detail-label">{{i18n.totalMonths}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-value">{{years}}</text>
              <text class="detail-label">{{i18n.yearUnit}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-value">{{hours}}</text>
              <text class="detail-label">{{i18n.hours}}</text>
            </view>
          </view>

          <view class="extra-info">
            <view class="info-row">
              <text class="info-label">{{i18n.startDateLabel}}</text>
              <text class="info-value">{{startDateDisplay}}</text>
            </view>
            <view class="info-row">
              <text class="info-label">{{i18n.endDateLabel}}</text>
              <text class="info-value">{{endDateDisplay}}</text>
            </view>
            <view class="info-row">
              <text class="info-label">{{i18n.weekdayLabel}}</text>
              <text class="info-value">{{startWeekday}} → {{endWeekday}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{calcMode === 'add'}}" class="add-result">
          <view class="main-result">
            <text class="result-number">{{resultDate}}</text>
          </view>
          <view class="weekday-result">
            <text>{{i18n.weekdayPrefix}}{{resultWeekday}}</text>
          </view>
          <view class="extra-info">
            <view class="info-row">
              <text class="info-label">{{i18n.baseDateLabel}}</text>
              <text class="info-value">{{baseDate}}</text>
            </view>
            <view class="info-row">
              <text class="info-label">{{addSubtract === 'add' ? i18n.plusLabel : i18n.minusLabel}}：</text>
              <text class="info-value">{{addYears}}{{i18n.yearUnit}} {{addMonths}}{{i18n.monthUnit}} {{addDays}}{{i18n.dayUnit}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="tool-actions-bar">
        <button class="tool-action-btn tool-action-copy" bindtap="copyResult" hover-class="btn-hover">{{i18n.copyResult}}</button>
        <button class="tool-action-btn tool-action-reset" bindtap="resetData" hover-class="btn-hover">{{i18n.resetData}}</button>
      </view>
    </view>

    <view wx:if="{{historyList.length > 0}}" class="history-section">
      <view class="section-header">
        <text class="section-title">{{i18n.calcHistory}}</text>
        <text class="clear-history" bindtap="clearHistory">{{i18n.clearHistory}}</text>
      </view>
      <view class="history-list">
        <view 
          class="history-item" 
          wx:for="{{historyList}}" 
          wx:key="time"
        >
          <text class="history-text">{{item.text}}</text>
          <text class="history-time">{{item.timeText}}</text>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>