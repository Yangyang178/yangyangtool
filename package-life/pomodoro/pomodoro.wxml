<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>
<skeleton show="{{isLoading}}" type="tool" dark="{{isDarkMode}}"></skeleton>

<view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}} {{fontClass}}">
  <view class="container">
    <!-- 工具头部 -->
    <view class="tool-header">
      <view class="icon-wrapper red-gradient">
        <view class="icon-decoration"></view>
        <text class="tool-icon">🍅</text>
      </view>
      <text class="tool-title">{{i18n.toolTitle}}</text>
      <text class="tool-desc">{{i18n.toolDesc}}</text>
    </view>

    <!-- 操作引导 -->
    <view class="guide-tip" wx:if="{{showGuideTip}}">
      <view class="guide-tip-header">
        <text class="guide-tip-icon">💡</text>
        <text class="guide-tip-title">{{i18n.guideTipTitle}}</text>
        <view class="guide-tip-close" bindtap="closeGuideTip">✕</view>
      </view>
      <view class="guide-tip-steps">
        <view class="guide-step" wx:for="{{i18n.guideSteps}}" wx:key="index">
          <text class="guide-step-num">{{index + 1}}</text>
          <text class="guide-step-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 计时器显示区 -->
    <view class="timer-section">
      <!-- 圆形进度条 -->
      <view class="progress-ring-wrapper">
        <canvas type="2d" id="progressRing" class="progress-canvas"></canvas>
        
        <view class="timer-display">
          <text class="time-text">{{displayTime}}</text>
          <text class="status-text">{{statusText}}</text>
        </view>
      </view>

      <!-- 统计信息 -->
      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-value">{{completedCount}}</text>
          <text class="stat-label">{{i18n.completed}}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{totalMinutes}}</text>
          <text class="stat-label">{{i18n.totalMinutesLabel}}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{currentRound}}/{{totalRounds}}</text>
          <text class="stat-label">{{i18n.currentRound}}</text>
        </view>
      </view>
    </view>

    <!-- 控制按钮 -->
    <view class="control-btns">
      <button 
        class="main-control-btn {{isRunning ? 'running' : ''}}" 
        bindtap="toggleTimer"
      >
        <text>{{isRunning ? i18n.pause : (isPaused ? i18n.continueBtn : i18n.startBtn)}}</text>
      </button>
      
      <button class="secondary-control-btn" bindtap="resetTimer" wx:if="{{!isRunning}}">
        <text>{{i18n.reset}}</text>
      </button>

      <button class="skip-btn" bindtap="skipToBreak" wx:if="{{isRunning}}">
        <text>{{i18n.skip}}</text>
      </button>
    </view>

    <!-- 时间设置 -->
    <view class="settings-section">
      <text class="settings-title">{{i18n.timeSettings}}</text>
      
      <view class="setting-item">
        <text class="setting-label">{{i18n.focusDuration}}</text>
        <picker mode="selector" range="{{workDurations}}" value="{{workDurationIndex}}" bindchange="onWorkDurationChange">
          <view class="setting-picker">{{workDurations[workDurationIndex]}} {{i18n.minutesUnit}} ▼</view>
        </picker>
      </view>

      <view class="setting-item">
        <text class="setting-label">{{i18n.shortBreak}}</text>
        <picker mode="selector" range="{{shortBreaks}}" value="{{shortBreakIndex}}" bindchange="onShortBreakChange">
          <view class="setting-picker">{{shortBreaks[shortBreakIndex]}} {{i18n.minutesUnit}} ▼</view>
        </picker>
      </view>

      <view class="setting-item">
        <text class="setting-label">{{i18n.longBreak}}</text>
        <picker mode="selector" range="{{longBreaks}}" value="{{longBreakIndex}}" bindchange="onLongBreakChange">
          <view class="setting-picker">{{longBreaks[longBreakIndex]}} {{i18n.minutesUnit}} ▼</view>
        </picker>
      </view>

      <view class="setting-item">
        <text class="setting-label">{{i18n.targetRounds}}</text>
        <view class="round-selector">
          <view class="round-btn {{totalRounds === 2 ? 'active' : ''}}" data-round="2" bindtap="changeTotalRounds">2</view>
          <view class="round-btn {{totalRounds === 4 ? 'active' : ''}}" data-round="4" bindtap="changeTotalRounds">4</view>
          <view class="round-btn {{totalRounds === 6 ? 'active' : ''}}" data-round="6" bindtap="changeTotalRounds">6</view>
          <view class="round-btn {{totalRounds === 8 ? 'active' : ''}}" data-round="8" bindtap="changeTotalRounds">8</view>
        </view>
      </view>
    </view>

    <!-- 今日统计 -->
    <view class="today-stats-section">
      <view class="stats-header">
        <text class="stats-title">{{i18n.todayFocus}}</text>
        <text class="stats-summary">{{todayPomodoroCount}}{{i18n.pomodoroUnit}} · {{todayFocusMinutes}}{{i18n.minutesUnit}}</text>
      </view>
      <view class="goal-progress-bar">
        <view class="goal-progress-fill" style="width: {{goalProgress}}%;"></view>
      </view>
      <view class="goal-row">
        <text class="goal-label">{{i18n.dailyGoal}}</text>
        <view class="goal-selector">
          <view class="goal-btn {{dailyGoal === 4 ? 'active' : ''}}" data-goal="4" bindtap="changeDailyGoal">4</view>
          <view class="goal-btn {{dailyGoal === 6 ? 'active' : ''}}" data-goal="6" bindtap="changeDailyGoal">6</view>
          <view class="goal-btn {{dailyGoal === 8 ? 'active' : ''}}" data-goal="8" bindtap="changeDailyGoal">8</view>
          <view class="goal-btn {{dailyGoal === 10 ? 'active' : ''}}" data-goal="10" bindtap="changeDailyGoal">10</view>
          <view class="goal-btn {{dailyGoal === 12 ? 'active' : ''}}" data-goal="12" bindtap="changeDailyGoal">12</view>
        </view>
        <text class="goal-percent">{{goalProgress}}%</text>
      </view>
    </view>

    <!-- 本周专注趋势 -->
    <view class="week-section">
      <view class="stats-header">
        <text class="stats-title">{{i18n.weekFocus}}</text>
        <view class="week-summary">
          <text class="week-stat">{{weekTotalPomodoros}}{{i18n.pomodoroUnit}}</text>
          <text class="week-stat-divider">·</text>
          <text class="week-stat">{{weekTotalMinutes}}{{i18n.minutesUnit}}</text>
          <text class="week-stat-divider">·</text>
          <text class="week-stat streak">🔥{{streakDays}}{{i18n.daysUnit}}</text>
        </view>
      </view>
      <view class="week-canvas-wrap">
        <canvas type="2d" id="weekCanvas" class="week-canvas"></canvas>
      </view>
    </view>

    <view class="tool-actions-bar">
      <button class="tool-action-btn tool-action-copy" bindtap="copyResult" hover-class="btn-hover">{{i18n.copyResult}}</button>
      <button class="tool-action-btn tool-action-export" bindtap="exportCSV" hover-class="btn-hover">{{i18n.exportCSV}}</button>
      <button class="tool-action-btn tool-action-share" bindtap="shareCSV" hover-class="btn-hover">{{i18n.shareFile}}</button>
    </view>

    <!-- 今日记录 -->
    <view class="history-section" wx:if="{{todayRecords.length > 0}}">
      <text class="history-title">{{i18n.todayRecords}}</text>
      <view class="record-list">
        <view class="record-item" wx:for="{{todayRecords}}" wx:key="index">
          <text class="record-icon">{{item.type === 'work' ? '🍅' : '☕'}}</text>
          <text class="record-time">{{item.time}}</text>
          <text class="record-duration">{{item.duration}}{{i18n.minutesUnit}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>
