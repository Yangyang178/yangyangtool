<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>

<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}}" scroll-y>
  <view class="container">
    <view class="tool-header">
      <view class="icon-wrapper orange-gradient">
        <view class="icon-decoration"></view>
        <text class="tool-icon">🎲</text>
      </view>
      <text class="tool-title">{{i18n.toolTitle}}</text>
      <text class="tool-desc">{{i18n.toolDesc}}</text>
    </view>

    <view class="mode-tabs">
      <view wx:for="{{modes}}" wx:key="id"
        class="mode-tab {{currentMode === item.id ? 'active' : ''}}"
        data-id="{{item.id}}" bindtap="switchMode">
        <text>{{item.icon}} {{item.name}}</text>
      </view>
    </view>

    <view wx:if="{{currentMode === 'decision' || currentMode === 'wheel'}}">
      <view class="input-section">
        <view class="section-header">
          <text class="section-label">{{i18n.addOptions}}</text>
          <view class="weight-toggle" bindtap="toggleWeightPanel">
            <text class="weight-toggle-text">{{showWeightPanel ? i18n.collapseWeight : i18n.weight}}</text>
          </view>
        </view>
        <view class="option-list">
          <view wx:for="{{options}}" wx:key="index"
            class="option-item {{selectedIndex === index ? 'selected' : ''}} {{resultIndex === index ? 'winner' : ''}}"
            data-index="{{index}}" bindtap="selectOption">
            <text class="option-index">{{index + 1}}</text>
            <text class="option-text">{{item}}</text>
            <view class="weight-badge" wx:if="{{weights[index] > 1}}">x{{weights[index]}}</view>
            <button class="delete-btn" catchtap="deleteOption" data-index="{{index}}">✕</button>
          </view>
        </view>
        <view class="weight-panel" wx:if="{{showWeightPanel && options.length > 0}}">
          <text class="weight-panel-title">{{i18n.weightDesc}}</text>
          <view class="weight-row" wx:for="{{options}}" wx:key="index">
            <text class="weight-name">{{item}}</text>
            <view class="weight-control">
              <input class="weight-input" type="number" value="{{weights[index]}}" data-index="{{index}}" bindinput="onWeightChange" maxlength="2"/>
            </view>
          </view>
        </view>
        <view class="add-option-wrapper">
          <input class="add-input" type="text" placeholder="{{i18n.inputNewOption}}" value="{{newOption}}" bindinput="onNewOptionInput" confirm-type="done" bindconfirm="addOption"/>
          <button class="add-btn" bindtap="addOption" disabled="{{!newOption}}"><text>{{i18n.addBtn}}</text></button>
        </view>
        <view class="quick-add-section">
          <text class="quick-label">{{i18n.quickAdd}}</text>
          <view class="quick-options">
            <text class="quick-tag" bindtap="quickAdd" data-options="{{i18n.lifeOptions}}">🍜 {{i18n.lifeTag}}</text>
            <text class="quick-tag" bindtap="quickAdd" data-options="{{i18n.travelOptions}}">📍 {{i18n.travelTag}}</text>
            <text class="quick-tag" bindtap="quickAdd" data-options="{{i18n.voteOptions}}">🗳 {{i18n.voteTag}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{currentMode === 'decision'}}">
      <button class="roll-btn {{isRolling ? 'rolling' : ''}} {{options.length >= 2 ? 'active' : ''}}" bindtap="startRoll" disabled="{{options.length < 2 || isRolling}}">
        <text>{{isRolling ? i18n.drawing : i18n.startDraw}}</text>
      </button>
      <view class="result-section" wx:if="{{showResult && !isRolling}}">
        <view class="result-card">
          <text class="result-emoji">🎉</text>
          <text class="result-title">{{i18n.fateChoice}}</text>
          <view class="result-answer"><text class="answer-text">{{selectedAnswer}}</text></view>
        </view>
      </view>
    </view>

    <view wx:if="{{currentMode === 'wheel'}}">
      <view class="wheel-section">
        <view class="wheel-container">
          <view class="wheel-pointer-wrap">
            <view class="wheel-pointer-arrow"></view>
          </view>
          <view class="wheel-wrapper" animation="{{wheelAnimData}}">
            <canvas type="2d" id="wheelCanvas" class="wheel-canvas"></canvas>
          </view>
        </view>
        <button class="roll-btn {{wheelSpinning ? 'rolling' : ''}} {{options.length >= 2 ? 'active' : ''}}" bindtap="spinWheel" disabled="{{options.length < 2 || wheelSpinning}}">
          <text>{{wheelSpinning ? i18n.spinning : i18n.spinWheel}}</text>
        </button>
        <view class="wheel-result-section" wx:if="{{showWheelResult && !wheelSpinning}}">
          <view class="result-card">
            <text class="result-emoji">🎡</text>
            <text class="result-title">{{i18n.wheelPoints}}</text>
            <view class="result-answer"><text class="answer-text">{{wheelResult}}</text></view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{currentMode === 'dice'}}">
      <view class="dice-section">
        <text class="section-label">{{i18n.diceCount}}</text>
        <view class="dice-count-row">
          <view class="dice-count-btn {{diceCount === 1 ? 'active' : ''}}" data-count="1" bindtap="changeDiceCount">1</view>
          <view class="dice-count-btn {{diceCount === 2 ? 'active' : ''}}" data-count="2" bindtap="changeDiceCount">2</view>
          <view class="dice-count-btn {{diceCount === 3 ? 'active' : ''}}" data-count="3" bindtap="changeDiceCount">3</view>
          <view class="dice-count-btn {{diceCount === 4 ? 'active' : ''}}" data-count="4" bindtap="changeDiceCount">4</view>
          <view class="dice-count-btn {{diceCount === 5 ? 'active' : ''}}" data-count="5" bindtap="changeDiceCount">5</view>
        </view>
        <view class="dice-display">
          <view wx:for="{{diceResults}}" wx:key="index" class="dice-item {{diceRolling ? 'rolling' : ''}}">
            <text class="dice-face">{{item}}</text>
          </view>
        </view>
        <view class="dice-total" wx:if="{{diceCount > 1}}">
          <text class="dice-total-label">{{i18n.total}}</text>
          <text class="dice-total-value">{{diceTotal}}</text>
        </view>
        <button class="roll-btn active" bindtap="rollDice" disabled="{{diceRolling}}">
          <text>{{diceRolling ? i18n.rolling : i18n.rollDice}}</text>
        </button>
      </view>
    </view>

    <view wx:if="{{currentMode === 'number'}}">
      <view class="number-section">
        <view class="number-range-row">
          <view class="number-input-group">
            <text class="number-label">{{i18n.minValue}}</text>
            <input class="number-input" type="number" value="{{numMin}}" bindinput="onNumMinInput"/>
          </view>
          <text class="number-sep">~</text>
          <view class="number-input-group">
            <text class="number-label">{{i18n.maxValue}}</text>
            <input class="number-input" type="number" value="{{numMax}}" bindinput="onNumMaxInput"/>
          </view>
        </view>
        <view class="number-result" wx:if="{{numResult}}">
          <text class="number-result-value {{numRolling ? 'rolling' : ''}}">{{numResult}}</text>
        </view>
        <button class="roll-btn active" bindtap="rollNumber" disabled="{{numRolling}}">
          <text>{{numRolling ? i18n.generating : i18n.generateNumber}}</text>
        </button>
      </view>
    </view>

    <view wx:if="{{currentMode === 'lottery'}}">
      <view class="lottery-section">
        <text class="section-label">{{i18n.lotteryInput}}</text>
        <textarea class="lottery-textarea" placeholder="{{i18n.lotteryPlaceholder}}" value="{{lotteryNames}}" bindinput="onLotteryNamesInput" maxlength="500" auto-height/>
        <view class="lottery-count-row">
          <text class="lottery-count-label">{{i18n.drawCount}}</text>
          <view class="lottery-count-btns">
            <view class="lottery-count-btn {{lotteryCount === 1 ? 'active' : ''}}" data-count="1" bindtap="onLotteryCountInput">1</view>
            <view class="lottery-count-btn {{lotteryCount === 2 ? 'active' : ''}}" data-count="2" bindtap="onLotteryCountInput">2</view>
            <view class="lottery-count-btn {{lotteryCount === 3 ? 'active' : ''}}" data-count="3" bindtap="onLotteryCountInput">3</view>
            <view class="lottery-count-btn {{lotteryCount === 4 ? 'active' : ''}}" data-count="4" bindtap="onLotteryCountInput">4</view>
            <view class="lottery-count-btn {{lotteryCount === 5 ? 'active' : ''}}" data-count="5" bindtap="onLotteryCountInput">5</view>
          </view>
        </view>
        <view class="lottery-result" wx:if="{{lotteryResult.length > 0}}">
          <text class="lottery-result-title">{{i18n.winners}}</text>
          <view class="lottery-result-list">
            <view wx:for="{{lotteryResult}}" wx:key="index" class="lottery-result-item {{lotteryRolling ? 'rolling' : ''}}">
              <text>{{item}}</text>
            </view>
          </view>
        </view>
        <view class="lottery-action">
          <button class="roll-btn active" bindtap="startLottery" disabled="{{lotteryRolling}}">
            <text>{{lotteryRolling ? i18n.drawing : i18n.startLottery}}</text>
          </button>
        </view>
      </view>
    </view>

    <view class="stats-section" wx:if="{{statsList.length > 0}}">
      <view class="stats-header">
        <text class="stats-title">{{i18n.decisionStats}} ({{i18n.totalLabel}}{{totalDecisions}}{{i18n.timesUnit}})</text>
        <view class="stats-actions">
          <text class="stats-toggle" bindtap="toggleStats">{{showStats ? i18n.collapse : i18n.view}}</text>
          <text class="stats-clear" bindtap="clearStats">🗑️</text>
        </view>
      </view>
      <view class="stats-list" wx:if="{{showStats}}">
        <view class="stats-item" wx:for="{{statsList}}" wx:key="name">
          <view class="stats-info">
            <text class="stats-name">{{item.name}}</text>
            <text class="stats-count">{{item.count}}{{i18n.timesUnit}} ({{item.percent}}%)</text>
          </view>
          <view class="stats-bar-bg">
            <view class="stats-bar" style="width: {{item.barWidth}}%;"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="tool-actions-bar">
      <button class="tool-action-btn tool-action-copy" bindtap="copyResult" hover-class="btn-hover">{{i18n.copyResult}}</button>
      <button class="tool-action-btn tool-action-reset" bindtap="resetData" hover-class="btn-hover">{{i18n.reset}}</button>
    </view>

    <view class="history-section" wx:if="{{historyList.length > 0}}">
      <text class="history-title">{{i18n.historyRecords}}</text>
      <scroll-view class="history-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="history-item" wx:for="{{historyList}}" wx:key="index">
          <text class="history-time">{{item.time}}</text>
          <text class="history-result">{{item.result}}</text>
        </view>
      </scroll-view>
      <button class="clear-history-btn" bindtap="clearHistory">{{i18n.clearHistory}}</button>
    </view>
  </view>
</scroll-view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>
