@import "../../styles/tool-common.wxss";

page {
  background-color: var(--pageBg, #F8FAFC);
}

.tool-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  padding: 20px;
}

.tool-header {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 24px;
  padding: 24px;
  background: linear-gradient(135deg, rgba(102,126,234,0.12) 0%, rgba(118,75,162,0.10) 50%, rgba(240,147,251,0.08) 100%);
  border-radius: 24px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8px 32px rgba(102, 126, 234, 0.15), 0 4px 16px rgba(118, 75, 162, 0.1);
}

.tool-icon-large {
  width: 64px;
  height: 64px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  position: relative;
  z-index: 2;
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
}

.tool-icon-decoration {
  position: absolute;
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: inherit;
  opacity: 0.2;
  filter: blur(18px);
  z-index: 1;
}

.tool-info {
  flex: 1;
  position: relative;
  z-index: 2;
}

.tool-title-main {
  font-size: 22px;
  font-weight: 800;
  color: var(--textPrimary, #1E293B);
  margin-bottom: 4px;
  letter-spacing: -0.5px;
}

.tool-desc-main {
  font-size: 13px;
  color: var(--textSecondary, #64748B);
  line-height: 1.5;
}

.section-label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--textPrimary, #1E293B);
  margin-bottom: 12px;
}

.gender-section {
  margin-bottom: 20px;
}

.gender-group {
  display: flex;
  gap: 12px;
}

.gender-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 52px;
  border-radius: 14px;
  background: var(--cardBg, #FFFFFF);
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  border: 2px solid transparent;
  transition: all 0.3s ease;
}

.gender-btn:active {
  transform: scale(0.97);
}

.gender-btn.gender-active {
  border-color: #667eea;
  background: linear-gradient(135deg, rgba(102,126,234,0.08) 0%, rgba(118,75,162,0.06) 100%);
  box-shadow: 0 4px 16px rgba(102,126,234,0.2);
}

.gender-icon {
  font-size: 22px;
}

.gender-text {
  font-size: 16px;
  font-weight: 700;
  color: var(--textPrimary, #1E293B);
}

.gender-active .gender-text {
  color: #667eea;
}

.chain-section {
  margin-bottom: 20px;
}

.chain-card {
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 50%, #8B5CF6 100%);
  border-radius: 16px;
  padding: 18px 20px;
  box-shadow: 0 8px 24px rgba(59, 130, 246, 0.3);
}

.chain-label {
  font-size: 12px;
  font-weight: 600;
  color: rgba(255,255,255,0.7);
  display: block;
  margin-bottom: 8px;
  letter-spacing: 1px;
}

.chain-display {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px;
  min-height: 32px;
}

.chain-prefix {
  font-size: 16px;
  font-weight: 700;
  color: #FFFFFF;
  background: rgba(255,255,255,0.2);
  padding: 4px 12px;
  border-radius: 8px;
}

.chain-arrow {
  font-size: 14px;
  color: rgba(255,255,255,0.6);
  margin: 0 2px;
}

.chain-text {
  font-size: 16px;
  font-weight: 700;
  color: #FFFFFF;
}

.chain-placeholder {
  font-size: 14px;
  color: rgba(255,255,255,0.5);
  font-style: italic;
}

.buttons-section {
  margin-bottom: 20px;
}

.button-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.step-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  height: 68px;
  border-radius: 14px;
  background: var(--cardBg, #FFFFFF);
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  border: 1.5px solid transparent;
  transition: all 0.25s ease;
}

.step-btn-spouse {
  grid-column: 1 / -1;
  max-width: 25%;
  justify-self: center;
}

.step-btn:active {
  transform: scale(0.95);
  border-color: #667eea;
  background: linear-gradient(135deg, rgba(102,126,234,0.06) 0%, rgba(118,75,162,0.04) 100%);
  box-shadow: 0 4px 12px rgba(102,126,234,0.15);
}

.step-icon {
  font-size: 22px;
}

.step-label {
  font-size: 13px;
  font-weight: 600;
  color: var(--textPrimary, #1E293B);
}

.result-section {
  margin-bottom: 20px;
}

.result-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FDFEFF 100%);
  border-radius: 20px;
  padding: 28px 24px;
  text-align: center;
  box-shadow: 0 8px 32px rgba(0,0,0,0.08), 0 3px 14px rgba(0,0,0,0.04);
  animation: resultPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

@keyframes resultPop {
  from {
    opacity: 0;
    transform: translateY(16px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.result-title {
  font-size: 42px;
  font-weight: 900;
  color: #D97706;
  display: block;
  margin-bottom: 4px;
  letter-spacing: 2px;
  text-shadow: 0 2px 8px rgba(217, 119, 6, 0.15);
}

.result-pinyin {
  font-size: 14px;
  color: var(--textTertiary, #94A3B8);
  display: block;
  margin-bottom: 16px;
  letter-spacing: 2px;
}

.result-divider {
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, rgba(102,126,234,0.15) 50%, transparent 100%);
  margin-bottom: 16px;
}

.result-info-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.result-info-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.result-info-sep {
  width: 1px;
  height: 36px;
  background: linear-gradient(180deg, transparent 0%, rgba(102,126,234,0.15) 50%, transparent 100%);
}

.result-info-label {
  font-size: 12px;
  color: var(--textTertiary, #94A3B8);
  font-weight: 600;
  letter-spacing: 1px;
}

.result-info-value {
  font-size: 15px;
  color: var(--textPrimary, #1E293B);
  font-weight: 600;
}

.result-info-value.call-value {
  color: #667eea;
  font-weight: 700;
}

.no-result-section {
  margin-bottom: 20px;
}

.no-result-card {
  background: var(--cardBg, #FFFFFF);
  border-radius: 16px;
  padding: 24px;
  text-align: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.no-result-icon {
  font-size: 36px;
  display: block;
  margin-bottom: 8px;
}

.no-result-text {
  font-size: 16px;
  font-weight: 700;
  color: var(--textPrimary, #1E293B);
  display: block;
  margin-bottom: 4px;
}

.no-result-hint {
  font-size: 13px;
  color: var(--textTertiary, #94A3B8);
}

.action-section {
  margin-bottom: 24px;
}

.action-row {
  display: flex;
  gap: 12px;
}

.action-btn {
  flex: 1;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  transition: all 0.25s ease;
}

.action-btn:active {
  transform: scale(0.97);
}

.back-btn {
  background: linear-gradient(135deg, rgba(102,126,234,0.08) 0%, rgba(118,75,162,0.06) 100%);
  color: #667eea;
  border: 1.5px solid rgba(102,126,234,0.15);
}

.reset-btn {
  background: linear-gradient(135deg, rgba(239,68,68,0.08) 0%, rgba(239,68,68,0.04) 100%);
  color: #EF4444;
  border: 1.5px solid rgba(239,68,68,0.15);
}

.history-section {
  margin-bottom: 20px;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.history-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--textPrimary, #1E293B);
}

.history-clear {
  font-size: 13px;
  color: var(--textTertiary, #94A3B8);
  padding: 4px 8px;
}

.history-clear:active {
  color: #EF4444;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
  background: var(--cardBg, #FFFFFF);
  border-radius: 14px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  transition: all 0.25s ease;
}

.history-item:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, rgba(102,126,234,0.04) 0%, rgba(118,75,162,0.02) 100%);
}

.history-left {
  flex: 1;
  min-width: 0;
}

.history-chain {
  font-size: 14px;
  font-weight: 600;
  color: var(--textPrimary, #1E293B);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-time {
  font-size: 11px;
  color: var(--textTertiary, #94A3B8);
  display: block;
  margin-top: 2px;
}

.history-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 12px;
}

.history-result {
  font-size: 16px;
  font-weight: 800;
  color: #D97706;
}

.history-call {
  font-size: 12px;
  color: #667eea;
  font-weight: 600;
}

/* ===================================
   🌙 夜间模式
   =================================== */
.dark-mode page {
  background-color: var(--pageBgNight, #0f1419);
}

.dark-mode .tool-header {
  background: linear-gradient(135deg, rgba(102,126,234,0.15) 0%, rgba(118,75,162,0.12) 50%, rgba(240,147,251,0.08) 100%);
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
}

.dark-mode .tool-title-main {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .tool-desc-main {
  color: var(--textSecondary, #94A3B8);
}

.dark-mode .section-label {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .gender-btn {
  background: var(--elevatedBg, #232d42);
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

.dark-mode .gender-btn.gender-active {
  border-color: #818cf8;
  background: linear-gradient(135deg, rgba(129,140,248,0.12) 0%, rgba(118,75,162,0.08) 100%);
  box-shadow: 0 4px 16px rgba(129,140,248,0.2);
}

.dark-mode .gender-text {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .gender-active .gender-text {
  color: #818cf8;
}

.dark-mode .step-btn {
  background: var(--elevatedBg, #232d42);
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

.dark-mode .step-btn:active {
  border-color: #818cf8;
  background: linear-gradient(135deg, rgba(129,140,248,0.08) 0%, rgba(118,75,162,0.06) 100%);
}

.dark-mode .step-label {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .result-card {
  background: linear-gradient(135deg, #1a2035 0%, #151b28 100%);
  box-shadow: 0 8px 32px rgba(0,0,0,0.4);
}

.dark-mode .result-title {
  color: #FBBF24;
  text-shadow: 0 2px 8px rgba(251,191,36,0.2);
}

.dark-mode .result-pinyin {
  color: var(--textMuted, #475569);
}

.dark-mode .result-divider {
  background: linear-gradient(90deg, transparent 0%, rgba(129,140,248,0.12) 50%, transparent 100%);
}

.dark-mode .result-info-sep {
  background: linear-gradient(180deg, transparent 0%, rgba(129,140,248,0.12) 50%, transparent 100%);
}

.dark-mode .result-info-label {
  color: var(--textMuted, #475569);
}

.dark-mode .result-info-value {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .result-info-value.call-value {
  color: #818cf8;
}

.dark-mode .no-result-card {
  background: var(--elevatedBg, #232d42);
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

.dark-mode .no-result-text {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .no-result-hint {
  color: var(--textMuted, #475569);
}

.dark-mode .back-btn {
  background: linear-gradient(135deg, rgba(129,140,248,0.1) 0%, rgba(118,75,162,0.06) 100%);
  color: #818cf8;
  border-color: rgba(129,140,248,0.2);
}

.dark-mode .reset-btn {
  background: linear-gradient(135deg, rgba(239,68,68,0.1) 0%, rgba(239,68,68,0.05) 100%);
  color: #F87171;
  border-color: rgba(239,68,68,0.2);
}

.dark-mode .history-title {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .history-clear {
  color: var(--textMuted, #475569);
}

.dark-mode .history-item {
  background: var(--elevatedBg, #232d42);
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

.dark-mode .history-item:active {
  background: linear-gradient(135deg, rgba(129,140,248,0.06) 0%, rgba(118,75,162,0.04) 100%);
}

.dark-mode .history-chain {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .history-time {
  color: var(--textMuted, #475569);
}

.dark-mode .history-result {
  color: #FBBF24;
}

.dark-mode .history-call {
  color: #818cf8;
}

.tab-bar {
  display: flex;
  background: var(--cardBg, #FFFFFF);
  border-radius: 14px;
  padding: 4px;
  margin-bottom: 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  height: 40px;
  border-radius: 10px;
  transition: all 0.25s ease;
}

.tab-item:active {
  transform: scale(0.97);
}

.tab-active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4px 12px rgba(102,126,234,0.3);
}

.tab-icon {
  font-size: 14px;
}

.tab-text {
  font-size: 13px;
  font-weight: 700;
  color: var(--textSecondary, #64748B);
}

.tab-active .tab-text {
  color: #FFFFFF;
}

.chain-nodes {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0;
  min-height: 40px;
}

.chain-node-wrap {
  display: flex;
  align-items: center;
}

.chain-node {
  padding: 6px 14px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
}

.chain-node-me {
  background: rgba(255,255,255,0.25);
  color: #FFFFFF;
}

.chain-node-relative {
  background: rgba(255,255,255,0.15);
  color: #FFFFFF;
}

.chain-node-spouse {
  background: rgba(251,191,36,0.3);
  color: #FBBF24;
  border: 1px solid rgba(251,191,36,0.4);
}

.chain-node-result {
  background: rgba(251,191,36,0.4);
  color: #FBBF24;
  font-size: 16px;
}

.chain-node-label {
  font-size: inherit;
  font-weight: inherit;
  color: inherit;
}

.chain-connector {
  display: flex;
  align-items: center;
  margin: 0 4px;
}

.connector-line {
  width: 8px;
  height: 2px;
  background: rgba(255,255,255,0.3);
}

.connector-arrow {
  font-size: 16px;
  color: rgba(255,255,255,0.5);
  margin-left: -2px;
}

.ref-section {
  margin-bottom: 20px;
}

.ref-category-bar {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  white-space: nowrap;
  padding-bottom: 4px;
}

.ref-cat-btn {
  padding: 8px 16px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 700;
  color: var(--textSecondary, #64748B);
  background: var(--cardBg, #FFFFFF);
  box-shadow: 0 2px 6px rgba(0,0,0,0.04);
  border: 1.5px solid transparent;
  transition: all 0.25s ease;
  flex-shrink: 0;
}

.ref-cat-btn:active {
  transform: scale(0.95);
}

.ref-cat-active {
  border-color: #667eea;
  color: #667eea;
  background: linear-gradient(135deg, rgba(102,126,234,0.08) 0%, rgba(118,75,162,0.04) 100%);
}

.ref-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.ref-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  background: var(--cardBg, #FFFFFF);
  border-radius: 14px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  transition: all 0.25s ease;
}

.ref-item:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, rgba(102,126,234,0.04) 0%, rgba(118,75,162,0.02) 100%);
}

.ref-item-left {
  flex: 1;
  min-width: 0;
}

.ref-relation {
  font-size: 14px;
  font-weight: 600;
  color: var(--textPrimary, #1E293B);
  display: block;
}

.ref-item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 12px;
}

.ref-title {
  font-size: 16px;
  font-weight: 800;
  color: #D97706;
  display: block;
}

.ref-call {
  font-size: 12px;
  color: #667eea;
  font-weight: 600;
  margin-top: 2px;
}

.dialect-section {
  margin-bottom: 20px;
}

.dialect-region-bar {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  white-space: nowrap;
  padding-bottom: 4px;
}

.dialect-reg-btn {
  padding: 8px 14px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 700;
  color: var(--textSecondary, #64748B);
  background: var(--cardBg, #FFFFFF);
  box-shadow: 0 2px 6px rgba(0,0,0,0.04);
  border: 1.5px solid transparent;
  transition: all 0.25s ease;
  flex-shrink: 0;
}

.dialect-reg-btn:active {
  transform: scale(0.95);
}

.dialect-reg-active {
  border-color: #F59E0B;
  color: #F59E0B;
  background: linear-gradient(135deg, rgba(245,158,11,0.08) 0%, rgba(217,119,6,0.04) 100%);
}

.dialect-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.dialect-item {
  display: flex;
  align-items: center;
  padding: 14px 16px;
  background: var(--cardBg, #FFFFFF);
  border-radius: 14px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  gap: 12px;
}

.dialect-standard,
.dialect-local {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.dialect-label {
  font-size: 10px;
  font-weight: 600;
  color: var(--textTertiary, #94A3B8);
  letter-spacing: 1px;
}

.dialect-value {
  font-size: 15px;
  font-weight: 700;
  color: var(--textPrimary, #1E293B);
}

.dialect-local-value {
  color: #D97706;
}

.dialect-arrow-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialect-arrow {
  font-size: 16px;
  color: var(--textTertiary, #94A3B8);
  font-weight: 700;
}

.dialect-region-tag {
  padding: 4px 8px;
  border-radius: 6px;
  background: rgba(245,158,11,0.08);
  flex-shrink: 0;
}

.dialect-region-text {
  font-size: 10px;
  font-weight: 600;
  color: #D97706;
  white-space: nowrap;
}

.dark-mode .tab-bar {
  background: var(--elevatedBg, #232d42);
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

.dark-mode .tab-text {
  color: var(--textSecondary, #94A3B8);
}

.dark-mode .tab-active .tab-text {
  color: #FFFFFF;
}

.dark-mode .ref-cat-btn {
  background: var(--elevatedBg, #232d42);
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  color: var(--textSecondary, #94A3B8);
}

.dark-mode .ref-cat-active {
  border-color: #818cf8;
  color: #818cf8;
  background: linear-gradient(135deg, rgba(129,140,248,0.1) 0%, rgba(118,75,162,0.06) 100%);
}

.dark-mode .ref-item {
  background: var(--elevatedBg, #232d42);
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}

.dark-mode .ref-relation {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .ref-title {
  color: #FBBF24;
}

.dark-mode .ref-call {
  color: #818cf8;
}

.dark-mode .dialect-reg-btn {
  background: var(--elevatedBg, #232d42);
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  color: var(--textSecondary, #94A3B8);
}

.dark-mode .dialect-reg-active {
  border-color: #FBBF24;
  color: #FBBF24;
  background: linear-gradient(135deg, rgba(251,191,36,0.1) 0%, rgba(217,119,6,0.06) 100%);
}

.dark-mode .dialect-item {
  background: var(--elevatedBg, #232d42);
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}

.dark-mode .dialect-value {
  color: var(--textPrimary, #F1F5F9);
}

.dark-mode .dialect-local-value {
  color: #FBBF24;
}

.dark-mode .dialect-region-tag {
  background: rgba(251,191,36,0.12);
}

.dark-mode .dialect-region-text {
  color: #FBBF24;
}
