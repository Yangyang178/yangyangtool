  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["calculator", "life"]
    },
    "pages/favorites/favorites": {
      "network": "all",
      "packages": ["text", "dev"]
    },
    "pages/recent/recent": {
      "network": "all",
      "packages": ["life", "fun"]
    }
  },
  "window": {
    "navigationBarTextStyle": "black",
    "navigationStyle": "custom"
  },
  "tabBar": {
    "color": "#94A3B8",
    "selectedColor": "#3B82F6",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "工具集",
        "iconPath": "images/tab-tools.png",
        "selectedIconPath": "images/tab-tools-active.png"
      },
      {
        "pagePath": "pages/favorites/favorites",
        "text": "收藏夹",
        "iconPath": "images/tab-fav.png",
        "selectedIconPath": "images/tab-fav-active.png"
      },
      {
        "pagePath": "pages/recent/recent",
        "text": "我的",
        "iconPath": "images/tab-recent.png",
        "selectedIconPath": "images/tab-recent-active.png"
      }
    ]
  },
  "style": "v2",
  "darkmode": true,
  "themeLocation": "theme.json",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "permission": {
    "scope.userLocation": {
      "desc": "指南针需要获取您的位置信息以显示经纬度坐标"
    },
    "scope.writePhotosAlbum": {
      "desc": "需要保存图片到您的相册"
    }
  },
  "__usePrivacyCheck__": true,
  "requiredPrivateInfos": [
    "getLocation"
  ]
}