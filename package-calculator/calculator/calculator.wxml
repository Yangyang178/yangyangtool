<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>

<view class="calc-page {{isDarkMode ? 'dark-mode' : ''}} {{fontClass}} font-size-{{fontSizeSetting}}" style="{{themeStyle}}">
  <view class="display-area">
    <view class="expression-line">
      <text class="expression-text">{{expression || ' '}}</text>
    </view>
    <view class="result-line">
      <text class="result-text">{{result}}</text>
    </view>
  </view>

  <view class="science-row">
    <view class="sci-btn" data-func="sin" bindtap="onScientific">sin</view>
    <view class="sci-btn" data-func="cos" bindtap="onScientific">cos</view>
    <view class="sci-btn" data-func="tan" bindtap="onScientific">tan</view>
    <view class="sci-btn" data-func="log" bindtap="onScientific">log</view>
    <view class="sci-btn" data-func="ln" bindtap="onScientific">ln</view>
  </view>
  <view class="science-row">
    <view class="sci-btn" data-func="sqrt" bindtap="onScientific">√</view>
    <view class="sci-btn" data-func="square" bindtap="onScientific">x²</view>
    <view class="sci-btn" data-func="power" bindtap="onScientific">xʸ</view>
    <view class="sci-btn" data-func="pi" bindtap="onScientific">π</view>
    <view class="sci-btn" data-func="e" bindtap="onScientific">e</view>
  </view>
  <view class="science-row">
    <view class="sci-btn" data-func="(" bindtap="onScientific">(</view>
    <view class="sci-btn" data-func=")" bindtap="onScientific">)</view>
    <view class="sci-btn func-clear" data-value="C" bindtap="onInput">C</view>
    <view class="sci-btn func-back" data-value="backspace" bindtap="onInput">⌫</view>
    <view class="sci-btn" data-value="÷" bindtap="onInput">÷</view>
  </view>

  <view class="keypad">
    <view class="key-row">
      <view class="key-btn" data-value="7" bindtap="onInput">7</view>
      <view class="key-btn" data-value="8" bindtap="onInput">8</view>
      <view class="key-btn" data-value="9" bindtap="onInput">9</view>
      <view class="key-btn op-btn" data-value="×" bindtap="onInput">×</view>
    </view>
    <view class="key-row">
      <view class="key-btn" data-value="4" bindtap="onInput">4</view>
      <view class="key-btn" data-value="5" bindtap="onInput">5</view>
      <view class="key-btn" data-value="6" bindtap="onInput">6</view>
      <view class="key-btn op-btn" data-value="-" bindtap="onInput">-</view>
    </view>
    <view class="key-row">
      <view class="key-btn" data-value="1" bindtap="onInput">1</view>
      <view class="key-btn" data-value="2" bindtap="onInput">2</view>
      <view class="key-btn" data-value="3" bindtap="onInput">3</view>
      <view class="key-btn op-btn" data-value="+" bindtap="onInput">+</view>
    </view>
    <view class="key-row">
      <view class="key-btn" data-value="0" bindtap="onInput">0</view>
      <view class="key-btn" data-value="." bindtap="onInput">.</view>
      <view class="key-btn history-toggle" bindtap="toggleHistory">📋</view>
      <view class="key-btn equal-btn" data-value="=" bindtap="onInput">=</view>
    </view>
  </view>

  <view class="tool-actions-bar">
    <button class="tool-action-btn tool-action-copy" bindtap="copyResult" hover-class="btn-hover">{{i18n.copy}}</button>
    <button class="tool-action-btn tool-action-save" bindtap="saveExpression" hover-class="btn-hover">{{i18n.save}}</button>
    <button class="tool-action-btn tool-action-reset" bindtap="resetData" hover-class="btn-hover">{{i18n.reset}}</button>
  </view>

  <view class="feature-tabs">
    <view class="feature-tab {{showHistory ? 'active' : ''}}" bindtap="toggleHistory">{{i18n.history}}</view>
    <view class="feature-tab {{showFavorites ? 'active' : ''}}" bindtap="toggleFavorites">⭐</view>
    <view class="feature-tab {{showExpressions ? 'active' : ''}}" bindtap="toggleExpressions">📝</view>
    <view class="feature-tab {{showConstants ? 'active' : ''}}" bindtap="toggleConstants">🔢</view>
  </view>

  <view class="history-section" wx:if="{{showHistory}}">
    <view class="history-header">
      <text class="history-title">{{i18n.calcHistory}}</text>
      <text class="history-clear" bindtap="clearHistory" wx:if="{{history.length > 0}}">{{i18n.clearHistoryTitle}}</text>
    </view>
    <view class="history-list" wx:if="{{history.length > 0}}">
      <view class="history-item" wx:for="{{history}}" wx:key="index">
        <view class="history-left" data-index="{{index}}" bindtap="useHistoryItem">
          <text class="history-expr">{{item.expression}}</text>
          <text class="history-time">{{item.time}}</text>
        </view>
        <view class="history-right">
          <text class="history-result" data-index="{{index}}" bindtap="useHistoryItem">= {{item.result}}</text>
          <view class="history-fav-btn" data-index="{{index}}" bindtap="addFavorite">⭐</view>
        </view>
      </view>
    </view>
    <view class="history-empty" wx:else>
      <text class="history-empty-text">{{i18n.noCalcHistory}}</text>
    </view>
  </view>

  <view class="favorites-section" wx:if="{{showFavorites}}">
    <view class="history-header">
      <text class="history-title">{{i18n.favoritesTitle}}</text>
      <text class="fav-count" wx:if="{{favorites.length > 0}}">{{favorites.length}}/20</text>
    </view>
    <view class="history-list" wx:if="{{favorites.length > 0}}">
      <view class="history-item" wx:for="{{favorites}}" wx:key="index">
        <view class="history-left" data-index="{{index}}" bindtap="useFavorite">
          <text class="history-expr">{{item.expression}}</text>
          <text class="history-time">{{item.time}}</text>
        </view>
        <view class="history-right">
          <text class="history-result" data-index="{{index}}" bindtap="useFavorite">= {{item.result}}</text>
          <view class="history-del-btn" data-index="{{index}}" bindtap="removeFavorite">✕</view>
        </view>
      </view>
    </view>
    <view class="history-empty" wx:else>
      <text class="history-empty-text">{{i18n.noFavorites}}</text>
    </view>
  </view>

  <view class="expressions-section" wx:if="{{showExpressions}}">
    <view class="history-header">
      <text class="history-title">{{i18n.expressionsTitle}}</text>
      <text class="fav-count" wx:if="{{savedExpressions.length > 0}}">{{savedExpressions.length}}/20</text>
    </view>
    <view class="history-list" wx:if="{{savedExpressions.length > 0}}">
      <view class="history-item" wx:for="{{savedExpressions}}" wx:key="index">
        <view class="history-left" data-index="{{index}}" bindtap="useExpression">
          <text class="history-expr">{{item.expression}}</text>
          <text class="history-time">{{item.time}}</text>
        </view>
        <view class="history-right">
          <view class="history-del-btn" data-index="{{index}}" bindtap="removeExpression">✕</view>
        </view>
      </view>
    </view>
    <view class="history-empty" wx:else>
      <text class="history-empty-text">{{i18n.noExpressions}}</text>
    </view>
  </view>

  <view class="constants-section" wx:if="{{showConstants}}">
    <view class="history-header">
      <text class="history-title">{{i18n.constantsTitle}}</text>
    </view>
    <view class="constants-grid">
      <view class="constant-item" wx:for="{{mathConstants}}" wx:key="label" data-index="{{index}}" bindtap="onConstantTap">
        <text class="constant-symbol">{{item.label}}</text>
        <text class="constant-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>
</view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>
