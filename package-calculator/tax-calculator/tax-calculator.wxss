@import "../../styles/tool-common.wxss";

page {
  background-color: #ffffff;
  height: 100vh;
}

.tool-page {
  height: 100vh;
}

.container {
  padding: 16px;
  padding-bottom: calc(60px + env(safe-area-inset-bottom));
}

/* 头部 */
.header {
  text-align: center;
  padding: 24px 0 20px;
}

.header-icon {
  font-size: 48px;
  display: block;
  margin-bottom: 8px;
}

.header-title {
  font-size: 22px;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 4px;
}

.header-sub {
  font-size: 13px;
  color: #94a3b8;
}

/* 表单区域 - 柔和圆角 */
.form-section {
  background: #f8fafc;
  border-radius: 24px;
  padding: 20px;
  margin-bottom: 16px;
}

.form-item {
  margin-bottom: 12px;
}

.form-label {
  font-size: 14px;
  font-weight: 600;
  color: #334155;
  display: block;
  margin-bottom: 8px;
}

.input-row {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  padding: 0 14px;
}

.form-input {
  flex: 1;
  height: 44px;
  font-size: 20px;
  font-weight: 700;
  color: #1e293b;
  background: transparent;
  border: none;
}

.input-unit {
  font-size: 13px;
  color: #64748b;
  font-weight: 500;
  padding-left: 8px;
  white-space: nowrap;
}

.divider {
  height: 1px;
  background: #e2e8f0;
  margin: 16px 0;
}

/* 扣除项标题 */
.deduction-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.deduction-title {
  font-size: 15px;
  font-weight: 700;
  color: #1e293b;
}

.deduction-total {
  font-size: 13px;
  color: #10b981;
  font-weight: 600;
  background: #ecfdf5;
  padding: 3px 10px;
  border-radius: 12px;
}

/* 扣除项列表 - 精美卡片式布局 */
.deduction-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* 扣除项 - 独立圆角卡片设计 */
.deduction-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 18px;
  background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%);
  border-radius: 16px;
  border: 1.5px solid rgba(148, 163, 184, 0.15);
  box-shadow:
    0 2px 8px rgba(0, 0, 0, 0.04),
    0 1px 3px rgba(0, 0, 0, 0.02);
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  margin-bottom: 0;
  overflow: hidden;
}

.deduction-item.item-last {
  margin-bottom: 0;
}

/* 卡片悬停/点击效果 */
.deduction-item:active {
  background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%);
  box-shadow:
    0 4px 16px rgba(102, 126, 234, 0.15),
    0 2px 8px rgba(102, 126, 234, 0.08);
  border-color: rgba(102, 126, 234, 0.25);
  transform: scale(0.98) translateY(-1px);
}

.item-left {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 0;
}

.item-icon {
  font-size: 24px;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%);
  border-radius: 12px;
  box-shadow:
    0 2px 6px rgba(102, 126, 234, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.item-name {
  font-size: 15px;
  font-weight: 600;
  color: #1E293B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.item-input {
  width: 70px;
  height: 38px;
  font-size: 14px;
  font-weight: 700;
  color: #1E293B;
  text-align: right;
  background: #FFFFFF;
  border: 1.5px solid #E2E8F0;
  border-radius: 12px;
  padding: 0 12px;
  box-shadow:
    inset 0 1px 3px rgba(0, 0, 0, 0.04),
    0 1px 2px rgba(255, 255, 255, 0.9);
  transition: all 0.2s ease;
}

.item-input:focus {
  border-color: #3B82F6;
  box-shadow:
    inset 0 1px 3px rgba(0, 0, 0, 0.04),
    0 0 0 3px rgba(59, 130, 246, 0.15);
}

.item-unit {
  font-size: 12px;
  color: #64748B;
  font-weight: 500;
  white-space: nowrap;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 50px;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border-radius: 25px;
  border: none;
  font-size: 16px;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2px;
  box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
  margin-top: 20px;
}

.btn-hover {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 结果区域 */
.result-box {
  margin-top: 20px;
}

.result-main {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border-radius: 20px;
  padding: 24px;
  text-align: center;
}

.result-label {
  font-size: 13px;
  color: rgba(255,255,255,0.85);
  display: block;
  margin-bottom: 8px;
}

.amount-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2px;
}

.currency {
  font-size: 22px;
  font-weight: 700;
  color: #ffffff;
}

.amount-num {
  font-size: 36px;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: -1px;
}

.result-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  background: #e2e8f0;
  border-radius: 0 0 20px 20px;
  overflow: hidden;
}

.grid-item {
  background: #ffffff;
  padding: 16px 12px;
  text-align: center;
}

.grid-label {
  font-size: 12px;
  color: #64748b;
  display: block;
  margin-bottom: 4px;
}

.grid-value {
  font-size: 18px;
  font-weight: 800;
  color: #1e293b;
}

.grid-value.red {
  color: #dc2626;
}

.grid-unit {
  font-size: 12px;
  color: #94a3b8;
  font-weight: 500;
}

/* 年度汇总 */
.annual-box {
  background: #f8fafc;
  border-radius: 20px;
  padding: 20px;
  margin-top: 12px;
}

.annual-title {
  font-size: 14px;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 12px;
}

.annual-list {
  
}

.annual-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #f1f5f9;
}

.annual-row.row-last {
  border-bottom: none;
}

.annual-label {
  font-size: 14px;
  color: #64748b;
}

.annual-value {
  font-size: 15px;
  font-weight: 700;
  color: #1e293b;
}

.annual-value.red {
  color: #dc2626;
}

.annual-value.bold {
  font-weight: 800;
  color: #10b981;
}

.annual-unit {
  font-size: 12px;
  color: #94a3b8;
  font-weight: 400;
  margin-left: 2px;
}

/* 计算明细 */
.detail-box {
  background: #f8fafc;
  border-radius: 20px;
  padding: 20px;
  margin-top: 12px;
}

.detail-title {
  font-size: 14px;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 12px;
}

.detail-list {
  
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid #f1f5f9;
}

.detail-label {
  font-size: 13px;
  color: #64748b;
}

.detail-value {
  font-size: 14px;
  font-weight: 700;
  color: #1e293b;
}

.val-unit {
  font-size: 11px;
  color: #94a3b8;
  font-weight: 400;
  margin-left: 2px;
}

/* 使用说明 */
.tips-box {
  background: #fefce8;
  border-radius: 20px;
  padding: 20px;
  margin-top: 16px;
  border-left: 3px solid #f59e0b;
}

.tips-title {
  font-size: 14px;
  font-weight: 700;
  color: #92400e;
  display: block;
  margin-bottom: 10px;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.tip-line {
  font-size: 12px;
  color: #78716c;
  line-height: 1.5;
}

.bottom-space {
  height: 40px;
}

.form-hint { font-size: 12px; color: #94A3B8; font-weight: 400; }

.social-arrow { font-size: 14px; color: #94A3B8; transition: transform 0.3s ease; }
.social-arrow.expanded { transform: rotate(180deg); }
.deduction-hint { font-size: 12px; color: #64748B; font-weight: 400; }

.social-detail { margin-bottom: 12px; }
.social-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: #FFFFFF; border-radius: 12px; margin-bottom: 8px; border: 1px solid #E2E8F0; }
.social-left { display: flex; align-items: center; gap: 8px; }
.social-icon { font-size: 18px; }
.social-name { font-size: 14px; font-weight: 600; color: #334155; }
.social-right { display: flex; align-items: center; gap: 4px; }
.social-input { width: 60px; height: 34px; font-size: 15px; font-weight: 700; color: #1E293B; text-align: right; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 0 8px; }
.social-unit { font-size: 13px; color: #64748B; font-weight: 500; }

.grid-value.blue { color: #3B82F6; }
.grid-value.green { color: #10B981; }

.section-title { font-size: 15px; font-weight: 700; color: #1E293B; display: block; margin-bottom: 12px; }

.social-box { background: #F8FAFC; border-radius: 20px; padding: 20px; margin-top: 12px; }
.social-breakdown { margin-bottom: 14px; }
.social-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid #F1F5F9; }
.social-row-total { border-bottom: none; font-weight: 700; }
.social-row-label { font-size: 13px; color: #64748B; }
.social-row-total .social-row-label { color: #1E293B; }
.social-row-value { font-size: 14px; font-weight: 600; color: #1E293B; }
.social-compare { background: #FFFFFF; border-radius: 12px; padding: 12px 14px; }
.compare-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; }
.compare-label { font-size: 13px; color: #64748B; }
.compare-value { font-size: 14px; font-weight: 700; color: #1E293B; }
.compare-value.green { color: #10B981; }
.compare-saved { border-top: 1px dashed #E2E8F0; margin-top: 4px; padding-top: 8px; }

.bonus-box { background: #F8FAFC; border-radius: 20px; padding: 20px; margin-top: 12px; }
.bonus-amount { font-size: 16px; font-weight: 800; color: #1E293B; margin-bottom: 14px; text-align: center; }
.compare-cards { display: flex; gap: 10px; margin-bottom: 14px; }
.compare-card { flex: 1; background: #FFFFFF; border-radius: 14px; padding: 14px 12px; border: 2px solid #E2E8F0; position: relative; }
.compare-card.card-better { border-color: #10B981; background: #F0FDF4; }
.card-badge { position: absolute; top: -10px; right: 10px; background: #10B981; color: #FFFFFF; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 8px; }
.card-title { font-size: 15px; font-weight: 800; color: #1E293B; display: block; margin-bottom: 2px; }
.card-desc { font-size: 11px; color: #94A3B8; display: block; margin-bottom: 10px; }
.card-data { display: flex; justify-content: space-between; align-items: center; padding: 4px 0; }
.card-label { font-size: 12px; color: #64748B; }
.card-val { font-size: 14px; font-weight: 700; color: #1E293B; }
.card-val.red { color: #DC2626; }

.bonus-conclusion { background: #FFFFFF; border-radius: 12px; padding: 12px 14px; display: flex; align-items: center; gap: 8px; }
.conclusion-icon { font-size: 18px; }
.conclusion-text { font-size: 13px; color: #64748B; line-height: 1.5; }
.conclusion-bold { font-weight: 800; color: #1E293B; }
.conclusion-green { font-weight: 800; color: #10B981; }

/* 夜间模式 */
.dark-mode page {
  background-color: #0f1419;
}

.dark-mode .header-title {
  color: #F1F5F9;
}

.dark-mode .form-section {
  background: #232d42;
}

.dark-mode .form-label,
.dark-mode .deduction-title {
  color: #F1F5F9;
}

.dark-mode .input-row,
.dark-mode .item-input {
  background: #1a2035;
  border-color: #374151;
  color: #F1F5F9;
}

.dark-mode .item-name {
  color: #CBD5E1;
}

.dark-mode .divider {
  background-color: #374151;
}

.dark-mode .deduction-item {
  background: linear-gradient(135deg, #1a2035 0%, #232d42 100%);
  border-color: rgba(71, 85, 105, 0.3);
}

.dark-mode .deduction-item:active {
  background: linear-gradient(135deg, #232d42 0%, #2a3654 100%);
  border-color: rgba(102, 126, 234, 0.2);
}

.dark-mode .item-icon {
  background: linear-gradient(135deg, #232d42 0%, #2a3654 100%);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.dark-mode .deduction-total {
  background: rgba(16, 185, 129, 0.15);
  color: #34D399;
}

.dark-mode .result-main {
  background: linear-gradient(135deg, #059669 0%, #047857 100%);
}

.dark-mode .grid-item {
  background: #232d42;
}

.dark-mode .grid-label {
  color: #94A3B8;
}

.dark-mode .grid-value {
  color: #F1F5F9;
}

.dark-mode .annual-box,
.dark-mode .detail-box {
  background: #232d42;
}

.dark-mode .annual-title,
.dark-mode .detail-title {
  color: #F1F5F9;
}

.dark-mode .annual-label,
.dark-mode .detail-label {
  color: #94A3B8;
}

.dark-mode .annual-value,
.dark-mode .detail-value {
  color: #F1F5F9;
}

.dark-mode .tips-box {
  background: #422006;
  border-left-color: #FBBF24;
}

.dark-mode .tips-title {
  color: #FBBF24;
}

.dark-mode .tip-line {
  color: #D4A574;
}

.dark-mode .social-item { background: #1a2035; border-color: #374151; }
.dark-mode .social-name { color: #CBD5E1; }
.dark-mode .social-input { background: #232d42; border-color: #374151; color: #F1F5F9; }
.dark-mode .social-arrow { color: #94A3B8; }
.dark-mode .deduction-hint { color: #94A3B8; }
.dark-mode .form-hint { color: #475569; }

.dark-mode .section-title { color: #F1F5F9; }
.dark-mode .social-box { background: #232d42; }
.dark-mode .social-row { border-bottom-color: #374151; }
.dark-mode .social-row-label { color: #94A3B8; }
.dark-mode .social-row-total .social-row-label { color: #F1F5F9; }
.dark-mode .social-row-value { color: #F1F5F9; }
.dark-mode .social-compare { background: #1a2035; }
.dark-mode .compare-label { color: #94A3B8; }
.dark-mode .compare-value { color: #F1F5F9; }
.dark-mode .compare-saved { border-top-color: #374151; }

.dark-mode .bonus-box { background: #232d42; }
.dark-mode .bonus-amount { color: #F1F5F9; }
.dark-mode .compare-card { background: #1a2035; border-color: #374151; }
.dark-mode .compare-card.card-better { border-color: #10B981; background: rgba(16,185,129,0.1); }
.dark-mode .card-title { color: #F1F5F9; }
.dark-mode .card-desc { color: #64748B; }
.dark-mode .card-label { color: #94A3B8; }
.dark-mode .card-val { color: #F1F5F9; }
.dark-mode .card-val.red { color: #F87171; }
.dark-mode .bonus-conclusion { background: #1a2035; }
.dark-mode .conclusion-text { color: #94A3B8; }
.dark-mode .conclusion-bold { color: #F1F5F9; }
