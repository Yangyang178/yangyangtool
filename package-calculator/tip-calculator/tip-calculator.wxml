<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>
<skeleton show="{{isLoading}}" type="tool" dark="{{isDarkMode}}"></skeleton>

<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}} {{fontClass}}" scroll-y>
  <view class="container">
    <view class="tool-header">
      <view class="icon-wrapper yellow-gradient">
        <view class="icon-decoration"></view>
        <text class="tool-icon">💰</text>
      </view>
      <text class="tool-title">{{i18n.toolTitle}}</text>
      <text class="tool-desc">{{i18n.toolDesc}}</text>
    </view>

    <view class="input-section">
      <view class="section-label-row">
        <text class="section-label">{{i18n.billAmount}}</text>
        <picker mode="selector" range="{{countryList}}" range-key="country" value="{{selectedCountryIdx}}" bindchange="onCountryChange">
          <view class="country-picker">
            <text class="country-flag">{{countryList[selectedCountryIdx].flag}}</text>
            <text class="country-name">{{countryList[selectedCountryIdx].country}}</text>
            <text class="country-arrow">▼</text>
          </view>
        </picker>
      </view>
      <view class="amount-input-wrapper">
        <text class="currency-symbol">{{currencySymbol}}</text>
        <input class="amount-input" type="digit" placeholder="0.00" value="{{billAmount}}" bindinput="onBillInput"/>
      </view>
    </view>

    <view class="tip-section">
      <text class="section-label">{{i18n.tipPercent}}</text>
      <view class="tip-options">
        <view class="tip-option {{selectedTip === item.value && !isCustomTip ? 'active' : ''}}" wx:for="{{tipOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="selectTip">
          <text class="tip-value">{{item.value}}%</text>
        </view>
        <view class="tip-option {{isCustomTip ? 'active' : ''}}" bindtap="showCustomTip">
          <text class="tip-value">{{i18n.custom}}</text>
        </view>
      </view>
      <view class="custom-tip-input" wx:if="{{isCustomTip}}">
        <input class="custom-input" type="digit" placeholder="{{i18n.inputCustomPercent}}" value="{{customTipValue}}" bindinput="onCustomTipInput"/>
        <text class="percent-sign">%</text>
      </view>
      <view class="country-tip-hint" wx:if="{{countryList[selectedCountryIdx].defaultTip > 0}}">
        <text class="hint-text">{{countryList[selectedCountryIdx].flag}} {{countryList[selectedCountryIdx].country}}{{i18n.commonTipLabel}}: {{countryList[selectedCountryIdx].tipRange}}</text>
      </view>
    </view>

    <view class="round-section">
      <text class="section-label">{{i18n.roundMode}}</text>
      <view class="round-options">
        <view class="round-option {{roundMode === item.value ? 'active' : ''}}" wx:for="{{roundOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="onRoundChange">
          <text class="round-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="split-section">
      <text class="section-label">{{i18n.splitPeople}}</text>
      <view class="people-selector">
        <view class="minus-btn" bindtap="decreasePeople">−</view>
        <text class="people-count">{{peopleCount}}</text>
        <view class="plus-btn" bindtap="increasePeople">+</view>
      </view>
    </view>

    <view class="result-section" wx:if="{{billAmount > 0}}">
      <view class="result-card">
        <text class="result-title">{{i18n.perPerson}}</text>
        <text class="result-amount">{{currencySymbol}}{{totalPerPerson}}</text>
        <text class="result-subtitle" wx:if="{{peopleCount > 1}}">{{peopleCount}}{{i18n.splitCount}}</text>
      </view>

      <view class="result-details">
        <view class="detail-item">
          <text class="detail-label">{{i18n.billLabel}}</text>
          <text class="detail-value">{{currencySymbol}}{{billAmount}}</text>
        </view>
        <view class="detail-item">
          <text class="detail-label">{{i18n.tipLabel}} ({{currentTipPercent}}%)</text>
          <text class="detail-value tip-color">{{currencySymbol}}{{tipAmount}}</text>
        </view>
        <view class="detail-item" wx:if="{{roundedTotal}}">
          <text class="detail-label">{{i18n.roundedTotal}}</text>
          <text class="detail-value round-color">{{currencySymbol}}{{roundedTotal}}</text>
        </view>
        <view class="detail-item" wx:if="{{roundedTip}}">
          <text class="detail-label">{{i18n.roundedTip}}</text>
          <text class="detail-value round-color">{{currencySymbol}}{{roundedTip}}</text>
        </view>
        <view class="detail-item total-row">
          <text class="detail-label">{{i18n.total}}</text>
          <text class="detail-value total-color">{{currencySymbol}}{{totalAmount}}</text>
        </view>
      </view>
    </view>

    <view class="country-ref-section">
      <view class="section-label-row">
        <text class="section-label">{{i18n.countryRef}}</text>
        <text class="ref-toggle" bindtap="toggleCountryRef">{{showCountryRef ? i18n.collapse : i18n.expand}}</text>
      </view>

      <view class="country-ref-card" wx:if="{{!showCountryRef}}">
        <view class="country-ref-summary">
          <text class="ref-summary-flag">{{countryList[selectedCountryIdx].flag}}</text>
          <view class="ref-summary-info">
            <text class="ref-summary-country">{{countryList[selectedCountryIdx].country}}</text>
            <text class="ref-summary-range">{{i18n.commonTipLabel}}: {{countryList[selectedCountryIdx].tipRange}}</text>
          </view>
        </view>
        <text class="ref-summary-note">{{countryList[selectedCountryIdx].note}}</text>
      </view>

      <view class="country-ref-list" wx:if="{{showCountryRef}}">
        <view class="country-ref-item {{idx === selectedCountryIdx ? 'current' : ''}}" wx:for="{{countryList}}" wx:for-idx="idx" wx:for-item="c" wx:key="country" data-idx="{{idx}}" bindtap="useCountryTip">
          <view class="ref-item-left">
            <text class="ref-item-flag">{{c.flag}}</text>
            <view class="ref-item-info">
              <text class="ref-item-country">{{c.country}}</text>
              <text class="ref-item-range">{{c.tipRange}} · {{c.currency}} {{c.code}}</text>
            </view>
          </view>
          <view class="ref-item-right">
            <text class="ref-item-default" wx:if="{{c.defaultTip > 0}}">{{c.defaultTip}}%</text>
            <text class="ref-item-zero" wx:if="{{c.defaultTip === 0}}">{{i18n.noTip}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="action-buttons">
      <button class="btn-primary" bindtap="copyResult" hover-class="btn-hover">{{i18n.copyResult}}</button>
      <button class="btn-secondary" bindtap="resetData" hover-class="btn-hover">{{i18n.resetData}}</button>
    </view>
  </view>
</scroll-view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>
