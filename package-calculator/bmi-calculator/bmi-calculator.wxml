<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>
<skeleton show="{{isLoading}}" type="tool" dark="{{isDarkMode}}"></skeleton>

<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}} {{fontClass}}" scroll-y>
  <view class="container">
    <view class="tool-header">
      <view class="icon-wrapper teal-gradient">
        <view class="icon-decoration"></view>
        <text class="tool-icon">⚖️</text>
      </view>
      <text class="tool-title">{{i18n.toolTitle}}</text>
      <text class="tool-desc">{{i18n.toolDesc}}</text>
    </view>

    <view class="result-card" wx:if="{{bmi !== null}}">
      <text class="bmi-value" style="color: {{statusClass === 'status-normal' ? '#10B981' : statusClass === 'status-overweight' ? '#F59E0B' : statusClass === 'status-obese' ? '#EF4444' : '#3B82F6'}}">{{bmi}}</text>
      <text class="bmi-label">{{i18n.bmiLabel}}</text>
      <view class="bmi-status {{statusClass}}">{{i18n[status]}}</view>

      <view class="bmi-scale">
        <view class="bmi-pointer" style="left: {{pointerLeft}}"></view>
      </view>
      <view class="scale-labels">
        <text>{{i18n.thin}}</text><text>{{i18n.normal}}</text><text>{{i18n.overweight}}</text><text>{{i18n.obese}}</text>
      </view>
    </view>

    <view class="input-card">
      <text class="section-title">{{i18n.inputData}}</text>

      <view class="unit-toggle">
        <view class="unit-option {{unitType === 'metric' ? 'active' : ''}}" data-type="metric" bindtap="switchUnit">{{i18n.metricUnit}}</view>
        <view class="unit-option {{unitType === 'imperial' ? 'active' : ''}}" data-type="imperial" bindtap="switchUnit">{{i18n.imperialUnit}}</view>
      </view>

      <view class="input-row">
        <view class="input-group">
          <text class="input-label">{{heightLabel}}</text>
          <view class="input-box">
            <input class="input-field" type="digit" placeholder="--" value="{{height}}" bindinput="onHeightInput"/>
            <text class="input-unit">{{unitType === 'metric' ? 'cm' : 'in'}}</text>
          </view>
        </view>
        <view class="input-group">
          <text class="input-label">{{weightLabel}}</text>
          <view class="input-box">
            <input class="input-field" type="digit" placeholder="--" value="{{weight}}" bindinput="onWeightInput"/>
            <text class="input-unit">{{unitType === 'metric' ? 'kg' : 'lb'}}</text>
          </view>
        </view>
      </view>

      <view class="input-row">
        <view class="input-group half">
          <text class="input-label">{{i18n.age}}</text>
          <view class="input-box">
            <input class="input-field" type="number" placeholder="--" value="{{age}}" bindinput="onAgeInput"/>
            <text class="input-unit">{{i18n.yearsOld}}</text>
          </view>
        </view>
        <view class="input-group half">
          <text class="input-label">{{i18n.gender}}</text>
          <view class="gender-toggle">
            <view class="gender-btn {{gender === 'male' ? 'active' : ''}}" data-type="male" bindtap="onGenderChange">{{i18n.male}}</view>
            <view class="gender-btn {{gender === 'female' ? 'active' : ''}}" data-type="female" bindtap="onGenderChange">{{i18n.female}}</view>
          </view>
        </view>
      </view>

      <button class="btn-primary calc-btn" bindtap="calculateBMI" hover-class="btn-hover">
        {{i18n.calculateBMI}}
      </button>
    </view>

    <view class="info-card" wx:if="{{idealWeight.min}}">
      <text class="info-title">{{i18n.referenceInfo}}</text>
      <view class="info-grid">
        <view class="info-item">
          <text class="info-item-label">{{i18n.standardWeightMin}}</text>
          <text class="info-item-value">{{idealWeight.min}} kg</text>
        </view>
        <view class="info-item">
          <text class="info-item-label">{{i18n.standardWeightMax}}</text>
          <text class="info-item-value">{{idealWeight.max}} kg</text>
        </view>
      </view>
    </view>

    <view class="info-card" wx:if="{{showBodyFat}}">
      <text class="info-title">{{i18n.bodyFatEstimate}}</text>
      <view class="bodyfat-grid">
        <view class="bodyfat-main">
          <text class="bodyfat-value">{{bodyFatRate}}%</text>
          <view class="bodyfat-status {{bodyFatClass}}">{{i18n[bodyFatStatus]}}</view>
        </view>
        <view class="bodyfat-detail">
          <view class="bodyfat-detail-item">
            <text class="bodyfat-detail-label">{{i18n.leanBodyMass}}</text>
            <text class="bodyfat-detail-value">{{leanBodyMass}} kg</text>
          </view>
          <view class="bodyfat-detail-item">
            <text class="bodyfat-detail-label">{{i18n.fatWeight}}</text>
            <text class="bodyfat-detail-value">{{fatWeight}} kg</text>
          </view>
        </view>
      </view>
      <view class="bodyfat-ref">
        <text class="bodyfat-ref-title">{{bodyFatRefTitle}}</text>
        <view class="bodyfat-ref-row" wx:if="{{gender === 'male'}}">
          <text class="bodyfat-ref-label bf-low">{{i18n.lowLabel}} &lt;10%</text>
          <text class="bodyfat-ref-label bf-normal">{{i18n.normalLabel}} 10-20%</text>
          <text class="bodyfat-ref-label bf-high">{{i18n.highLabel}} 20-25%</text>
          <text class="bodyfat-ref-label bf-veryhigh">{{i18n.veryHighLabel}} &gt;25%</text>
        </view>
        <view class="bodyfat-ref-row" wx:if="{{gender === 'female'}}">
          <text class="bodyfat-ref-label bf-low">{{i18n.lowLabel}} &lt;18%</text>
          <text class="bodyfat-ref-label bf-normal">{{i18n.normalLabel}} 18-28%</text>
          <text class="bodyfat-ref-label bf-high">{{i18n.highLabel}} 28-33%</text>
          <text class="bodyfat-ref-label bf-veryhigh">{{i18n.veryHighLabel}} &gt;33%</text>
        </view>
      </view>
      <view class="bodyfat-formula-note">
        <text class="formula-note-text">{{i18n.formulaNote}}</text>
      </view>
    </view>

    <view class="info-card" wx:if="{{showAgeRef && ageGroupRef}}">
      <text class="info-title">{{i18n.ageStandardRef}}</text>
      <view class="ageref-current">
        <text class="ageref-group">{{ageGroupRef.group}}</text>
        <text class="ageref-range">{{i18n.bmiNormalRange}}: {{ageGroupRef.normalMin}} - {{ageGroupRef.normalMax}}</text>
      </view>
      <view class="ageref-table">
        <view class="ageref-header">
          <text class="ageref-col">{{i18n.ageGroup}}</text>
          <text class="ageref-col">{{i18n.normalBmiRange}}</text>
        </view>
        <view class="ageref-row {{item.label === ageGroupRef.group ? 'current' : ''}}" wx:for="{{ageGroupRef.allGroups}}" wx:key="label">
          <text class="ageref-col">{{item.label}}</text>
          <text class="ageref-col">{{gender === 'male' ? item.maleNormal[1] : item.femaleNormal[1]}}</text>
        </view>
      </view>
      <view class="ageref-note">
        <text class="ageref-note-text">{{i18n.ageRefNote}}</text>
      </view>
    </view>

    <view class="info-card" wx:if="{{bmi !== null}}">
      <view class="advice-card">
        <text class="advice-title">{{i18n.healthAdvice}}</text>
        <text class="advice-text">{{advice}}</text>
      </view>
    </view>

    <view class="info-card">
      <view class="section-title-row">
        <text class="info-title" style="margin-bottom:0">{{i18n.bmiHistory}} ({{bmiHistory.length}})</text>
        <view class="history-actions">
          <text class="history-toggle-btn" bindtap="toggleHistory">{{showHistory ? i18n.collapse : i18n.view}}</text>
          <text class="history-clear-btn" wx:if="{{bmiHistory.length > 0}}" bindtap="clearHistory">🗑️</text>
        </view>
      </view>

      <view wx:if="{{showHistory && bmiHistory.length >= 2}}">
        <canvas type="2d" id="trendCanvas" class="trend-canvas"></canvas>
      </view>

      <view class="history-list" wx:if="{{showHistory && bmiHistory.length > 0}}">
        <view class="history-item" wx:for="{{bmiHistory}}" wx:key="ts">
          <view class="history-info">
            <text class="history-bmi">{{item.bmi}}</text>
            <view class="history-status {{item.statusClass}}">{{i18n[item.statusKey]}}</view>
          </view>
          <view class="history-meta">
            <text class="history-date">{{item.date}}</text>
            <view class="history-del" catchtap="deleteHistoryItem" data-ts="{{item.ts}}">✕</view>
          </view>
        </view>
      </view>

      <view class="history-empty" wx:if="{{showHistory && bmiHistory.length === 0}}">
        <text class="history-empty-text">{{i18n.noHistory}}</text>
      </view>
    </view>

    <view class="tool-actions-bar">
      <button class="tool-action-btn tool-action-copy" bindtap="copyResult" hover-class="btn-hover">{{i18n.copyResult}}</button>
      <button class="tool-action-btn tool-action-reset" bindtap="resetData" hover-class="btn-hover">{{i18n.resetData}}</button>
    </view>

    <view class="advice-card" wx:if="{{bmi === null}}">
      <text class="advice-title">{{i18n.aboutBMI}}</text>
      <text class="advice-text">{{i18n.aboutBMIDesc}}</text>
    </view>
  </view>
</scroll-view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>
