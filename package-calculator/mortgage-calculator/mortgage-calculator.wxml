<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>
<skeleton show="{{isLoading}}" type="tool" dark="{{isDarkMode}}"></skeleton>

<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}} {{fontClass}}" scroll-y>
  <view class="container">
    <view class="tool-header">
      <view class="icon-wrapper green-gradient">
        <view class="icon-decoration"></view>
        <text class="tool-icon">🏠</text>
      </view>
      <text class="tool-title">{{i18n.toolTitle}}</text>
      <text class="tool-desc">{{i18n.toolDesc}}</text>
    </view>

    <!-- 操作引导 -->
    <view class="guide-tip" wx:if="{{showGuideTip}}">
      <view class="guide-tip-header">
        <text class="guide-tip-icon">💡</text>
        <text class="guide-tip-title">{{i18n.guideTipTitle}}</text>
        <view class="guide-tip-close" bindtap="closeGuideTip">✕</view>
      </view>
      <view class="guide-tip-steps">
        <view class="guide-step" wx:for="{{i18n.guideSteps}}" wx:key="index">
          <text class="guide-step-num">{{index + 1}}</text>
          <text class="guide-step-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 输入表单 -->
    <view class="form-section">
      <view class="input-group">
        <view class="label-row">
          <text class="label">{{i18n.loanAmount}}</text>
          <text class="unit-hint">{{i18n.unitWan}}</text>
        </view>
        <input class="input" type="digit" placeholder="{{i18n.inputLoanAmount}}" value="{{loanAmount}}" bindinput="onLoanAmountInput"/>
      </view>

      <view class="input-group">
        <text class="label">{{i18n.loanYears}}</text>
        <picker mode="selector" range="{{yearOptions}}" value="{{yearIndex}}" bindchange="onYearChange">
          <view class="picker-value">{{yearOptions[yearIndex]}}{{i18n.years}} ▼</view>
        </picker>
      </view>

      <view class="input-group">
        <text class="label">{{i18n.annualRate}}</text>
        <input class="input" type="digit" placeholder="{{i18n.ratePlaceholder}}" value="{{interestRate}}" bindinput="onRateInput"/>
        <view class="rate-tips">
          <text class="tip-item" wx:for="{{ratePresets}}" wx:key="rate" data-rate="{{item.rate}}" bindtap="usePresetRate">{{item.label}}</text>
        </view>
      </view>

      <view class="input-group">
        <text class="label">{{i18n.repaymentMethod}}</text>
        <view class="type-selector">
          <view class="type-btn {{repaymentType === 'equalPayment' ? 'active' : ''}}" data-type="equalPayment" bindtap="onTypeChange">
            <text>{{i18n.equalPayment}}</text>
            <text class="type-desc">{{i18n.equalPaymentDesc}}</text>
          </view>
          <view class="type-btn {{repaymentType === 'equalPrincipal' ? 'active' : ''}}" data-type="equalPrincipal" bindtap="onTypeChange">
            <text>{{i18n.equalPrincipal}}</text>
            <text class="type-desc">{{i18n.equalPrincipalDesc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-btns">
      <button class="btn-primary" bindtap="calculate">
        <text>{{i18n.calculate}}</text>
      </button>
      <button class="btn-secondary" bindtap="resetForm">
        <text>{{i18n.reset}}</text>
      </button>
    </view>

    <!-- 计算结果 -->
    <view class="result-section" wx:if="{{hasCalculated}}">
      <view class="result-card main-result">
        <text class="result-label">{{monthlyPaymentLabel}}</text>
        <text class="result-value">{{monthlyPayment}}</text>
        <text class="result-unit">{{i18n.yuanPerMonth}}</text>
        <text class="amount-info">{{loanSummaryText}}</text>
      </view>

      <view class="result-grid">
        <view class="result-item">
          <text class="item-label">{{i18n.interestPaid}}</text>
          <text class="item-value interest">{{totalInterest}}</text>
          <text class="item-unit">{{i18n.yuan}}</text>
        </view>
        <view class="result-item">
          <text class="item-label">{{i18n.totalRepayment}}</text>
          <text class="item-value">{{totalPayment}}</text>
          <text class="item-unit">{{i18n.yuan}}</text>
        </view>
        <view class="result-item">
          <text class="item-label">{{i18n.loanPrincipal}}</text>
          <text class="item-value">{{loanTotal}}</text>
          <text class="item-unit">{{i18n.yuan}}</text>
        </view>
        <view class="result-item">
          <text class="item-label">{{i18n.repaymentPeriod}}</text>
          <text class="item-value">{{totalMonths}}</text>
          <text class="item-unit">{{i18n.months}} ({{yearOptions[yearIndex]}}{{i18n.years}})</text>
        </view>
      </view>

      <!-- 等额本金额外信息 -->
      <view class="extra-info" wx:if="{{repaymentType === 'equalPrincipal'}}">
        <view class="info-row">
          <text class="info-label">{{i18n.firstMonthPayment}}</text>
          <text class="info-value">{{firstMonthPayment}} {{i18n.yuan}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">{{i18n.lastMonthPayment}}</text>
          <text class="info-value">{{lastMonthPayment}} {{i18n.yuan}}</text>
        </view>
        <view class="info-row highlight">
          <text class="info-label">{{i18n.monthlyDecrease}}</text>
          <text class="info-value">{{monthlyDecrease}}</text>
        </view>
      </view>

      <!-- 对比信息 -->
      <view class="compare-section">
        <text class="compare-title">{{i18n.repaymentAnalysis}}</text>
        <view class="compare-item">
          <text class="compare-text">{{i18n.loanAmountLabel}}: {{amountDisplay}} {{i18n.yuan}}</text>
        </view>
        <view class="compare-item">
          <text class="compare-text">{{i18n.interestRatio}}: {{interestRatio}}%</text>
        </view>
      </view>

      <!-- 还款对比图 -->
      <view class="chart-section">
        <view class="chart-header" bindtap="toggleChart">
          <view class="chart-header-left">
            <text class="chart-icon">📊</text>
            <text class="chart-title">{{i18n.repaymentChart}}</text>
          </view>
          <view class="chart-header-right">
            <text class="chart-arrow {{showChart ? 'expanded' : ''}}">▾</text>
          </view>
        </view>

        <view class="chart-body" wx:if="{{showChart}}">
          <view class="chart-type-tabs">
            <view class="chart-type-tab {{chartType === 'pie' ? 'active' : ''}}" data-type="pie" bindtap="switchChartType">{{i18n.pieChart}}</view>
            <view class="chart-type-tab {{chartType === 'bar' ? 'active' : ''}}" data-type="bar" bindtap="switchChartType">{{i18n.barChart}}</view>
          </view>
          <view class="chart-canvas-wrapper">
            <canvas type="2d" id="pieCanvas" class="chart-canvas" wx:if="{{chartType === 'pie'}}"></canvas>
            <canvas type="2d" id="barCanvas" class="chart-canvas" wx:if="{{chartType === 'bar'}}"></canvas>
          </view>
          <view class="chart-summary" wx:if="{{compareData}}">
            <view class="summary-row">
              <text class="summary-label">{{i18n.equalPaymentTotal}}</text>
              <text class="summary-value">{{compareData.ep.interestRatio}}%{{i18n.isInterest}}</text>
            </view>
            <view class="summary-row">
              <text class="summary-label">{{i18n.equalPrincipalTotal}}</text>
              <text class="summary-value">{{compareData.epr.interestRatio}}%{{i18n.isInterest}}</text>
            </view>
            <view class="summary-row highlight">
              <text class="summary-label">{{i18n.equalPrincipalSave}}</text>
              <text class="summary-value saved">{{compareData.savedInterest > 0 ? compareData.savedInterest.toFixed(2) : '0.00'}} {{i18n.yuan}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="tool-actions-bar">
      <view class="tool-action-btn tool-action-copy" bindtap="copyResult" hover-class="btn-hover">{{i18n.copyResult}}</view>
    </view>

    <!-- 使用说明 -->
    <view class="tips-section">
      <text class="tips-title">{{i18n.calculationNote}}</text>
      <view class="tips-list">
        <text class="tip-item">• {{i18n.equalPaymentNote}}</text>
        <text class="tip-item">• {{i18n.equalPrincipalNote}}</text>
        <text class="tip-item">• {{i18n.loanAmountNote}}</text>
        <text class="tip-item">• {{i18n.lprNote}}</text>
      </view>
    </view>
  </view>
</scroll-view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>
