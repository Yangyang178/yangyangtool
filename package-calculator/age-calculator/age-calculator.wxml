<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>

<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}}" scroll-y>
  <view class="container">
    <view class="tool-header">
      <view class="icon-wrapper">
        <view class="icon-decoration"></view>
        <text class="tool-icon">👶</text>
      </view>
      <text class="tool-title">{{i18n.toolTitle}}</text>
      <text class="tool-desc">{{i18n.toolDesc}}</text>
    </view>

    <view class="input-section">
      <view class="input-card">
        <view class="input-group">
          <text class="input-label">{{i18n.selectBirthDate}}</text>
          <picker mode="date" value="{{birthDate}}" end="{{today}}" bindchange="onBirthDateChange">
            <view class="date-picker-box">
              <text>{{birthDate || i18n.selectBirthDatePlaceholder}}</text>
              <text class="picker-icon">📅</text>
            </view>
          </picker>
        </view>

        <view class="quick-birthdays">
          <text class="quick-label">{{i18n.quickSelect}}</text>
          <view class="quick-btn" bindtap="setTodayBirthday">{{i18n.todayBirthday}}</view>
          <view class="quick-btn" bindtap="setYesterdayBirthday">{{i18n.yesterdayBirthday}}</view>
          <view class="quick-btn" bindtap="setWeekAgo">{{i18n.weekAgo}}</view>
          <view class="quick-btn" bindtap="setMonthAgo">{{i18n.monthAgo}}</view>
          <view class="quick-btn" bindtap="setYearAgo">{{i18n.yearAgo}}</view>
        </view>

        <view class="calculate-btn" bindtap="calculateAge">
          <text>{{i18n.calculateAge}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{showResult}}" class="result-section">
      <view class="age-display-card">
        <view class="age-header">
          <text class="zodiac-emoji">{{zodiacEmoji}}</text>
          <view class="zodiac-info">
            <text class="zodiac-name">{{zodiacName}}</text>
            <text class="constellation-name">{{constellationName}}</text>
          </view>
        </view>
        
        <view class="age-main">
          <view class="age-number">
            <text class="age-value">{{ageYears}}</text>
            <text class="age-unit">{{i18n.yearsOld}}</text>
          </view>
          <view class="age-detail">
            <text class="detail-text">{{ageMonths}}{{i18n.monthsDays}} {{ageDays}}{{i18n.days}}</text>
          </view>
        </view>

        <view class="next-birthday-info">
          <view class="birthday-countdown">
            <text class="countdown-label">{{i18n.nextBirthday}}</text>
            <text class="countdown-days">{{nextBirthdayDays}}</text>
            <text class="countdown-unit">{{i18n.days}}</text>
          </view>
          <text class="next-birthday-date">{{nextBirthdayDate}}</text>
        </view>
      </view>

      <view class="life-progress-section">
        <view class="life-progress-header">
          <text class="life-progress-title">{{i18n.lifeProgress}}</text>
          <view class="life-expectancy-row">
            <text class="life-expectancy-label">{{i18n.lifeExpectancy}}</text>
            <text class="life-expectancy-value">{{lifeExpectancy}}{{i18n.yearsOld}}</text>
          </view>
        </view>
        <view class="life-progress-bar">
          <view class="life-progress-track">
            <view class="life-progress-fill" style="width: {{lifeProgress}}%;"></view>
            <view class="life-progress-marker" style="left: {{lifeProgress}}%;">
              <view class="marker-dot"></view>
            </view>
          </view>
          <view class="life-progress-labels">
            <text class="progress-born">{{i18n.born}}</text>
            <text class="progress-now">{{i18n.now}} {{livedPercent}}%</text>
            <text class="progress-end">{{lifeExpectancy}}{{i18n.yearsOld}}</text>
          </view>
        </view>
        <view class="life-progress-stats">
          <view class="life-stat">
            <text class="life-stat-value">{{livedPercent}}%</text>
            <text class="life-stat-label">{{i18n.lived}}</text>
          </view>
          <view class="life-stat-divider"></view>
          <view class="life-stat">
            <text class="life-stat-value">{{remainYears}}</text>
            <text class="life-stat-label">{{i18n.remainYears}}</text>
          </view>
          <view class="life-stat-divider"></view>
          <view class="life-stat">
            <text class="life-stat-value">{{lifeProgressLabel}}</text>
            <text class="life-stat-label">{{i18n.lifeProgressLabel}}</text>
          </view>
        </view>
        <slider min="50" max="120" value="{{lifeExpectancy}}" activeColor="var(--accentPink,#EC4899)" block-size="18" bindchange="onLifeExpectancyChange" />
      </view>

      <view class="life-stats-grid">
        <view class="stat-card">
          <text class="stat-icon">📅</text>
          <text class="stat-value">{{totalDays}}</text>
          <text class="stat-label">{{i18n.totalDays}}</text>
        </view>
        <view class="stat-card">
          <text class="stat-icon">⏰</text>
          <text class="stat-value">{{totalHours}}</text>
          <text class="stat-label">{{i18n.totalHours}}</text>
        </view>
        <view class="stat-card">
          <text class="stat-icon">⏱️</text>
          <text class="stat-value">{{totalMinutes}}</text>
          <text class="stat-label">{{i18n.totalMinutes}}</text>
        </view>
        <view class="stat-card">
          <text class="stat-icon">💓</text>
          <text class="stat-value">{{heartbeats}}</text>
          <text class="stat-label">{{i18n.heartbeats}}</text>
        </view>
        <view class="stat-card">
          <text class="stat-icon">😮‍💨</text>
          <text class="stat-value">{{breaths}}</text>
          <text class="stat-label">{{i18n.breaths}}</text>
        </view>
        <view class="stat-card">
          <text class="stat-icon">🌙</text>
          <text class="stat-value">{{sleepNights}}</text>
          <text class="stat-label">{{i18n.sleepNights}}</text>
        </view>
      </view>

      <view class="date-calc-section">
        <view class="date-calc-header" bindtap="toggleDateCalc">
          <text class="date-calc-title">{{i18n.dateCalc}}</text>
          <text class="date-calc-toggle {{showDateCalc ? 'active' : ''}}">{{showDateCalc ? i18n.collapse : i18n.expand}}</text>
        </view>
        <view class="date-calc-body" wx:if="{{showDateCalc}}">
          <view class="date-calc-inputs">
            <view class="date-calc-input">
              <text class="date-calc-label">{{i18n.startDate}}</text>
              <picker mode="date" value="{{dateCalcStart}}" bindchange="onDateCalcStartChange">
                <view class="date-calc-picker">{{dateCalcStart}}</view>
              </picker>
            </view>
            <text class="date-calc-arrow">→</text>
            <view class="date-calc-input">
              <text class="date-calc-label">{{i18n.endDate}}</text>
              <picker mode="date" value="{{dateCalcEnd}}" bindchange="onDateCalcEndChange">
                <view class="date-calc-picker">{{dateCalcEnd}}</view>
              </picker>
            </view>
          </view>
          <view class="date-calc-btn" bindtap="calculateDateDiff">
            <text>{{i18n.calcInterval}}</text>
          </view>
          <view class="date-calc-result" wx:if="{{dateCalcResult}}">
            <view class="calc-result-main">
              <text class="calc-result-value">{{dateCalcResult.diffDays}}</text>
              <text class="calc-result-unit">{{i18n.days}}</text>
            </view>
            <view class="calc-result-detail">
              <text class="calc-detail-item">≈ {{dateCalcResult.diffWeeks}} {{i18n.weeks}}</text>
              <text class="calc-detail-item">= {{dateCalcResult.detailYears}}{{i18n.yearsOld}} {{dateCalcResult.detailMonths}}{{i18n.monthsDays}} {{dateCalcResult.detailDays}}{{i18n.days}}</text>
              <text class="calc-detail-item">{{dateCalcResult.totalMonths}} {{i18n.totalMonths}}</text>
              <text class="calc-detail-item">{{dateCalcResult.diffHours}} {{i18n.hours}}</text>
              <text class="calc-detail-item">{{dateCalcResult.diffMinutes}} {{i18n.minutes}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="milestone-section">
        <text class="milestone-title">{{i18n.milestones}}</text>
        <view class="milestone-list">
          <view 
            class="milestone-item {{item.passed ? 'passed' : 'future'}}"
            wx:for="{{milestones}}"
            wx:key="name"
          >
            <view class="milestone-status">
              <text>{{item.passed ? '✅' : '⏳'}}</text>
            </view>
            <view class="milestone-content">
              <text class="milestone-age">{{item.age}}</text>
              <text class="milestone-name">{{item.name}}</text>
            </view>
            <text class="milestone-date">{{item.date}}</text>
          </view>
        </view>
      </view>

      <view class="action-buttons">
        <view class="action-btn copy" bindtap="copyResult">
          <text>{{i18n.copyResult}}</text>
        </view>
        <view class="action-btn share" bindtap="shareResult">
          <text>{{i18n.share}}</text>
        </view>
      </view>

      <view class="tool-actions-bar">
        <button class="tool-action-btn tool-action-reset" bindtap="resetData" hover-class="btn-hover">{{i18n.resetData}}</button>
      </view>
    </view>

    <view wx:if="{{historyList.length > 0}}" class="history-section">
      <view class="section-header">
        <text class="section-title">{{i18n.calcHistory}}</text>
        <text class="clear-history" bindtap="clearHistory">{{i18n.clearHistory}}</text>
      </view>
      <view class="history-list">
        <view 
          class="history-item"
          wx:for="{{historyList}}"
          wx:key="time"
        >
          <text class="history-birth">{{item.birthDate}}</text>
          <text class="history-age">{{item.ageText}}</text>
          <text class="history-time">{{item.timeText}}</text>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>
