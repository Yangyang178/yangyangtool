<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>
<skeleton show="{{isLoading}}" type="tool" dark="{{isDarkMode}}"></skeleton>

<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}} {{fontClass}}" scroll-y>
  <view class="container">
    <view class="tool-header">
      <view class="icon-wrapper blue-gradient">
        <view class="icon-decoration"></view>
        <text class="tool-icon">💱</text>
      </view>
      <text class="tool-title">{{i18n.toolTitle}}</text>
      <text class="tool-desc">{{i18n.toolDesc}}</text>
      <view class="rate-source-tag {{rateSource === 'demo' ? 'demo' : rateSource === 'cache' ? 'cache' : 'real'}}" bindtap="refreshRates">
        <text class="source-icon">{{rateSource === 'demo' ? '⚠️' : rateSource === 'cache' ? '💾' : '🌐'}}</text>
        <text class="source-text">{{lastUpdateText}}</text>
        <text class="refresh-hint">{{isRefreshing ? i18n.fetching : i18n.tapRefresh}}</text>
      </view>
    </view>

    <view wx:if="{{isOffline}}" class="offline-banner">
      <text class="offline-icon">📡</text>
      <text class="offline-text">{{i18n.offline}}</text>
      <text class="offline-hint" wx:if="{{cacheAge}}">{{cacheAge}}{{i18n.updated}}</text>
    </view>

    <view wx:if="{{cacheExpired && !isOffline}}" class="cache-warn-banner">
      <text class="warn-icon">⚠️</text>
      <text class="warn-text">{{i18n.cacheMayNotLatest}}（{{cacheAge}}）</text>
      <view class="warn-refresh" bindtap="refreshRates">
        <text>{{i18n.refresh}}</text>
      </view>
    </view>

    <view class="input-section">
      <view class="input-group">
        <text class="input-label">{{i18n.convertAmount}}</text>
        <view class="amount-input-wrapper">
          <text class="currency-symbol">{{fromSymbol}}</text>
          <input
            class="amount-input"
            type="digit"
            placeholder="{{i18n.inputAmount}}"
            value="{{amount}}"
            bindinput="onAmountInput"
          />
        </view>
      </view>
    </view>

    <view class="currency-section">
      <view class="currency-selector">
        <view class="selector-box" bindtap="showFromCurrency">
          <text class="currency-code">{{fromCurrency}}</text>
          <text class="currency-name">{{fromCurrencyName}}</text>
        </view>

        <view class="swap-btn" bindtap="swapCurrency">
          <text class="swap-icon">⇄</text>
        </view>

        <view class="selector-box" bindtap="showToCurrency">
          <text class="currency-code">{{toCurrency}}</text>
          <text class="currency-name">{{toCurrencyName}}</text>
        </view>
      </view>
    </view>

    <view class="result-section">
      <view class="result-card">
        <text class="result-amount">{{resultAmount}}</text>
        <text class="result-label">= {{toCurrency}} {{toCurrencyName}}</text>
        <text class="rate-info">{{i18n.rateInfo}}: 1 {{fromCurrency}} = {{exchangeRate}} {{toCurrency}}</text>
      </view>

      <view class="quick-rates">
        <text class="section-title">{{i18n.commonRates}}</text>
        <view class="rate-list">
          <view class="rate-item" wx:for="{{quickRates}}" wx:key="code" bindtap="selectQuickRate" data-currency="{{item.code}}">
            <view class="rate-item-accent"></view>
            <view class="rate-item-body">
              <view class="rate-header">
                <text class="rate-flag">{{item.flag}}</text>
                <text class="rate-code">{{item.code}}</text>
              </view>
              <text class="rate-name">{{item.name}}</text>
            </view>
            <view class="rate-value-wrap">
              <text class="rate-value">{{item.rate}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="action-btns">
      <button class="btn-primary" bindtap="copyResult">
        <text>{{i18n.copyResult}}</text>
      </button>
      <button class="btn-secondary" bindtap="resetCalculator">
        <text>{{i18n.recalculate}}</text>
      </button>
    </view>

    <view class="trend-section">
      <view class="trend-header" bindtap="toggleTrendChart">
        <view class="trend-header-left">
          <text class="trend-icon">📈</text>
          <text class="trend-title">{{i18n.rateTrend}}</text>
          <text class="trend-pair">{{fromCurrency}}/{{toCurrency}}</text>
        </view>
        <view class="trend-header-right">
          <text class="trend-change {{trendChangeDir}}" wx:if="{{trendChange}}">{{trendChangeDir === 'up' ? '↑' : trendChangeDir === 'down' ? '↓' : '→'}} {{trendChange}}</text>
          <text class="trend-arrow {{showTrendChart ? 'expanded' : ''}}">▾</text>
        </view>
      </view>

      <view class="trend-body" wx:if="{{showTrendChart}}">
        <view class="trend-period-tabs">
          <view class="trend-period-tab {{trendPeriod === '7d' ? 'active' : ''}}" data-period="7d" bindtap="switchTrendPeriod">{{i18n.last7days}}</view>
          <view class="trend-period-tab {{trendPeriod === '30d' ? 'active' : ''}}" data-period="30d" bindtap="switchTrendPeriod">{{i18n.last30days}}</view>
        </view>
        <view class="trend-canvas-wrapper">
          <canvas type="2d" id="trendCanvas" class="trend-canvas"></canvas>
        </view>
        <view class="trend-hint" wx:if="{{trendData.length < 2}}">
          <text>{{i18n.trendHint}}</text>
        </view>
      </view>
    </view>

    <view class="currency-picker-mask" wx:if="{{showCurrencyPicker}}" bindtap="hideCurrencyPicker"></view>
    <view class="currency-picker-popup {{showCurrencyPicker ? 'show' : ''}}">
      <view class="picker-header">
        <text class="picker-title">{{pickerTitleText}}</text>
        <view class="picker-close" bindtap="hideCurrencyPicker">
          <text>✕</text>
        </view>
      </view>
      <scroll-view scroll-y class="picker-list">
        <view wx:for="{{currencyGroups}}" wx:key="name" class="picker-group">
          <text class="picker-group-title">{{item.name}}</text>
          <view
            class="picker-item {{ci.code === (pickerType === 'from' ? fromCurrency : toCurrency) ? 'selected' : ''}}"
            wx:for="{{item.list}}"
            wx:for-item="ci"
            wx:key="code"
            data-code="{{ci.code}}"
            bindtap="selectCurrency"
          >
            <text class="picker-flag">{{ci.flag}}</text>
            <view class="picker-info">
              <text class="picker-name">{{ci.name}}</text>
              <text class="picker-code-text">{{ci.code}}</text>
            </view>
            <text class="picker-symbol-text">{{ci.symbol}}</text>
            <text class="picker-check" wx:if="{{ci.code === (pickerType === 'from' ? fromCurrency : toCurrency)}}">✓</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</scroll-view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>
