<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>
<skeleton show="{{isLoading}}" type="tool" dark="{{isDarkMode}}"></skeleton>

<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}} {{fontClass}}" scroll-y>
  <view class="container">
    <view class="tool-header">
      <view class="icon-wrapper" style="background: linear-gradient(135deg, #64748B33 0%, #64748B66 100%);">
        <view class="icon-decoration"></view>
        <text class="tool-icon">{}</text>
      </view>
      <text class="tool-title">{{i18n.toolTitle}}</text>
      <text class="tool-desc">{{i18n.toolDesc}}</text>
    </view>

    <view class="input-section">
      <view class="section-label">
        <text class="label-text">📝 {{i18n.inputJson}}</text>
        <view class="input-actions">
          <view class="action-tag paste" bindtap="pasteFromClipboard">
            <text>📋 {{i18n.paste}}</text>
          </view>
          <view class="action-tag sample" bindtap="loadSample">
            <text>📄 {{i18n.sample}}</text>
          </view>
          <view class="action-tag clear" bindtap="clearInput">
            <text>🗑️ {{i18n.clear}}</text>
          </view>
        </view>
      </view>

      <textarea 
        class="json-input"
        placeholder="{{i18n.inputPlaceholder}}"
        value="{{inputJson}}"
        bindinput="onInputChange"
        auto-height
        maxlength="-1"
      ></textarea>

      <view wx:if="{{errorMsg}}" class="error-banner">
        <text class="error-icon">❌</text>
        <text class="error-msg">{{errorMsg}}</text>
      </view>

      <view wx:if="{{!errorMsg && inputJson}}" class="success-banner">
        <text class="success-icon">✅</text>
        <text class="success-msg">{{i18n.jsonCorrect}} ({{jsonSize}} {{i18n.chars}})</text>
      </view>
    </view>

    <view class="button-group">
      <view class="main-btn format" bindtap="formatJson">
        <text>🎨 {{i18n.format}}</text>
      </view>
      <view class="main-btn compress" bindtap="compressJson">
        <text>🗜️ {{i18n.compress}}</text>
      </view>
      <view class="main-btn validate" bindtap="validateJson">
        <text>✅ {{i18n.validate}}</text>
      </view>
    </view>

    <view wx:if="{{outputJson}}" class="output-section">
      <view class="section-label">
        <text class="label-text">📤 {{i18n.outputResult}}</text>
        <view class="output-actions">
          <view class="action-tag copy" bindtap="copyOutput">
            <text>📋 {{i18n.copy}}</text>
          </view>
        </view>
      </view>

      <view class="output-container">
        <scroll-view class="json-output-scroll" scroll-x scroll-y>
          <text class="json-output">{{outputJson}}</text>
        </scroll-view>
      </view>

      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-value">{{outputStats.chars}}</text>
          <text class="stat-label">{{i18n.charCount}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{outputStats.lines}}</text>
          <text class="stat-label">{{i18n.lineCount}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{outputStats.size}}</text>
          <text class="stat-label">{{i18n.size}}</text>
        </view>
      </view>
    </view>

    <view class="tool-actions-bar">
      <button class="tool-action-btn tool-action-reset" bindtap="resetData" hover-class="btn-hover">🔄 {{i18n.reset}}</button>
    </view>

    <view class="features-section">
      <text class="features-title">✨ {{i18n.features}}</text>
      <view class="features-grid">
        <view class="feature-card">
          <text class="feature-icon">🎨</text>
          <text class="feature-name">{{i18n.smartIndent}}</text>
          <text class="feature-desc">{{i18n.smartIndentDesc}}</text>
        </view>
        <view class="feature-card">
          <text class="feature-icon">🗜️</text>
          <text class="feature-name">{{i18n.oneClickCompress}}</text>
          <text class="feature-desc">{{i18n.oneClickCompressDesc}}</text>
        </view>
        <view class="feature-card">
          <text class="feature-icon">🔍</text>
          <text class="feature-name">{{i18n.errorLocate}}</text>
          <text class="feature-desc">{{i18n.errorLocateDesc}}</text>
        </view>
        <view class="feature-card">
          <text class="feature-icon">📊</text>
          <text class="feature-name">{{i18n.statistics}}</text>
          <text class="feature-desc">{{i18n.statisticsDesc}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{historyList.length > 0}}" class="history-section">
      <view class="section-header">
        <text class="section-title">{{i18n.history}}</text>
        <text class="clear-history" bindtap="clearHistory">{{i18n.clearHistory}}</text>
      </view>
      <view class="history-list">
        <view 
          class="history-item"
          wx:for="{{historyList}}"
          wx:key="time"
          bindtap="loadHistoryItem"
          data-index="{{index}}"
        >
          <text class="history-preview">{{item.preview}}</text>
          <text class="history-time">{{item.timeText}}</text>
          <text class="history-type {{item.type}}">{{item.typeText}}</text>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>