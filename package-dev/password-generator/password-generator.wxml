<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>

<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}}" scroll-y>
  <view class="container">
    <view class="tool-header">
      <view class="icon-wrapper">
        <view class="icon-decoration"></view>
        <text class="tool-icon">🔐</text>
      </view>
      <text class="tool-title">{{i18n.toolTitle}}</text>
      <text class="tool-desc">{{i18n.toolDesc}}</text>
    </view>

    <view class="mode-tabs">
      <view 
        wx:for="{{modes}}" wx:key="id"
        class="mode-tab {{generateMode === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="switchMode"
      >
        <text>{{item.icon}} {{item.name}}</text>
      </view>
    </view>

    <view class="result-card">
      <view class="password-display">{{password}}</view>
      
      <view class="strength-visual">
        <view class="strength-segments">
          <view class="strength-seg {{strengthPercent >= 25 ? 'seg-' + strengthLevel : ''}}"></view>
          <view class="strength-seg {{strengthPercent >= 50 ? 'seg-' + strengthLevel : ''}}"></view>
          <view class="strength-seg {{strengthPercent >= 75 ? 'seg-' + strengthLevel : ''}}"></view>
          <view class="strength-seg {{strengthPercent >= 100 ? 'seg-' + strengthLevel : ''}}"></view>
        </view>
        <view class="strength-info">
          <text class="strength-label {{strengthLevel}}">{{strengthText}}</text>
          <text class="strength-detail">{{strengthPercent}}% · {{password.length}}{{i18n.bits}}</text>
        </view>
      </view>

      <view class="action-row">
        <button class="copy-btn" bindtap="copyPassword" hover-class="btn-hover">
          <text class="btn-icon">📋</text>{{i18n.copy}}
        </button>
        <button class="refresh-btn" bindtap="refreshPassword" hover-class="btn-hover">
          <text class="btn-icon">🔄</text>{{i18n.refresh}}
        </button>
      </view>
    </view>

    <view class="tool-actions-bar">
      <button class="tool-action-btn tool-action-reset" bindtap="resetData" hover-class="btn-hover">🔄 {{i18n.reset}}</button>
    </view>

    <view class="settings-card" wx:if="{{generateMode === 'random'}}">
      <text class="section-title">{{i18n.passwordLength}}</text>
      <view class="length-section">
        <view class="length-header">
          <text class="length-label">{{i18n.length}}</text>
          <text class="length-value">{{length}} {{i18n.bits}}</text>
        </view>
        <view class="slider-container">
          <slider class="length-slider" min="6" max="32" value="{{length}}" step="1"
            show-value="{{false}}" block-size="16" activeColor="#8B5CF6"
            backgroundColor="#E2E8F0" bindchange="onLengthChange"/>
        </view>
        <view class="length-presets">
          <view class="length-preset {{length === 8 ? 'active' : ''}}" data-len="8" bindtap="selectLength">8</view>
          <view class="length-preset {{length === 12 ? 'active' : ''}}" data-len="12" bindtap="selectLength">12</view>
          <view class="length-preset {{length === 16 ? 'active' : ''}}" data-len="16" bindtap="selectLength">16</view>
          <view class="length-preset {{length === 24 ? 'active' : ''}}" data-len="24" bindtap="selectLength">24</view>
          <view class="length-preset {{length === 32 ? 'active' : ''}}" data-len="32" bindtap="selectLength">32</view>
        </view>
      </view>

      <text class="section-title">{{i18n.charTypes}}</text>
      <view class="options-grid">
        <view class="option-item {{options.uppercase ? 'active' : ''}}" data-key="uppercase" bindtap="toggleOption">
          <view class="option-left">
            <text class="option-icon">🔤</text>
            <view>
              <text class="option-name">{{i18n.uppercase}}</text>
              <text class="option-desc">A B C ... Z</text>
            </view>
          </view>
          <view class="toggle-switch {{options.uppercase ? 'active' : ''}}">
            <view class="toggle-knob"></view>
          </view>
        </view>

        <view class="option-item {{options.lowercase ? 'active' : ''}}" data-key="lowercase" bindtap="toggleOption">
          <view class="option-left">
            <text class="option-icon">🔡</text>
            <view>
              <text class="option-name">{{i18n.lowercase}}</text>
              <text class="option-desc">a b c ... z</text>
            </view>
          </view>
          <view class="toggle-switch {{options.lowercase ? 'active' : ''}}">
            <view class="toggle-knob"></view>
          </view>
        </view>

        <view class="option-item {{options.numbers ? 'active' : ''}}" data-key="numbers" bindtap="toggleOption">
          <view class="option-left">
            <text class="option-icon">🔢</text>
            <view>
              <text class="option-name">{{i18n.numbers}}</text>
              <text class="option-desc">0 1 2 ... 9</text>
            </view>
          </view>
          <view class="toggle-switch {{options.numbers ? 'active' : ''}}">
            <view class="toggle-knob"></view>
          </view>
        </view>

        <view class="option-item {{options.symbols ? 'active' : ''}}" data-key="symbols" bindtap="toggleOption">
          <view class="option-left">
            <text class="option-icon">★</text>
            <view>
              <text class="option-name">{{i18n.symbols}}</text>
              <text class="option-desc">! @ # $ % ^ & *</text>
            </view>
          </view>
          <view class="toggle-switch {{options.symbols ? 'active' : ''}}">
            <view class="toggle-knob"></view>
          </view>
        </view>

        <view class="option-item option-full {{options.excludeConfused ? 'active' : ''}}" data-key="excludeConfused" bindtap="toggleOption">
          <view class="option-left">
            <text class="option-icon">🚫</text>
            <view>
              <text class="option-name">{{i18n.excludeConfused}}</text>
              <text class="option-desc">{{i18n.excludeConfusedDesc}}</text>
            </view>
          </view>
          <view class="toggle-switch {{options.excludeConfused ? 'active' : ''}}">
            <view class="toggle-knob"></view>
          </view>
        </view>
      </view>

      <button class="generate-btn" bindtap="generatePassword" hover-class="btn-hover">
        <text class="btn-icon-lg">🎲</text>{{i18n.generateNew}}
      </button>

      <view class="batch-section">
        <view class="batch-header" bindtap="toggleBatch">
          <text class="batch-title">📦 {{i18n.batchGenerate}}</text>
          <text class="batch-arrow {{showBatch ? 'expanded' : ''}}">▾</text>
        </view>
        <view class="batch-body" wx:if="{{showBatch}}">
          <view class="batch-count-row">
            <text class="batch-count-label">{{i18n.quantity}}</text>
            <view class="batch-count-btns">
              <view 
                wx:for="{{batchCounts}}" wx:key="*this"
                class="batch-count-btn {{batchCount === item ? 'active' : ''}}"
                data-count="{{item}}"
                bindtap="selectBatchCount"
              >{{item}}</view>
            </view>
          </view>
          <view class="batch-list" wx:if="{{batchPasswords.length > 0}}">
            <view class="batch-item" wx:for="{{batchPasswords}}" wx:key="index">
              <text class="batch-pwd">{{item}}</text>
              <view class="batch-copy-btn" data-index="{{index}}" bindtap="copyBatchOne">{{i18n.batchCopyOne}}</view>
            </view>
          </view>
          <view class="batch-actions">
            <view class="batch-regen-btn" bindtap="generateBatch">🔄 {{i18n.regenerate}}</view>
            <view class="batch-copyall-btn" bindtap="copyBatchAll">📋 {{i18n.copyAll}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="settings-card" wx:if="{{generateMode === 'readable'}}">
      <text class="section-title">📖 {{i18n.readablePassword}}</text>
      <text class="section-desc">{{i18n.readableDesc}}</text>
      <text class="section-desc" style="margin-top:8px;">{{i18n.readableExample}}</text>
      <button class="generate-btn" bindtap="generatePassword" hover-class="btn-hover" style="margin-top:16px;">
        <text class="btn-icon-lg">🔄</text>{{i18n.refresh}}
      </button>
    </view>

    <view class="settings-card" wx:if="{{generateMode === 'pin'}}">
      <text class="section-title">🔢 {{i18n.pinLength}}</text>
      <view class="pin-length-row">
        <view 
          wx:for="{{pinLengths}}" wx:key="*this"
          class="pin-length-btn {{pinLength === item ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="onPinLengthChange"
        >{{item}}{{i18n.bits}}</view>
      </view>
      <button class="generate-btn" bindtap="generatePassword" hover-class="btn-hover" style="margin-top:16px;">
        <text class="btn-icon-lg">🔄</text>{{i18n.refresh}}
      </button>
    </view>

    <view class="check-section">
      <text class="section-title">🔍 {{i18n.strengthCheck}}</text>
      <view class="check-input-card">
        <input 
          class="check-input"
          type="text"
          placeholder="{{i18n.checkPasswordPlaceholder}}"
          value="{{checkPassword}}"
          bindinput="onCheckInput"
        />
      </view>

      <view class="check-result" wx:if="{{checkResult}}">
        <view class="check-score-row">
          <text class="check-score-label">{{i18n.strengthScore}}</text>
          <text class="check-score-value" style="color: {{checkResult.levelColor}};">{{checkScore}}{{i18n.scoreUnit}} · {{checkResult.levelText}}</text>
        </view>
        <view class="check-score-bar">
          <view class="check-score-fill" style="width: {{checkScore}}%; background: {{checkResult.levelColor}};"></view>
        </view>
        <view class="check-details">
          <view wx:for="{{checkDetails}}" wx:key="text" class="check-detail-item">
            <text class="check-detail-icon">{{item.pass ? '✅' : '❌'}}</text>
            <text class="check-detail-text">{{item.text}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="tips-section">
      <text class="tips-title">💡 {{i18n.securityTips}}</text>
      <view class="tips-list">
        <text class="tip-item">• {{i18n.tip1}}</text>
        <text class="tip-item">• {{i18n.tip2}}</text>
        <text class="tip-item">• {{i18n.tip3}}</text>
      </view>
    </view>
  </view>
</scroll-view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>
