<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>

<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}}" scroll-y>
  <view class="container">
    <view class="tool-header">
      <view class="icon-wrapper" style="background: linear-gradient(135deg, #F472B633 0%, #F472B666 100%);">
        <view class="icon-decoration"></view>
        <text class="tool-icon">🎨</text>
      </view>
      <text class="tool-title">{{i18n.toolTitle}}</text>
      <text class="tool-desc">{{i18n.toolDesc}}</text>
    </view>

    <!-- 颜色预览区域 -->
    <view class="color-preview-section">
      <view class="color-preview-large" style="background-color: {{currentColor}};" bindtap="showColorPicker">
        <text class="preview-hex">{{hexValue}}</text>
        <view class="pick-hint">{{i18n.tapToPick}}</view>
      </view>
      
      <view class="color-info-row">
        <view class="color-sample-item" style="background: {{currentColor}};" bindtap="copyColor">
          <text class="sample-label">{{i18n.tapToCopy}}</text>
        </view>
        <view class="color-text-info">
          <text class="color-name-text">{{colorName}}</text>
          <text class="contrast-text">{{i18n.contrast}}: {{contrastRatio}}</text>
        </view>
        <view class="fav-btn" bindtap="addFavorite">
          <text class="fav-icon">❤️</text>
          <text class="fav-text">{{i18n.favorite}}</text>
        </view>
      </view>
    </view>

    <!-- HEX 输入 -->
    <view class="input-card">
      <view class="input-header">
        <text class="input-label">🎯 {{i18n.hexColor}}</text>
        <view class="format-badge hex">#RRGGBB</view>
      </view>
      <view class="input-row">
        <text class="input-prefix">#</text>
        <input 
          class="color-input"
          placeholder="FF5733"
          value="{{hexInput}}"
          bindinput="onHexInput"
          maxlength="6"
          type="text"
        />
      </view>
      <view class="quick-colors">
        <view 
          class="quick-color-dot" 
          wx:for="{{presetColors}}" 
          wx:key="value"
          style="background: {{item.value}};"
          data-value="{{item.value}}"
          bindtap="selectPresetColor"
        ></view>
      </view>
    </view>

    <!-- RGB 输入 -->
    <view class="input-card">
      <view class="input-header">
        <text class="input-label">🔴 {{i18n.rgbColor}}</text>
        <view class="format-badge rgb">R,G,B (0-255)</view>
      </view>
      <view class="rgb-inputs">
        <view class="rgb-input-group">
          <text class="rgb-label">R</text>
          <input 
            class="rgb-input red"
            type="number"
            placeholder="255"
            value="{{rValue}}"
            bindinput="onRInput"
            maxlength="3"
          />
        </view>
        <view class="rgb-input-group">
          <text class="rgb-label green-text">G</text>
          <input 
            class="rgb-input green"
            type="number"
            placeholder="128"
            value="{{gValue}}"
            bindinput="onGInput"
            maxlength="3"
          />
        </view>
        <view class="rgb-input-group">
          <text class="rgb-label blue-text">B</text>
          <input 
            class="rgb-input blue"
            type="number"
            placeholder="0"
            value="{{bValue}}"
            bindinput="onBInput"
            maxlength="3"
          />
        </view>
      </view>
    </view>

    <!-- HSL 输入 -->
    <view class="input-card">
      <view class="input-header">
        <text class="input-label">🌈 {{i18n.hslColor}}</text>
        <view class="format-badge hsl">H,S,L (0-360, 0-100%)</view>
      </view>
      <view class="hsl-inputs">
        <view class="hsl-input-group">
          <text class="hsl-label h-text">H</text>
          <input 
            class="hsl-input h-input"
            type="digit"
            placeholder="0"
            value="{{hValue}}"
            bindinput="onHInput"
            maxlength="3"
          />
          <text class="hsl-unit">°</text>
        </view>
        <view class="hsl-input-group">
          <text class="hsl-label s-text">S</text>
          <input 
            class="hsl-input s-input"
            type="digit"
            placeholder="100"
            value="{{sValue}}"
            bindinput="onSInput"
            maxlength="3"
          />
          <text class="hsl-unit">%</text>
        </view>
        <view class="hsl-input-group">
          <text class="hsl-label l-text">L</text>
          <input 
            class="hsl-input l-input"
            type="digit"
            placeholder="50"
            value="{{lValue}}"
            bindinput="onLInput"
            maxlength="3"
          />
          <text class="hsl-unit">%</text>
        </view>
      </view>
    </view>

    <!-- 转换结果 -->
    <view class="result-section">
      <text class="result-title">📋 {{i18n.allFormats}}</text>
      
      <view class="result-grid">
        <view class="result-item" bindtap="copyHex">
          <text class="result-format">HEX</text>
          <text class="result-value">{{hexValue}}</text>
        </view>
        
        <view class="result-item" bindtap="copyRgb">
          <text class="result-format">RGB</text>
          <text class="result-value">{{rgbValue}}</text>
        </view>
        
        <view class="result-item" bindtap="copyHsl">
          <text class="result-format">HSL</text>
          <text class="result-value">{{hslValue}}</text>
        </view>
        
        <view class="result-item" bindtap="copyCmyk">
          <text class="result-format">CMYK</text>
          <text class="result-value cmyk-small">{{cmykValue}}</text>
        </view>
      </view>

      <!-- CSS格式 -->
      <view class="css-output">
        <text class="css-label">{{i18n.cssFormat}}</text>
        <scroll-view scroll-x class="css-scroll">
          <view class="css-items">
            <view class="css-item" bindtap="copyCssHex">
              <text class="css-code">color: {{hexValue}};</text>
            </view>
            <view class="css-item" bindtap="copyCssRgb">
              <text class="css-code">rgb({{rValue}}, {{gValue}}, {{bValue}});</text>
            </view>
            <view class="css-item" bindtap="copyCssHsl">
              <text class="css-code">hsl({{hValue}}, {{sValue}}%, {{lValue}}%);</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view class="tool-actions-bar">
      <button class="tool-action-btn tool-action-reset" bindtap="resetData" hover-class="btn-hover">🔄 {{i18n.reset}}</button>
    </view>

    <!-- 常用颜色列表 -->
    <view class="palette-section">
      <text class="palette-title">🎨 {{i18n.colorPalette}}</text>
      <view class="palette-grid">
        <view 
          class="palette-item"
          wx:for="{{colorPalette}}"
          wx:key="name"
          style="background: {{item.hex}};"
          data-color="{{item}}"
          bindtap="selectPaletteColor"
        >
          <text class="palette-name">{{item.name}}</text>
          <text class="palette-hex">{{item.hex}}</text>
        </view>
      </view>
    </view>

    <!-- 收藏颜色 -->
    <view class="fav-section" wx:if="{{favoriteColors.length > 0}}">
      <view class="fav-header">
        <text class="palette-title">❤️ {{i18n.myFavorites}}</text>
        <text class="fav-count">{{favoriteColors.length}}/20</text>
      </view>
      <view class="fav-grid">
        <view class="fav-item" wx:for="{{favoriteColors}}" wx:key="*this">
          <view class="fav-color-dot" style="background: {{item}};" data-hex="{{item}}" bindtap="selectFavorite"></view>
          <view class="fav-remove" data-index="{{index}}" bindtap="removeFavorite">✕</view>
        </view>
      </view>
    </view>

    <!-- 图片取色 -->
    <view class="pick-section">
      <text class="palette-title">📷 {{i18n.imagePick}}</text>
      <text class="pick-desc">{{i18n.extractColor}}</text>
      <button class="pick-btn" bindtap="pickFromImage">
        <text>📷 {{i18n.selectImagePick}}</text>
      </button>
    </view>
    <canvas type="2d" id="pickCanvas" style="position:fixed;left:-9999px;top:-9999px;width:1px;height:1px;"></canvas>

    <!-- 配色方案 -->
    <view class="scheme-section">
      <text class="palette-title">🎯 {{i18n.colorScheme}}</text>
      <view class="harmony-types">
        <view 
          wx:for="{{harmonyTypes}}" wx:key="id"
          class="harmony-type-btn {{harmonyType === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectHarmonyType"
        >{{item.name}}</view>
      </view>
      <view class="harmony-colors" wx:if="{{harmonyScheme}}">
        <view 
          wx:for="{{harmonyScheme}}" wx:key="label"
          class="harmony-color-item"
          style="background: {{item.hex}};"
          data-hex="{{item.hex}}"
          bindtap="onHarmonyColorTap"
        >
          <text class="harmony-label">{{item.label}}</text>
          <text class="harmony-hex">{{item.hex}}</text>
        </view>
      </view>
      <view class="harmony-copy" bindtap="copyHarmonyAll">📋 {{i18n.copyAllScheme}}</view>
    </view>

    <!-- 渐变色生成器 -->
    <view class="gradient-section">
      <text class="palette-title">🌈 {{i18n.gradientGenerator}}</text>
      <view class="gradient-preview" style="background: {{gradientCSS}};">
        <text class="gradient-css-text">{{gradientCSS}}</text>
      </view>
      <view class="gradient-controls">
        <view class="gradient-color-pick">
          <view class="grad-color-item">
            <view class="grad-color-dot" style="background: {{gradientStart}};" bindtap="selectGradientStart"></view>
            <text class="grad-color-label">{{i18n.startColor}}</text>
          </view>
          <text class="grad-arrow">→</text>
          <view class="grad-color-item">
            <view class="grad-color-dot" style="background: {{gradientEnd}};" bindtap="selectGradientEnd"></view>
            <text class="grad-color-label">{{i18n.endColor}}</text>
          </view>
        </view>
        <view class="gradient-angle-row">
          <text class="grad-angle-label">{{i18n.angle}}</text>
          <view class="grad-angle-btns">
            <view class="grad-angle-btn {{gradientAngle === 0 ? 'active' : ''}}" data-angle="0" bindtap="selectGradientAngle">0°</view>
            <view class="grad-angle-btn {{gradientAngle === 45 ? 'active' : ''}}" data-angle="45" bindtap="selectGradientAngle">45°</view>
            <view class="grad-angle-btn {{gradientAngle === 90 ? 'active' : ''}}" data-angle="90" bindtap="selectGradientAngle">90°</view>
            <view class="grad-angle-btn {{gradientAngle === 135 ? 'active' : ''}}" data-angle="135" bindtap="selectGradientAngle">135°</view>
            <view class="grad-angle-btn {{gradientAngle === 180 ? 'active' : ''}}" data-angle="180" bindtap="selectGradientAngle">180°</view>
            <view class="grad-angle-btn {{gradientAngle === 270 ? 'active' : ''}}" data-angle="270" bindtap="selectGradientAngle">270°</view>
          </view>
        </view>
      </view>
      <view class="gradient-actions">
        <view class="grad-action-btn grad-random" bindtap="randomGradient">🎲 {{i18n.randomGradient}}</view>
        <view class="grad-action-btn grad-copy" bindtap="copyGradientCSS">📋 {{i18n.copyCSS}}</view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <view class="action-btn random" bindtap="generateRandomColor">
        <text>🎲 {{i18n.randomColor}}</text>
      </view>
      <view class="action-btn invert" bindtap="invertColor">
        <text>🔄 {{i18n.invertColor}}</text>
      </view>
    </view>

    <!-- 颜色选择器弹窗 -->
    <view class="color-picker-mask" wx:if="{{showPicker}}" bindtap="hideColorPicker"></view>
    <view class="color-picker-panel {{showPicker ? 'show' : ''}}">
      <view class="picker-header">
        <text class="picker-title">🎨 {{i18n.selectColor}}</text>
        <text class="picker-close" bindtap="hideColorPicker">✕</text>
      </view>

      <!-- SV色板 - 使用CSS渐变 -->
      <view class="sv-container">
        <view class="sv-canvas-css" style="--hue-color: hsl({{pickerHue}}, 100%, 50%);" bindtouchstart="onSvTouchStart" bindtouchmove="onSvTouchMove">
          <view class="sv-indicator" style="left: {{pickerS}}%; top: {{100 - pickerV}}%; background: {{pickerColor}};"></view>
        </view>
      </view>

      <!-- 色相条 - 使用CSS渐变 -->
      <view class="hue-container">
        <view class="hue-canvas-css" bindtouchstart="onHueTouchStart" bindtouchmove="onHueTouchMove">
          <view class="hue-indicator" style="left: {{pickerHuePos}}%;"></view>
        </view>
      </view>

      <!-- 当前颜色预览 -->
      <view class="picker-preview-row">
        <view class="picker-color-box" style="background: {{currentColor}};"></view>
        <text class="picker-hex-text">{{hexValue}}</text>
      </view>

      <!-- 快捷颜色 -->
      <view class="picker-quick-colors">
        <view class="quick-pick-item" style="background:#EF4444;" data-hex="#EF4444" bindtap="pickQuickColor"></view>
        <view class="quick-pick-item" style="background:#F97316;" data-hex="#F97316" bindtap="pickQuickColor"></view>
        <view class="quick-pick-item" style="background:#F59E0B;" data-hex="#F59E0B" bindtap="pickQuickColor"></view>
        <view class="quick-pick-item" style="background:#10B981;" data-hex="#10B981" bindtap="pickQuickColor"></view>
        <view class="quick-pick-item" style="background:#3B82F6;" data-hex="#3B82F6" bindtap="pickQuickColor"></view>
        <view class="quick-pick-item" style="background:#8B5CF6;" data-hex="#8B5CF6" bindtap="pickQuickColor"></view>
        <view class="quick-pick-item" style="background:#EC4899;" data-hex="#EC4899" bindtap="pickQuickColor"></view>
        <view class="quick-pick-item" style="background:#000000;" data-hex="#000000" bindtap="pickQuickColor"></view>
      </view>
    </view>
  </view>
</scroll-view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>