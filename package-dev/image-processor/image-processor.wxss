  margin-bottom: 10px;
}

.exif-empty .empty-text {
  font-size: 15px;
  color: var(--textTertiary,#94A3B8);
  display: block;
  margin-bottom: 6px;
}

.exif-empty .empty-hint {
  font-size: 12px;
  color: var(--textMuted,#CBD5E1);
  display: block;
}

.exif-loading,
.loading-text {
  text-align: center;
  padding: 30px;
  font-size: 14px;
  color: var(--textTertiary,#94A3B8);
}

.color-section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.color-bar {
  display: flex;
  height: 24px;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
}

.color-bar-segment {
  min-width: 8px;
