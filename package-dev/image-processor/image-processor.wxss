  color: var(--textSecondary,#94A3B8);
}

.dark-mode .info-tab.active {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
}

.dark-mode .exif-item {
  background: var(--cardBg,#1a2035);
  border-left-color: var(--accentPurple,#A78BFA);
}

.dark-mode .exif-key {
  color: var(--textSecondary,#94A3B8);
}

.dark-mode .exif-value {
  color: var(--textPrimary,#F1F5F9);
}

.dark-mode .color-item {
  background: var(--cardBg,#1a2035);
}

.dark-mode .color-swatch {
  border-color: var(--borderLight,#374151);
}

.dark-mode .color-hex {
  color: var(--textPrimary,#F1F5F9);
}

.dark-mode .color-rgb {
  color: var(--textMuted,#475569);
}

.dark-mode .color-percent {
  color: var(--accentPurple,#A78BFA);
}

.stitch-img-index {
  position: absolute;
  top: 4px;
  left: 4px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: rgba(139,92,246,0.9);
  color: white;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stitch-img-actions {
  position: absolute;
  top: 4px;
  right: 28px;
  display: flex;
  gap: 4px;
}

.stitch-sort-btn {
  width: 22px;
  height: 22px;
  border-radius: 6px;
  background: rgba(0,0,0,0.6);
  color: white;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stitch-sort-btn:active {
  background: var(--accentPurple,#8B5CF6);
}

.convert-compare {
  background: var(--pageBg,#F8FAFC);
  border-radius: 12px;
  padding: 14px;
}

.compare-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid var(--borderLight,#E2E8F0);
}

.compare-row:last-child {
  border-bottom: none;
}

.compare-row.highlight {
  padding-top: 12px;
  margin-top: 4px;
  border-top: 2px solid var(--accentPurple,#8B5CF6);
  border-bottom: none;
}

.compare-label {
  font-size: 13px;
  color: var(--textSecondary,#64748B);
  font-weight: 500;
}

.compare-value {
  font-size: 14px;
  font-weight: 700;
  color: var(--textPrimary,#1E293B);
}

.compare-value.green {
  color: var(--accentGreen,#10B981);
}

.compare-value.red {
  color: var(--accentRed,#EF4444);
}

.wm-modes {
  display: flex;
  gap: 10px;
}

.wm-mode {
  flex: 1;
  height: 44px;
  border-radius: 12px;
  background: var(--pageBg,#F8FAFC);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 600;
  color: var(--textSecondary,#64748B);
  transition: all 0.2s ease;
  border: 2px solid transparent;
}

.wm-mode.active {
  background: linear-gradient(135deg, var(--accentPurple,#8B5CF6) 0%, var(--accentPurple,#8B5CF6) 100%);
  color: white;
  border-color: var(--accentPurple,#8B5CF6);
}

.wm-input {
  height: 44px;
  background: var(--pageBg,#F8FAFC);
  border: 2px solid var(--borderLight,#E2E8F0);
  border-radius: 10px;
  padding: 0 14px;
  font-size: 15px;
  color: var(--textPrimary,#1E293B);
}

.wm-positions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.wm-pos {
  padding: 8px 16px;
  border-radius: 10px;
  background: var(--pageBg,#F8FAFC);
  font-size: 13px;
  font-weight: 600;
  color: var(--textSecondary,#64748B);
  transition: all 0.2s ease;
  border: 2px solid transparent;
}

.wm-pos.active {
  background: var(--bgTipPurple,#EDE9FE);
  color: var(--accentPurple,#8B5CF6);
  border-color: var(--accentPurple,#8B5CF6);
}

.dark-mode .convert-compare {
  background: var(--cardBg,#1a2035);
}

.dark-mode .compare-row {
  border-bottom-color: var(--borderLight,#374151);
}

.dark-mode .compare-label {
  color: var(--textSecondary,#94A3B8);
}

.dark-mode .compare-value {
  color: var(--textPrimary,#F1F5F9);
}

.dark-mode .compare-value.green {
  color: var(--accentGreen,#34D399);
}

.dark-mode .compare-value.red {
  color: var(--accentRed,#F87171);
}

.dark-mode .wm-mode {
  background: var(--cardBg,#1a2035);
  color: var(--textSecondary,#94A3B8);
}

.dark-mode .wm-mode.active {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
  color: white;
}

.dark-mode .wm-input {
  background: var(--cardBg,#1a2035);
  border-color: var(--borderLight,#374151);
  color: var(--textPrimary,#F1F5F9);
}

.dark-mode .wm-pos {
  background: var(--cardBg,#1a2035);
  color: var(--textSecondary,#94A3B8);
}

.dark-mode .wm-pos.active {
  background: rgba(139,92,246,0.15);
  color: var(--accentPurple,#A78BFA);
  border-color: var(--accentPurple,#A78BFA);
}
