.color-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  background: var(--pageBg,#F8FAFC);
  border-radius: 10px;
}

.color-swatch {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  flex-shrink: 0;
  border: 2px solid var(--borderLight,#E2E8F0);
