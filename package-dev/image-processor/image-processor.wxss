.idphoto-presets {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.idphoto-preset {
  background: var(--pageBg,#F8FAFC);
  border: 2px solid var(--borderLight,#E2E8F0);
  border-radius: 12px;
  padding: 12px;
  text-align: center;
  transition: all 0.2s ease;
}

.idphoto-preset.active {
  border-color: var(--accentPurple,#8B5CF6);
  background: var(--bgTipPurple,#EDE9FE);
}

.idphoto-name {
  font-size: 16px;
  font-weight: 700;
  color: var(--textPrimary,#1E293B);
  display: block;
  margin-bottom: 4px;
}

.idphoto-size {
  font-size: 12px;
  color: var(--accentPurple,#8B5CF6);
  font-family: monospace;
  display: block;
  margin-bottom: 2px;
}

.idphoto-desc {
  font-size: 10px;
  color: var(--textTertiary,#94A3B8);
  display: block;
}

.crop-coords {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.coord-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.coord-label {
  font-size: 12px;
  font-weight: 600;
  color: var(--textSecondary,#64748B);
}

.coord-input {
  height: 40px;
  background: var(--pageBg,#F8FAFC);
  border: 2px solid var(--borderLight,#E2E8F0);
  border-radius: 10px;
  padding: 0 12px;
  font-size: 14px;
  font-family: monospace;
  color: var(--textPrimary,#1E293B);
  text-align: center;
}

.crop-preview-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.crop-preview-wrapper {
  overflow: hidden;
  border-radius: 8px;
  border: 2px solid var(--borderLight,#E2E8F0);
  display: flex;
  flex-direction: column;
}

.crop-preview-img {
  position: absolute;
  top: 0;
  left: 0;
}

.crop-overlay-top,
.crop-overlay-bottom {
  background: rgba(0, 0, 0, 0.45);
}

.crop-overlay-row {
  display: flex;
  flex: 0 0 auto;
}

.crop-overlay-left,
.crop-overlay-right {
  background: rgba(0, 0, 0, 0.45);
}

.crop-selection {
  position: relative;
  border: 2px dashed #FFFFFF;
  box-sizing: border-box;
  flex-shrink: 0;
}

.crop-corner {
  position: absolute;
  width: 10px;
  height: 10px;
  border: 2px solid #FFFFFF;
}

.crop-corner.tl { top: -2px; left: -2px; border-right: none; border-bottom: none; }
.crop-corner.tr { top: -2px; right: -2px; border-left: none; border-bottom: none; }
.crop-corner.bl { bottom: -2px; left: -2px; border-right: none; border-top: none; }
.crop-corner.br { bottom: -2px; right: -2px; border-left: none; border-top: none; }

.crop-size-info {
  font-size: 12px;
  color: var(--textSecondary,#64748B);
  font-family: monospace;
  font-weight: 600;
  background: var(--pageBg,#F8FAFC);
  padding: 4px 12px;
  border-radius: 8px;
}

.info-tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
  background: var(--cardBg,#FFFFFF);
  border-radius: 12px;
  padding: 4px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.04);
}

.info-tab {
  flex: 1;
  height: 38px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
  color: var(--textSecondary,#64748B);
  transition: all 0.2s ease;
}

.info-tab.active {
  background: linear-gradient(135deg, var(--accentPurple,#8B5CF6) 0%, var(--accentPurple,#8B5CF6) 100%);
  color: white;
}

.exif-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.exif-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 14px;
  background: var(--pageBg,#F8FAFC);
  border-radius: 10px;
  border-left: 3px solid var(--accentPurple,#8B5CF6);
}

.exif-key {
  font-size: 13px;
  font-weight: 600;
  color: var(--textSecondary,#64748B);
  flex-shrink: 0;
}

.exif-value {
  font-size: 13px;
  font-weight: 500;
  color: var(--textPrimary,#1E293B);
  text-align: right;
  margin-left: 12px;
  word-break: break-all;
}

.exif-empty {
