      <view class="desktop-entry-left">
        <text class="desktop-entry-icon">📱</text>
        <view class="desktop-entry-info">
          <text class="desktop-entry-title">{{i18n.addToDesktop}}</text>
          <text class="desktop-entry-desc">{{i18n.addToDesktopDesc}}</text>
        </view>
      </view>
      <text class="desktop-entry-arrow">›</text>
    </view>

    <!-- 系统设置 -->
    <view class="section-group-title">
      <text class="group-line"></text>
      <text class="group-text">{{i18n.systemSettings}}</text>
      <text class="group-line"></text>
    </view>

    <!-- 设置 -->
    <view class="settings-section">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-icon">⚙️</text>
          <text class="section-title">{{i18n.settings}}</text>
        </view>
      </view>

      <view class="settings-list">
        <view class="setting-item" bindtap="toggleDarkMode" hover-class="setting-hover" aria-role="button" aria-label="外观模式设置">
          <view class="setting-left">
            <text class="setting-icon">{{darkModeSetting === 'dark' ? '🌙' : darkModeSetting === 'light' ? '☀️' : '🔄'}}</text>
            <text class="setting-name">{{i18n.appearance}}</text>
          </view>
          <view class="setting-right">
            <text class="setting-value">{{darkModeSetting === 'system' ? i18n.followSystem : darkModeSetting === 'dark' ? i18n.darkMode : i18n.lightMode}}</text>
            <text class="setting-arrow">›</text>
          </view>
        </view>

        <view class="setting-item" bindtap="toggleFontSize" hover-class="setting-hover" aria-role="button" aria-label="字体大小设置">
          <view class="setting-left">
            <text class="setting-icon">🔤</text>
            <text class="setting-name">{{i18n.fontSize}}</text>
          </view>
          <view class="setting-right">
            <text class="setting-value">{{fontSizeSetting === 'small' ? i18n.small : fontSizeSetting === 'large' ? i18n.large : i18n.medium}}</text>
            <text class="setting-arrow">›</text>
          </view>
        </view>

        <view class="setting-item" bindtap="openFontPicker" hover-class="setting-hover" aria-role="button" aria-label="字体样式设置">
          <view class="setting-left">
            <text class="setting-icon">🖋️</text>
            <text class="setting-name">{{i18n.fontStyle}}</text>
          </view>
          <view class="setting-right">
            <text class="setting-value">{{fontName}}</text>
            <text class="setting-arrow">›</text>
          </view>
        </view>

        <view class="setting-item" bindtap="openLangPicker" hover-class="setting-hover" aria-role="button" aria-label="语言设置">
          <view class="setting-left">
            <text class="setting-icon">🌐</text>
            <text class="setting-name">{{i18n.language}}</text>
          </view>
          <view class="setting-right">
            <text class="setting-value">{{langName}}</text>
            <text class="setting-arrow">›</text>
          </view>
        </view>

        <view class="setting-item" bindtap="clearCache" hover-class="setting-hover" aria-role="button" aria-label="清理缓存">
          <view class="setting-left">
            <text class="setting-icon">🗑️</text>
            <text class="setting-name">{{i18n.clearCache}}</text>
          </view>
          <view class="setting-right">
            <text class="setting-value">{{cacheSize}}</text>
            <text class="setting-arrow">›</text>
          </view>
        </view>

        <view class="setting-item" bindtap="openDataManage" hover-class="setting-hover" aria-role="button" aria-label="数据管理">
          <view class="setting-left">
            <text class="setting-icon">☁️</text>
            <text class="setting-name">{{i18n.dataManage}}</text>
          </view>
          <view class="setting-right">
            <text class="setting-value">{{lastBackupTimeText}}</text>
            <text class="setting-arrow">›</text>
          </view>
        </view>

        <view class="setting-item" bindtap="openPerfPanel" hover-class="setting-hover" aria-role="button" aria-label="性能监控">
          <view class="setting-left">
            <text class="setting-icon">📊</text>
            <text class="setting-name">{{i18n.perfMonitor}}</text>
          </view>
          <view class="setting-right">
            <text class="setting-value {{storageInfo.isDanger ? 'danger' : storageInfo.isWarning ? 'warning' : ''}}">{{storageInfo.usedMB}}MB / {{storageInfo.limitMB}}MB</text>
            <text class="setting-arrow">›</text>
          </view>
        </view>

        <view class="setting-item" bindtap="onFeedback" hover-class="setting-hover" aria-role="button" aria-label="意见反馈">
          <view class="setting-left">
            <text class="setting-icon">💬</text>
            <text class="setting-name">{{i18n.feedback}}</text>
          </view>
          <view class="setting-right">
            <text class="setting-arrow">›</text>
          </view>
        </view>

        <view class="setting-item" bindtap="showNewUserGuide" hover-class="setting-hover" aria-role="button" aria-label="新手引导">
          <view class="setting-left">
            <text class="setting-icon">📖</text>
            <text class="setting-name">{{i18n.viewGuide}}</text>
          </view>
          <view class="setting-right">
            <text class="setting-arrow">›</text>
          </view>
        </view>

        <view class="setting-item" bindtap="showAboutUs" hover-class="setting-hover" aria-role="button" aria-label="关于我们">
          <view class="setting-left">
            <text class="setting-icon">ℹ️</text>
            <text class="setting-name">{{i18n.aboutUs}}</text>
          </view>
          <view class="setting-right">
            <text class="setting-arrow">›</text>
          </view>
        </view>
        <view class="setting-item" bindtap="openPrivacy" hover-class="setting-hover" aria-role="button" aria-label="隐私协议">
          <view class="setting-left">
            <text class="setting-icon">🔒</text>
            <text class="setting-name">{{i18n.privacyPolicy}}</text>
          </view>
          <view class="setting-right">
            <text class="setting-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- UGC需求收集入口 -->
    <view class="ugc-entry" bindtap="openToolRequest" hover-class="ugc-hover">
      <view class="ugc-icon-wrapper">
        <text class="ugc-icon">💡</text>
      </view>
      <view class="ugc-content">
        <text class="ugc-title">{{i18n.wantTool}}</text>
        <text class="ugc-subtitle">{{i18n.tellUsNeed}} ✨</text>
      </view>
      <text class="ugc-arrow">→</text>
    </view>

    <!-- UGC需求收集弹窗 -->
    <view class="ugc-mask" wx:if="{{showToolRequest}}" bindtap="closeToolRequest"></view>
    <view class="ugc-panel {{showToolRequest ? 'show' : ''}}" style="padding-top: {{menuButtonInfo.top + menuButtonInfo.height + 16}}px;">
      <view class="ugc-header">
        <text class="ugc-panel-title">{{i18n.toolRequestTitle}}</text>
        <text class="ugc-close" bindtap="closeToolRequest">✕</text>
      </view>

      <view class="ugc-form">
        <!-- 快速分类选择 -->
        <view class="ugc-category-section">
          <text class="ugc-form-label">{{i18n.toolTypeOptional}}</text>
          <view class="category-chips">
            <view 
              wx:for="{{toolCategories}}" 
              wx:key="value"
              class="chip {{selectedCategory === item.value ? 'active' : ''}}"
              data-value="{{item.value}}"
              bindtap="selectToolCategory"
            >
              <text>{{item.icon}} {{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 需求描述 -->
        <view class="ugc-input-group">
          <text class="ugc-form-label">{{i18n.needDesc}} <text class="required">*</text></text>
          <textarea 
            class="ugc-textarea" 
            value="{{toolRequestContent}}" 
            placeholder="{{i18n.toolRequestPlaceholder}}"
            maxlength="300" 
            auto-height
            bindinput="onToolRequestInput"
          ></textarea>
          <text class="char-count">{{toolRequestContent.length}}/300</text>
        </view>

        <!-- 优先级 -->
        <view class="ugc-priority-section">
          <text class="ugc-form-label">{{i18n.priority}}</text>
          <view class="priority-options">
            <view 
              wx:for="{{priorityLevels}}" 
              wx:key="value"
              class="priority-option {{selectedPriority === item.value ? 'active' : ''}}"
              data-value="{{item.value}}"
              bindtap="selectPriority"
            >
              <text>{{item.icon}}</text>
              <text>{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 联系方式（可选） -->
        <view class="ugc-input-group">
          <text class="ugc-form-label">{{i18n.contactOptional}}</text>
          <input
            class="ugc-input" 
            value="{{toolRequestContact}}" 
            placeholder="{{i18n.toolRequestContactPlaceholder}}"
            maxlength="50"
            bindinput="onToolRequestContactInput"
          />
        </view>
      </view>

      <!-- 提交按钮 -->
      <button 
        class="submit-ugc-btn {{isSubmittingUGC ? 'disabled' : ''}}" 
        bindtap="submitToolRequest" 
        disabled="{{isSubmittingUGC}}"
      >
        {{isSubmittingUGC ? i18n.submitting : i18n.submitRequest}}
      </button>

      <!-- 备用关闭按钮 -->
      <view class="close-ugc-bottom" bindtap="closeToolRequest">
        <text class="close-ugc-text">{{i18n.close}}</text>
      </view>

      <!-- 已提交的需求列表 -->
      <view class="submitted-list" wx:if="{{submittedRequests.length > 0}}">
        <view class="submitted-header">
          <text class="submitted-title">{{i18n.mySubmitted}} ({{submittedRequests.length}})</text>
        </view>
        <view 
          wx:for="{{submittedRequests}}" 
          wx:key="id"
          class="submitted-item"
        >
          <view class="submitted-left">
            <text class="status-dot {{item.status === 'pending' ? 'pending' : 'done'}}"></text>
            <view class="submitted-info">
              <text class="submitted-content">{{item.content}}</text>
              <text class="submitted-time">{{item.time}}</text>
            </view>
          </view>
          <text class="status-tag">{{item.status === 'pending' ? i18n.statusPending : i18n.statusAdopted}}</text>
        </view>
      </view>
    </view>

    <!-- 数据管理弹窗 -->
    <view class="datamask" wx:if="{{showDataManage}}" bindtap="closeDataManage"></view>
    <view class="datapanel {{showDataManage ? 'show' : ''}}">
      <view class="data-header">
        <text class="data-title">{{i18n.dataManageTitle}}</text>
        <text class="data-close" bindtap="closeDataManage">✕</text>
      </view>

      <view class="data-status-card">
        <view class="data-status-row">
          <text class="data-status-icon">{{cloudBackupInfo.hasBackup ? '🟢' : '⚪'}}</text>
          <view class="data-status-info">
            <text class="data-status-label">{{i18n.cloudBackup}}</text>
            <text class="data-status-desc">{{cloudBackupInfo.hasBackup ? i18n.hasBackupData : i18n.noBackupData}}</text>
          </view>
        </view>
        <view class="data-status-detail" wx:if="{{cloudBackupInfo.hasBackup}}">
          <view class="data-detail-item">
            <text class="data-detail-label">{{i18n.backupTime}}</text>
            <text class="data-detail-value">{{lastBackupTimeText}}</text>
          </view>
          <view class="data-detail-item">
            <text class="data-detail-label">{{i18n.dataCount}}</text>
            <text class="data-detail-value">{{cloudBackupInfo.keyCount}} {{i18n.itemsUnit}}</text>
          </view>
        </view>
      </view>

      <view class="data-actions">
        <button class="data-btn data-backup-btn {{isBackingUp ? 'disabled' : ''}}" 
          bindtap="doBackup" disabled="{{isBackingUp}}">
          {{isBackingUp ? i18n.backingUp : i18n.backupToCloud}}
        </button>
        <button class="data-btn data-restore-btn {{isRestoring ? 'disabled' : ''}}" 
          bindtap="doRestore" disabled="{{isRestoring}}">
          {{isRestoring ? i18n.restoring : i18n.restoreFromCloud}}
        </button>
      </view>

      <view class="data-tips">
        <text class="data-tip-title">{{i18n.dataTipTitle}}</text>
        <text class="data-tip-item">{{i18n.dataTip1}}</text>
        <text class="data-tip-item">{{i18n.dataTip2}}</text>
        <text class="data-tip-item">{{i18n.dataTip3}}</text>
        <text class="data-tip-item">{{i18n.dataTip4}}</text>
      </view>
    </view>

