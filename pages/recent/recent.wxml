          <text class="task-bonus-icon">🎁</text>
          <view class="task-bonus-info">
            <text class="task-bonus-title">{{i18n.allCompletedBonus}}</text>
            <text class="task-bonus-desc">{{i18n.allCompletedBonusDesc}}</text>
          </view>
          <text class="task-bonus-points">+{{dailyTaskInfo.bonusPoints}}</text>
        </view>
      </view>

      <view class="task-bonus-section" wx:elif="{{dailyTaskInfo.bonusClaimed}}">
        <view class="task-bonus-card claimed">
          <text class="task-bonus-icon">✅</text>
          <text class="task-bonus-title">{{i18n.todayRewardClaimed}}</text>
        </view>
