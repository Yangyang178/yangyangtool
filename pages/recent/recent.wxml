      <view class="shop-balance">
        <text class="shop-balance-icon">💎</text>
        <text class="shop-balance-value">{{pointsSummary.currentPoints}}</text>
        <text class="shop-balance-label">{{i18n.availablePoints}}</text>
      </view>

      <scroll-view class="shop-list" scroll-y>
        <view wx:for="{{shopItems}}" wx:key="id" class="shop-item {{item.isOwned ? 'owned' : ''}} {{item.isActive ? 'active' : ''}}" data-id="{{item.id}}" data-type="{{item.type}}" bindtap="purchaseItem">
          <view class="shop-item-icon-wrap {{item.frameClass ? item.frameClass + '-preview' : ''}}" wx:if="{{item.type !== 'theme'}}">
            <text class="shop-item-icon">{{item.icon}}</text>
          </view>
          <view class="shop-item-color-preview" wx:if="{{item.type === 'theme'}}" style="background: {{item.color}};">
            <text class="shop-item-color-icon">{{item.icon}}</text>
          </view>
          <view class="shop-item-info">
            <text class="shop-item-name">{{item.name}}</text>
            <text class="shop-item-desc">{{item.desc}}</text>
          </view>
          <view class="shop-item-action">
            <text class="shop-item-price" wx:if="{{!item.isOwned}}">💎 {{item.price}}</text>
            <text class="shop-item-owned" wx:elif="{{item.isActive}}" data-type="{{item.type}}" catchtap="deactivateItem">{{i18n.itemInUse}}</text>
            <text class="shop-item-activate" wx:elif="{{item.isOwned && item.type === 'theme'}}" data-id="{{item.id}}" catchtap="activateItem">{{i18n.itemUse}}</text>
            <text class="shop-item-activate" wx:elif="{{item.type === 'frame'}}">{{i18n.itemSelect}}</text>
            <text class="shop-item-activate" wx:else>{{i18n.itemOwned}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 头像框选择弹窗 -->
    <view class="ptmask" wx:if="{{showFrameSelector}}" bindtap="closeFrameSelector"></view>
    <view class="ptpanel {{showFrameSelector ? 'show' : ''}}">
      <view class="ptpanel-header">
        <text class="ptpanel-title">🖼️ 选择头像框</text>
        <text class="ptpanel-close" bindtap="closeFrameSelector">✕</text>
      </view>

      <view class="frame-preview-area">
        <view class="frame-preview-wrap {{previewFrame ? previewFrame.frameClass : ''}}" bindtap="chooseAvatarFromSelector">
          <view class="frame-preview-avatar" style="{{userInfo.avatarBg ? 'background:' + userInfo.avatarBg : ''}}">
            <image wx:if="{{userInfo.avatarUrl}}" class="frame-preview-img" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
            <text wx:else class="frame-preview-icon">👤</text>
          </view>
          <view class="frame-deco frame-deco-tl" wx:if="{{previewFrame}}"></view>
          <view class="frame-deco frame-deco-tr" wx:if="{{previewFrame}}"></view>
          <view class="frame-deco frame-deco-bl" wx:if="{{previewFrame}}"></view>
          <view class="frame-deco frame-deco-br" wx:if="{{previewFrame}}"></view>
          <view class="frame-deco frame-deco-t" wx:if="{{previewFrame}}"></view>
          <view class="frame-deco frame-deco-r" wx:if="{{previewFrame}}"></view>
          <view class="frame-deco frame-deco-b" wx:if="{{previewFrame}}"></view>
          <view class="frame-deco frame-deco-l" wx:if="{{previewFrame}}"></view>
        </view>
        <text class="frame-preview-name">{{previewFrame ? previewFrame.name : i18n.noFrame}}</text>
      </view>

      <scroll-view class="frame-selector-list" scroll-y>
        <view class="frame-option {{!activeFrame ? 'frame-option-active' : ''}}" bindtap="selectFrame" data-id="">
          <view class="frame-option-avatar">
            <text class="frame-option-icon">👤</text>
          </view>
          <view class="frame-option-info">
            <text class="frame-option-name">{{i18n.noFrame}}</text>
          </view>
          <view class="frame-option-check" wx:if="{{!activeFrame}}">✓</view>
        </view>
        <view wx:for="{{ownedFrames}}" wx:key="id" class="frame-option {{activeFrame && activeFrame.id === item.id ? 'frame-option-active' : ''}}" bindtap="selectFrame" data-id="{{item.id}}">
          <view class="frame-option-avatar {{item.frameClass}}">
            <text class="frame-option-icon">{{item.icon}}</text>
          </view>
          <view class="frame-option-info">
            <text class="frame-option-name">{{item.name}}</text>
          </view>
          <view class="frame-option-check" wx:if="{{activeFrame && activeFrame.id === item.id}}">✓</view>
        </view>
      </scroll-view>

      <view class="frame-selector-tip" wx:if="{{ownedFrames.length === 0}}">
        <text class="frame-tip-text">{{i18n.noFrameTip}}</text>
        <view class="frame-tip-btn" bindtap="goToShopFromSelector">{{i18n.goToRedeem}}</view>
      </view>
    </view>

    <!-- 邀请好友弹窗 -->
    <view class="ptmask" wx:if="{{showInvitePanel}}" bindtap="closeInvitePanel"></view>
    <view class="ptpanel {{showInvitePanel ? 'show' : ''}}">
      <view class="ptpanel-header">
        <text class="ptpanel-title">🎁 邀请好友</text>
        <text class="ptpanel-close" bindtap="closeInvitePanel">✕</text>
      </view>

      <view class="invite-hero">
        <text class="invite-hero-icon">🎉</text>
        <text class="invite-hero-title">{{i18n.inviteHeroTitle}}</text>
        <text class="invite-hero-desc">{{i18n.inviteHeroDesc}}</text>
      </view>

      <view class="invite-code-section">
        <text class="invite-section-label">{{i18n.myInviteCode}}</text>
        <view class="invite-code-row">
          <text class="invite-code-value">{{myInviteCode}}</text>
          <view class="invite-copy-btn" bindtap="copyInviteCode" hover-class="invite-copy-hover">
            <text>{{i18n.copyCode}}</text>
          </view>
        </view>
        <text class="invite-hint">{{i18n.inviteHint}}</text>
      </view>

      <view class="invite-input-section">
        <text class="invite-section-label">{{i18n.inputFriendCode}}</text>
        <view class="invite-input-row">
          <input class="invite-input" placeholder="输入邀请码" value="{{inviteCodeInput}}" maxlength="20" bindinput="onInviteCodeInput" />
          <view class="invite-use-btn" bindtap="useInviteCode" hover-class="invite-use-hover">
            <text>{{i18n.useCode}}</text>
          </view>
        </view>
      </view>

      <view class="invite-stats" wx:if="{{inviteInfo.totalInvites > 0}}">
        <text class="invite-stats-title">{{inviteStatsText}}</text>
      </view>
    </view>

    <!-- 性能监控弹窗 -->
    <view class="ptmask" wx:if="{{showPerfPanel}}" bindtap="closePerfPanel"></view>
    <view class="ptpanel ptpanel-shop {{showPerfPanel ? 'show' : ''}}">
      <view class="ptpanel-header">
        <text class="ptpanel-title">{{i18n.perfMonitorTitle}}</text>
        <text class="ptpanel-close" bindtap="closePerfPanel">✕</text>
      </view>

      <view class="perf-storage-card" wx:if="{{storageInfo}}">
        <view class="perf-storage-header">
          <text class="perf-storage-title">{{i18n.storageCapacity}}</text>
          <text class="perf-storage-percent {{storageInfo.isDanger ? 'danger' : storageInfo.isWarning ? 'warning' : ''}}">{{storageInfo.percent}}%</text>
        </view>
        <view class="perf-storage-bar">
          <view class="perf-storage-fill {{storageInfo.isDanger ? 'danger' : storageInfo.isWarning ? 'warning' : ''}}" style="width: {{storageInfo.percent}}%"></view>
        </view>
        <view class="perf-storage-detail">
          <text class="perf-storage-used">{{storageInfo.usedMB}} MB {{i18n.used}}</text>
          <text class="perf-storage-remain">{{storageInfo.remainingMB}} MB {{i18n.remaining}}</text>
        </view>
        <view class="perf-storage-warning" wx:if="{{storageInfo.isDanger}}">
          <text class="perf-warning-icon">⚠️</text>
          <text class="perf-warning-text danger">{{i18n.storageCritical}}</text>
        </view>
        <view class="perf-storage-warning" wx:elif="{{storageInfo.isWarning}}">
          <text class="perf-warning-icon">💡</text>
          <text class="perf-warning-text warning">{{i18n.storageWarning}}</text>
        </view>
      </view>

      <view class="perf-section" wx:if="{{perfSummary}}">
        <text class="perf-section-title">{{i18n.startupPerf}}</text>
        <view class="perf-metric-row">
          <view class="perf-metric">
            <text class="perf-metric-value">{{perfSummary.appReadyMs || '-'}}</text>
            <text class="perf-metric-unit">ms</text>
            <text class="perf-metric-label">{{i18n.appStartup}}</text>
          </view>
          <view class="perf-metric">
            <text class="perf-metric-value">{{storageInfo.keyCount || 0}}</text>
            <text class="perf-metric-unit">{{i18n.unitItems}}</text>
            <text class="perf-metric-label">{{i18n.storageKey}}</text>
          </view>
          <view class="perf-metric">
            <text class="perf-metric-value">{{perfSummary.totalEvents || 0}}</text>
            <text class="perf-metric-unit">{{i18n.unitRecords}}</text>
            <text class="perf-metric-label">{{i18n.monitorEvents}}</text>
          </view>
        </view>
      </view>

      <view class="perf-section" wx:if="{{perfSummary.pageLoadStats.length > 0}}">
        <text class="perf-section-title">{{i18n.pageLoadTime}}</text>
        <view class="perf-page-list">
          <view wx:for="{{perfSummary.pageLoadStats}}" wx:key="page" class="perf-page-item">
            <text class="perf-page-name">{{item.page}}</text>
            <view class="perf-page-bar-wrap">
              <view class="perf-page-bar" style="width: {{item.avgMs >= 2000 ? 100 : item.avgMs >= 1000 ? 80 : item.avgMs >= 500 ? 60 : item.avgMs >= 200 ? 40 : item.avgMs >= 100 ? 25 : 12}}%"></view>
            </view>
            <text class="perf-page-time">{{item.avgMs}}ms</text>
          </view>
        </view>
      </view>

      <view class="perf-section" wx:if="{{storageBreakdown.categories.length > 0}}">
        <text class="perf-section-title">{{i18n.storageCategory}}</text>
        <view class="perf-category-list">
          <view wx:for="{{storageBreakdown.categories}}" wx:key="name" class="perf-category-item">
            <text class="perf-category-name">{{item.name}}</text>
            <text class="perf-category-size">{{item.totalKB}}KB</text>
            <text class="perf-category-count">{{item.count}}{{i18n.itemsUnit}}</text>
          </view>
        </view>
      </view>

      <view class="perf-section" wx:if="{{storageBreakdown.breakdown.length > 0}}">
        <text class="perf-section-title">{{i18n.topStorageKeys}}</text>
        <view class="perf-key-list">
          <view wx:for="{{storageBreakdown.breakdown}}" wx:key="key" class="perf-key-item">
            <text class="perf-key-name">{{item.key}}</text>
            <text class="perf-key-size">{{item.sizeKB}}KB</text>
          </view>
        </view>
      </view>

      <view class="perf-actions">
        <view class="perf-action-btn" bindtap="clearPerfRecords" hover-class="perf-action-hover">
          <text>{{i18n.clearPerfRecords}}</text>
        </view>
      </view>
    </view>

    <view class="bottom-safe-area"></view>
  </view>
</scroll-view>

<!-- 添加到桌面引导弹窗 -->
<view class="ptmask" wx:if="{{showDesktopGuideModal}}" bindtap="closeDesktopGuide"></view>
<view class="ptpanel desktop-guide-panel show" wx:if="{{showDesktopGuideModal}}">
  <view class="ptpanel-header">
    <text class="ptpanel-title">📱 {{i18n.addToDesktopTitle}}</text>
    <text class="ptpanel-close" bindtap="closeDesktopGuide">✕</text>
  </view>
  <view class="desktop-guide-content">
    <view class="desktop-guide-step">
      <view class="desktop-guide-num">1</view>
      <text class="desktop-guide-text">{{i18n.desktopGuideStep1}}</text>
    </view>
    <view class="desktop-guide-step">
      <view class="desktop-guide-num">2</view>
      <text class="desktop-guide-text">{{i18n.desktopGuideStep2}}</text>
    </view>
    <view class="desktop-guide-step">
      <view class="desktop-guide-num">3</view>
      <text class="desktop-guide-text">{{i18n.desktopGuideStep3}}</text>
    </view>
    <view class="desktop-guide-tip">
      <text class="desktop-guide-tip-icon">💡</text>
      <text class="desktop-guide-tip-text">{{i18n.desktopGuideTip}}</text>
    </view>
  </view>
  <button class="desktop-guide-btn" bindtap="closeDesktopGuide">{{i18n.gotIt}}</button>
</view>

<!-- 字体选择弹窗 -->
<view class="ptmask" wx:if="{{showFontPicker}}" bindtap="closeFontPicker"></view>
<view class="ptpanel font-picker-panel show" wx:if="{{showFontPicker}}">
  <view class="font-picker-header">
    <text class="font-picker-title">{{i18n.selectFontStyle}}</text>
    <view class="font-picker-close" bindtap="closeFontPicker">✕</view>
  </view>
  <scroll-view class="font-picker-list" scroll-y enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{fontPickerItems}}"
      wx:key="id"
      class="font-picker-item {{item.isActive ? 'font-picker-active' : ''}} {{!item.isOwned ? 'font-picker-locked' : ''}}"
      data-id="{{item.id}}"
      bindtap="selectFont"
      hover-class="font-picker-hover"
    >
      <view class="font-picker-item-left">
        <text class="font-picker-item-icon">{{item.icon}}</text>
        <view class="font-picker-item-info">
          <text class="font-picker-item-name">{{item.name}}</text>
          <text class="font-picker-item-desc">{{item.desc}}</text>
        </view>
      </view>
      <view class="font-picker-item-right">
        <text wx:if="{{item.isActive}}" class="font-picker-active-tag">{{i18n.inUse}}</text>
        <text wx:elif="{{!item.isOwned}}" class="font-picker-locked-tag">🔒</text>
        <text wx:else class="font-picker-owned-tag">{{i18n.owned}}</text>
      </view>
    </view>
  </scroll-view>
  <view class="font-picker-preview">
    <text class="font-picker-preview-label">{{i18n.previewEffect}}</text>
    <text class="font-picker-preview-text">{{i18n.fontPreviewText}}</text>
  </view>
</view>

<!-- 语言选择弹窗 -->
<view class="ptmask" wx:if="{{showLangPicker}}" bindtap="closeLangPicker"></view>
<view class="ptpanel lang-picker-panel show" wx:if="{{showLangPicker}}">
  <view class="lang-picker-header">
    <text class="lang-picker-title">{{i18n.selectLanguage}}</text>
    <view class="lang-picker-close" bindtap="closeLangPicker">✕</view>
  </view>
  <view class="lang-picker-list">
    <view
      wx:for="{{langPickerItems}}"
      wx:key="id"
      class="lang-picker-item {{item.isActive ? 'lang-picker-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="selectLang"
      hover-class="lang-picker-hover"
    >
      <view class="lang-picker-item-left">
        <text class="lang-picker-item-icon">{{item.icon}}</text>
        <text class="lang-picker-item-name">{{item.name}}</text>
      </view>
      <view class="lang-picker-item-right">
        <text wx:if="{{item.isActive}}" class="lang-picker-active-tag">{{i18n.inUse}}</text>
      </view>
    </view>
  </view>
</view>

<privacy-popup />
