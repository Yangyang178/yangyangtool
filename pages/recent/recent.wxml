            wx:for="{{recentTools}}"
            wx:key="id"
            wx:if="{{index < 7}}"
            class="recent-item"
            data-tool="{{item}}"
            bindtap="onToolClick"
            hover-class="recent-item-hover"
            hover-stay-time="100"
          >
            <view class="recent-icon-wrapper" style="background: {{item.iconBg}}">
              <text class="recent-icon">{{item.icon}}</text>
            </view>
            <view class="recent-content">
              <view class="recent-info">
                <text class="recent-name">{{item.name}}</text>
                <text class="recent-time">{{item.timeText}}</text>
              </view>
              <view class="recent-usage-row" wx:if="{{item.useCount > 0}}">
                <view class="recent-usage-track">
                  <view class="recent-usage-fill" style="width: {{item.usePercent}}%; background: {{item.iconBg || 'linear-gradient(90deg, #6366F1, #8B5CF6)'}};"></view>
                </view>
                <text class="recent-usage-count">{{item.useCount}}{{i18n.times}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="empty-mini" wx:if="{{recentTools.length === 0}}">
          <text>{{i18n.noRecentRecordTip}}</text>
        </view>

        <view class="see-all-btn" bindtap="goToRecentFull" wx:if="{{recentTools.length > 0}}">
          <text>{{i18n.viewAllRecent}}</text>
        </view>
      </view>
    </view>

    <!-- 我的收藏 -->
    <view class="section-block">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-icon">⭐</text>
          <text class="section-title">{{i18n.myFavorites}}</text>
        </view>
        <text class="section-subtitle">({{favoriteTools.length}}{{i18n.piece}})</text>
      </view>

      <view class="fav-preview" wx:if="{{favoriteTools.length > 0}}">
        <text class="fav-names">{{favoritePreviewNames}}</text>
      </view>
      <view class="empty-mini" wx:else>
        <text>{{i18n.noFavoriteTip}}</text>
      </view>

      <view class="see-all-btn" bindtap="goToFavorites">
        <text>{{i18n.viewAllFavorites}} ></text>
      </view>
    </view>

    <!-- 添加到桌面 -->
