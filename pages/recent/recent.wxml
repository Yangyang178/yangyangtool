        <view class="unlock-icon-ring">
          <text class="unlock-icon">{{unlockAchievement.icon}}</text>
        </view>
        <view class="unlock-text" style="opacity: {{unlockAnimation.textOpacity}}">
          <text class="unlock-label">{{i18n.achUnlockTitle}}</text>
          <text class="unlock-name">{{unlockAchievement.name}}</text>
          <text class="unlock-desc">{{unlockAchievement.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 成就详情弹窗 -->
    <view class="ach-detail-mask" wx:if="{{showAchievementDetail}}" bindtap="closeAchievementDetail"></view>
    <view class="ach-detail-panel {{showAchievementDetail ? 'show' : ''}}">
      <view class="ach-detail-header">
        <text class="ach-detail-title">{{i18n.achHallTitle}}</text>
        <text class="ach-detail-close" bindtap="closeAchievementDetail">✕</text>
      </view>

      <view class="ach-filter-bar">
        <view class="ach-filter-btn {{achievementFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="filterAchievements">{{i18n.achFilterAll}}</view>
        <view class="ach-filter-btn {{achievementFilter === 'unlocked' ? 'active' : ''}}" data-filter="unlocked" bindtap="filterAchievements">{{i18n.achFilterUnlocked}}</view>
        <view class="ach-filter-btn {{achievementFilter === 'locked' ? 'active' : ''}}" data-filter="locked" bindtap="filterAchievements">{{i18n.achFilterLocked}}</view>
      </view>

