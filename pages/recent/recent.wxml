<navigation-bar title="{{i18n.myPage}}" back="{{false}}" color="{{isDarkMode ? 'white' : 'black'}}" background="{{isDarkMode ? '#0F172A' : '#F8FAFC'}}"></navigation-bar>

<scroll-view class="main-scroll {{isDarkMode ? 'dark-mode' : ''}} {{fontClass}}" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}">
  <view class="page-container {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}} {{fontClass}}" style="{{themeStyle}}">

    <!-- 用户信息区 -->
    <view class="user-section">
      <view class="avatar-frame-wrap {{activeFrame ? activeFrame.frameClass : ''}}" bindtap="openEditProfile" bindlongpress="openFrameSelector" hover-class="avatar-frame-hover">
        <view class="user-avatar" style="{{userInfo.avatarBg ? 'background:' + userInfo.avatarBg : ''}}">
          <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          <text wx:else class="avatar-icon">👤</text>
        </view>
        <view class="frame-deco frame-deco-tl" wx:if="{{activeFrame}}"></view>
        <view class="frame-deco frame-deco-tr" wx:if="{{activeFrame}}"></view>
        <view class="frame-deco frame-deco-bl" wx:if="{{activeFrame}}"></view>
        <view class="frame-deco frame-deco-br" wx:if="{{activeFrame}}"></view>
        <view class="frame-deco frame-deco-t" wx:if="{{activeFrame}}"></view>
        <view class="frame-deco frame-deco-r" wx:if="{{activeFrame}}"></view>
        <view class="frame-deco frame-deco-b" wx:if="{{activeFrame}}"></view>
        <view class="frame-deco frame-deco-l" wx:if="{{activeFrame}}"></view>
      </view>
      <view class="user-info" bindtap="openEditProfile">
        <view class="user-name-row">
          <text class="user-nickname">{{userInfo.nickname}}</text>
          <text wx:if="{{activeBadge}}" class="user-badge">{{activeBadge}}</text>
          <text class="edit-icon">✏️</text>
        </view>
        <text class="user-stats">{{funStats.levelIcon}} {{funStats.efficiencyLevel}} · {{i18n.savedLabel}} {{funStats.savedTime}}</text>
      </view>
    </view>

    <!-- 趣味化统计卡片 -->
    <view class="fun-stats-card">
      <view class="stats-header">
        <text class="stats-title">⚡ {{i18n.efficiencyStats}}</text>
        <text class="stats-subtitle">{{i18n.cumulativeData}}</text>
      </view>
      
      <view class="stats-main">
        <view class="stat-item highlight">
          <text class="stat-number">{{funStats.operationCount}}</text>
          <text class="stat-label">{{i18n.operations}}</text>
        </view>
        
        <view class="stat-divider"></view>
        
        <view class="stat-item">
          <text class="stat-number">{{funStats.savedTime}}</text>
          <text class="stat-label">{{i18n.saved}}</text>
        </view>
        
        <view class="stat-divider"></view>
        
        <view class="stat-item">
          <text class="stat-icon-large">{{funStats.levelIcon}}</text>
          <text class="stat-label">{{funStats.efficiencyLevel}}</text>
        </view>
      </view>

      <view class="progress-section">
        <view class="progress-label">
          <text>{{i18n.efficiencyProgress}}</text>
          <text>{{funStats.progressPercent}}%</text>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{funStats.progressPercent}}%"></view>
        </view>
      </view>
    </view>

    <!-- 数据看板 -->
    <view class="section-group-title">
      <text class="group-line"></text>
      <text class="group-text">{{i18n.dataDashboard}}</text>
      <text class="group-line"></text>
    </view>

    <!-- 每日签到 -->
    <view class="checkin-card">
      <view class="checkin-header">
        <view class="checkin-title-row">
          <text class="checkin-icon">📅</text>
          <text class="checkin-title">{{i18n.dailyCheckin}}</text>
        </view>
        <view class="checkin-points-badge">
          <text class="points-badge-icon">💎</text>
          <text class="points-badge-value">{{checkinInfo.currentPoints}}</text>
        </view>
      </view>

      <view class="checkin-streak">
        <view class="streak-days">
          <view wx:for="{{7}}" wx:key="index" class="streak-day {{checkinInfo.cycleDay > index ? 'active' : ''}} {{checkinInfo.cycleDay === index && !checkinInfo.isChecked ? 'current' : ''}}">
            <text class="streak-day-num">{{index + 1}}</text>
            <text class="streak-day-label">{{i18n.day}}</text>
          </view>
        </view>
        <view class="streak-bonus-row">
          <text class="streak-bonus-label">{{i18n.dailyPoints}}</text>
          <view class="streak-bonus-values">
            <text class="bonus-val">+10</text>
            <text class="bonus-val">+15</text>
            <text class="bonus-val">+20</text>
            <text class="bonus-val">+25</text>
            <text class="bonus-val">+30</text>
            <text class="bonus-val">+40</text>
            <text class="bonus-val">+60</text>
          </view>
        </view>
      </view>

      <view class="checkin-action">
        <view class="checkin-info-row">
          <text class="checkin-continuous">🔥 {{consecutiveDaysText}}</text>
          <text class="checkin-today-points">{{checkinInfo.isChecked ? i18n.todayChecked : todayPointsText}}</text>
        </view>
        <button class="checkin-btn {{checkinInfo.isChecked ? 'checked' : ''}}" bindtap="doCheckin" disabled="{{checkinInfo.isChecked}}">
          {{checkinInfo.isChecked ? i18n.checkedIn : i18n.checkinNow}}
        </button>
      </view>

      <!-- 签到日历 -->
      <view class="cal-toggle" bindtap="toggleCalendar">
        <text class="cal-toggle-text">📅 {{i18n.checkinCalendar}}</text>
        <text class="cal-toggle-arrow {{showCalendar ? 'cal-arrow-up' : ''}}">›</text>
      </view>
      <view class="checkin-calendar {{showCalendar ? 'cal-expanded' : 'cal-collapsed'}}">
        <view class="cal-header">
          <view class="cal-nav" bindtap="calPrevMonth">
            <text class="cal-nav-arrow">‹</text>
          </view>
          <text class="cal-month">{{calYear}}{{i18n.year}} {{calMonthName}}</text>
          <view class="cal-nav {{calIsCurrent ? 'cal-nav-disabled' : ''}}" bindtap="calNextMonth">
            <text class="cal-nav-arrow">›</text>
          </view>
        </view>
        <view class="cal-weekdays">
          <text wx:for="{{calWeekDays}}" wx:key="index" class="cal-weekday">{{item}}</text>
        </view>
        <view class="cal-grid">
          <view wx:for="{{calDays}}" wx:key="index" class="cal-day {{item.day === 0 ? 'cal-empty' : ''}} {{item.checked ? 'cal-checked' : ''}} {{item.isToday ? 'cal-today' : ''}}">
            <text wx:if="{{item.day > 0}}" class="cal-day-num">{{item.day}}</text>
            <view wx:if="{{item.checked}}" class="cal-check-dot"></view>
          </view>
        </view>
        <view class="cal-legend">
          <view class="cal-legend-item">
            <view class="cal-legend-dot cal-legend-dot-checked"></view>
            <text class="cal-legend-text">{{i18n.checked}}</text>
          </view>
          <view class="cal-legend-item">
            <view class="cal-legend-dot cal-legend-dot-today"></view>
            <text class="cal-legend-text">{{i18n.today}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 成就系统 -->
    <view class="section-block achievement-section">
      <view class="section-header collapse-toggle" bindtap="toggleAchievement">
        <view class="section-title-row">
          <text class="section-icon">🏅</text>
          <text class="section-title">{{i18n.achievements}}</text>
        </view>
        <view class="collapse-header-right">
          <text class="section-subtitle">{{achievementStats.unlocked}}/{{achievementStats.total}}</text>
          <text class="collapse-arrow {{showAchievement ? 'collapse-arrow-up' : ''}}">›</text>
        </view>
      </view>

      <view class="collapse-body {{showAchievement ? 'collapse-expanded' : 'collapse-collapsed'}}">
        <view class="achievement-progress">
          <view class="achievement-progress-bar">
            <view class="achievement-progress-fill" style="width: {{achievementStats.percent}}%"></view>
          </view>
          <text class="achievement-progress-text">{{achievementStats.percent}}%</text>
        </view>

        <view class="achievement-grid">
          <view wx:for="{{achievementList}}" wx:key="id" class="achievement-item {{item.unlocked ? 'unlocked' : 'locked'}}">
            <view class="achievement-icon-wrap">
              <text class="achievement-emoji">{{item.unlocked ? item.icon : '🔒'}}</text>
            </view>
            <text class="achievement-name">{{item.name}}</text>
          </view>
        </view>

        <view class="achievement-view-all" bindtap="openAchievementDetail">
          <text>{{i18n.viewAllAchievements}} ›</text>
        </view>
      </view>
    </view>

    <!-- 积分中心入口 -->
    <view class="section-group-title">
      <text class="group-line"></text>
      <text class="group-text">{{i18n.pointsCenter}}</text>
      <text class="group-line"></text>
    </view>

    <view class="points-center-card">
      <view class="points-balance-row">
        <view class="points-balance-left">
          <text class="points-balance-icon">💎</text>
          <view class="points-balance-info">
            <text class="points-balance-label">{{i18n.myPoints}}</text>
            <text class="points-balance-value">{{pointsSummary.currentPoints}}</text>
          </view>
        </view>
        <view class="points-balance-right">
          <text class="points-earned-text">{{totalEarnedText}}</text>
          <text class="points-spent-text" wx:if="{{pointsSummary.totalSpent > 0}}">{{totalSpentText}}</text>
        </view>
      </view>

      <view class="points-entry-row">
        <view class="points-entry-item" bindtap="openDailyTasks" hover-class="points-entry-hover">
          <view class="entry-icon-wrap entry-tasks">
            <text class="entry-icon">📋</text>
          </view>
          <text class="entry-label">{{i18n.dailyTasks}}</text>
          <text class="entry-badge" wx:if="{{pointsSummary.dailyTaskCompleted > 0}}">{{pointsSummary.dailyTaskCompleted}}/{{pointsSummary.dailyTaskTotal}}</text>
        </view>

        <view class="points-entry-item" bindtap="openPointsShop" hover-class="points-entry-hover">
          <view class="entry-icon-wrap entry-shop">
            <text class="entry-icon">🛒</text>
          </view>
          <text class="entry-label">{{i18n.pointsShop}}</text>
        </view>

        <view class="points-entry-item" bindtap="openInvitePanel" hover-class="points-entry-hover">
          <view class="entry-icon-wrap entry-invite">
            <text class="entry-icon">🎁</text>
          </view>
          <text class="entry-label">{{i18n.inviteFriends}}</text>
          <text class="entry-badge" wx:if="{{pointsSummary.totalInvites > 0}}">{{pointsSummary.totalInvites}}{{i18n.people}}</text>
        </view>
      </view>
    </view>

    <!-- 使用足迹图表 -->
    <view class="section-block footprint-section">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-icon">📊</text>
          <text class="section-title">{{i18n.usageFootprint}}</text>
        </view>
        <text class="section-subtitle">{{i18n.thisWeek}}</text>
      </view>

      <!-- 图表区域 -->
      <view class="chart-container">
        <view class="chart-y-axis">
          <text class="y-label">{{weeklyData.maxValue}}</text>
          <text class="y-label">{{Math.floor(weeklyData.maxValue * 0.5)}}</text>
          <text class="y-label">0</text>
        </view>
        
        <view class="chart-bars">
          <view 
            wx:for="{{weeklyData.labels}}" 
            wx:key="index"
            class="bar-wrapper"
          >
            <view class="bar-container">
              <view 
                class="bar {{item === weeklyData.mostUsedDay ? 'active' : ''}}"
                style="height: {{weeklyData.values[index] > 0 ? (weeklyData.values[index] / weeklyData.maxValue * 100) : 2}}%"
              ></view>
              <text class="bar-value" wx:if="{{weeklyData.values[index] > 0}}">{{weeklyData.values[index]}}</text>
            </view>
            <text class="x-label {{item === weeklyData.mostUsedDay ? 'active' : ''}}">{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 统计摘要 -->
      <view class="footprint-summary">
        <view class="summary-item">
          <text class="summary-value">{{weeklyData.totalWeekUsage}}</text>
          <text class="summary-label">{{i18n.weekTotal}}</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">{{weeklyData.averageDaily}}</text>
          <text class="summary-label">{{i18n.dailyAverage}}</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">{{weeklyData.mostUsedDay}}</text>
          <text class="summary-label">{{i18n.mostActiveDay}}</text>
        </view>
      </view>
    </view>

    <!-- 本周周报 -->
    <view class="section-block weekly-report-section">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-icon">📋</text>
          <text class="section-title">{{i18n.weeklyReport}}</text>
        </view>
        <text class="report-compare">{{weeklyReport.compareLastWeek}}</text>
      </view>

      <view class="report-summary">
        <text class="report-summary-text">{{weeklyReport.summary}}</text>
      </view>

      <view class="report-detail-row" wx:if="{{weeklyReport.topTools.length > 0}}">
        <text class="report-detail-label">🏆 {{i18n.frequentTools}}</text>
        <view class="report-top-tools">
          <view wx:for="{{weeklyReport.topTools}}" wx:key="name" class="report-tool-item">
            <text class="report-tool-icon">{{item.icon}}</text>
            <text class="report-tool-name">{{item.name}}</text>
            <text class="report-tool-count">{{item.count}}{{i18n.times}}</text>
          </view>
        </view>
      </view>

      <view class="report-detail-row">
        <text class="report-detail-label">📅 {{i18n.checkinLabel}}</text>
        <text class="report-detail-value">{{weeklyReport.checkinSummary}}</text>
      </view>
    </view>

    <!-- 编辑用户信息弹窗 -->
    <view class="profile-mask" wx:if="{{showEditProfile}}" bindtap="closeEditProfile"></view>
    <view class="profile-panel {{showEditProfile ? 'show' : ''}}">
      <view class="profile-header">
        <text class="profile-title">✏️ 编辑资料</text>
        <text class="profile-close" bindtap="closeEditProfile">✕</text>
      </view>

      <!-- 头像选择 -->
      <view class="profile-avatar-area" bindtap="chooseAvatar">
        <view class="profile-avatar-preview" style="{{userInfo.avatarBg ? 'background:' + userInfo.avatarBg : ''}}">
          <image wx:if="{{tempAvatarUrl}}" class="avatar-img-large" src="{{tempAvatarUrl}}" mode="aspectFill"></image>
          <text wx:elif="{{userInfo.avatarUrl}}" class="avatar-img-large-wrap"><image class="avatar-img-large" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image></text>
          <text wx:else class="avatar-placeholder-large">📷</text>
        </view>
        <text class="avatar-hint">{{i18n.tapChangeAvatar}}</text>
      </view>

      <!-- 昵称输入 -->
      <view class="profile-input-group">
        <text class="profile-input-label">{{i18n.nickname}}</text>
        <input class="profile-input" value="{{editNickname}}" placeholder="请输入昵称" maxlength="12" bindinput="onNicknameInput"/>
      </view>

      <!-- 头像背景色选择 -->
      <view class="profile-color-section">
        <text class="profile-input-label">{{i18n.avatarBgColor}}</text>
        <view class="color-options">
          <view wx:for="{{avatarColors}}" wx:key="color"
            class="color-option {{selectedAvatarColor === item.color ? 'selected' : ''}}"
            style="background: {{item.color}}"
            data-color="{{item.color}}"
            data-bg="{{item.bg}}"
            bindtap="selectAvatarColor">
            <text wx:if="{{selectedAvatarColor === item.color}}" class="check-mark">✓</text>
          </view>
        </view>
      </view>

      <!-- 头像框引导 -->
      <view class="profile-frame-guide" bindtap="openFrameSelectorFromProfile">
        <view class="frame-guide-left">
          <text class="frame-guide-icon">🖼️</text>
          <view class="frame-guide-text">
            <text class="frame-guide-title">{{i18n.frameSettings}}</text>
            <text class="frame-guide-desc">{{i18n.frameGuideDesc}}</text>
          </view>
        </view>
        <text class="frame-guide-arrow">›</text>
      </view>

      <!-- 保存按钮 -->
      <button class="save-profile-btn" bindtap="saveProfile" hover-class="btn-hover">
        保存
      </button>
    </view>

    <!-- 意见反馈弹窗 -->
    <view class="feedback-mask" wx:if="{{showFeedback}}" bindtap="closeFeedback"></view>
    <view class="feedback-panel {{showFeedback ? 'show' : ''}}">
      <view class="feedback-header">
        <text class="feedback-title">{{i18n.feedbackTitle}}</text>
        <text class="feedback-close" bindtap="closeFeedback">✕</text>
      </view>

      <view class="feedback-form">
        <!-- 反馈类型 -->
        <view class="form-group">
          <text class="form-label">{{i18n.feedbackType}}</text>
          <view class="type-options">
            <view wx:for="{{feedbackTypes}}" wx:key="value"
              class="type-option {{feedbackType === item.value ? 'active' : ''}}"
              data-value="{{item.value}}"
              bindtap="selectFeedbackType">
              <text>{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 联系方式（可选） -->
          <view class="form-group">
          <text class="form-label">{{i18n.contactOptional}}</text>
          <input class="form-input" value="{{contactInfo}}" placeholder="{{i18n.contactPlaceholder}}"
            maxlength="50" bindinput="onContactInput" placeholder-class="form-placeholder"/>
        </view>

        <!-- 反馈内容 -->
          <view class="form-group">
          <text class="form-label">{{i18n.feedbackContent}} <text class="required">*</text></text>
          <textarea class="form-textarea" value="{{feedbackContent}}" placeholder="{{i18n.feedbackPlaceholder}}"
            maxlength="500" auto-height bindinput="onFeedbackInput" placeholder-class="form-placeholder"></textarea>
          <text class="char-count">{{feedbackContent.length}}/500</text>
        </view>
      </view>

      <!-- 提交按钮 -->
      <button class="submit-feedback-btn {{isSubmitting ? 'disabled' : ''}}"
        bindtap="submitFeedback" disabled="{{isSubmitting}}">
        {{isSubmitting ? i18n.submitting : i18n.submitFeedback}}
      </button>
    </view>

    <!-- 关于我们弹窗 -->
    <view class="about-mask" wx:if="{{showAboutUs}}" bindtap="closeAboutUs"></view>
    <view class="about-panel {{showAboutUs ? 'show' : ''}}">
      <view class="about-header">
        <text class="about-title">{{i18n.aboutUsTitle}}</text>
        <text class="about-close" bindtap="closeAboutUs">✕</text>
      </view>

      <view class="about-content">
        <!-- 应用信息 -->
        <view class="app-info-section">
          <view class="app-logo-area">
            <text class="app-logo-icon">🧰</text>
            <text class="app-name">{{i18n.brandTitle}}</text>
            <text class="app-version">v2.0</text>
          </view>

          <view class="app-slogan">
            <text>{{i18n.appSlogan}}</text>
          </view>
        </view>

        <!-- 功能介绍 -->
        <view class="feature-list">
          <view class="feature-item">
            <text class="feature-icon">🎯</text>
            <view class="feature-text">
              <text class="feature-title">{{i18n.focusEfficiency}}</text>
              <text class="feature-desc">{{i18n.focusEfficiencyDesc}}</text>
            </view>
          </view>

          <view class="feature-item">
            <text class="feature-icon">⚡</text>
            <view class="feature-text">
              <text class="feature-title">{{i18n.readyToUse}}</text>
              <text class="feature-desc">{{i18n.readyToUseDesc}}</text>
            </view>
          </view>

          <view class="feature-item">
            <text class="feature-icon">🔒</text>
            <view class="feature-text">
              <text class="feature-title">{{i18n.privacySafe}}</text>
              <text class="feature-desc">{{i18n.privacySafeDesc}}</text>
            </view>
          </view>

          <view class="feature-item">
            <text class="feature-icon">🆓</text>
            <view class="feature-text">
              <text class="feature-title">{{i18n.totallyFree}}</text>
              <text class="feature-desc">{{i18n.totallyFreeDesc}}</text>
            </view>
          </view>
        </view>

        <!-- 统计数据 -->
        <view class="stats-section">
          <view class="stat-row">
            <view class="stat-box">
              <text class="stat-num">40+</text>
              <text class="stat-label">{{i18n.practicalTools}}</text>
            </view>
            <view class="stat-box">
              <text class="stat-num">6</text>
              <text class="stat-label">{{i18n.allCategories}}</text>
            </view>
            <view class="stat-box">
              <text class="stat-num">100%</text>
              <text class="stat-label">{{i18n.freeUse}}</text>
            </view>
          </view>
        </view>

        <!-- 联系方式 -->
        <view class="contact-section">
          <text class="contact-title">{{i18n.contactUs}}</text>
          <view class="contact-items">
            <button
              class="contact-item contact-service-btn"
              hover-class="contact-hover"
              open-type="contact"
              session-from="来自百宝工具箱-关于我们"
              show-message-card="true"
              send-message-title="百宝工具箱 - 意见反馈"
              send-message-path="/pages/index/index"
            >
              <view class="contact-btn-content">
                <text class="contact-icon">💬</text>
                <text class="contact-label">{{i18n.wechatService}}</text>
                <text class="contact-value">{{i18n.tapConsultFeedback}}</text>
                <text class="contact-arrow">→</text>
              </view>
            </button>
          </view>
        </view>

        <!-- 版权信息 -->
        <view class="copyright-section">
          <text class="copyright-text">{{i18n.copyrightText}}</text>
          <text class="copyright-sub">{{i18n.craftWithHeart}}</text>
        </view>
      </view>

      <!-- 关闭按钮 -->
      <button class="close-about-btn" bindtap="closeAboutUs">{{i18n.iKnow}}</button>
    </view>

    <!-- 缓存清理弹窗 -->
    <view class="cache-mask" wx:if="{{showClearCache}}" bindtap="closeClearCache"></view>
    <view class="cache-panel {{showClearCache ? 'show' : ''}}">
      <view class="cache-header">
        <text class="cache-title">{{i18n.clearCacheTitle}}</text>
        <text class="cache-close" bindtap="closeClearCache">✕</text>
      </view>

      <view class="cache-overview">
        <view class="cache-total">
          <text class="total-label">{{i18n.totalCacheSize}}</text>
          <text class="total-value">{{cacheInfo.total}}</text>
        </view>
      </view>

      <view class="cache-items">
        <view class="cache-item">
          <view class="item-left">
            <text class="item-icon">💾</text>
            <view class="item-info">
              <text class="item-name">{{i18n.dataCache}}</text>
              <text class="item-desc">{{i18n.dataCacheDesc}}</text>
            </view>
          </view>
          <view class="item-right">
            <text class="item-size">{{cacheInfo.data}}</text>
            <text class="item-action" catchtap="clearUserData">{{i18n.clearData}}</text>
          </view>
        </view>

        <view class="cache-item">
          <view class="item-left">
            <text class="item-icon">🖼️</text>
            <view class="item-info">
              <text class="item-name">{{i18n.imageCache}}</text>
