    <!-- 每日任务弹窗 -->
    <view class="ptmask" wx:if="{{showDailyTasks}}" bindtap="closeDailyTasks"></view>
    <view class="ptpanel {{showDailyTasks ? 'show' : ''}}">
      <view class="ptpanel-header">
        <text class="ptpanel-title">📋 {{i18n.dailyTasks}}</text>
        <text class="ptpanel-close" bindtap="closeDailyTasks">✕</text>
      </view>

      <view class="task-list">
        <view wx:for="{{dailyTaskInfo.tasks}}" wx:key="id" class="task-item {{item.completed ? 'completed' : ''}}">
