      <text class="group-line"></text>
      <text class="group-text">{{i18n.toolManage}}</text>
      <text class="group-line"></text>
    </view>

    <!-- 最近使用 -->
    <view class="section-block">
      <view class="section-header collapse-toggle" bindtap="toggleRecentTools">
        <view class="section-title-row">
          <text class="section-icon">📌</text>
          <text class="section-title">{{i18n.recentUse}}</text>
        </view>
        <view class="collapse-header-right">
          <text class="section-subtitle">{{i18n.recentUse7days}}</text>
          <text class="collapse-arrow {{showRecentTools ? 'collapse-arrow-up' : ''}}">›</text>
        </view>
      </view>

