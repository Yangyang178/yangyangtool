}

.dark-mode .task-bonus-title {
  color: #FDE68A;
}

.dark-mode .task-bonus-desc {
  color: #FBBF24;
}

.dark-mode .task-bonus-points {
  color: #FDE68A;
}

.dark-mode .shop-balance {
  background: linear-gradient(135deg, var(--primaryLight), var(--primaryLight));
}

.dark-mode .shop-balance-value {
  color: var(--primaryLight);
}

.dark-mode .shop-balance-label {
  color: var(--primaryColor);
}

.dark-mode .shop-item {
  background: rgba(30, 41, 59, 0.8);
  border-color: rgba(51, 65, 85, 0.5);
}

.dark-mode .shop-item.owned {
  border-color: rgba(16, 185, 129, 0.3);
