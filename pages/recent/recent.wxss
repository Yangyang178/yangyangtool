  border-radius: 12px;
}

.copyright-text {
  font-size: 14px;
  font-weight: 600;
  color: var(--textSecondary,#64748B);
  display: block;
  margin-bottom: 4px;
}

.copyright-sub {
  font-size: 13px;
  color: var(--textTertiary,#94A3B8);
}

.close-about-btn {
  width: 100%;
