}

.dark-mode .shop-item.active {
  border-color: var(--primaryLight);
  background: var(--primaryLight);
}

.dark-mode .shop-item-icon-wrap {
  background: rgba(51, 65, 85, 0.6);
}

.dark-mode .shop-item-name {
  color: #F1F5F9;
}

.dark-mode .shop-item-price {
  color: var(--primaryColor);
}

.dark-mode .invite-hero {
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.15), rgba(244, 114, 182, 0.1));
}

.dark-mode .invite-hero-title {
  color: #FBCFE8;
}

.dark-mode .invite-hero-desc {
  color: #F9A8D4;
}

.dark-mode .invite-code-value {
  background: rgba(30, 41, 59, 0.8);
  border-color: var(--primaryLight);
  color: var(--primaryColor);
}

.dark-mode .invite-input {
  background: rgba(30, 41, 59, 0.8);
  border-color: rgba(51, 65, 85, 0.6);
  color: #F1F5F9;
}

.dark-mode .invite-stats {
  background: rgba(51, 65, 85, 0.4);
}

.dark-mode .invite-stats-title {
  color: #94A3B8;
}

/* ==================== 性能监控 ==================== */
.setting-value.danger {
  color: #EF4444 !important;
  font-weight: 700;
}

.setting-value.warning {
  color: #F59E0B !important;
  font-weight: 700;
}

.perf-storage-card {
  background: linear-gradient(135deg, #F0FDF4, #DCFCE7);
  border-radius: 16px;
  padding: 18px;
  margin-bottom: 16px;
}

.perf-storage-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.perf-storage-title {
  font-size: 15px;
  font-weight: 700;
  color: #166534;
}

.perf-storage-percent {
  font-size: 18px;
  font-weight: 800;
  color: #16A34A;
}

.perf-storage-percent.warning {
  color: #D97706;
}

.perf-storage-percent.danger {
  color: #DC2626;
}

.perf-storage-bar {
  height: 8px;
  background: rgba(22, 163, 74, 0.15);
  border-radius: 4px;
  overflow: hidden;
  margin-bottom: 8px;
}

.perf-storage-fill {
  height: 100%;
  background: linear-gradient(90deg, #22C55E, #16A34A);
  border-radius: 4px;
  transition: width 0.3s ease;
}

.perf-storage-fill.warning {
  background: linear-gradient(90deg, #F59E0B, #D97706);
}

.perf-storage-fill.danger {
  background: linear-gradient(90deg, #EF4444, #DC2626);
}

.perf-storage-detail {
  display: flex;
  justify-content: space-between;
}

.perf-storage-used {
  font-size: 12px;
  color: #166534;
  font-weight: 500;
}

.perf-storage-remain {
  font-size: 12px;
  color: #16A34A;
  font-weight: 500;
}

.perf-storage-warning {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 10px;
  padding: 8px 12px;
  border-radius: 10px;
  background: rgba(245, 158, 11, 0.1);
}

.perf-warning-icon {
  font-size: 16px;
}

.perf-warning-text {
  font-size: 12px;
  font-weight: 600;
}

.perf-warning-text.warning {
  color: #D97706;
}

.perf-warning-text.danger {
  color: #DC2626;
}

.perf-section {
  margin-bottom: 16px;
}

.perf-section-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--textPrimary, #1E293B);
  margin-bottom: 10px;
  display: block;
}

.perf-metric-row {
  display: flex;
  gap: 10px;
}

.perf-metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 12px 8px;
  background: var(--surfaceBg, #F8FAFC);
  border-radius: 12px;
  border: 1px solid var(--borderLight, #E2E8F0);
}

.perf-metric-value {
  font-size: 20px;
  font-weight: 800;
  color: var(--textPrimary, #1E293B);
}

.perf-metric-unit {
  font-size: 11px;
  color: var(--textTertiary, #94A3B8);
}

.perf-metric-label {
  font-size: 11px;
  color: var(--textSecondary, #64748B);
