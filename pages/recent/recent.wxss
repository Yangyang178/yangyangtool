/* 小程序操作面板 */
.mini-app-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1098;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.mini-app-mask.show {
  opacity: 1;
  visibility: visible;
}

.mini-app-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 24px 24px 0 0;
  z-index: 1099;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  padding-bottom: calc(20px + env(safe-area-inset-bottom));
}

.mini-app-panel.show {
  transform: translateY(0);
}

.mini-app-panel.dark-mode {
  background: #1E293B;
}

.mini-app-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 20px 0;
}

.mini-app-panel-title {
  font-size: 17px;
  font-weight: 600;
  color: var(--textPrimary, #1E293B);
}

.dark-mode .mini-app-panel-title {
  color: #F1F5F9;
}

.mini-app-panel-close {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F1F5F9;
  color: #64748B;
  font-size: 14px;
}

.dark-mode .mini-app-panel-close {
