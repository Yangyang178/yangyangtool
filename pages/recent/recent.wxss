}

.dark-mode .cal-expanded {
  border-top-color: rgba(255, 255, 255, 0.08);
}

.cal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.cal-nav {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
}

.dark-mode .cal-nav {
  background: rgba(255, 255, 255, 0.08);
}

.cal-nav-disabled {
  opacity: 0.3;
}

.cal-nav-arrow {
  font-size: 20px;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 300;
}

.dark-mode .cal-nav-arrow {
  color: rgba(255, 255, 255, 0.7);
}

.cal-month {
  font-size: 16px;
  font-weight: 600;
  color: #FFFFFF;
}

.dark-mode .cal-month {
  color: #F1F5F9;
}

.cal-weekdays {
  display: flex;
  margin-bottom: 8px;
}

.cal-weekday {
  flex: 1;
  text-align: center;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 500;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-day {
  width: 14.28%;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 12px;
}

.cal-empty {
  visibility: hidden;
}

.cal-day-num {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
}

.dark-mode .cal-day-num {
  color: rgba(255, 255, 255, 0.7);
}

.cal-checked {
  background: linear-gradient(135deg, #10B981, #059669);
}

.cal-checked .cal-day-num {
  color: #FFFFFF;
  font-weight: 600;
}

.cal-check-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #FFFFFF;
  margin-top: 2px;
}

.cal-today {
  border: 2px solid rgba(255, 255, 255, 0.6);
}

.cal-today .cal-day-num {
  color: #FFFFFF;
  font-weight: 700;
}

.cal-today.cal-checked .cal-day-num {
  color: #FFFFFF;
}

.cal-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
}

.dark-mode .cal-legend {
  border-top-color: rgba(255, 255, 255, 0.08);
}

.cal-legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
}

.cal-legend-dot {
  width: 10px;
  height: 10px;
  border-radius: 3px;
}

.cal-legend-dot-checked {
  background: linear-gradient(135deg, #10B981, #059669);
}

.cal-legend-dot-today {
  border: 2px solid rgba(255, 255, 255, 0.6);
  background: transparent;
}

.cal-legend-text {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
}

/* ==================== 成就系统 ==================== */
.achievement-section {
  padding: 18px 16px !important;
}

.achievement-progress {
