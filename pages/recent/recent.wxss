/* 微信客服按钮 - 精美设计 */
.contact-service-btn {
  margin: 0 !important;
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  border-radius: 14px !important;
  line-height: inherit !important;
  font-size: inherit !important;
  overflow: visible !important;
}

.contact-service-btn::after {
  display: none !important;
}

.contact-btn-content {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 16px 18px;
  background: linear-gradient(135deg, var(--primaryLight) 0%, var(--primaryLight) 100%);
  border-radius: 14px;
  border: 1.5px solid var(--primaryLight);
  box-shadow:
    0 4px 12px var(--primaryLight),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.contact-btn-content:active {
  background: linear-gradient(135deg, var(--primaryLight) 0%, var(--primaryLight) 100%);
  box-shadow:
    0 6px 20px var(--primaryLight),
    inset 0 1px 0 rgba(255, 255, 255, 1);
  transform: scale(0.98) translateY(-1px);
}

.contact-arrow {
  font-size: 18px;
  color: var(--primaryColor);
  font-weight: 700;
  transition: transform 0.25s ease;
}

.contact-btn-content:active .contact-arrow {
  transform: translateX(4px);
}

.contact-item:active {
  opacity: 0.75;
}

.contact-icon {
  font-size: 24px;
}

.contact-label {
  font-size: 15px;
  font-weight: 600;
  color: var(--textPrimary,#1E293B);
  flex: 1;
}

.contact-value {
  font-size: 13px;
  font-weight: 600;
  color: var(--primaryColor);
}

.copyright-section {
  text-align: center;
  padding: 16px;
