}

.lang-picker-item-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.lang-picker-item-icon {
  font-size: 24px;
}

.lang-picker-item-name {
  font-size: 16px;
  font-weight: 600;
  color: var(--textPrimary, #1E293B);
}

.lang-picker-active-tag {
  font-size: 12px;
  font-weight: 600;
  color: var(--primaryColor);
  background: var(--primaryLight);
  padding: 3px 10px;
  border-radius: 10px;
}

.dark-mode .lang-picker-close {
  background: var(--elevatedBg);
}

.dark-mode .lang-picker-hover {
  background: var(--elevatedBg);
}

/* 查看全部按钮 */
.see-all-btn {
  margin-top: 12px;
  text-align: center;
  padding-top: 12px;
  border-top: 1px solid var(--borderFaint,#F1F5F9);
}

.see-all-btn text {
  font-size: 13px;
  color: var(--primaryColor);
  font-weight: 500;
}

/* 设置列表 - 简约设计 */
.settings-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
  border-bottom: none;
  transition: all 0.2s ease;
  position: relative;
}

.setting-item::after {
  display: none;
}

.setting-item:last-child::after {
  display: none;
}

.setting-hover {
  background: transparent;
}

.setting-hover .setting-name {
  color: var(--primaryColor);
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 14px;
}

/* 图标 - 圆形精美容器设计 */
.setting-icon {
  font-size: 22px;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primaryLight) 0%, var(--primaryLight) 100%);
  border-radius: 12px;
  box-shadow:
    0 2px 8px var(--primaryLight),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.setting-hover .setting-icon {
  transform: scale(1.1) rotate(-3deg);
  background: linear-gradient(135deg, var(--primaryLight) 0%, var(--primaryLight) 100%);
  box-shadow:
    0 4px 12px var(--primaryLight),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.setting-name {
  font-size: 16px;
  font-weight: 700;
  color: var(--textPrimary,#1E293B);
  letter-spacing: 0.3px;
  transition: color 0.2s ease;
}

.setting-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.setting-value {
  font-size: 13px;
  font-weight: 700;
  color: var(--primaryColor);
  padding: 5px 14px;
  background: var(--primaryLight);
  border-radius: 20px;
  border: 1.5px solid var(--primaryLight);
  box-shadow:
    inset 0 1px 2px rgba(255, 255, 255, 0.8),
    0 1px 3px var(--primaryLight);
}

.setting-arrow {
  font-size: 22px;
  color: var(--textTertiary,#CBD5E1);
  font-weight: 300;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.setting-hover .setting-arrow {
  transform: translateX(4px);
  color: var(--primaryColor);
}

/* 设置区域 - 大框架+内部分割线设计 */
.settings-section {
  background: var(--cardBg,#FFFFFF) !important;
  border-radius: 20px !important;
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.05) !important;
  padding: 4px 16px !important;
  margin-bottom: 14px;
  border: none;
  overflow: hidden;
}

.settings-section .section-header {
  margin-bottom: 12px;
  padding-top: 8px;
}

.settings-section .settings-list {
  margin-top: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.settings-section .setting-item {
  background: transparent;
  border-radius: 14px;
  padding: 15px 12px;
  margin-bottom: 0;
  box-shadow: none;
  border: none;
  transition: all 0.25s ease;
  position: relative;
}

.settings-section .setting-item + .setting-item {
  border-top: none;
  margin-top: 2px;
}

.settings-section .setting-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.settings-section .setting-item:active,
.setting-hover {
  background: var(--primaryLight) !important;
  border-radius: 14px;
  box-shadow: none !important;
  transform: scale(0.985);
}


/* ==================== UGC工具需求收集 ==================== */
.ugc-entry {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border-radius: 16px;
  padding: 18px 20px;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 14px;
  box-shadow: 0 4px 12px rgba(251, 191, 36, 0.2);
  border: 2px solid rgba(251, 191, 36, 0.3);
  transition: all 0.2s ease;
}

.ugc-hover {
  transform: scale(0.98);
  box-shadow: 0 2px 8px rgba(251, 191, 36, 0.15);
}

.ugc-icon-wrapper {
  width: 48px;
  height: 48px;
  background: linear-gradient(135deg, #FBBF24 0%, #F59E0B 100%);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(251, 191, 36, 0.3);
}

.ugc-icon {
  font-size: 24px;
}

.ugc-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.ugc-title {
  font-size: 16px;
  font-weight: 700;
  color: #92400E;
}

.ugc-subtitle {
  font-size: 12px;
  color: #B45309;
}

.ugc-arrow {
  font-size: 24px;
  color: #D97706;
  flex-shrink: 0;
}

/* UGC弹窗 */
.ugc-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1098;
}

.ugc-panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: white;
  border-radius: 24px 24px 0 0;
  padding: 20px 20px calc(60px + env(safe-area-inset-bottom));
  z-index: 1099;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 90vh;
  overflow-y: auto;
}

.ugc-panel.show {
  transform: translateY(0);
}

.ugc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.ugc-panel-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--textPrimary,#1E293B);
}

.ugc-close {
  font-size: 28px;
  color: var(--textSecondary,#64748B);
  padding: 8px;
  margin: -8px;
  min-width: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ugc-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.ugc-category-section,
.ugc-priority-section {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.ugc-form-label {
  font-size: 14px;
  font-weight: 600;
  color: var(--textPrimary,#1E293B);
}

.required {
  color: #EF4444;
  font-size: 12px;
}

.category-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.chip {
  padding: 8px 14px;
  border-radius: 20px;
  border: 2px solid var(--borderLight,#E2E8F0);
  background: var(--surfaceBg,#F8FAFC);
  font-size: 13px;
  font-weight: 500;
  color: var(--textSecondary,#64748B);
  transition: all 0.2s ease;
}

.chip.active {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border-color: #F59E0B;
  color: #92400E;
  font-weight: 600;
}

.chip text {
  display: flex;
  align-items: center;
  gap: 4px;
}

.ugc-input-group {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.ugc-textarea {
  width: 100%;
  min-height: 120px;
  max-height: 200px;
  background: var(--surfaceBg,#F1F5F9);
  border-radius: 12px;
  padding: 14px 16px;
  font-size: 15px;
  color: var(--textPrimary,#1E293B);
  box-sizing: border-box;
  line-height: 1.6;
}

.ugc-input {
  width: 100%;
  height: 46px;
  background: var(--surfaceBg,#F1F5F9);
  border-radius: 12px;
  padding: 0 16px;
  font-size: 15px;
  color: var(--textPrimary,#1E293B);
  box-sizing: border-box;
}

.priority-options {
  display: flex;
  gap: 10px;
}

.priority-option {
  flex: 1;
  padding: 12px 8px;
  border-radius: 12px;
  border: 2px solid var(--borderLight,#E2E8F0);
  background: var(--surfaceBg,#F8FAFC);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  transition: all 0.2s ease;
}

.priority-option.active {
  background: linear-gradient(135deg, var(--primaryLight) 0%, var(--primaryLight) 100%);
  border-color: var(--primaryColor);
}

.priority-option.active text:first-child {
  transform: scale(1.2);
}

.priority-option text {
  font-size: 14px;
  font-weight: 600;
  color: var(--textSecondary,#64748B);
}

.priority-option.active text {
  color: var(--primaryDark);
}

.submit-ugc-btn {
  width: 100%;
  height: 50px;
  border-radius: 25px;
  font-size: 17px;
  font-weight: 700;
  color: white;
  background: linear-gradient(135deg, #FBBF24 0%, #F59E0B 100%);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 14px rgba(251, 191, 36, 0.3);
  margin-top: 8px;
}

/* 备用关闭按钮 */
.close-ugc-bottom {
  margin-top: 20px;
  padding: 14px;
  text-align: center;
}

.close-ugc-text {
  font-size: 15px;
  font-weight: 600;
  color: var(--textTertiary,#94A3B8);
}

.submit-ugc-btn.disabled {
  opacity: 0.6;
}

/* 已提交列表 */
.submitted-list {
  margin-top: 20px;
  padding-top: 16px;
  border-top: 1px solid var(--borderLight,#E2E8F0);
}

.submitted-header {
  margin-bottom: 12px;
}

.submitted-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--textPrimary,#1E293B);
}

.submitted-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px;
  background: var(--surfaceBg,#F8FAFC);
  border-radius: 10px;
  margin-bottom: 8px;
}

.submitted-left {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  min-width: 0;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot.pending {
  background: #FBBF24;
  animation: pulse 2s infinite;
}

.status-dot.done {
  background: #10B981;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.submitted-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.submitted-content {
  font-size: 14px;
  font-weight: 600;
  color: var(--textPrimary,#1E293B);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submitted-time {
  font-size: 11px;
  color: var(--textTertiary,#94A3B8);
}

.status-tag {
  font-size: 11px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 10px;
  flex-shrink: 0;
  background: #FEF3C7;
  color: #92400E;
}

/* Banner广告位 */
.banner-ad {
  background: linear-gradient(135deg, #F1F5F9 0%, #E2E8F0 100%);
  border-radius: 12px;
  padding: 32px 20px;
  text-align: center;
  border: 2px dashed var(--borderLight,#CBD5E1);
  margin-top: 4px;
}

.banner-text {
  font-size: 14px;
  color: var(--textTertiary,#94A3B8);
  font-weight: 500;
}

.bottom-safe-area {
  height: 40px;
}

/* ==================== 夜间模式优化 ==================== */
.dark-mode {
  background-color: #0F172A !important;
}

.dark-mode .page-container {
  background: linear-gradient(180deg, #0F172A 0%, #1E293B 100%);
}

.dark-mode .user-avatar {
  box-shadow: 0 4px 16px rgba(59, 130, 246, 0.2);
}

.dark-mode .frame-gold {
  box-shadow:
    0 0 12px rgba(255, 215, 0, 0.8),
    0 0 24px rgba(255, 165, 0, 0.5),
    0 0 36px rgba(255, 140, 0, 0.3),
    inset 0 0 10px rgba(255, 215, 0, 0.5);
}

.dark-mode .frame-diamond {
  box-shadow:
    0 0 12px rgba(0, 188, 212, 0.8),
    0 0 24px rgba(77, 208, 225, 0.5),
    0 0 36px rgba(128, 222, 234, 0.3),
    inset 0 0 10px rgba(224, 247, 250, 0.6);
}

.dark-mode .frame-rainbow {
  box-shadow:
    0 0 12px rgba(255, 107, 107, 0.6),
    0 0 24px rgba(78, 205, 196, 0.5),
    0 0 36px rgba(69, 183, 209, 0.4),
    0 0 48px rgba(221, 160, 221, 0.3),
    inset 0 0 10px rgba(255, 255, 255, 0.4);
}

.dark-mode .frame-gold .frame-deco {
  box-shadow: 0 0 8px rgba(255, 215, 0, 1), 0 0 16px rgba(255, 165, 0, 0.7);
}

.dark-mode .frame-diamond .frame-deco {
  box-shadow: 0 0 8px rgba(0, 188, 212, 1), 0 0 16px rgba(77, 208, 225, 0.7);
}

.dark-mode .frame-rainbow .frame-deco-tl {
  box-shadow: 0 0 8px rgba(255, 107, 107, 1), 0 0 14px rgba(255, 107, 107, 0.6);
}
.dark-mode .frame-rainbow .frame-deco-tr {
  box-shadow: 0 0 8px rgba(255, 230, 109, 1), 0 0 14px rgba(255, 230, 109, 0.6);
}
.dark-mode .frame-rainbow .frame-deco-bl {
  box-shadow: 0 0 8px rgba(78, 205, 196, 1), 0 0 14px rgba(78, 205, 196, 0.6);
}
.dark-mode .frame-rainbow .frame-deco-br {
