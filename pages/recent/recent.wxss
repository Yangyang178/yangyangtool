  align-items: center;
  justify-content: space-between;
  padding: 6px 12px;
  border-radius: 8px;
}

.perf-key-name {
  font-size: 12px;
  color: var(--textSecondary, #64748B);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.perf-key-size {
  font-size: 12px;
  font-weight: 600;
  color: var(--textPrimary, #1E293B);
  flex-shrink: 0;
  margin-left: 8px;
}

.perf-actions {
  margin-top: 16px;
}

.perf-action-btn {
  width: 100%;
  height: 44px;
  border-radius: 22px;
  font-size: 14px;
  font-weight: 600;
  color: var(--textSecondary, #64748B);
  background: var(--surfaceBg, #F1F5F9);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.perf-action-hover {
  transform: scale(0.98);
  opacity: 0.8;
}

/* ==================== 性能监控暗黑模式 ==================== */
.dark-mode .perf-storage-card {
  background: linear-gradient(135deg, rgba(22, 163, 74, 0.1), rgba(34, 197, 94, 0.06));
}

.dark-mode .perf-storage-title {
  color: #86EFAC;
}

.dark-mode .perf-storage-used {
  color: #86EFAC;
}

.dark-mode .perf-storage-remain {
  color: #4ADE80;
}

.dark-mode .perf-storage-bar {
  background: rgba(34, 197, 94, 0.15);
}

.dark-mode .perf-metric {
  background: rgba(30, 41, 59, 0.8);
  border-color: rgba(51, 65, 85, 0.5);
}

.dark-mode .perf-metric-value {
  color: #F1F5F9;
}

.dark-mode .perf-page-item {
  background: rgba(30, 41, 59, 0.8);
  border-color: rgba(51, 65, 85, 0.5);
}

.dark-mode .perf-page-bar-wrap {
  background: rgba(51, 65, 85, 0.6);
}

.dark-mode .perf-page-time {
  color: var(--primaryColor);
}

.dark-mode .perf-category-item {
  background: rgba(30, 41, 59, 0.8);
  border-color: rgba(51, 65, 85, 0.5);
}

.dark-mode .perf-category-size {
  color: var(--primaryColor);
}

.dark-mode .perf-key-name {
  color: #94A3B8;
}

.dark-mode .perf-key-size {
  color: #F1F5F9;
}

.dark-mode .perf-action-btn {
  background: rgba(51, 65, 85, 0.4);
  color: #94A3B8;
}

.dark-mode .perf-warning-text.warning {
  color: #FBBF24;
}

.dark-mode .perf-warning-text.danger {
  color: #FCA5A5;
}

.dark-mode .perf-storage-warning {
  background: rgba(245, 158, 11, 0.1);
}
