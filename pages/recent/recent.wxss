/* ==================== 编辑资料弹窗 ==================== */
.profile-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1098;
}

.profile-panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: white;
  border-radius: 24px 24px 0 0;
  padding: 24px 20px calc(60px + env(safe-area-inset-bottom));
  z-index: 1099;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 85vh;
  overflow-y: auto;
}

.profile-panel.show {
  transform: translateY(0);
}

.profile-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.profile-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--textPrimary,#1E293B);
}

.profile-close {
  font-size: 22px;
  color: var(--textSecondary,#64748B);
  padding: 4px;
}

.profile-avatar-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
}

.profile-avatar-preview {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 3px solid var(--borderLight,#E2E8F0);
}

.avatar-img-large {
  width: 90px;
  height: 90px;
  border-radius: 50%;
}

.avatar-img-large-wrap {
  width: 90px;
  height: 90px;
  display: block;
}

.avatar-placeholder-large {
  font-size: 36px;
}

.avatar-hint {
  font-size: 12px;
  color: var(--primaryColor);
  font-weight: 500;
}

.profile-input-group {
  margin-bottom: 20px;
}

.profile-input-label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--textPrimary,#1E293B);
  margin-bottom: 10px;
}

.profile-input {
  width: 100%;
  height: 48px;
  background: var(--surfaceBg,#F1F5F9);
  border-radius: 12px;
  padding: 0 16px;
  font-size: 16px;
  color: var(--textPrimary,#1E293B);
  box-sizing: border-box;
}

.profile-color-section {
  margin-bottom: 28px;
}

.color-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 10px;
}

.color-option {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3px solid transparent;
  transition: all 0.2s ease;
  position: relative;
}

.color-option.selected {
  border-color: var(--primaryColor);
  transform: scale(1.1);
}

.check-mark {
  color: white;
  font-size: 18px;
  font-weight: 700;
  text-shadow: 0 1px 2px rgba(0,0,0,0.3);
}

.profile-frame-guide {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  margin-top: 12px;
  margin-bottom: 20px;
  background: var(--primaryLight);
  border-radius: 12px;
  border: 1px solid var(--primaryLight);
}

.frame-guide-left {
  display: flex;
  align-items: center;
}

.frame-guide-icon {
  font-size: 22px;
  margin-right: 10px;
}

.frame-guide-text {
  display: flex;
  flex-direction: column;
}

.frame-guide-title {
  font-size: 15px;
  color: #1E293B;
  font-weight: 500;
}

.frame-guide-desc {
  font-size: 12px;
  color: #64748B;
  margin-top: 2px;
}

.frame-guide-arrow {
  font-size: 20px;
  color: #94A3B8;
  font-weight: 300;
}

.save-profile-btn {
  width: 100%;
  height: 50px;
  border-radius: 25px;
  font-size: 17px;
  font-weight: 700;
  color: white;
  background: linear-gradient(135deg, var(--primaryColor) 0%, var(--primaryDark) 100%);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 14px var(--primaryLight);
}

