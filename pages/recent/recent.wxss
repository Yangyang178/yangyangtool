/* 更多小程序 */
.mini-apps-section {
  margin: 12px 0 4px;
}

.mini-apps-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--textSecondary, #666);
  margin-bottom: 10px;
  padding-left: 2px;
}

.dark-mode .mini-apps-title {
  color: var(--textSecondary, #aaa);
}

.mini-apps-grid {
  display: flex;
  gap: 10px;
}

.mini-app-card {
  flex: 1;
  min-width: 0;
