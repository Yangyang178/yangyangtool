  flex-direction: column;
  gap: 8px;
}

.perf-page-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: var(--surfaceBg, #F8FAFC);
  border-radius: 10px;
  border: 1px solid var(--borderLight, #E2E8F0);
}

.perf-page-name {
