/* ==================== 字体选择弹窗 ==================== */
.font-picker-panel {
  max-height: 70vh;
  padding-bottom: 0;
  background: white;
}

.dark-mode .font-picker-panel {
  background: #1E293B;
}

.font-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 20px 16px;
  border-bottom: 1px solid var(--borderFaint, #F1F5F9);
}

.font-picker-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--textPrimary, #1E293B);
}

.font-picker-close {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: var(--textTertiary, #94A3B8);
  border-radius: 50%;
  background: var(--surfaceBg, #F1F5F9);
}

.font-picker-list {
  max-height: 45vh;
  padding: 8px 12px;
}

.font-picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 12px;
  border-radius: 12px;
  margin-bottom: 4px;
  transition: all 0.15s ease;
}

.font-picker-hover {
  background: var(--surfaceBg, #F1F5F9);
}

.font-picker-active {
  background: var(--primaryLight);
  border: 1px solid var(--primaryColor);
}

.font-picker-locked {
  opacity: 0.55;
}

.font-picker-item-left {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 0;
}

.font-picker-item-icon {
  font-size: 24px;
  flex-shrink: 0;
}

.font-picker-item-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.font-picker-item-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--textPrimary, #1E293B);
}

.font-picker-item-desc {
  font-size: 12px;
  color: var(--textTertiary, #94A3B8);
}

.font-picker-item-right {
  flex-shrink: 0;
}

.font-picker-active-tag {
  font-size: 12px;
  font-weight: 600;
  color: var(--primaryColor);
  background: var(--primaryLight);
  padding: 3px 10px;
  border-radius: 10px;
}

.font-picker-locked-tag {
  font-size: 14px;
}

.font-picker-owned-tag {
  font-size: 11px;
  color: var(--successColor, #10B981);
  font-weight: 500;
}

.font-picker-preview {
  padding: 16px 20px;
  border-top: 1px solid var(--borderFaint, #F1F5F9);
  background: var(--surfaceBg, #F1F5F9);
  border-radius: 0 0 20px 20px;
}

.font-picker-preview-label {
  font-size: 11px;
  color: var(--textTertiary, #94A3B8);
  display: block;
  margin-bottom: 8px;
}

.font-picker-preview-text {
  font-size: 18px;
  font-weight: 600;
  color: var(--textPrimary, #1E293B);
  letter-spacing: 1px;
}

.dark-mode .font-picker-close {
  background: var(--elevatedBg);
}

.dark-mode .font-picker-hover {
  background: var(--elevatedBg);
}

.dark-mode .font-picker-preview {
  background: var(--elevatedBg);
}

/* ==================== 语言选择弹窗 ==================== */
.lang-picker-panel {
  max-height: 50vh;
  padding-bottom: 0;
  background: white;
}

.dark-mode .lang-picker-panel {
  background: #1E293B;
}

.lang-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 20px 16px;
  border-bottom: 1px solid var(--borderFaint, #F1F5F9);
}

.lang-picker-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--textPrimary, #1E293B);
}

.lang-picker-close {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: var(--textTertiary, #94A3B8);
  border-radius: 50%;
  background: var(--surfaceBg, #F1F5F9);
}

.lang-picker-list {
  padding: 8px 12px;
}

.lang-picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 12px;
  border-radius: 12px;
  margin-bottom: 4px;
  transition: all 0.15s ease;
}

.lang-picker-hover {
  background: var(--surfaceBg, #F1F5F9);
}

.lang-picker-active {
  background: var(--primaryLight);
