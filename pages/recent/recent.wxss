  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
}

.dark-mode .desktop-entry-card {
  background: linear-gradient(135deg, #1a2035 0%, #1e2a4a 100%);
}

.desktop-entry-hover {
  opacity: 0.85;
}

.desktop-entry-left {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 0;
}

.desktop-entry-icon {
  font-size: 24px;
  flex-shrink: 0;
}

.desktop-entry-info {
