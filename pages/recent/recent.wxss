  background: #F8FAFC;
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 20px;
}

.dark-mode .mini-app-panel-info {
  background: #0F172A;
}

.mini-app-panel-label {
  display: block;
  font-size: 11px;
  color: #94A3B8;
  margin-bottom: 6px;
}

.mini-app-panel-appid {
  display: block;
