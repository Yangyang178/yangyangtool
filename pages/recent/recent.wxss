/* ==================== 通用折叠组件 ==================== */
.collapse-toggle {
  cursor: pointer;
}

.collapse-header-right {
  display: flex;
  align-items: center;
  gap: 6px;
}

.collapse-arrow {
  font-size: 18px;
  color: var(--textTertiary, #94A3B8);
  transition: transform 0.3s ease;
  transform: rotate(90deg);
}

.collapse-arrow-up {
  transform: rotate(-90deg);
}

.collapse-body {
  overflow: hidden;
  transition: max-height 0.35s ease, opacity 0.3s ease;
}

.collapse-collapsed {
  max-height: 0;
  opacity: 0;
}

.collapse-expanded {
  max-height: 2000px;
  opacity: 1;
}

/* ==================== 签到日历 ==================== */
.cal-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16px;
  padding: 10px 14px;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 12px;
}

.cal-toggle-text {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.cal-toggle-arrow {
  font-size: 18px;
  color: rgba(255, 255, 255, 0.6);
  transition: transform 0.3s ease;
  transform: rotate(90deg);
}

.cal-arrow-up {
  transform: rotate(-90deg);
}

.checkin-calendar {
  margin-top: 12px;
  overflow: hidden;
  transition: max-height 0.35s ease, opacity 0.3s ease;
}

.cal-collapsed {
  max-height: 0;
  opacity: 0;
  margin-top: 0;
}

.cal-expanded {
