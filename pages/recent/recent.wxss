  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 4px 16px var(--primaryLight);
}

.points-balance-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
}

.points-balance-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.points-balance-icon {
  font-size: 32px;
}

.points-balance-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.points-balance-label {
  font-size: 12px;
  color: var(--primaryColor);
  font-weight: 500;
}

.points-balance-value {
  font-size: 28px;
  font-weight: 800;
  color: var(--primaryColor);
}

.points-balance-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.points-earned-text {
  font-size: 12px;
  color: var(--primaryColor);
  font-weight: 500;
}

.points-spent-text {
  font-size: 11px;
  color: var(--primaryColor);
  font-weight: 400;
}

.points-entry-row {
  display: flex;
  gap: 10px;
}

.points-entry-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 14px 8px;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 14px;
  position: relative;
  transition: all 0.2s ease;
}

.points-entry-hover {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.9);
}

.entry-icon-wrap {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-tasks {
  background: linear-gradient(135deg, #DBEAFE, #BFDBFE);
}

.entry-shop {
  background: linear-gradient(135deg, #FEF3C7, #FDE68A);
}

.entry-invite {
  background: linear-gradient(135deg, #FCE7F3, #FBCFE8);
}

.entry-icon {
  font-size: 20px;
}

.entry-label {
  font-size: 12px;
  font-weight: 600;
  color: var(--textPrimary, #1E293B);
}

.entry-badge {
  font-size: 10px;
  color: var(--primaryColor);
  font-weight: 700;
  background: var(--primaryLight);
  padding: 1px 6px;
  border-radius: 8px;
}

/* ==================== 每日任务弹窗 ==================== */
.ptmask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1098;
}

.ptpanel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: white;
  border-radius: 24px 24px 0 0;
  padding: 24px 20px calc(60px + env(safe-area-inset-bottom));
  z-index: 1099;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 80vh;
  overflow-y: auto;
}

.ptpanel.show {
  transform: translateY(0);
}

.ptpanel-shop {
  max-height: 85vh;
}

.ptpanel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.ptpanel-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--textPrimary, #1E293B);
}

.ptpanel-close {
  font-size: 22px;
  color: var(--textSecondary, #64748B);
  padding: 4px;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
  background: var(--surfaceBg, #F8FAFC);
  border-radius: 14px;
  border: 1px solid var(--borderLight, #E2E8F0);
  transition: all 0.2s ease;
}

.task-item.completed {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.06), rgba(5, 150, 105, 0.03));
  border-color: rgba(16, 185, 129, 0.2);
}

.task-icon-wrap {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  flex-shrink: 0;
}

.task-icon {
  font-size: 20px;
}

.task-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.task-name {
  font-size: 14px;
  font-weight: 700;
  color: var(--textPrimary, #1E293B);
}

.task-desc {
  font-size: 11px;
  color: var(--textTertiary, #94A3B8);
}

.task-progress-bar {
  height: 4px;
  background: var(--borderLight, #E2E8F0);
  border-radius: 2px;
  margin-top: 4px;
  overflow: hidden;
}

.task-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primaryColor), var(--primaryDark));
  border-radius: 2px;
  transition: width 0.3s ease;
}

.task-progress-text {
  font-size: 10px;
  color: var(--textTertiary, #94A3B8);
}

.task-reward {
  display: flex;
  align-items: center;
  gap: 2px;
  flex-shrink: 0;
}

.task-reward-icon {
  font-size: 14px;
}

.task-reward-value {
  font-size: 14px;
  font-weight: 700;
  color: var(--primaryColor);
}

.task-bonus-section {
  margin-top: 16px;
}

.task-bonus-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  background: linear-gradient(135deg, #FEF3C7, #FDE68A);
  border-radius: 16px;
  transition: all 0.2s ease;
}

.task-bonus-hover {
  transform: scale(0.98);
}

.task-bonus-card.claimed {
  background: var(--surfaceBg, #F1F5F9);
  justify-content: center;
}

.task-bonus-icon {
  font-size: 28px;
}

.task-bonus-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.task-bonus-title {
  font-size: 15px;
  font-weight: 700;
  color: #92400E;
}

.task-bonus-desc {
  font-size: 12px;
  color: #B45309;
}

.task-bonus-points {
  font-size: 18px;
  font-weight: 800;
  color: #92400E;
}

/* ==================== 积分商城弹窗 ==================== */
.shop-balance {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 16px;
  background: linear-gradient(135deg, var(--primaryLight), var(--primaryLight));
  border-radius: 14px;
  margin-bottom: 16px;
}

.shop-balance-icon {
  font-size: 20px;
}

.shop-balance-value {
  font-size: 24px;
  font-weight: 800;
  color: var(--primaryDark);
}

.shop-balance-label {
  font-size: 12px;
  color: var(--primaryColor);
  margin-left: 4px;
}

.shop-list {
  max-height: 55vh;
}

.shop-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
  background: var(--surfaceBg, #F8FAFC);
  border-radius: 14px;
  margin-bottom: 10px;
  border: 1px solid var(--borderLight, #E2E8F0);
  transition: all 0.2s ease;
}

.shop-item.owned {
  border-color: rgba(16, 185, 129, 0.3);
  background: rgba(16, 185, 129, 0.04);
}

.shop-item.active {
  border-color: var(--primaryLight);
  background: var(--primaryLight);
  box-shadow: 0 2px 8px var(--primaryLight);
}

.shop-item.active .shop-item-icon {
  animation: badgeShine 2s ease-in-out infinite;
  display: inline-block;
}

@keyframes badgeShine {
  0%, 100% { transform: scale(1); filter: brightness(1); }
  50% { transform: scale(1.15); filter: brightness(1.3); }
}

.shop-item-icon-wrap {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  flex-shrink: 0;
}

.shop-item-color-preview {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.shop-item-color-icon {
  font-size: 22px;
  filter: brightness(2);
}

.shop-item-icon {
  font-size: 24px;
}

.shop-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.shop-item-name {
  font-size: 15px;
  font-weight: 700;
  color: var(--textPrimary, #1E293B);
}

.shop-item-desc {
  font-size: 12px;
  color: var(--textTertiary, #94A3B8);
}

.shop-item-action {
  flex-shrink: 0;
}

.shop-item-price {
  font-size: 14px;
  font-weight: 700;
  color: var(--primaryColor);
}

.shop-item-owned {
  font-size: 12px;
  font-weight: 600;
  color: #10B981;
  padding: 4px 10px;
  background: rgba(16, 185, 129, 0.1);
  border-radius: 8px;
}

.shop-item-activate {
  font-size: 12px;
  font-weight: 600;
  color: var(--primaryColor);
  padding: 4px 10px;
  background: var(--primaryLight);
  border-radius: 8px;
}

/* ==================== 邀请好友弹窗 ==================== */
.invite-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 24px 16px;
  background: linear-gradient(135deg, #FCE7F3, #FBCFE8);
  border-radius: 16px;
  margin-bottom: 20px;
}

.invite-hero-icon {
  font-size: 40px;
}

.invite-hero-title {
  font-size: 18px;
  font-weight: 800;
  color: #9D174D;
}

.invite-hero-desc {
  font-size: 13px;
  color: #BE185D;
  text-align: center;
}

.invite-code-section,
.invite-input-section {
  margin-bottom: 18px;
}

.invite-section-label {
  font-size: 14px;
  font-weight: 700;
  color: var(--textPrimary, #1E293B);
  margin-bottom: 10px;
  display: block;
}

.invite-code-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.invite-code-value {
  flex: 1;
  height: 48px;
  background: var(--surfaceBg, #F1F5F9);
  border-radius: 12px;
  padding: 0 16px;
  font-size: 18px;
  font-weight: 800;
  color: var(--primaryColor);
  letter-spacing: 3px;
  display: flex;
  align-items: center;
  border: 2px solid var(--primaryLight);
}

.invite-copy-btn {
  height: 48px;
  padding: 0 20px;
  background: linear-gradient(135deg, var(--primaryColor), var(--primaryDark));
  color: white;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.invite-copy-hover {
  transform: scale(0.96);
  opacity: 0.9;
}

.invite-hint {
  font-size: 11px;
  color: var(--textTertiary, #94A3B8);
  margin-top: 6px;
  display: block;
}

.invite-input-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.invite-input {
  flex: 1;
  height: 48px;
  background: var(--surfaceBg, #F1F5F9);
  border-radius: 12px;
  padding: 0 16px;
  font-size: 15px;
  color: var(--textPrimary, #1E293B);
  border: 2px solid var(--borderLight, #E2E8F0);
}

.invite-use-btn {
  height: 48px;
  padding: 0 20px;
  background: linear-gradient(135deg, #10B981, #059669);
  color: white;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.invite-use-hover {
  transform: scale(0.96);
  opacity: 0.9;
}

.invite-stats {
  text-align: center;
  padding: 12px;
  background: var(--surfaceBg, #F8FAFC);
  border-radius: 12px;
}

.invite-stats-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--textSecondary, #64748B);
}

/* ==================== 积分中心暗黑模式 ==================== */
.dark-mode .section-group-title .group-line {
  background: linear-gradient(90deg, transparent, rgba(51, 65, 85, 0.6), transparent);
}

.dark-mode .group-text {
  color: #94A3B8;
}

.dark-mode .points-center-card {
  background: linear-gradient(135deg, var(--primaryLight), var(--primaryLight));
  box-shadow: 0 4px 16px var(--primaryLight);
}

.dark-mode .points-balance-label {
  color: var(--primaryColor);
}

.dark-mode .points-balance-value {
  color: #F1F5F9;
}

.dark-mode .points-earned-text {
  color: var(--primaryColor);
}

.dark-mode .points-entry-item {
