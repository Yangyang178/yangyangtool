/* ==================== 使用足迹图表 ==================== */
.footprint-section {
  padding: 20px 16px !important;
}

.chart-container {
  display: flex;
  gap: 8px;
  margin: 16px 0;
  padding: 12px;
  background: var(--surfaceBg,#F8FAFC);
  border-radius: 12px;
}

.chart-y-axis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4px 0;
  width: 24px;
}

.y-label {
  font-size: 10px;
  color: var(--textTertiary,#94A3B8);
  text-align: right;
}

.chart-bars {
  flex: 1;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 140px;
  gap: 6px;
}

.bar-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  max-width: 40px;
}

.bar-container {
  width: 100%;
  height: 110px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  position: relative;
  overflow: visible;
}

.bar {
  width: 70%;
  min-height: 4px;
  background: linear-gradient(180deg, var(--primaryColor) 0%, var(--primaryDark) 100%);
  border-radius: 4px 4px 0 0;
  transition: all 0.3s ease;
  position: relative;
}

.bar.active {
  background: linear-gradient(180deg, var(--primaryColor) 0%, var(--primaryDark) 100%);
  box-shadow: 0 0 12px var(--primaryLight);
}

.bar-value {
  position: absolute;
  top: -18px;
  font-size: 10px;
  font-weight: 600;
  color: var(--textPrimary,#1E293B);
  white-space: nowrap;
  left: 50%;
  transform: translateX(-50%);
}

.x-label {
  font-size: 11px;
  color: var(--textTertiary,#94A3B8);
  font-weight: 500;
  transition: all 0.2s ease;
}

.x-label.active {
  color: var(--primaryColor);
  font-weight: 700;
}

.footprint-summary {
  display: flex;
  justify-content: space-around;
  padding-top: 14px;
  border-top: 1px solid var(--borderFaint,#F1F5F9);
  margin-top: 8px;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.summary-value {
  font-size: 20px;
  font-weight: 800;
  color: var(--primaryColor);
}

.summary-label {
  font-size: 11px;
  color: var(--textTertiary,#94A3B8);
}

/* 区块通用 */
.section-block {
  background: var(--cardBg,#FFFFFF);
  border-radius: 16px;
  padding: 18px 16px;
  margin-bottom: 14px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.03);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.section-icon {
  font-size: 16px;
}

.section-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--textPrimary,#1E293B);
}

.section-subtitle {
  font-size: 12px;
  color: var(--textTertiary,#94A3B8);
}

/* 最近使用列表 */
.recent-list {
  display: flex;
