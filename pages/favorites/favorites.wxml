<navigation-bar title="{{i18n.navTitle}}" back="{{false}}" color="{{isDarkMode ? 'white' : 'black'}}" background="{{isDarkMode ? '#0F172A' : '#F8FAFC'}}"></navigation-bar>
<skeleton show="{{isLoading}}" type="list" dark="{{isDarkMode}}"></skeleton>

<scroll-view class="main-scroll {{isDarkMode ? 'dark-mode' : ''}} {{fontClass}}" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}">
  <view class="page-container {{isDarkMode ? 'dark-mode' : ''}} {{fontClass}} font-size-{{fontSizeSetting}}">
    <view class="header-section">
      <view class="header-row">
        <view class="header-left">
          <text class="page-title">{{i18n.toolTitle}}</text>
          <text class="page-subtitle">{{favoriteTools.length}} {{i18n.toolCount}}</text>
        </view>
        <view class="sort-toggle" bindtap="toggleSort" wx:if="{{favoriteTools.length > 1}}">
          <text class="sort-icon">{{sortBy === 'time' ? '🕐' : '🔤'}}</text>
          <text class="sort-label">{{sortBy === 'time' ? i18n.sortByTime : i18n.sortByName}}</text>
        </view>
      </view>
    </view>

    <view class="tools-list" wx:if="{{favoriteTools.length > 0}}">
      <view 
        wx:for="{{favoriteTools}}" 
        wx:key="id"
        class="tool-item"
        data-tool="{{item}}"
        bindtap="onToolClick"
        hover-class="tool-item-hover"
        hover-stay-time="100"
      >
        <view class="item-icon-wrapper" style="background: {{item.iconBg}}">
          <text class="item-icon">{{item.icon}}</text>
        </view>
        
        <view class="item-content">
          <text class="item-name">{{item.name}}</text>
          <text class="item-desc">{{item.desc}}</text>
        </view>

        <view class="item-actions">
          <view class="action-fav active" catchtap="removeFavorite" data-id="{{item.id}}" data-index="{{index}}">
            <text>⭐</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{favoriteTools.length === 0}}">
      <view class="empty-illustration">
        <text class="empty-emoji">⭐</text>
        <view class="empty-dots">
          <text class="empty-dot"></text>
          <text class="empty-dot"></text>
          <text class="empty-dot"></text>
        </view>
      </view>
      <text class="empty-text">{{i18n.noFavorites}}</text>
      <text class="empty-subtext">{{i18n.noFavoritesHint}}</text>
      <view class="empty-btn" bindtap="goToHome">
        <text>{{i18n.browseTools}}</text>
      </view>
    </view>

    <view class="popular-section" wx:if="{{popularTools.length > 0}}">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-icon">🔥</text>
          <text class="section-title">{{i18n.hotRecommend}}</text>
        </view>
        <text class="section-subtitle">{{i18n.everyoneUsing}}</text>
      </view>
      <view class="popular-grid">
        <view 
          wx:for="{{popularTools}}" 
          wx:key="id"
          class="popular-item {{item.isFavorite ? 'is-fav' : ''}}"
          data-tool="{{item}}"
          bindtap="onToolClick"
          hover-class="popular-item-hover"
        >
          <view class="popular-icon-wrap" style="background: {{item.iconBg}}">
            <text class="popular-icon">{{item.icon}}</text>
          </view>
          <text class="popular-name">{{item.name}}</text>
          <view class="popular-fav" catchtap="toggleFavorite" data-id="{{item.id}}">
            <text>{{item.isFavorite ? '⭐' : '☆'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-safe-area"></view>
  </view>
</scroll-view>
