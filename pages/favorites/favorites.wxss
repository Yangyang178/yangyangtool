page {
  height: 100vh;
  background-color: var(--pageBg,#F8FAFC);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.main-scroll {
  flex: 1;
  height: 100vh;
  background-color: var(--pageBg) !important;
}

.page-container {
  padding: 0 20px;
  padding-bottom: 100px;
  min-height: calc(100vh - 100px);
}

.header-section {
  padding: 24px 0 20px;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 28px;
  font-weight: 700;
  color: var(--textPrimary,#1E293B);
  display: block;
  margin-bottom: 4px;
}

.page-subtitle {
  font-size: 14px;
  color: var(--textSecondary,#64748B);
}

.sort-toggle {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 12px;
  background: var(--surfaceBg,#F1F5F9);
  border-radius: 16px;
  flex-shrink: 0;
}

.sort-icon {
  font-size: 14px;
}

.sort-label {
  font-size: 12px;
  font-weight: 600;
  color: var(--textSecondary,#64748B);
}

.tools-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.tool-item {
  background: var(--cardBg,#FFFFFF);
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  display: flex;
  align-items: center;
  gap: 14px;
  transition: all 0.15s ease;
}

.tool-item-hover {
  transform: scale(0.98);
  opacity: 0.95;
}

.item-icon-wrapper {
  width: 48px;
  height: 48px;
  border-radius: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.item-icon {
  font-size: 24px;
}

.item-content {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--textPrimary,#1E293B);
  display: block;
  margin-bottom: 3px;
}

.item-desc {
  font-size: 12px;
  color: var(--textTertiary,#94A3B8);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-actions {
  flex-shrink: 0;
}

.action-fav {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.action-fav.active text {
  font-size: 18px;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px 40px;
}

.empty-illustration {
  position: relative;
  margin-bottom: 24px;
}

.empty-emoji {
  font-size: 64px;
  display: block;
  text-align: center;
  opacity: 0.7;
}

.empty-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 12px;
}

.empty-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--textTertiary,#CBD5E1);
  opacity: 0.4;
}

.empty-text {
  font-size: 18px;
  font-weight: 700;
  color: var(--textPrimary,#1E293B);
  margin-bottom: 8px;
}

.empty-subtext {
  font-size: 14px;
  color: var(--textTertiary,#94A3B8);
  margin-bottom: 24px;
  text-align: center;
  line-height: 1.6;
  white-space: pre-line;
}

.empty-btn {
  padding: 12px 32px;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  border-radius: 24px;
  box-shadow: 0 4px 14px rgba(59,130,246,0.3);
}

.empty-btn text {
  color: white;
  font-size: 15px;
  font-weight: 600;
}

/* ========== 热门推荐 ========== */
.popular-section {
  margin-top: 28px;
  padding-top: 20px;
  border-top: 1px solid var(--borderFaint,#F1F5F9);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.section-icon {
  font-size: 16px;
}

.section-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--textPrimary,#1E293B);
}

.section-subtitle {
  font-size: 12px;
  color: var(--textTertiary,#94A3B8);
}

.popular-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.popular-item {
  width: calc(50% - 5px);
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px;
  background: var(--cardBg,#FFFFFF);
  border-radius: 14px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.03);
  transition: all 0.2s ease;
  position: relative;
}

.popular-item-hover {
  transform: scale(0.97);
}

.popular-item.is-fav {
  border: 1.5px solid rgba(251, 191, 36, 0.3);
}

.popular-icon-wrap {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.popular-icon {
  font-size: 18px;
}

.popular-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--textPrimary,#1E293B);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.popular-fav {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popular-fav text {
  font-size: 16px;
}

.bottom-safe-area {
  height: 40px;
}

/* ========== 暗黑模式 ========== */
.dark-mode .main-scroll {
  background-color: var(--pageBg) !important;
}

.dark-mode .page-container {
  background-color: var(--pageBg);
}

.dark-mode .sort-toggle {
  background: rgba(51, 65, 85, 0.6);
}

.dark-mode .sort-label {
  color: #94A3B8;
}

.dark-mode .tool-item {
  background: var(--cardBg);
  border-color: rgba(100,116,139,0.3);
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

.dark-mode .popular-item {
  background: rgba(30, 41, 59, 0.6);
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

.dark-mode .popular-item.is-fav {
  border-color: rgba(251, 191, 36, 0.4);
}

.dark-mode .popular-section {
  border-top-color: rgba(51, 65, 85, 0.5);
}
