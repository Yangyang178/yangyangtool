<navigation-bar title="" back="{{false}}" color="{{isDarkMode ? 'white' : 'black'}}" background="{{isDarkMode ? '#0F172A' : '#F8FAFC'}}"></navigation-bar>

<canvas type="2d" id="shareCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>

<guide-overlay show="{{showGuide}}" bindclose="onGuideClose"></guide-overlay>

<skeleton show="{{isLoading}}" type="tools" dark="{{isDarkMode}}"></skeleton>

<scroll-view class="main-scroll {{isDarkMode ? 'dark-mode' : ''}} {{fontClass}}" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}" refresher-enabled="{{!isEditMode}}" refresher-triggered="{{isRefreshing}}" bindrefresherrefresh="onPullDownRefresh" scroll-top="{{scrollTop}}" bindscrolltoupper="onScrollToUpper" bindscroll="onPageScroll" lower-threshold="0">
  <view class="page-container {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}} {{fontClass}}" style="{{themeStyle}}">
    <!-- 应用头部 - Hero Section v2 -->
    <view class="header-section">
      <!-- 品牌标识区 -->
      <view class="header-brand">
        <text class="brand-logo">🧰</text>
        <view class="brand-text">
          <text class="brand-title">{{i18n.brandTitle}}</text>
          <view class="version-badge">
            <text>v2.0</text>
          </view>
        </view>
      </view>

      <!-- 价值主张 -->
      <view class="value-proposition">
        <text class="slogan">{{isEditMode ? i18n.editModeTip : i18n.slogan}}</text>
      </view>

      <!-- 今日推荐卡片 -->
    <view class="today-tip-card" wx:if="{{todayTip && !isEditMode}}" bindtap="onTodayTipClick">
      <view class="tip-card-left">
        <view class="tip-badge">
          <text>💡 {{i18n.todayRecommend}}</text>
        </view>
        <text class="tip-card-title">{{todayTip.title}}</text>
        <text class="tip-card-desc">{{todayTip.desc}}</text>
        <view class="tip-card-footer">
          <text class="tip-card-category">{{todayTip.category}}</text>
          <text class="tip-card-action">{{i18n.tryNow}} ›</text>
        </view>
      </view>
      <view class="tip-card-right" wx:if="{{todayTip.tool}}">
        <view class="tip-tool-icon" style="background: {{todayTip.tool.iconBg}}">
          <text>{{todayTip.tool.icon}}</text>
        </view>
      </view>
    </view>

    <!-- 工具推荐模块 -->
    <view class="recommend-section recommend-in-header" wx:if="{{recommendedTools.length > 0 && !isEditMode}}">
      <view class="recommend-header">
        <view class="recommend-title-row">
          <text class="recommend-icon">🎯</text>
          <text class="recommend-title recommend-title-light">{{i18n.recommendForYou}}</text>
        </view>
      </view>
      <scroll-view class="recommend-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="recommend-list">
          <view 
            wx:for="{{recommendedTools}}" 
            wx:key="id"
            class="recommend-item recommend-item-glass"
            data-tool="{{item}}"
            bindtap="onRecommendToolClick"
          >
            <view class="recommend-icon-wrap" style="background: {{item.iconBg}}">
              <text class="recommend-emoji">{{item.icon}}</text>
            </view>
            <text class="recommend-name recommend-name-light">{{item.name}}</text>
            <text class="recommend-reason recommend-reason-light">{{item.reason}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 最近使用工具 -->
    <view class="recent-section" wx:if="{{recentTools.length > 0}}">
      <view class="recent-header">
        <text class="recent-title">🕐 {{i18n.recentUse}}</text>
        <view class="recent-more-btn" bindtap="showRecentModalFn">
          <text class="recent-more-text">{{i18n.viewAll}}</text>
          <text class="recent-arrow">›</text>
        </view>
      </view>

      <!-- 默认只显示前2个记录（使用JS层过滤后的数组） -->
      <view class="recent-list-inline">
        <block wx:for="{{displayRecentTools}}" wx:key="id">
          <view class="recent-item" bindtap="onRecentToolClick" data-tool="{{item}}">
            <view class="recent-icon-wrap" style="background: {{item.iconBg}}">{{item.icon}}</view>
            <view class="recent-info">
              <text class="recent-name">{{item.name}}</text>
              <text class="recent-time">{{item.usedAt ? item.usedAt : ''}}</text>
            </view>
            <text class="recent-arrow-right">›</text>
          </view>
        </block>
      </view>

      <!-- 更多提示 -->
      <view class="recent-more-hint" wx:if="{{recentTools.length > 2}}" bindtap="showRecentModalFn">
        <text class="recent-hint-text">{{moreRecordsText}}</text>
      </view>
    </view>

      <!-- 数据信任条 -->
      <view class="trust-bar" wx:if="{{!isEditMode}}">
        <view class="trust-item">
          <text class="trust-number">40+</text>
          <text class="trust-label">{{i18n.practicalTools}}</text>
        </view>
        <view class="trust-divider"></view>
        <view class="trust-item">
          <text class="trust-number">{{totalUsageDisplay}}</text>
          <text class="trust-label">{{i18n.totalUsage}}</text>
        </view>
        <view class="trust-divider"></view>
        <view class="trust-item">
          <text class="trust-number">100%</text>
          <text class="trust-label">{{i18n.freeUse}}</text>
        </view>
      </view>

      <!-- 趣味测试入口横幅 -->
      <view class="fun-banner" bindtap="openFunZone" wx:if="{{!isEditMode}}">
        <view class="fun-banner-left">
          <view class="fun-banner-icons">
            <text class="fun-banner-main-icon">🧠</text>
          </view>
          <view class="fun-banner-info">
            <text class="fun-banner-title">{{i18n.funTest}}</text>
            <text class="fun-banner-desc">{{i18n.funTestDesc}}</text>
          </view>
        </view>
        <view class="fun-banner-right">
          <text class="fun-banner-action">{{i18n.goChallenge}} ›</text>
        </view>
      </view>

      <!-- 右侧操作区域 -->
      <view class="header-right" bindtap="{{isEditMode ? '' : 'showMoreMenu'}}">
        <text class="greeting-text">{{greetingText}}</text>
        <view class="edit-mode-btn {{isEditMode ? 'active' : ''}}" catchtap="toggleEditMode" wx:if="{{!isEditMode}}">
          <text class="edit-icon">✏️</text>
        </view>
        <view class="more-icon" wx:if="{{!isEditMode}}">
          <text class="dot"></text>
          <text class="dot"></text>
          <text class="dot"></text>
        </view>
        <view class="edit-actions" wx:if="{{isEditMode}}">
          <view class="edit-row-top">
            <view class="edit-action-btn done-btn" catchtap="toggleEditMode">
              <text>{{i18n.done}}</text>
            </view>
            <view class="edit-action-btn reset-btn" catchtap="resetLayout">
              <text>{{i18n.resetLayout}}</text>
            </view>
          </view>
          <view class="edit-row-bottom">
            <view class="edit-action-btn undo-btn {{canUndo ? 'can-undo' : ''}}" catchtap="undoLastAction">
              <text>{{i18n.undoLastStep}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 编辑模式提示条 -->
      <view class="edit-tip-bar {{isEditMode ? 'show' : ''}}" wx:if="{{isEditMode}}">
        <text class="tip-text">{{i18n.editTipBar}}</text>
      </view>
    </view>

    <!-- 搜索栏 v2 - Task B3 增强 -->
    <view class="search-bar {{showSearchPanel ? 'active' : ''}}">
      <view class="search-input-wrapper">
        <input
          class="search-input"
          type="text"
          placeholder="{{i18n.searchPlaceholder}}"
          placeholder-class="search-placeholder"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          bindfocus="onSearchFocus"
          bindblur="onSearchBlur"
          confirm-type="search"
        />
        <view class="clear-btn {{searchKeyword ? 'show' : ''}}" bindtap="clearSearch">
          <text>✕</text>
        </view>
      </view>

      <!-- 搜索面板 v2 -->
      <view class="search-panel" wx:if="{{showSearchPanel}}">
        <!-- 搜索历史 -->
        <view class="search-section" wx:if="{{searchHistory.length > 0}}">
          <view class="section-header">
            <view class="section-title-wrapper">
              <text class="section-icon">🕐</text>
              <text class="section-title">{{i18n.recentSearch}}</text>
            </view>
            <text class="clear-history-btn" bindtap="clearSearchHistory">
              <text class="clear-history-icon">🗑️</text>
              <text>{{i18n.clearAll}}</text>
            </text>
          </view>
          <scroll-view class="history-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="history-tags">
              <view class="history-tag" wx:for="{{searchHistory}}" wx:key="index" bindtap="onHistoryClick" data-word="{{item}}">
                <text class="history-tag-text">{{item}}</text>
                <text class="history-tag-arrow">→</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <!-- 热门搜索 -->
        <view class="search-section">
          <view class="section-header">
            <view class="section-title-wrapper">
              <text class="section-icon">🔥</text>
              <text class="section-title">{{i18n.hotRecommend}}</text>
            </view>
          </view>
          <view class="hot-tags">
            <view 
              class="hot-tag {{index < 3 ? 'top-hot' : ''}}" 
              wx:for="{{hotSearchWords}}" 
              wx:key="index" 
              bindtap="onHotSearchClick" 
              data-word="{{item}}"
            >
              <view class="hot-tag-rank" wx:if="{{index < 3}}">
                <text>{{index + 1}}</text>
              </view>
              <text class="hot-tag-text">{{item}}</text>
              <text class="hot-tag-fire" wx:if="{{index < 3}}">🔥</text>
            </view>
          </view>
        </view>

        <!-- 快捷提示 -->
        <view class="search-tip">
          <text class="tip-text">{{i18n.searchTip}}</text>
        </view>
      </view>
    </view>

    <!-- 分类快捷标签栏 -->
    <scroll-view class="category-tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="tabs-container">
        <view 
          wx:for="{{categories}}" 
          wx:key="id"
          class="tab-item {{currentCategory === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onCategoryChange"
        >
          <text class="tab-text">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 工具网格区域 -->
    <view class="tools-grid {{isEditMode ? 'edit-mode' : ''}}">
      <view 
        wx:for="{{filteredTools}}" 
        wx:key="id"
        class="tool-card {{item.isFavorite ? 'favorite' : ''}} {{selectedToolIndex === index ? 'selected' : ''}}"
        data-tool="{{item}}"
        data-index="{{index}}"
        bindtap="{{isEditMode ? 'onEditToolClick' : 'onToolClick'}}"
        hover-class="{{isEditMode ? 'tool-card-edit-hover' : 'tool-card-hover'}}"
        hover-stay-time="100"
      >
        <view class="card-favorite" catchtap="toggleFavorite" data-id="{{item.id}}" wx:if="{{!isEditMode}}">
          <text>{{item.isFavorite ? '★' : '☆'}}</text>
        </view>

        <!-- 编辑模式：显示/隐藏按钮 -->
        <view
          class="card-visibility {{hiddenTools.indexOf(item.id) !== -1 ? 'hidden-tool' : ''}}"
          catchtap="toggleToolVisibility"
          data-id="{{item.id}}"
          wx:if="{{isEditMode}}"
        >
          <text>{{hiddenTools.indexOf(item.id) !== -1 ? '👁️‍🗨️' : '👁️'}}</text>
        </view>

        <!-- 选中标记 -->
        <view class="selected-overlay" wx:if="{{isEditMode && selectedToolIndex === index}}">
          <view class="selected-ring"></view>
          <view class="selected-badge">
            <text>{{i18n.selected}}</text>
          </view>
          <view class="selected-hint">
            <text>{{i18n.tapToSwap}}</text>
          </view>
        </view>

        <view class="card-icon-wrapper" style="background: {{item.iconBg}}">
          <text class="card-icon">{{item.icon}}</text>
        </view>

        <rich-text class="card-title" nodes="{{item._highlighted.name || item.name}}"></rich-text>
        <rich-text class="card-desc" nodes="{{item._highlighted.description || item.description}}"></rich-text>

        <view class="card-badge" wx:if="{{item.isHot}}">
          <text>{{i18n.hot}}</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{filteredTools.length === 0}}">
        <text class="empty-icon">🔍</text>
        <text class="empty-text">{{i18n.noToolsFound}}</text>
        <text class="empty-subtext">{{i18n.tryOtherKeywords}}</text>
      </view>
    </view>

    <!-- 已隐藏工具管理区 -->
    <view class="hidden-tools-section {{isEditMode && hiddenTools.length > 0 ? 'show' : ''}}" wx:if="{{isEditMode}}">
      <view class="hidden-header">
        <text class="hidden-title">{{hiddenToolsText}}</text>
        <text class="hidden-hint">{{i18n.tapToRestore}}</text>
      </view>
      
      <scroll-view class="hidden-tools-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{hiddenToolsList.length > 0}}">
        <view class="hidden-tools-list">
          <view 
            wx:for="{{hiddenToolsList}}" 
            wx:key="id"
            class="hidden-tool-item"
            data-id="{{item.id}}"
            catchtap="restoreHiddenTool"
          >
            <view class="hidden-icon-wrapper" style="background: {{item.iconBg}}">
              <text class="hidden-icon">{{item.icon}}</text>
            </view>
            <text class="hidden-name">{{item.name}}</text>
            <view class="restore-badge">
              <text>{{i18n.restore}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
      
      <view class="no-hidden-tools" wx:if="{{hiddenToolsList.length === 0}}">
        <text>{{i18n.noHiddenTools}}</text>
      </view>
    </view>

    <!-- 底部安全区域占位 -->
    <view class="bottom-safe-area"></view>
  </view>
</scroll-view>

<!-- 最近使用弹窗 - 必须放在scroll-view外部，确保fixed定位在真机正常工作 -->
<view class="modal-mask" wx:if="{{showRecentModal}}" bindtap="hideRecentModal"></view>
<view class="modal-container recent-modal" wx:if="{{showRecentModal}}">
  <view class="modal-header">
    <text class="modal-title">{{allRecentUseText}}</text>
    <view class="modal-close-btn" bindtap="hideRecentModal">
      <text>✕</text>
    </view>
  </view>

  <scroll-view scroll-y class="modal-body" style="max-height: 500px;">
    <block wx:for="{{recentTools}}" wx:key="id">
      <view class="recent-item-modal" bindtap="onRecentToolClick" data-tool="{{item}}">
        <view class="recent-icon-wrap" style="background: {{item.iconBg}}">{{item.icon}}</view>
        <view class="recent-info">
          <text class="recent-name">{{item.name}}</text>
          <text class="recent-time">{{item.usedAt ? item.usedAt : ''}}</text>
        </view>
        <text class="recent-arrow-right">›</text>
      </view>
    </block>

    <!-- 空状态 -->
    <view class="recent-empty-modal" wx:if="{{recentTools.length === 0}}">
      <text class="recent-empty-text">{{i18n.noRecentRecord}}</text>
      <text class="recent-empty-desc">{{i18n.recentRecordTip}}</text>
    </view>
  </scroll-view>

  <view class="modal-footer">
    <button class="btn-secondary btn-sm" bindtap="hideRecentModal">{{i18n.close}}</button>
  </view>
</view>

<privacy-popup />