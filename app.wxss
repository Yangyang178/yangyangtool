}
.font-family-song {
  --fontFamilyBase: SimSun, STSong, serif;
  font-family: SimSun, STSong, serif !important;
}
.font-family-song view,
.font-family-song text,
.font-family-song input,
.font-family-song textarea,
.font-family-song button {
  font-family: SimSun, STSong, serif !important;
}
.font-family-fang {
  --fontFamilyBase: FangSong, STFangsong, serif;
  font-family: FangSong, STFangsong, serif !important;
}
.font-family-fang view,
.font-family-fang text,
.font-family-fang input,
.font-family-fang textarea,
.font-family-fang button {
  font-family: FangSong, STFangsong, serif !important;
}
.font-family-round {
  --fontFamilyBase: Hiragino Sans GB, YouYuan, sans-serif;
  font-family: Hiragino Sans GB, YouYuan, sans-serif !important;
}
.font-family-round view,
.font-family-round text,
.font-family-round input,
.font-family-round textarea,
.font-family-round button {
  font-family: Hiragino Sans GB, YouYuan, sans-serif !important;
}
.font-family-hei {
  --fontFamilyBase: SimHei, STHeiti, sans-serif;
  font-family: SimHei, STHeiti, sans-serif !important;
}
.font-family-hei view,
.font-family-hei text,
.font-family-hei input,
.font-family-hei textarea,
.font-family-hei button {
  font-family: SimHei, STHeiti, sans-serif !important;
}

/* ==================== 暗黑模式：一键覆盖所有变量 ==================== */
.dark-mode,
.dark-mode page {
  --pageBg: #0a0e1a;
  --cardBg: #1a2035;
  --surfaceBg: #1a2035;
  --elevatedBg: #232d42;

  --textPrimary: #F1F5F9;
  --textSecondary: #CBD5E1;
  --textTertiary: #94A3B8;
  --textMuted: #64748B;

  --borderLight: #334155;
  --borderFaint: #1E293B;
  --borderDark: rgba(71,85,105,0.25);

  --inputBg: #232d42;
  --inputBorder: #334155;
  --searchBg: #232d42;
  --searchBorder: rgba(148,163,184,0.2);

  --primaryColor: #60A5FA;
  --primaryLight: rgba(96,165,250,0.15);
  --primaryDark: #3B82F6;

  --dangerColor: #F87171;
  --successColor: #34D399;
  --warningColor: #FBBF24;
  --infoColor: #60A5FA;

  --shadowSm: 0 1px 3px rgba(0,0,0,0.3);
  --shadowMd: 0 4px 12px rgba(0,0,0,0.35);
  --shadowLg: 0 10px 30px rgba(0,0,0,0.4);
  --shadowCardNight: 0 4px 12px rgba(0,0,0,0.3);

  background-color: var(--pageBg) !important;
  color: var(--textPrimary);
}

/* ==================== 基础布局 ==================== */
.container {
  max-width: 500px;
  margin: 0 auto;
  padding: 0 20px;
}

.page-container,
.tool-page {
  background-color: var(--pageBg);
}

/* ==================== 卡片/区块（统一使用变量） ==================== */
.section-block,
.card,
.tool-item,
.input-card,
.result-card,
.tips-card,
.advice-card,
.color-preview-section,
.text-areas,
.action-buttons,
.action-row,
.history-section,
.settings-list,
.banner-ad,
.empty-state,
.bottom-info,
.nav-placeholder {
  background-color: var(--cardBg);
  box-shadow: var(--shadowSm);
}

.input-box,
.password-display,
.deduction-grid,
.deduction-item,
.deduction-value-box,
.text-area-wrapper,
.bmi-value-display,
.result-detail-item,
.diff-header,
.diff-line {
  background-color: var(--elevatedBg);
  border: 1px solid var(--borderDark);
}

/* ==================== 输入框 ==================== */
input,
textarea {
  background-color: transparent;
  color: var(--textPrimary);
  border: none;
  caret-color: var(--primaryColor);
}

.search-input {
  background-color: transparent;
  color: var(--textPrimary);
  border: none !important;
  padding: 0 !important;
  margin: 0 !important;
}

.search-input-wrapper::after,
.search-input-wrapper .search-input::after {
  display: none !important;
  border: none !important;
}

/* ==================== 文字颜色（统一变量） ==================== */
.page-title,
.tool-title,
.app-title,
.section-title,
.item-name,
.recent-name,
.tool-name,
.card-title,
.result-main-label,
.result-main-value,
.detail-label,
.detail-value,
.input-field,
.password-display,
.text-area,
.greeting-text,
.user-nickname,
.setting-name,
.fav-names,
.picker-hex-text,
.status-text,
.advice-text,
.tips-title,
.tips-text,
.tip-text,
.banner-text,
.empty-text,
.tool-desc,
.item-desc,
.card-desc,
.section-subtitle,
.page-subtitle,
.user-stats,
.input-label,
.area-label,
.deduction-name,
.deduction-unit,
.text-placeholder,
.diff-added,
.diff-removed,
.line-same,
.setting-value,
.empty-subtext,
.tip-icon {
  color: var(--textPrimary);
}

.tool-desc,
.item-desc,
.recent-time,
.setting-value,
.section-subtitle,
.page-subtitle,
.user-stats,
.input-label,
.area-label,
.deduction-name,
.deduction-unit,
.text-placeholder,
.empty-subtext,
.tip-icon,
.card-desc {
  color: var(--textSecondary);
}

/* ==================== 边框/分割线 ==================== */
.section-block,
.card,
.tool-item,
.input-card,
.search-bar,
.input-box,
.text-area,
.password-display,
.deduction-grid .deduction-item,
.deduction-value-box,
.result-card,
.tips-card,
.advice-card,
.color-preview-section,
.banner-ad,
.tools-grid .tool-card,
.see-all-btn,
.settings-list .setting-item {
  border-color: var(--borderDark);
}

.section-header,
.diff-header,
.result-header {
  border-bottom-color: var(--borderDark);
}

/* ==================== 按钮 ==================== */
.compare-btn,
.calc-btn,
.swap-btn,
.empty-btn,
.action-btn,
.category-tab.active {
  opacity: 0.95;
}

.category-tab {
  color: var(--textSecondary);
  background-color: transparent;
}

.category-tab.active {
  color: var(--primaryColor);
  background-color: var(--primaryLight);
}

/* ==================== 收藏星标 ==================== */
.card-favorite text {
  color: var(--textTertiary);
}
.tool-card.favorite .card-favorite text {
  color: var(--warningColor);
}

/* ==================== 收藏夹提示条 ==================== */
.favorite-tip {
  background: rgba(245,158,11,0.1);
  border-left-color: var(--warningColor);
}
.tip-icon { font-size: 16px; }
.tip-text {
  color: var(--warningColor);
}

/* ==================== 底部安全区 ==================== */
.bottom-safe-area {
  background-color: var(--pageBg);
}

/* ==================== 工具快捷操作栏（复制+重置） ==================== */
.tool-actions-bar {
  display: flex;
  gap: 10px;
  margin: 16px 0;
  padding: 0 4px;
}

.tool-action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 11px 16px;
  border-radius: 12px;
  border: none;
  font-size: 14px;
  font-weight: 600;
  margin: 0;
  line-height: 1.3;
  transition: opacity 0.15s ease;
}

.tool-action-btn::after { border: none; }

.tool-action-copy {
  background: var(--surfaceBg);
  color: var(--textPrimary);
  border: 1px solid var(--borderLight);
}

.tool-action-reset {
  background: transparent;
  color: var(--textTertiary);
  border: 1px dashed var(--borderLight);
}

.dark-mode .tool-action-copy {
  background: var(--elevatedBg);
  border-color: var(--borderDark);
}

.dark-mode .tool-action-reset {
  border-color: var(--borderDark);
}

/* ==================== 导航栏组件 ==================== */

/* ==================== icon wrapper ==================== */
.icon-wrapper {
  filter: none;
}
.dark-mode .icon-wrapper {
  filter: brightness(0.85);
}

/* ==================== 暗黑模式兜底（仅处理极少数无法用变量覆盖的场景） ==================== */
.dark-mode {
  background-color: var(--pageBg) !important;
}

.dark-mode .page-container,
.dark-mode .container,
.dark-mode .tool-page,
.dark-mode .section-block,
.dark-mode .card,
.dark-mode .tool-item,
.dark-mode .input-card,
.dark-mode .result-card,
.dark-mode .tips-card,
.dark-mode .advice-card,
.dark-mode .color-preview-section,
.dark-mode .text-areas,
.dark-mode .action-buttons,
.dark-mode .action-row,
.dark-mode .history-section,
.dark-mode .settings-list,
.dark-mode .banner-ad,
.dark-mode .empty-state,
.dark-mode .bottom-info,
.dark-mode .nav-placeholder,
.dark-mode .bottom-safe-area {
  background-color: var(--cardBg) !important;
  box-shadow: none !important;
}

.dark-mode input,
.dark-mode textarea {
  color: var(--textPrimary) !important;
  -webkit-appearance: none !important;
  caret-color: var(--primaryColor) !important;
}

.dark-mode navigation-bar,
.dark-mode .weui-navigation-bar {
  background-color: var(--pageBg) !important;
}

.dark-mode .weui-navigation-bar__inner {
  background-color: var(--pageBg) !important;
}

