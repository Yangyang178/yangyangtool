<tool-page
  title="{{toolTitle}}"
  desc="{{toolDesc}}"
  icon="{{toolIcon}}"
  iconBg="{{iconBg}}"
  badge="{{badge}}"
  actions="{{actionButtons}}"
  tips="{{tipList}}"
  tipsTitle="{{i18n.tipsTitle}}"
>
  
  <!-- 输入区（slot: input） -->
  <view slot="input" class="tp-input-section">
    <text class="tp-label">{{i18n.inputLabel}}</text>
    <input class="tp-standard-input" 
      type="text"
      placeholder="{{i18n.inputPlaceholder}}"
      value="{{inputValue}}"
      bindinput="onInput"
    />
  </view>

  <!-- 结果区（slot: result） -->
  <view slot="result" class="tp-result-section">
    <text class="tp-result-value">{{resultValue}}</text>
    <text class="tp-result-label">{{resultLabel}}</text>
    
    <view class="tp-divider"></view>
    
    <!-- 详细结果列表 -->
    <view class="detail-row">
      <text class="detail-label">{{i18n.item1}}</text>
      <text class="detail-value">{{detail1}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">{{i18n.item2}}</text>
      <text class="detail-value">{{detail2}}</text>
    </view>
  </view>

</tool-page>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>
