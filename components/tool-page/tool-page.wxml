<navigation-bar title="{{title}}" back="{{true}}" color="{{navColor}}" background="{{navBg}}"></navigation-bar>

<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} {{fontClass}}" style="{{themeStyle}}" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="tp-container">
    
    <view class="tp-header" wx:if="{{showHeader}}">
      <view class="tp-header-shortcut" bindtap="toggleShortcut" hover-class="tp-header-shortcut-hover">
        <text class="tp-header-shortcut-icon">{{isShortcut ? '⭐' : '☆'}}</text>
        <text class="tp-header-shortcut-text">{{isShortcut ? i18n.shortcutAddedBtn : i18n.addShortcutBtn}}</text>
      </view>
      <view class="tp-icon-wrap" style="background: {{iconBg || 'linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%)'}};">
        <text class="tp-icon">{{icon || '🔧'}}</text>
      </view>
      <text class="tp-title">{{title}}</text>
      <text class="tp-desc" wx:if="{{desc}}">{{desc}}</text>
      <view class="tp-badge" wx:if="{{badge}}">
        <text>{{badge}}</text>
      </view>
    </view>

    <slot name="input"></slot>

    <slot name="result"></slot>

    <view class="tp-quick-actions" wx:if="{{showCopyBtn || showResetBtn}}">
      <button 
        class="tp-quick-btn tp-quick-copy" 
        wx:if="{{showCopyBtn}}"
        bindtap="onCopyResult"
        hover-class="tp-btn-hover"
      >
        <text class="tp-quick-icon">📋</text>
        <text class="tp-quick-text">{{i18n.copyResult}}</text>
      </button>
      <button 
        class="tp-quick-btn tp-quick-reset" 
        wx:if="{{showResetBtn}}"
        bindtap="onResetData"
        hover-class="tp-btn-hover"
      >
        <text class="tp-quick-icon">🔄</text>
        <text class="tp-quick-text">{{i18n.reset}}</text>
      </button>
    </view>

    <view class="tp-actions" wx:if="{{actions.length > 0}}">
      <block wx:for="{{actions}}" wx:key="type">
        <button 
          class="tp-btn tp-btn-{{item.type || 'primary'}}" 
          bindtap="{{item.bindtap}}"
          hover-class="tp-btn-hover"
          data-action="{{item.type}}"
        >
          <text wx:if="{{item.icon}}" class="tp-btn-icon">{{item.icon}}</text>
          <text class="tp-btn-text">{{item.text}}</text>
        </button>
      </block>
    </view>

    <view class="tp-tips" wx:if="{{tips && tips.length > 0}}">
      <view class="tp-tips-title" wx:if="{{tipsTitle}}">{{tipsTitle}}</view>
      <view class="tp-tip-item" wx:for="{{tips}}" wx:key="*this">
        <text>• {{item}}</text>
      </view>
    </view>

    <slot name="extra"></slot>

    <view class="tp-related" wx:if="{{relatedTools.length > 0}}">
      <view class="tp-related-header">
        <text class="tp-related-title">🔍 {{i18n.relatedTools}}</text>
      </view>
      <view class="tp-related-list">
        <view 
          wx:for="{{relatedTools}}" 
          wx:key="id" 
          class="tp-related-item"
          data-route="{{item.route}}"
          bindtap="onRelatedTap"
          hover-class="tp-related-hover"
        >
          <view class="tp-related-icon" style="background: {{item.iconBg}}">
            <text>{{item.icon}}</text>
          </view>
          <view class="tp-related-info">
            <text class="tp-related-name">{{item.name}}</text>
            <text class="tp-related-desc">{{item.description}}</text>
          </view>
          <text class="tp-related-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="tp-footer-safe"></view>
  </view>
</scroll-view>
