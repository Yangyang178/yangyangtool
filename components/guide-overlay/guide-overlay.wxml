<view class="guide-mask" wx:if="{{show}}" catchtouchmove="preventMove">
  <swiper class="guide-swiper" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#FFFFFF" autoplay="{{false}}" current="{{current}}" bindchange="onSwiperChange">

    <!-- Page 1: Welcome -->
    <swiper-item class="guide-item">
      <view class="guide-content center">
        <view class="guide-icon-wrap hero-icon">
          <text class="guide-emoji">🧰</text>
        </view>
        <text class="guide-title">{{i18n.welcomeTitle}}</text>
        <text class="guide-desc">{{i18n.welcomeDesc}}</text>
        <view class="guide-tags">
          <text class="guide-tag">{{i18n.tagLocal}}</text>
          <text class="guide-tag">{{i18n.tagInstant}}</text>
          <text class="guide-tag">{{i18n.tagPrivacy}}</text>
        </view>
      </view>
    </swiper-item>

    <!-- Page 2: Daily Recommend + Search -->
    <swiper-item class="guide-item">
      <view class="guide-content">
        <view class="guide-highlight-box">
          <view class="highlight-tip-card">
            <view class="highlight-tip-badge">{{i18n.todayRecommend}}</view>
            <view class="highlight-tip-row">
              <view class="highlight-tip-info">
                <text class="highlight-tip-title">{{i18n.pomodoroTitle}}</text>
                <text class="highlight-tip-desc">{{i18n.pomodoroDesc}}</text>
              </view>
              <view class="highlight-tip-icon-wrap">
                <text class="highlight-tip-icon">🍅</text>
              </view>
            </view>
          </view>
          <view class="highlight-arrow-down"></view>
        </view>
        <view class="guide-highlight-box" style="margin-top: 16rpx;">
          <view class="highlight-search">
            <text class="highlight-icon">🔍</text>
            <text class="highlight-text">{{i18n.searchTools}}</text>
          </view>
          <view class="highlight-arrow-down"></view>
        </view>
        <text class="guide-title">{{i18n.dailyRecommendTitle}}</text>
        <text class="guide-desc">{{i18n.dailyRecommendDesc}}</text>
      </view>
    </swiper-item>

    <!-- Page 3: Category Folders -->
    <swiper-item class="guide-item">
      <view class="guide-content">
        <view class="guide-highlight-box">
          <view class="highlight-section-folder">
            <view class="highlight-section-header">
              <view class="highlight-section-left">
                <text class="highlight-section-icon">🧮</text>
                <text class="highlight-section-name">{{i18n.guideSectionCalc}}</text>
                <view class="highlight-section-count">
                  <text>{{i18n.guideSectionCountSample}}</text>
                </view>
              </view>
              <text class="highlight-section-arrow expanded">›</text>
            </view>
            <view class="highlight-section-tools">
              <view class="highlight-tool">
                <view class="highlight-tool-icon" style="background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%)">
                  <text>💱</text>
                </view>
                <text class="highlight-tool-name">{{i18n.toolExchange}}</text>
              </view>
              <view class="highlight-tool">
                <view class="highlight-tool-icon" style="background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%)">
                  <text>🏠</text>
                </view>
                <text class="highlight-tool-name">{{i18n.toolMortgage}}</text>
              </view>
            </view>
          </view>
          <view class="highlight-arrow-down"></view>
        </view>
        <view class="guide-highlight-box" style="margin-top: 16rpx;">
          <view class="highlight-section-folder collapsed-folder">
            <view class="highlight-section-header">
              <view class="highlight-section-left">
                <text class="highlight-section-icon">💻</text>
                <text class="highlight-section-name">{{i18n.guideSectionDev}}</text>
                <view class="highlight-section-count">
                  <text>{{i18n.guideSectionCountSample2}}</text>
                </view>
              </view>
              <text class="highlight-section-arrow">›</text>
            </view>
          </view>
          <view class="highlight-arrow-down"></view>
        </view>
        <text class="guide-title">{{i18n.searchCategoryTitle}}</text>
        <text class="guide-desc">{{i18n.searchCategoryDesc}}</text>
      </view>
    </swiper-item>

    <!-- Page 4: Checkin & Points -->
    <swiper-item class="guide-item">
      <view class="guide-content">
        <view class="guide-highlight-box">
          <view class="highlight-checkin-card">
            <view class="highlight-checkin-header">
              <text class="highlight-checkin-icon">📅</text>
              <text class="highlight-checkin-title">{{i18n.guideCheckinTitle}}</text>
            </view>
            <view class="highlight-checkin-streak">
              <view class="highlight-streak-day active"><text class="streak-num">1</text></view>
              <view class="highlight-streak-day active"><text class="streak-num">2</text></view>
              <view class="highlight-streak-day active"><text class="streak-num">3</text></view>
              <view class="highlight-streak-day current"><text class="streak-num">4</text></view>
              <view class="highlight-streak-day"><text class="streak-num">5</text></view>
              <view class="highlight-streak-day"><text class="streak-num">6</text></view>
              <view class="highlight-streak-day"><text class="streak-num">7</text></view>
            </view>
            <view class="highlight-points-row">
              <text class="highlight-points-icon">💎</text>
              <text class="highlight-points-text">{{i18n.guidePointsSample}}</text>
            </view>
          </view>
          <view class="highlight-arrow-down"></view>
        </view>
        <text class="guide-title">{{i18n.checkinPointsTitle}}</text>
        <text class="guide-desc">{{i18n.checkinPointsDesc}}</text>
      </view>
    </swiper-item>

    <!-- Page 5: Favorites & Achievements -->
    <swiper-item class="guide-item">
      <view class="guide-content">
        <view class="guide-highlight-box">
          <view class="highlight-fav">
            <text class="highlight-star">⭐</text>
            <text class="highlight-fav-text">{{i18n.guideFavExample}}</text>
          </view>
          <view class="highlight-arrow-down"></view>
        </view>
        <view class="guide-highlight-box" style="margin-top: 16rpx;">
          <view class="highlight-ach-row">
            <view class="highlight-ach unlocked">
              <text class="highlight-ach-icon">🎯</text>
              <text class="highlight-ach-name">{{i18n.achFirstStep}}</text>
            </view>
            <view class="highlight-ach unlocked">
              <text class="highlight-ach-icon">🧭</text>
              <text class="highlight-ach-name">{{i18n.achExplorer}}</text>
            </view>
            <view class="highlight-ach locked">
              <text class="highlight-ach-icon">🔒</text>
              <text class="highlight-ach-name">{{i18n.achLocked}}</text>
            </view>
          </view>
          <view class="highlight-arrow-down"></view>
        </view>
        <text class="guide-title">{{i18n.favAchTitle}}</text>
        <text class="guide-desc">{{i18n.favAchDesc}}</text>
      </view>
    </swiper-item>

    <!-- Page 6: Personalization -->
    <swiper-item class="guide-item">
      <view class="guide-content">
        <view class="guide-highlight-box">
          <view class="highlight-settings-card">
            <view class="highlight-setting-item">
              <text class="highlight-setting-icon">🎨</text>
              <text class="highlight-setting-name">{{i18n.guideThemeColor}}</text>
            </view>
            <view class="highlight-setting-item">
              <text class="highlight-setting-icon">🌙</text>
              <text class="highlight-setting-name">{{i18n.guideDarkMode}}</text>
            </view>
            <view class="highlight-setting-item">
              <text class="highlight-setting-icon">🔤</text>
              <text class="highlight-setting-name">{{i18n.guideFontSize}}</text>
            </view>
            <view class="highlight-setting-item">
              <text class="highlight-setting-icon">🌐</text>
              <text class="highlight-setting-name">{{i18n.guideLanguage}}</text>
            </view>
          </view>
          <view class="highlight-arrow-down"></view>
        </view>
        <text class="guide-title">{{i18n.personalizeTitle}}</text>
        <text class="guide-desc">{{i18n.personalizeDesc}}</text>
      </view>
    </swiper-item>

    <!-- Page 7: Start -->
    <swiper-item class="guide-item">
      <view class="guide-content center">
        <view class="guide-icon-wrap feature-icon">
          <text class="guide-emoji">✨</text>
        </view>
        <text class="guide-title">{{i18n.moreFeaturesTitle}}</text>
        <view class="feature-grid">
          <view class="feature-item">
            <text class="feature-emoji">🖼️</text>
            <text class="feature-name">{{i18n.featureBatchImage}}</text>
          </view>
          <view class="feature-item">
            <text class="feature-emoji">💧</text>
            <text class="feature-name">{{i18n.featureWaterReminder}}</text>
          </view>
          <view class="feature-item">
            <text class="feature-emoji">🌍</text>
            <text class="feature-name">{{i18n.featureCrossTimezone}}</text>
          </view>
          <view class="feature-item">
            <text class="feature-emoji">💱</text>
            <text class="feature-name">{{i18n.featureOfflineRate}}</text>
          </view>
          <view class="feature-item">
            <text class="feature-emoji">🎬</text>
            <text class="feature-name">{{i18n.featureDanmaku}}</text>
          </view>
          <view class="feature-item">
            <text class="feature-emoji">🎭</text>
            <text class="feature-name">{{i18n.featureMemeMaker}}</text>
          </view>
        </view>
        <text class="guide-desc">{{i18n.allLocalDesc}}</text>
      </view>
    </swiper-item>

  </swiper>

  <view class="guide-footer">
    <view class="skip-btn" bindtap="onSkip" wx:if="{{current < 6}}">
      <text>{{i18n.skip}}</text>
    </view>
    <view class="start-btn {{current === 6 ? 'active' : ''}}" bindtap="{{current === 6 ? 'onStart' : 'onNext'}}">
      <text>{{current === 6 ? i18n.startNow : i18n.nextStep}}</text>
      <text class="btn-arrow" wx:if="{{current < 6}}">→</text>
    </view>
  </view>
</view>
