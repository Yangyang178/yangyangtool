.guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.95);
  z-index: 9999;
}

.guide-swiper {
  width: 100%;
  height: calc(100vh - 180rpx);
  margin-top: 60rpx;
}

.guide-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.guide-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 40rpx 48rpx;
}

.guide-content.center {
  justify-content: center;
}

.guide-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.guide-icon-wrap.hero-icon {
  background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%);
  box-shadow: 0 8px 32rpx rgba(59, 130, 246, 0.35);
  width: 140rpx;
  height: 140rpx;
  border-radius: 42rpx;
}

.guide-icon-wrap.feature-icon {
  background: linear-gradient(135deg, #8B5CF6 0%, #6D28D9 100%);
  box-shadow: 0 8px 32rpx rgba(139, 92, 246, 0.35);
  width: 140rpx;
  height: 140rpx;
  border-radius: 42rpx;
}

.guide-emoji {
  font-size: 60rpx;
}

.hero-icon .guide-emoji,
.feature-icon .guide-emoji {
  font-size: 70rpx;
}

.guide-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 20rpx;
  text-align: center;
}

.guide-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  line-height: 1.8;
  white-space: pre-line;
}

.guide-tags {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.guide-tag {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  background: rgba(255,255,255,0.1);
  border: 1rpx solid rgba(255,255,255,0.15);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.guide-highlight-box {
  margin-bottom: 56rpx;
  position: relative;
}

.highlight-search {
  display: flex;
  align-items: center;
  background: #1E293B;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  gap: 16rpx;
  box-shadow: 0 0 0 6rpx rgba(59, 130, 246, 0.3), 0 12rpx 40rpx rgba(59, 130, 246, 0.2);
  animation: pulse-highlight 2s ease-in-out infinite;
}

.highlight-icon {
  font-size: 32rpx;
}

.highlight-text {
  font-size: 26rpx;
  color: #94A3B8;
}

.highlight-tabs {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #1E293B;
  border-radius: 16rpx;
  box-shadow: 0 0 0 6rpx rgba(59, 130, 246, 0.3), 0 12rpx 40rpx rgba(59, 130, 246, 0.2);
  animation: pulse-highlight 2s ease-in-out infinite;
}

.highlight-tab {
  padding: 10rpx 28rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #94A3B8;
}

.highlight-tab.active {
  background: #3B82F6;
  color: #FFFFFF;
}

.highlight-fav {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 40rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border-radius: 16rpx;
  box-shadow: 0 0 0 6rpx rgba(245, 158, 11, 0.3), 0 12rpx 40rpx rgba(245, 158, 11, 0.2);
  animation: pulse-highlight 2s ease-in-out infinite;
}

.highlight-star {
  font-size: 36rpx;
  color: #F59E0B;
}

.highlight-fav-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #92400E;
}

.highlight-arrow-down {
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 20rpx solid rgba(59, 130, 246, 0.5);
  margin-top: 24rpx;
  margin-left: auto;
  margin-right: auto;
  animation: bounce-down 1.5s ease-in-out infinite;
}

@keyframes pulse-highlight {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03); }
}

@keyframes bounce-down {
  0%, 100% { transform: translateY(0); opacity: 0.6; }
  50% { transform: translateY(12rpx); opacity: 1; }
}

.highlight-tip-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.3), 0 12rpx 40rpx rgba(102, 126, 234, 0.2);
  animation: pulse-highlight 2s ease-in-out infinite;
  min-width: 520rpx;
}

.highlight-tip-badge {
  display: inline-flex;
  padding: 6rpx 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 12rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.95);
  font-weight: 700;
  margin-bottom: 20rpx;
}

.highlight-tip-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.highlight-tip-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.highlight-tip-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.highlight-tip-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

.highlight-tip-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255,255,255,0.2);
}

.highlight-tip-icon {
  font-size: 40rpx;
}

.highlight-tools-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 24rpx;
  background: #1E293B;
  border-radius: 20rpx;
  box-shadow: 0 0 0 6rpx rgba(139, 92, 246, 0.3), 0 12rpx 40rpx rgba(139, 92, 246, 0.2);
  animation: pulse-highlight 2s ease-in-out infinite;
  min-width: 480rpx;
}

.highlight-tool {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 12rpx;
}

.highlight-tool-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.highlight-tool-name {
  font-size: 22rpx;
  color: #E2E8F0;
  font-weight: 500;
}

.highlight-ach-row {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  background: #1E293B;
  border-radius: 20rpx;
  box-shadow: 0 0 0 6rpx rgba(245, 158, 11, 0.3), 0 12rpx 40rpx rgba(245, 158, 11, 0.2);
  animation: pulse-highlight 2s ease-in-out infinite;
  min-width: 520rpx;
}

.highlight-ach {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  flex: 1;
}

.highlight-ach.unlocked {
  background: linear-gradient(135deg, rgba(251,191,36,0.15) 0%, rgba(217,119,6,0.1) 100%);
  border: 1rpx solid rgba(251,191,36,0.2);
}

.highlight-ach.locked {
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.06);
}

.highlight-ach-icon {
  font-size: 36rpx;
}

.highlight-ach-name {
  font-size: 20rpx;
  font-weight: 600;
  color: #E2E8F0;
}

.highlight-ach.locked .highlight-ach-name {
  color: #475569;
}

.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
  margin-top: 32rpx;
  margin-bottom: 28rpx;
  width: 100%;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 12rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.08);
}

.feature-emoji {
  font-size: 40rpx;
}

.feature-name {
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
  font-weight: 500;
  text-align: center;
}

.guide-footer {
  position: fixed;
  bottom: calc(80rpx + 50px + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 48rpx;
}

.skip-btn {
  padding: 16rpx 32rpx;
}

.skip-btn text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

.start-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 22rpx 48rpx;
  border-radius: 50rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.25);
}

.start-btn.active {
  background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%);
  border-color: transparent;
  padding: 22rpx 56rpx;
  box-shadow: 0 8px 32rpx rgba(59, 130, 246, 0.4);
}

.start-btn text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.btn-arrow {
  font-size: 28rpx;
}

.highlight-checkin-card {
  background: linear-gradient(135deg, #059669 0%, #047857 100%);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 0 0 6rpx rgba(5, 150, 105, 0.3), 0 12rpx 40rpx rgba(5, 150, 105, 0.2);
  animation: pulse-highlight 2s ease-in-out infinite;
  min-width: 520rpx;
}

.highlight-checkin-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.highlight-checkin-icon {
  font-size: 32rpx;
}

.highlight-checkin-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.highlight-checkin-streak {
  display: flex;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.highlight-streak-day {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: rgba(255,255,255,0.1);
  border: 2rpx solid rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.highlight-streak-day.active {
  background: rgba(255,255,255,0.2);
  border-color: rgba(255,255,255,0.3);
}

.highlight-streak-day.current {
  background: rgba(251,191,36,0.3);
  border-color: #FBBF24;
}

.streak-num {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  font-weight: 600;
}

.highlight-streak-day.active .streak-num,
.highlight-streak-day.current .streak-num {
  color: #FFFFFF;
}

.highlight-points-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 12rpx;
}

.highlight-points-icon {
  font-size: 24rpx;
}

.highlight-points-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 600;
}

.highlight-settings-card {
  background: #1E293B;
  border-radius: 20rpx;
  padding: 8rpx 0;
  box-shadow: 0 0 0 6rpx rgba(99, 102, 241, 0.3), 0 12rpx 40rpx rgba(99, 102, 241, 0.2);
  animation: pulse-highlight 2s ease-in-out infinite;
  min-width: 480rpx;
}

/* 分类折叠区样式 */
.highlight-section-folder {
  background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.3), 0 12rpx 40rpx rgba(102, 126, 234, 0.2);
  animation: pulse-highlight 2s ease-in-out infinite;
  min-width: 520rpx;
}

.collapsed-folder {
  box-shadow: 0 0 0 6rpx rgba(148, 163, 184, 0.2), 0 8rpx 24rpx rgba(148, 163, 184, 0.1);
}

.highlight-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.highlight-section-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.highlight-section-icon {
  font-size: 32rpx;
}

.highlight-section-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.highlight-section-count {
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.highlight-section-count text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.highlight-section-arrow {
  font-size: 32rpx;
  color: #94A3B8;
  font-weight: 600;
  transition: all 0.3s ease;
}

.highlight-section-arrow.expanded {
  transform: rotate(90deg);
  color: #667eea;
}

.highlight-section-tools {
  display: flex;
  gap: 16rpx;
  padding: 0 28rpx 24rpx;
}

.highlight-setting-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}

.highlight-setting-item:last-child {
  border-bottom: none;
}

.highlight-setting-icon {
  font-size: 28rpx;
}

.highlight-setting-name {
  font-size: 26rpx;
  color: #E2E8F0;
  font-weight: 500;
}
