}

.dark-mode .library-category-tag {
  background: var(--borderLight,#374151);
  color: var(--textMuted,#475569);
}

.dark-mode .library-pattern {
  color: var(--accentPurple,#A78BFA);
}

.dark-mode .cheat-toggle {
  background: rgba(139, 92, 246, 0.15);
  color: var(--accentPurple,#A78BFA);
}

.dark-mode .cheat-category-header {
  background: var(--cardBg,#1a2035);
}

.dark-mode .cheat-category-name {
  color: var(--textPrimary,#F1F5F9);
}

.dark-mode .cheat-category-arrow {
  color: var(--textMuted,#475569);
}

.dark-mode .cheat-item {
  background: var(--cardBg,#1a2035);
}

.dark-mode .cheat-syntax {
  color: var(--accentPurple,#A78BFA);
}

.dark-mode .cheat-desc {
  color: var(--textSecondary,#94A3B8);
}
