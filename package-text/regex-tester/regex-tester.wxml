<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>
<skeleton show="{{isLoading}}" type="tool" dark="{{isDarkMode}}"></skeleton>
<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}} {{fontClass}}" scroll-y>
  <view class="container">
    <view class="tool-header">
      <view class="icon-wrapper" style="background: linear-gradient(135deg, #8B5CF633 0%, #8B5CF666 100%);">
        <view class="icon-decoration"></view>
        <text class="tool-icon">🔍</text>
      </view>
      <text class="tool-title">{{i18n.toolTitle}}</text>
      <text class="tool-desc">{{i18n.toolDesc}}</text>
    </view>

    <view class="regex-input-section">
      <view class="section-header-row">
        <text class="section-label">{{i18n.regexLabel}}</text>
        <view class="regex-actions">
          <view class="action-tag sample" bindtap="loadSampleRegex">
            <text>{{i18n.sampleBtn}}</text>
          </view>
          <view class="action-tag clear" bindtap="clearRegex">
            <text>{{i18n.clearBtn}}</text>
          </view>
        </view>
      </view>

      <view class="regex-input-wrapper">
        <text class="regex-slash">/</text>
        <input
          class="regex-input"
          placeholder="{{i18n.regexPlaceholder}}"
          value="{{regexPattern}}"
          bindinput="onRegexInput"
        />
        <text class="regex-slash">/</text>
        <view class="flags-display">{{currentFlags}}</view>
      </view>

      <view class="flags-section">
        <text class="flags-label">{{i18n.flagsLabel}}</text>
        <view
          class="flag-btn {{flags.g ? 'active' : ''}}"
          data-flag="g"
          bindtap="toggleFlag"
        >
          <text class="flag-name">g</text>
          <text class="flag-desc">{{i18n.flagGlobal}}</text>
        </view>
        <view
          class="flag-btn {{flags.i ? 'active' : ''}}"
          data-flag="i"
          bindtap="toggleFlag"
        >
          <text class="flag-name">i</text>
          <text class="flag-desc">{{i18n.flagIgnoreCase}}</text>
        </view>
        <view
          class="flag-btn {{flags.m ? 'active' : ''}}"
          data-flag="m"
          bindtap="toggleFlag"
        >
          <text class="flag-name">m</text>
          <text class="flag-desc">{{i18n.flagMultiline}}</text>
        </view>
      </view>

      <view wx:if="{{errorMsg}}" class="error-msg">
        <text class="error-icon">❌</text>
        <text class="error-text">{{errorMsg}}</text>
      </view>
    </view>

    <view class="test-text-section">
      <view class="section-header-row">
        <text class="section-label">{{i18n.testTextLabel}}</text>
        <view class="test-actions">
          <view class="action-tag paste" bindtap="pasteText">
            <text>{{i18n.pasteBtn}}</text>
          </view>
        </view>
      </view>

      <textarea
        class="test-textarea"
        placeholder="{{i18n.testTextPlaceholder}}"
        value="{{testText}}"
        bindinput="onTextInput"
        auto-height
        maxlength="-1"
      ></textarea>

      <view class="text-stats">
        <text class="stat-item">{{i18n.charCountLabel}}: {{textLength}}</text>
        <text class="stat-item">{{i18n.lineCountLabel}}: {{lineCount}}</text>
      </view>
    </view>

    <view class="action-buttons">
      <view class="main-btn test" bindtap="testRegex">
        <text>{{i18n.testMatchBtn}}</text>
      </view>
      <view class="main-btn replace" bindtap="showReplacePanel">
        <text>{{i18n.replaceBtn}}</text>
      </view>
    </view>

    <view wx:if="{{showReplace}}" class="replace-section">
      <view class="replace-input-group">
        <text class="replace-label">{{i18n.replaceLabel}}</text>
        <input
          class="replace-input"
          placeholder="{{i18n.replacePlaceholder}}"
          value="{{replaceText}}"
          bindinput="onReplaceInput"
        />
      </view>
      <view class="replace-btn" bindtap="executeReplace">
        <text>{{i18n.executeReplaceBtn}}</text>
      </view>
    </view>

    <view wx:if="{{matchResult}}" class="result-section">
      <view class="result-header">
        <text class="result-title">{{i18n.matchResultTitle}}</text>
        <view class="match-stats">
          <view class="stat-badge success">
            <text>✅ {{matchCount}} {{i18n.matchCountUnit}}</text>
          </view>
        </view>
      </view>

      <view class="highlighted-text">
        <rich-text nodes="{{highlightedText}}"></rich-text>
      </view>

      <view wx:if="{{matches.length > 0}}" class="matches-list">
        <text class="matches-title">{{i18n.matchDetailTitle}}</text>
        <view
          class="match-item"
          wx:for="{{matches}}"
          wx:key="index"
        >
          <view class="match-index">
            <text>#{{index + 1}}</text>
          </view>
          <view class="match-content">
            <text class="match-value">"{{item.match}}"</text>
            <text class="match-position">{{i18n.positionLabel}}: {{item.index}}</text>
          </view>
          <view wx:if="{{item.groups.length > 0}}" class="match-groups">
            <text class="group-label">{{i18n.captureGroupLabel}}</text>
            <view class="group-tags">
              <view
                class="group-tag group-color-{{gItem.index % 8}}"
                wx:for="{{item.groups}}"
                wx:for-item="gItem"
                wx:key="index"
              >
                <text>${{gItem.index}}: {{gItem.value}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{!matchResult && hasTested}}" class="no-match-section">
      <text class="no-match-icon">😕</text>
      <text class="no-match-text">{{i18n.noMatchText}}</text>
    </view>

    <view class="tool-actions-bar">
      <button class="tool-action-btn tool-action-copy" bindtap="copyResult" hover-class="btn-hover">{{i18n.copyResultBtn}}</button>
      <button class="tool-action-btn tool-action-reset" bindtap="resetData" hover-class="btn-hover">{{i18n.resetBtn}}</button>
    </view>

    <view class="library-section">
      <view class="section-header-row">
        <text class="library-title">{{i18n.commonRegexTitle}}</text>
      </view>
      <view class="category-filter">
        <view
          class="category-tab {{activeRegexCategory === item.key ? 'active' : ''}}"
          wx:for="{{regexCategories}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onRegexCategoryTap"
        >
          <text>{{item.name}}</text>
        </view>
      </view>
      <view class="library-grid">
        <view
          class="library-item"
          wx:for="{{filteredRegexes}}"
          wx:key="name"
          data-regex="{{item}}"
          bindtap="selectLibraryRegex"
        >
          <view class="library-item-header">
            <text class="library-name">{{item.name}}</text>
            <text class="library-category-tag">{{item.desc}}</text>
          </view>
          <text class="library-pattern">{{item.pattern}}</text>
        </view>
      </view>
    </view>

    <view class="cheat-sheet-section">
      <view class="section-header-row" bindtap="toggleCheatSheet">
        <text class="cheat-title">{{i18n.cheatSheetTitle}}</text>
        <view class="cheat-toggle">
          <text>{{showCheatSheet ? i18n.collapse : i18n.expand}}</text>
        </view>
      </view>
      <view wx:if="{{showCheatSheet}}" class="cheat-content">
        <view
          class="cheat-category"
          wx:for="{{cheatSheetData}}"
          wx:key="category"
        >
          <view
            class="cheat-category-header"
            data-key="{{item.category}}"
            bindtap="onCheatCategoryTap"
          >
            <text class="cheat-category-name">{{item.category}}</text>
            <text class="cheat-category-arrow">{{activeCheatCategory === item.category ? '▲' : '▼'}}</text>
          </view>
          <view wx:if="{{activeCheatCategory === item.category}}" class="cheat-items">
            <view
              class="cheat-item"
              wx:for="{{item.items}}"
              wx:for-item="ci"
              wx:key="syntax"
            >
              <text class="cheat-syntax">{{ci.syntax}}</text>
              <text class="cheat-desc">{{ci.desc}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>
