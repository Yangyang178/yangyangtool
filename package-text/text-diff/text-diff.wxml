<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>

<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}}" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="container">
    <view class="hero-section">
      <view class="hero-icon">
        <view class="icon-bg"></view>
        <text class="icon-text">🔄</text>
      </view>
      <text class="hero-title">{{i18n.toolTitle}}</text>
      <text class="hero-subtitle">{{i18n.toolDesc}}</text>
    </view>

    <view class="input-section">
      <view class="input-group">
        <view class="input-header">
          <view class="input-label">
            <view class="label-dot dot-left"></view>
            <text>{{i18n.originalText}}</text>
          </view>
          <view class="input-actions">
            <text class="char-count">{{text1.length}} {{i18n.charUnit}}</text>
            <view class="action-btn" bindtap="clearText1" wx:if="{{text1.length > 0}}">
              <text>{{i18n.clearBtn}}</text>
            </view>
          </view>
        </view>
        <textarea
          class="text-input"
          value="{{text1}}"
          bindinput="onInput1"
          placeholder="{{i18n.originalPlaceholder}}"
          placeholder-class="placeholder"
          maxlength="-1"
          auto-height
          adjust-position="{{false}}"
        />
      </view>

      <view class="divider-line">
        <view class="divider-dot"></view>
      </view>

      <view class="input-group">
        <view class="input-header">
          <view class="input-label">
            <view class="label-dot dot-right"></view>
            <text>{{i18n.modifiedText}}</text>
          </view>
          <view class="input-actions">
            <text class="char-count">{{text2.length}} {{i18n.charUnit}}</text>
            <view class="action-btn" bindtap="clearText2" wx:if="{{text2.length > 0}}">
              <text>{{i18n.clearBtn}}</text>
            </view>
          </view>
        </view>
        <textarea
          class="text-input"
          value="{{text2}}"
          bindinput="onInput2"
          placeholder="{{i18n.modifiedPlaceholder}}"
          placeholder-class="placeholder"
          maxlength="-1"
          auto-height
          adjust-position="{{false}}"
        />
      </view>
    </view>

    <view class="button-group">
      <button class="primary-btn" bindtap="compare" hover-class="btn-pressed">
        <view class="btn-content">
          <text class="btn-icon">◈</text>
          <text class="btn-text">{{i18n.compareBtn}}</text>
        </view>
        <view class="btn-glow"></view>
      </button>
      <button class="secondary-btn" bindtap="swapTexts" hover-class="btn-pressed-secondary">
        <text class="swap-icon">⇅</text>
      </button>
    </view>

    <view class="result-section" wx:if="{{diffResult.length > 0}}">
      <view class="result-header">
        <view class="result-title-group">
          <text class="result-icon">◉</text>
          <text class="result-title">{{i18n.diffResult}}</text>
        </view>
        <view class="stats-bar">
          <view class="stat-chip stat-added">
            <view class="chip-indicator"></view>
            <text>{{stats.added}} {{i18n.added}}</text>
          </view>
          <view class="stat-chip stat-removed">
            <view class="chip-indicator"></view>
            <text>{{stats.removed}} {{i18n.removed}}</text>
          </view>
          <view class="stat-chip stat-same">
            <view class="chip-indicator"></view>
            <text>{{stats.same}} {{i18n.unchanged}}</text>
          </view>
        </view>
      </view>

      <view class="result-toolbar">
        <view class="toolbar-btn {{showLineNumbers ? 'active' : ''}}" bindtap="toggleLineNumbers">
          <text>{{i18n.lineNumbers}}</text>
        </view>
        <view class="toolbar-btn" bindtap="toggleMergePanel">
          <text>{{i18n.merge}}</text>
        </view>
        <view class="toolbar-btn" bindtap="exportResult">
          <text>{{i18n.export}}</text>
        </view>
      </view>

      <view class="merge-panel" wx:if="{{showMergePanel}}">
        <text class="merge-label">{{i18n.mergeStrategy}}</text>
        <view class="merge-options">
          <view class="merge-opt {{mergeMode === 'left' ? 'active' : ''}}" data-mode="left" bindtap="selectMergeMode">
            <text>{{i18n.keepOriginal}}</text>
          </view>
          <view class="merge-opt {{mergeMode === 'right' ? 'active' : ''}}" data-mode="right" bindtap="selectMergeMode">
            <text>{{i18n.keepModified}}</text>
          </view>
          <view class="merge-opt {{mergeMode === 'both' ? 'active' : ''}}" data-mode="both" bindtap="selectMergeMode">
            <text>{{i18n.keepBoth}}</text>
          </view>
        </view>
        <view class="merge-actions" wx:if="{{mergedText}}">
          <view class="merge-action-btn use" bindtap="useMergedText">
            <text>{{i18n.replaceOriginal}}</text>
          </view>
          <view class="merge-action-btn copy" bindtap="copyMergedText">
            <text>{{i18n.copyResult}}</text>
          </view>
        </view>
      </view>

      <scroll-view class="diff-container" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="diff-list">
          <block wx:for="{{diffResult}}" wx:key="index">
            <view class="diff-item {{item.type === 'added' ? 'is-added' : item.type === 'removed' ? 'is-removed' : 'is-same'}}">
              <view class="item-linenum" wx:if="{{showLineNumbers && item.lineNum > 0}}">
                <text>{{item.lineNum}}</text>
              </view>
              <view class="item-marker">
                <text wx:if="{{item.type === 'added'}}">+</text>
                <text wx:elif="{{item.type === 'removed'}}">−</text>
                <text wx:else>·</text>
              </view>
              <view class="item-content">
                <text class="content-text">{{item.content || '\u00A0'}}</text>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>

    <view class="tool-actions-bar">
      <button class="tool-action-btn tool-action-copy" bindtap="copyResult" hover-class="btn-hover">{{i18n.copyResultBtn}}</button>
      <button class="tool-action-btn tool-action-reset" bindtap="resetData" hover-class="btn-hover">{{i18n.resetBtn}}</button>
    </view>

    <view class="empty-state" wx:if="{{diffResult.length === 0 && (text1 || text2)}}">
      <view class="empty-illustration">
        <text class="empty-symbol">◇</text>
      </view>
      <text class="empty-hint">{{i18n.clickCompareHint}}</text>
    </view>

    <view class="welcome-state" wx:if="{{!text1 && !text2 && diffResult.length === 0}}">
      <view class="welcome-card">
        <view class="welcome-icon-wrap">
          <text class="welcome-icon">✦</text>
        </view>
        <text class="welcome-title">{{i18n.readyToStart}}</text>
        <text class="welcome-desc">{{i18n.readyDesc}}</text>
        <view class="feature-list">
          <view class="feature-item">
            <text class="feature-bullet">→</text>
            <text class="feature-text">{{i18n.feature1}}</text>
          </view>
          <view class="feature-item">
            <text class="feature-bullet">→</text>
            <text class="feature-text">{{i18n.feature2}}</text>
          </view>
          <view class="feature-item">
            <text class="feature-bullet">→</text>
            <text class="feature-text">{{i18n.feature3}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-spacer"></view>
  </view>
</scroll-view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>
