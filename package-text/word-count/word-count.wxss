@import "../../styles/tool-common.wxss";

page { background-color: var(--pageBg,#F8FAFC); }
.tool-page { height: 100vh; }
.container { padding: 20px; padding-bottom: 40px; }

.tool-header { text-align: center; margin-bottom: 24px; }
.icon-wrapper { width: 80px; height: 80px; border-radius: 24px; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; background: linear-gradient(135deg, var(--gradientPurpleStart,#DDD6FE) 0%, var(--gradientPurpleEnd,#C4B5FD) 100%); }
.tool-icon { font-size: 40px; }
.tool-title { font-size: 24px; font-weight: 700; color: var(--textPrimary,#1E293B); display: block; margin-bottom: 8px; }
.tool-desc { font-size: 14px; color: var(--textSecondary,#64748B); }

.input-area { background: var(--cardBg,#FFFFFF); border-radius: 20px; padding: 20px; box-shadow: 0 2px 12px rgba(0,0,0,0.04); margin-bottom: 24px; }
.text-input { width: 100%; min-height: 200px; font-size: 15px; line-height: 1.6; color: var(--textPrimary,#1E293B); border: none; outline: none; }
.input-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--surfaceBg,#F1F5F9); }
.char-hint { font-size: 13px; color: var(--textTertiary,#94A3B8); }
.clear-btn { font-size: 13px; color: var(--accentRed,#EF4444); background: none; border: none; padding: 6px 12px; }

.stats-section { margin-bottom: 24px; }
.main-stat-card { background: linear-gradient(135deg, var(--accentPurple,#8B5CF6) 0%, var(--accentPurpleDark,#7C3AED) 100%); border-radius: 20px; padding: 32px; text-align: center; margin-bottom: 16px; box-shadow: 0 8px 24px rgba(99, 102, 241, 0.3); }
.big-number { font-size: 56px; font-weight: 700; color: var(--cardBg,#FFFFFF); display: block; }
.stat-label { font-size: 15px; color: rgba(255,255,255,0.9); margin-top: 8px; display: block; }

.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 16px; }
.stat-item { background: var(--cardBg,#FFFFFF); border-radius: 14px; padding: 18px 10px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
.stat-value { font-size: 28px; font-weight: 700; display: block; margin-bottom: 4px; }
.stat-value.purple { color: var(--accentPurple,#8B5CF6); }
.stat-value.blue { color: var(--accentBlue,#3B82F6); }
.stat-value.green { color: var(--accentGreen,#10B981); }
.stat-value.orange { color: var(--accentYellow,#F59E0B); }
.stat-name { font-size: 12px; color: var(--textSecondary,#64748B); }

.detail-list { background: var(--cardBg,#FFFFFF); border-radius: 16px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
.detail-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--surfaceBg,#F1F5F9); }
.detail-row:last-child { border-bottom: none; }
.detail-label { font-size: 14px; color: var(--textSecondary,#64748B); }
.detail-value { font-size: 16px; font-weight: 600; color: var(--textPrimary,#1E293B); }

.action-btns { display: flex; gap: 12px; }
.primary-btn, .secondary-btn { flex: 1; height: 52px; border-radius: 26px; display: flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 600; border: none; }
.primary-btn { background: linear-gradient(135deg, var(--accentPurple,#8B5CF6) 0%, var(--accentPurpleDark,#7C3AED) 100%); color: var(--cardBg,#FFFFFF); box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3); }
.secondary-btn { background: var(--surfaceBg,#F1F5F9); color: var(--textSecondary,#64748B); }

.section-title { font-size: 15px; font-weight: 700; color: var(--textPrimary,#1E293B); display: block; margin-bottom: 12px; }

.time-section { margin-top: 16px; }
.time-grid { display: flex; gap: 10px; }
.time-card { flex: 1; background: var(--cardBg,#FFFFFF); border-radius: 14px; padding: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
.time-card.read { border-left: 4px solid var(--accentBlue,#3B82F6); }
.time-card.speak { border-left: 4px solid var(--accentGreen,#10B981); }
.time-icon { font-size: 22px; display: block; margin-bottom: 6px; }
.time-value { font-size: 22px; font-weight: 800; color: var(--textPrimary,#1E293B); display: block; margin-bottom: 4px; }
.time-card.read .time-value { color: var(--accentBlue,#3B82F6); }
.time-card.speak .time-value { color: var(--accentGreen,#10B981); }
.time-label { font-size: 11px; color: var(--textTertiary,#94A3B8); line-height: 1.3; }

.keyword-section { margin-top: 16px; background: var(--cardBg,#FFFFFF); border-radius: 16px; padding: 16px 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
.keyword-header { display: flex; justify-content: space-between; align-items: center; }
.keyword-toggle { padding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: 600; background: var(--pageBg,#F8FAFC); color: var(--textSecondary,#64748B); border: 1.5px solid var(--borderLight,#E2E8F0); }
.keyword-toggle.active { background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%); color: #FFFFFF; border-color: transparent; box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3); }
.keyword-body { margin-top: 14px; animation: slideUp 0.3s ease; }
@keyframes slideUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
.keyword-list { display: flex; flex-wrap: wrap; gap: 8px; }
.keyword-item { display: flex; align-items: center; gap: 6px; padding: 6px 14px; background: var(--pageBg,#F8FAFC); border-radius: 20px; border: 1px solid var(--borderLight,#E2E8F0); }
.keyword-word { font-size: 13px; font-weight: 600; color: var(--textPrimary,#1E293B); }
.keyword-count { font-size: 11px; color: var(--accentPurple,#8B5CF6); font-weight: 700; }
.keyword-empty { text-align: center; padding: 16px 0; }
.keyword-empty-text { font-size: 13px; color: var(--textTertiary,#94A3B8); }

.dedup-section { margin-top: 16px; background: var(--cardBg,#FFFFFF); border-radius: 16px; padding: 16px 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
.dedup-header { display: flex; justify-content: space-between; align-items: center; }
.dedup-toggle { padding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: 600; background: var(--pageBg,#F8FAFC); color: var(--textSecondary,#64748B); border: 1.5px solid var(--borderLight,#E2E8F0); }
.dedup-toggle.active { background: linear-gradient(135deg, #10B981 0%, #059669 100%); color: #FFFFFF; border-color: transparent; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); }
.dedup-body { margin-top: 14px; animation: slideUp 0.3s ease; }
.dedup-info { text-align: center; padding: 12px; background: var(--pageBg,#F8FAFC); border-radius: 10px; margin-bottom: 12px; }
.dedup-info-text { font-size: 14px; color: var(--textSecondary,#64748B); font-weight: 500; }
.dedup-actions { display: flex; gap: 10px; }
.dedup-btn { flex: 1; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 600; }
.dedup-btn.use { background: linear-gradient(135deg, #10B981 0%, #059669 100%); color: #FFFFFF; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); }
.dedup-btn.copy { background: var(--pageBg,#F8FAFC); color: var(--textSecondary,#64748B); border: 1.5px solid var(--borderLight,#E2E8F0); }
.dedup-btn:active { transform: scale(0.97); }

/* ===================================
   🌙 夜间模式完整适配 - 靛蓝主题
   =================================== */
.dark-mode page {
  background-color: var(--pageBgNight,#0f1419);
}

.dark-mode .icon-wrapper {
  box-shadow: 0 8px 24px rgba(99, 102, 241, 0.25);
}

.dark-mode .tool-title {
  color: var(--textPrimary,#F1F5F9);
}

.dark-mode .tool-desc {
  color: var(--textSecondary,#94A3B8);
}

.dark-mode .input-area {
  background: var(--elevatedBg,#232d42);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.dark-mode .text-input {
  color: var(--textPrimary,#F1F5F9);
}

.dark-mode .input-footer {
  border-top-color: var(--borderLight,#374151);
}

.dark-mode .char-hint {
  color: var(--textMuted,#475569);
}

.dark-mode .clear-btn {
  color: var(--accentRed,#F87171);
}

.dark-mode .main-stat-card {
  background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%);
  box-shadow: 0 8px 24px rgba(99, 102, 241, 0.25);
}

.dark-mode .stat-item {
  background: var(--cardBg,#1a2035);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
}

.dark-mode .stat-value.purple {
  color: var(--accentIndigo,#818CF8);
}

.dark-mode .stat-value.blue {
  color: var(--accentBlue,#60A5FA);
}

.dark-mode .stat-value.green {
  color: var(--accentGreen,#34D399);
}

.dark-mode .stat-value.orange {
  color: var(--accentYellow,#FBBF24);
}

.dark-mode .stat-name {
  color: var(--textMuted,#475569);
}

.dark-mode .detail-list {
  background: var(--elevatedBg,#232d42);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
}

.dark-mode .detail-row {
  border-bottom-color: var(--borderLight,#374151);
}

.dark-mode .detail-label {
  color: var(--textSecondary,#94A3B8);
}

.dark-mode .detail-value {
  color: var(--textPrimary,#F1F5F9);
}

.dark-mode .primary-btn {
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
}

.dark-mode .secondary-btn {
  background: var(--cardBg,#1a2035);
  color: var(--textSecondary,#94A3B8);
}

.dark-mode .section-title {
  color: var(--textPrimary,#F1F5F9);
}

.dark-mode .time-card {
  background: var(--cardBg,#1a2035);
}

.dark-mode .time-value {
  color: var(--textPrimary,#F1F5F9);
}

.dark-mode .time-card.read .time-value {
  color: var(--accentBlue,#60A5FA);
}

.dark-mode .time-card.speak .time-value {
  color: var(--accentGreen,#34D399);
}

.dark-mode .keyword-section,
.dark-mode .dedup-section {
  background: var(--elevatedBg,#232d42);
}

.dark-mode .keyword-toggle,
.dark-mode .dedup-toggle {
  background: var(--cardBg,#1a2035);
  color: var(--textSecondary,#94A3B8);
  border-color: var(--borderDark,rgba(71,85,105,0.25));
}

.dark-mode .keyword-toggle.active {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
  color: #FFFFFF;
  border-color: transparent;
}

.dark-mode .dedup-toggle.active {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  border-color: transparent;
}

.dark-mode .keyword-item {
  background: var(--cardBg,#1a2035);
  border-color: var(--borderDark,rgba(71,85,105,0.25));
}

.dark-mode .keyword-word {
  color: var(--textPrimary,#F1F5F9);
}

.dark-mode .keyword-count {
  color: var(--accentPurple,#A78BFA);
}

.dark-mode .dedup-info {
  background: var(--cardBg,#1a2035);
}

.dark-mode .dedup-info-text {
  color: var(--textSecondary,#94A3B8);
}

.dark-mode .dedup-btn.copy {
  background: var(--cardBg,#1a2035);
  color: var(--textSecondary,#94A3B8);
  border-color: var(--borderDark,rgba(71,85,105,0.25));
}
