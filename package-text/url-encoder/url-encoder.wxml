<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#F8FAFC"></navigation-bar>

<scroll-view class="tool-page {{isDarkMode ? 'dark-mode' : ''}} font-size-{{fontSizeSetting}}" scroll-y>
  <view class="container">
    <view class="tool-header">
      <view class="icon-wrapper" style="background: linear-gradient(135deg, #06B6D433 0%, #06B6D466 100%);">
        <view class="icon-decoration"></view>
        <text class="tool-icon">🔗</text>
      </view>
      <text class="tool-title">{{i18n.toolTitle}}</text>
      <text class="tool-desc">{{i18n.toolDesc}}</text>
    </view>

    <view class="mode-tabs">
      <view class="mode-tab {{currentMode === 'encode' ? 'active' : ''}}" data-mode="encode" bindtap="switchMode">
        <text>{{i18n.modeEncode}}</text>
      </view>
      <view class="mode-tab {{currentMode === 'decode' ? 'active' : ''}}" data-mode="decode" bindtap="switchMode">
        <text>{{i18n.modeDecode}}</text>
      </view>
      <view class="mode-tab {{currentMode === 'base64' ? 'active' : ''}}" data-mode="base64" bindtap="switchMode">
        <text>{{i18n.modeBase64}}</text>
      </view>
    </view>

    <view class="input-section">
      <view class="section-header-row">
        <text class="section-label">{{inputLabel}}</text>
        <view class="input-actions">
          <view class="action-tag paste" bindtap="pasteFromClipboard"><text>{{i18n.pasteBtn}}</text></view>
          <view class="action-tag sample" bindtap="loadSample"><text>{{i18n.sampleBtn}}</text></view>
          <view class="action-tag clear" bindtap="clearInput"><text>{{i18n.clearBtn}}</text></view>
        </view>
      </view>
      <textarea class="url-input" placeholder="{{inputPlaceholder}}" value="{{inputText}}" bindinput="onInputChange" auto-height maxlength="-1"></textarea>
      <view wx:if="{{inputText}}" class="input-stats">
        <text class="stat-item">{{i18n.charCountLabel}}: {{inputLength}}</text>
        <text class="stat-item">{{i18n.byteCountLabel}}: {{inputBytes}}</text>
      </view>
    </view>

    <view class="convert-btn" bindtap="convert">
      <text>{{convertBtnText}}</text>
    </view>

    <view wx:if="{{outputText}}" class="output-section">
      <view class="section-header-row">
        <text class="section-label">{{outputLabel}}</text>
        <view class="output-actions">
          <view class="action-tag copy-main" bindtap="copyOutput"><text>{{i18n.copyBtn}}</text></view>
        </view>
      </view>
      <view class="output-container">
        <scroll-view scroll-x scroll-y class="output-scroll">
          <text class="output-text">{{outputText}}</text>
        </scroll-view>
      </view>
      <view class="output-stats">
        <text class="stat-item">{{i18n.charCountLabel}}: {{outputLength}}</text>
        <text class="stat-item">{{i18n.changeRateLabel}}: {{changeRate}}</text>
      </view>
    </view>

    <view class="tool-actions-bar">
      <button class="tool-action-btn tool-action-reset" bindtap="resetData" hover-class="btn-hover">{{i18n.resetBtn}}</button>
    </view>

    <view wx:if="{{parsedUrl}}" class="parse-section">
      <text class="parse-title">{{i18n.urlParseTitle}}</text>

      <view class="parse-card">
        <view class="parse-item">
          <text class="parse-label">{{i18n.protocol}}</text>
          <text class="parse-value">{{parsedUrl.protocol}}</text>
        </view>
        <view class="parse-item">
          <text class="parse-label">{{i18n.host}}</text>
          <text class="parse-value">{{parsedUrl.host}}</text>
        </view>
        <view class="parse-item" wx:if="{{parsedUrl.port}}">
          <text class="parse-label">{{i18n.port}}</text>
          <text class="parse-value">{{parsedUrl.port}}</text>
        </view>
        <view class="parse-item">
          <text class="parse-label">{{i18n.path}}</text>
          <text class="parse-value">{{parsedUrl.pathname}}</text>
        </view>
        <view class="parse-item" wx:if="{{parsedUrl.hash}}">
          <text class="parse-label">{{i18n.anchor}}</text>
          <text class="parse-value">#{{parsedUrl.hash}}</text>
        </view>
      </view>

      <view class="param-table-section" wx:if="{{paramTable.length > 0}}">
        <view class="param-table-header">
          <text class="param-table-title">{{i18n.paramTableTitle}} ({{paramTable.length}}{{i18n.paramCountUnit}})</text>
          <view class="param-table-actions">
            <view class="param-add-btn" bindtap="addNewParam">{{i18n.addParamBtn}}</view>
          </view>
        </view>

        <view class="param-table">
          <view class="param-table-row param-table-head">
            <text class="pt-cell pt-idx">#</text>
            <text class="pt-cell pt-key">{{i18n.paramName}}</text>
            <text class="pt-cell pt-val">{{i18n.paramValue}}</text>
            <text class="pt-cell pt-act">{{i18n.paramAction}}</text>
          </view>

          <view class="param-table-row" wx:for="{{paramTable}}" wx:key="index">
            <block wx:if="{{editingParamIndex === item.index}}">
              <text class="pt-cell pt-idx">{{item.index + 1}}</text>
              <view class="pt-cell pt-edit-cell">
                <input class="pt-edit-input" value="{{editingParamKey}}" bindinput="onEditParamKey" placeholder="{{i18n.paramName}}"/>
              </view>
              <view class="pt-cell pt-edit-cell">
                <input class="pt-edit-input" value="{{editingParamValue}}" bindinput="onEditParamValue" placeholder="{{i18n.paramValue}}"/>
              </view>
              <view class="pt-cell pt-act pt-act-edit">
                <text class="pt-save" bindtap="saveParamEdit">✓</text>
                <text class="pt-cancel" bindtap="cancelParamEdit">✕</text>
              </view>
            </block>
            <block wx:else>
              <text class="pt-cell pt-idx">{{item.index + 1}}</text>
              <text class="pt-cell pt-key" bindtap="onEditParam" data-index="{{item.index}}">{{item.key}}</text>
              <text class="pt-cell pt-val" bindtap="onEditParam" data-index="{{item.index}}">{{item.value || i18n.emptyValue}}</text>
              <view class="pt-cell pt-act">
                <text class="pt-edit" bindtap="onEditParam" data-index="{{item.index}}">✏️</text>
                <text class="pt-del" catchtap="deleteParam" data-index="{{item.index}}">🗑️</text>
              </view>
            </block>
          </view>
        </view>
      </view>

      <view class="rebuilt-url-section" wx:if="{{parsedUrl.fullUrl}}">
        <text class="rebuilt-label">{{i18n.fullUrl}}</text>
        <view class="rebuilt-url-box">
          <text class="rebuilt-url-text">{{parsedUrl.fullUrl}}</text>
          <view class="rebuilt-copy-btn" bindtap="copyRebuiltUrl">📋</view>
        </view>
      </view>

      <view class="short-url-section">
        <view class="short-url-header">
          <text class="short-url-label">{{i18n.shortUrlLabel}}</text>
        </view>
        <view class="short-url-btn" bindtap="generateShortUrl">
          <text>{{shortUrlLoading ? i18n.generating : i18n.generateShortUrl}}</text>
        </view>
        <view class="short-url-result" wx:if="{{shortUrl}}">
          <text class="short-url-text">{{shortUrl}}</text>
          <view class="short-url-copy" bindtap="copyShortUrl">📋</view>
        </view>
      </view>
    </view>

    <view class="reference-section">
      <text class="ref-title">{{i18n.encodingRefTitle}}</text>
      <view class="ref-table">
        <view class="ref-header">
          <text class="ref-cell header">{{i18n.refChar}}</text>
          <text class="ref-cell header">{{i18n.refEncoded}}</text>
          <text class="ref-cell header">{{i18n.refDesc}}</text>
        </view>
        <view class="ref-row" wx:for="{{commonEncodings}}" wx:key="char">
          <text class="ref-cell char">{{item.char}}</text>
          <text class="ref-cell encoded">{{item.encoded}}</text>
          <text class="ref-cell desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="tips-section">
      <text class="tips-title">{{i18n.usageTitle}}</text>
      <view class="tips-list">
        <view class="tip-item">
          <text class="tip-bullet">•</text>
          <text class="tip-text"><b>{{i18n.urlEncodeLabel}}</b>: {{i18n.tip1}}</text>
        </view>
        <view class="tip-item">
          <text class="tip-bullet">•</text>
          <text class="tip-text"><b>{{i18n.urlDecodeLabel}}</b>: {{i18n.tip2}}</text>
        </view>
        <view class="tip-item">
          <text class="tip-bullet">•</text>
          <text class="tip-text"><b>{{i18n.paramTableLabel}}</b>: {{i18n.tip3}}</text>
        </view>
        <view class="tip-item">
          <text class="tip-bullet">•</text>
          <text class="tip-text"><b>{{i18n.shortUrlGenLabel}}</b>: {{i18n.tip4}}</text>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
<canvas type="2d" id="toolPosterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>
